{
  "name": "cocenglish",
  "private": true,
  "packageManager": "pnpm@10.15.0",
  "scripts": {
    "blueprint:check": "node tools/blueprint/validate.mjs",
    "mobile:verify": "node tools/scripts/mobile-check.mjs",
    "build:web": "node tools/scripts/mobile-web-build.mjs",
    "preview:web": "node tools/scripts/mobile-preview.mjs",
    "build:android": "node tools/scripts/mobile-check.mjs --build-android",
    "verify": "node tools/scripts/mobile-check.mjs --with-blueprint",
    "backend:build": "node tools/scripts/backend-check.mjs --build",
    "backend:verify": "node tools/scripts/backend-check.mjs",
    "backend:smoke": "node tools/scripts/backend-smoke.mjs",
    "dev:services": "node tools/scripts/dev-services.mjs",
    "dev:smoke": "node tools/scripts/dev-smoke.mjs",
    "local:setup": "node tools/scripts/local-setup.mjs",
    "local:configure": "node tools/scripts/local-config.mjs",
    "local:doctor": "node tools/scripts/local-dev.mjs doctor",
    "local:up": "node tools/scripts/local-dev.mjs up",
    "local:stop": "node tools/scripts/local-dev.mjs stop",
    "local:status": "node tools/scripts/local-dev.mjs status",
    "local:logs": "node tools/scripts/local-dev.mjs logs",
    "local:appwrite": "node tools/scripts/local-appwrite.mjs",
    "local:smoke": "node tools/scripts/local-learning-smoke.mjs",
    "local:auth-smoke": "node tools/scripts/local-auth-smoke.mjs",
    "local:offline-defines": "node tools/scripts/local-offline-defines.mjs",
    "local:apk": "node tools/scripts/local-mobile.mjs",
    "local:test": "node --test tools/tests/local-appwrite.test.mjs tools/tests/local-config.test.mjs tools/tests/local-dev.test.mjs tools/tests/local-learning-smoke.test.mjs tools/tests/local-auth-smoke.test.mjs tools/tests/local-offline-defines.test.mjs tools/tests/local-load.test.mjs",
    "load:local": "node tools/scripts/local-load.mjs",
    "runtime:check": "node tools/scripts/runtime-check.mjs",
    "container:check": "node tools/scripts/container-check.mjs",
    "contracts:generate": "openapi-typescript docs/api/openapi.yaml -o packages/api_contracts/generated.ts",
    "contracts:check": "node tools/blueprint/validate-schemas.mjs && node tools/blueprint/generate-dart-contracts.mjs --check",
    "contracts:dart": "node tools/blueprint/generate-dart-contracts.mjs",
    "api:lint": "redocly lint docs/api/openapi.yaml",
    "audit:check": "node tools/audit/validate.mjs && node tools/audit/endpoint-matrix.mjs --check",
    "docs:endpoints": "node tools/audit/endpoint-matrix.mjs",
    "docs:tree": "node tools/audit/tree.mjs",
    "palette:check": "python3 tools/palette_check.py",
    "schema:plan": "node appwrite/scripts/schema.mjs",
    "schema:test": "node --test appwrite/test/schema.test.mjs appwrite/test/ops.test.mjs",
    "schema:apply": "node appwrite/scripts/schema.mjs --apply",
    "schema:check-live": "node appwrite/scripts/schema.mjs --check-live",
    "appwrite:probe": "node appwrite/scripts/live-probe.mjs",
    "seed:check": "node appwrite/scripts/seed.mjs",
    "schema:declare": "node appwrite/scripts/schema-declare.mjs",
    "appwrite:plan": "node appwrite/scripts/ops.mjs",
    "appwrite:test": "node --test appwrite/test/ops.test.mjs",
    "appwrite:apply": "node appwrite/scripts/ops.mjs --apply",
    "appwrite:check-live": "node appwrite/scripts/ops.mjs --check-live",
    "appwrite:deploy": "node appwrite/scripts/ops.mjs --deploy",
    "appwrite:health": "node appwrite/scripts/ops.mjs --health",
    "appwrite:probe-functions": "node appwrite/scripts/ops.mjs --probe"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@redis/client": "5.9.0",
    "amqplib": "2.2.0"
  },
  "devDependencies": {
    "@redocly/cli": "2.62.1",
    "@types/node": "22.20.5",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "esbuild": "0.28.2",
    "eslint": "10.12.0",
    "jsdom": "30.1.2",
    "mermaid": "12.1.0",
    "node-appwrite": "29.2.0",
    "openapi-typescript": "7.13.0",
    "prettier": "3.9.9",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.1",
    "yaml": "2.9.1"
  }
}
