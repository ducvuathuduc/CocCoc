:"vi_en.v1.placement","lessonId":"placement","lessonVersion":"v1.placement","rewardIdentity":"placement","sha256":"8797fb2059fea2ce3a5cd73330c377f3095829c22ea370e9137a0261f79994c0"},"schemaVersion":1,"sections":[{"sectionId":"sec1","title":"Phần 1: Nền tảng","unitIds":["u1","u2","u3"]},{"sectionId":"sec2","title":"Phần 2: Cuộc sống sinh viên","unitIds":["u4","u5","u6"]}],"signature":"a94bjxvvXOHtaBk4fdfUzlfQUOvpvBS5wTgX4fKlQKTpuuADz1Er6LiuwbuyoOMH9-av5C8hkrssTrjSq0EhBQ","signatureKeyId":"dev-content-1","sourceLocale":"vi-VN","targetLocale":"en-US","title":"Tiếng Anh cho người Việt","units":[{"guideText":"Mẫu câu chính: \"Hello, I am ...\" (Xin chào, tôi là ...), \"Nice to meet you\" (Rất vui được gặp bạn). Trong tiếng Anh, \"I\" luôn viết hoa. Dùng \"Good morning\" trước buổi trưa và \"Good evening\" sau 6 giờ tối.","nodeIds":["u1n1","u1n2","u1n3","u1n4"],"sectionId":"sec1","title":"Chào hỏi và giới thiệu","unitId":"u1"},{"guideText":"Dùng \"my/your/his/her\" để nói về sở hữu: \"my mother\" (mẹ tôi). Động từ \"to be\": I am, you are, he/she is, they are. Số nhiều thường thêm -s: brother → brothers.","nodeIds":["u2n1","u2n2","u2n3","u2n4"],"sectionId":"sec1","title":"Gia đình và con người","unitId":"u2"},{"guideText":"Gọi món lịch sự: \"I would like a coffee, please.\" Danh từ đếm được dùng \"a/an\": a banana, an apple. Danh từ không đếm được (water, rice) không dùng \"a\".","nodeIds":["u3n1","u3n2","u3n3","u3n4"],"sectionId":"sec1","title":"Đồ ăn và thức uống","unitId":"u3"},{"guideText":"Thì hiện tại đơn diễn tả thói quen: \"I get up at six.\" Với he/she/it thêm -s: \"She gets up at six.\" Hỏi giờ: \"What time is it?\" — \"It is seven o'clock.\"","nodeIds":["u4n1","u4n2","u4n3","u4n4"],"sectionId":"sec2","title":"Thói quen hằng ngày","unitId":"u4"},{"guideText":"Hỏi đường: \"Where is the station?\" Chỉ đường: \"Turn left/right\", \"Go straight\". Giới từ chỉ vị trí: next to (bên cạnh), near (gần), opposite (đối diện).","nodeIds":["u5n1","u5n2","u5n3","u5n4"],"sectionId":"sec2","title":"Du lịch và chỉ đường","unitId":"u5"},{"guideText":"Câu hỏi lịch sự trong lớp: \"Could you repeat that, please?\" \"Can I ask a question?\" Dùng \"have to\" để nói việc bắt buộc: \"I have to study for the exam.\"","nodeIds":["u6n1","u6n2","u6n3","u6n4"],"sectionId":"sec2","title":"Học tập ở trường đại học","unitId":"u6"}]}