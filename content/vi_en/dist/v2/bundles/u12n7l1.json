nds":7,"referenceText":"The taxi driver is from Hanoi."},"explanation":"Câu mẫu: \"The taxi driver is from Hanoi.\".","gradingRule":{"acceptedText":["The taxi driver is from Hanoi."],"caseSensitive":false,"ignoreDiacritics":false,"ignorePunctuation":true},"hint":"Nghĩa: \"Tài xế taxi đến từ Hà Nội.\"","id":"u12n7l1-e13","nonSpeechAlternative":{"content":{"tokens":[{"id":"t1","text":"from"},{"id":"t2","text":"is"},{"id":"t3","text":"The"},{"id":"t4","text":"driver"},{"id":"t5","text":"taxi"},{"id":"t6","text":"Hanoi"}]},"explanation":"Câu đúng: \"The taxi driver is from Hanoi.\".","gradingRule":{"caseSensitive":false,"correctTokenIds":["t3","t5","t4","t2","t1","t6"],"ignoreDiacritics":false,"ignorePunctuation":false},"hint":"Câu bắt đầu bằng \"The\".","id":"u12n7l1-e13a","prompt":{"locale":"vi-VN","text":"Sắp xếp thành câu đúng: \"Tài xế taxi đến từ Hà Nội.\""},"skillIds":["speaking","u12.grammar"],"type":"sentenceOrder","vocabularyIds":["u1.from","u11.taxi","u12.driver"]},"prompt":{"audioAssetId":"a.u12.s10.n","locale":"en-US","text":"Nói câu sau: \"The taxi driver is from Hanoi.\""},"skillIds":["speaking","u12.grammar"],"type":"speakRepeat","vocabularyIds":["u1.from","u11.taxi","u12.driver"]},{"content":{"tokens":[{"id":"t1","text":"Tôi"},{"id":"t2","text":"Câu"},{"id":"t3","text":"sách"},{"id":"t4","text":"của"},{"id":"t5","text":"việc"},{"id":"t6","text":"mở"},{"id":"t7","text":"tôi"},{"id":"t8","text":"nấu"},{"id":"t9","text":"công"},{"id":"t10","text":"yêu"}]},"explanation":"Câu đúng: \"Tôi yêu công việc của tôi.\".","gradingRule":{"caseSensitive":false,"correctTokenIds":["t1","t10","t9","t5","t4","t7"],"ignoreDiacritics":false,"ignorePunctuation":false},"hint":"\"love\" = yêu; \"job\" = công việc","id":"u12n7l1-e14","prompt":{"locale":"vi-VN","text":"Dịch sang tiếng Việt: \"I love my job.\""},"skillIds":["u12.grammar"],"type":"wordBank","vocabularyIds":["u2.love","u12.job"]},{"content":{"maxChars":200,"placeholder":"Viết bằng tiếng Anh"},"explanation":"Đáp án: \"Engineers work with computers.\".","gradingRule":{"acceptedText":["Engineers work with computers."],"caseSensitive":false,"ignoreDiacritics":false,"ignorePunctuation":true},"hint":"\"work\" = làm việc; \"engineer\" = kỹ sư; \"computer\" = máy tính","id":"u12n7l1-e15","prompt":{"locale":"vi-VN","text":"Kỹ sư làm việc với máy tính."},"skillIds":["u12.grammar"],"type":"textTranslation","vocabularyIds":["u12.work","u12.engineer","u12.computer"]}],"gradingRulesVersion":"g1","guideText":"Mẫu câu chính: \"What do you do?\" (Bạn làm nghề gì?) — \"I am an engineer.\" (Tôi là kỹ sư.) — \"I worked late yesterday.\" (Hôm qua tôi làm việc muộn.)\nNghề nghiệp luôn có a/an: \"She is a nurse\", \"He is an engineer\" (an trước nguyên âm).\nThì quá khứ đơn (động từ có quy tắc): thêm -ed: work → worked, start → started, finish → finished. Quá khứ của \"be\": I/he/she was, you/we/they were.\nCâu hỏi quá khứ dùng \"did\" + động từ nguyên mẫu: \"Did you finish your work?\" (không nói \"Did you finished\").\nMốc thời gian quá khứ: yesterday (hôm qua), last week (tuần trước).","lessonId":"u12n7l1","lessonVersion":"v2.u12n7l1","manifestHash":"013672aa5927648264926e14d514d9d670ba04f547fc10aba6d50095b8e8b587","nodeId":"u12n7","order":94,"rewardIdentity":"v2.u12n7l1","schemaVersion":1,"sectionId":"sec2","signature":"oZKwnPUC333vk8Ww4-8QqE6Z4eUMRLQGrHyeE-URMRRCUKJclDViKkqLVqvBSnNPjWuJjUkTvIRhdTJyIfxFDA","signatureKeyId":"dev-content-1","skillIds":["u12.grammar","listening","speaking","u12.dialogue","reading","u12.story","u12.vocab"],"title":"Ôn tập cửa ải · Bài 1","unitId":"u12"}