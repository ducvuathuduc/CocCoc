".","gradingRule":{"caseSensitive":false,"correctTokenIds":["t1","t4","t3","t5","t7"],"ignoreDiacritics":false,"ignorePunctuation":false},"hint":"\"new\" = mới; \"dress\" = váy; \"bought\" = đã mua","id":"u16n3l1-e13","prompt":{"locale":"vi-VN","text":"Dịch câu này: \"Mai đã mua một cái váy mới.\""},"skillIds":["u16.grammar"],"type":"wordBank","vocabularyIds":["u6.new","u9.dress","u16.bought"]}],"gradingRulesVersion":"g1","guideText":"Mẫu câu chính: \"What will you do this weekend?\" (Cuối tuần này bạn sẽ làm gì?) — \"I went to the museum.\" (Tôi đã đi bảo tàng.) — \"That is a good idea!\" (Ý hay đấy!)\nTương lai: will + động từ nguyên mẫu: \"I will call you.\" Rút gọn: I'll, you'll, we'll. Phủ định: will not = won't.\nQuá khứ bất quy tắc phải học thuộc: go → went, see → saw, eat → ate, buy → bought, forget → forgot.\n\"Maybe\" (có lẽ) đứng đầu câu: \"Maybe it will rain tomorrow.\"\nRủ rê: \"Let's ...\" (Chúng ta hãy ... nhé): \"Let's have a picnic.\"","lessonId":"u16n3l1","lessonVersion":"v2.u16n3l1","manifestHash":"013672aa5927648264926e14d514d9d670ba04f547fc10aba6d50095b8e8b587","nodeId":"u16n3","order":122,"rewardIdentity":"v2.u16n3l1","schemaVersion":1,"sectionId":"sec2","signature":"EZ5FkhexFj4NCNxNmU0OgSmcZ6jsXfFZNH1AWL0Xza5gB5ZchcldjhZibWidjFJ8W2VEy4UiMgf34rYsM6NFDQ","signatureKeyId":"dev-content-1","skillIds":["u16.vocab","u16.grammar","listening"],"title":"Hòa nhạc và lễ hội · Bài 1","unitId":"u16"}