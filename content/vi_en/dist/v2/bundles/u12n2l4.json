 you/we/they were.\nCâu hỏi quá khứ dùng \"did\" + động từ nguyên mẫu: \"Did you finish your work?\" (không nói \"Did you finished\").\nMốc thời gian quá khứ: yesterday (hôm qua), last week (tuần trước).","lessonId":"u12n2l4","lessonVersion":"v2.u12n2l4","manifestHash":"013672aa5927648264926e14d514d9d670ba04f547fc10aba6d50095b8e8b587","nodeId":"u12n2","order":89,"rewardIdentity":"v2.u12n2l4","schemaVersion":1,"sectionId":"sec2","signature":"W9JPydqapfxYVR_M0ebuTdCKvhJ6CBN2-xANLVQT9h3Io8OYhh9zZzoAqv-UdZGqUfjUgrnRGLT8ItP2OqZSAA","signatureKeyId":"dev-content-1","skillIds":["speaking","u12.grammar","u12.dialogue","u12.vocab"],"title":"Nghề nghiệp · Bài 4","unitId":"u12"}