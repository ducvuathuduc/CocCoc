t cold now?"},{"id":"c2","text":"The bank is on this street."},{"id":"c3","text":"I want some water."}]},"explanation":"Bạn nghe: \"The bank is on this street.\" (Ngân hàng ở trên đường này.).","gradingRule":{"caseSensitive":false,"correctChoiceId":"c2","ignoreDiacritics":false,"ignorePunctuation":false},"hint":"Câu có nghĩa: \"Ngân hàng ở trên đường này.\"","id":"u10n7l1-e07a","prompt":{"locale":"vi-VN","text":"Chọn câu tiếng Anh có nghĩa: \"Ngân hàng ở trên đường này.\""},"skillIds":["listening","u10.grammar"],"type":"choice","vocabularyIds":["u10.street","u10.bank"]},"prompt":{"audioAssetId":"a.u10.s12.n","locale":"vi-VN","text":"Nghe và chọn câu bạn nghe được"},"skillIds":["listening","u10.grammar"],"type":"listenChoice","vocabularyIds":["u10.street","u10.bank"]},{"content":{"locale":"en-US","maxSeconds":12,"referenceText":"Yes, I cannot find the bridge."},"explanation":"Câu trả lời mẫu: \"Yes, I cannot find the bridge.\". Cũng đúng: \"Yes, I can't find the bridge.\".","gradingRule":{"acceptedText":["Yes, I cannot find the bridge.","Yes, I can't find the bridge."],"caseSensitive":false,"ignoreDiacritics":false,"ignorePunctuation":true},"hint":"Gợi ý trả lời: \"Vâng, tôi không tìm thấy cây cầu.\"","id":"u10n7l1-e08","nonSpeechAlternative":{"content":{"choices":[{"id":"c1","text":"It is on the second floor."},{"id":"c2","text":"Yes, please."},{"id":"c3","text":"Yes, I cannot find the bridge."}]},"explanation":"Câu trả lời mẫu: \"Yes, I cannot find the bridge.\".","gradingRule":{"caseSensitive":false,"correctChoiceId":"c3","ignoreDiacritics":false,"ignorePunctuation":false},"hint":"Gợi ý trả lời: \"Vâng, tôi không tìm thấy cây cầu.\"","id":"u10n7l1-e08a","prompt":{"locale":"vi-VN","text":"\"Are you lost?\" — chọn câu trả lời phù hợp"},"skillIds":["speaking","u10.dialogue"],"type":"choice","vocabularyIds":["u1.yes","u10.bridge","u10.lost","u10.find"]},"prompt":{"audioAssetId":"a.u10.d5.n","locale":"en-US","text":"Are you lost?"},"skillIds":["speaking","u10.dialogue"],"type":"dialogueTurn","vocabularyIds":["u1.yes","u10.bridge","u10.lost","u10.find"]},{"content":{"choices":[{"id":"c1","text":"At the bridge"},{"id":"c2","text":"At the park"},{"id":"c3","text":"At the bank"}],"passage":"On Saturday, Tom wants to go to the bookshop. He walks from his house, but the city is big and he is lost. He does not have a map. He asks a woman, \"Excuse me, where is the bookshop?\" \"Go straight on this street. Turn left at the bank. The bookshop is next to the park, opposite the hospital.\" \"Is it far?\" \"No, it is near. You can walk.\" Tom finds the bookshop. Mai is there too! \"You are not lost now,\" she laughs.","question":"Where does Tom turn left?"},"explanation":"Đáp án: \"At the bank\".","gradingRule":{"caseSensitive":false,"correctChoiceId":"c3","ignoreDiacritics":false,"ignorePunctuation":false},"hint":"Đọc lại câu chuyện \"Tom bị lạc\".","id":"u10n7l1-e09","prompt":{"locale":"en-US","text":"Where does Tom turn left?"},"skillIds":["reading","u10.story"],"type":"storyQuestion","vocabularyIds":[]},{"content":{"choices":[{"id":"c1","imageAssetId":"i.u6.kitchen","text":"kitchen"},{"id":"c2","imageAssetId":"i.u2.baby","text":"baby"},{"id":"c3","imageAssetId":"i.u10.bridge","text":"bridge"},{"id":"c4","imageAssetId":"i.u6.house","text":"house"}]},"explanation":"\"bridge\" = \"cây cầu\".","gradingRule":{"caseSensitive":false,"correctChoiceId":"c3","ignoreDiacritics":false,"ignorePunctuation":false},"hint":"\"cây cầu\" là \"bridge\".","id":"u10n7l1-e10","prompt":{"locale":"vi-VN","text":"Hình nào là \"cây cầu\"?"},"skillIds":["u10.vocab"],"type":"imageChoice","vocabularyIds":["u10.bridge"]},{"content":{"pairs":[{"id":"p1","left":{"id":"p1l","text":"park"},"right":{"id":"p1r","text":"công viên"}},{"id":"p2","left":{"id":"p2l","text":"lost"},"right":{"id":"p2r","text":"bị lạc"}},{"id":"p3","left":{"id":"p3l","text":"find"},"right":{"id":"p3r","text":"tìm"}},{"id":"p4","left":{"id":"p4l","text":"turn"},"right":{"id":"p4r","text":"rẽ"}},{"id":"p5","left":{"id":"p5l","text":"corner"},"right":{"id":"p5r","text":"góc đường"}}]},"explanation":"park = công viên; lost = bị lạc; find = tìm; turn = rẽ; corner = góc đường","gradingRule":{"caseSensitive":false,"correctPairIds":["p1","p2","p3","p4","p5"],"ignoreDiacritics":false,"ignorePunctuation":false},"hint":"Ví dụ: \"park\" = \"công viên\".","id":"u10n7l1-e11","prompt":{"locale":"vi-VN","text":"Nối các cặp từ tương ứng"},"skillIds":["u10.vocab"],"type":"matchPairs","vocabularyIds":["u10.park","u10.lost","u10.find","u10.turn","u10.corner"]},{"content":{"choices":[{"id":"c1","text":"rainy"},{"id":"c2","text":"sky"},{"id":"c3","text":"English"},{"id":"c4","text":"hospital"}]},"explanation":"\"hospital\" = \"bệnh viện\".","gradingRule":{"caseSensitive":false,"correctChoiceId":"c4","ignoreDiacritics":false,"ignorePunctuation":false},"hint":"\"hospital\" nghĩa là \"bệnh viện\".","id":"u10n7l1-e12","prompt":{"locale":"vi-VN","text":"\"bệnh viện\" trong tiếng Anh là gì?"},"skillIds":["u10.vocab"],"type":"choice","vocabularyIds":["u10.hospital"]},{"content":{"locale":"en-US","maxSeconds":8,"referenceText":"We go to the park on Sunday."},"explanation":"Câu mẫu: \"We go to the park on Sunday.\".","gradingRule":{"acceptedText":["We go to the park on Sunday."],"caseSensitive":false,"ignoreDiacritics":false,"ignorePunctuation":true},"hint":"Nghĩa: \"Chúng tôi đi công viên vào Chủ nhật.\"","id":"u10n7l1-e13","nonSpeechAlternative":{"content":{"tokens":[{"id":"t1","text":"the"},{"id":"t2","text":"Sunday"},{"id":"t3","text":"We"},{"id":"t4","text":"on"},{"id":"t5","text":"park"},{"id":"t6","text":"to"},{"id":"t7","text":"go"}]},"explanation":"Câu đúng: \"We go to the park on Sunday.\".","gradingRule":{"caseSensitive":false,"correctTokenIds":["t3","t7","t6","t1","t5","t4","t2"],"ignoreDiacritics":false,"ignorePunctuation":false},"hint":"Câu bắt đầu bằng \"We\".","id":"u10n7l1-e13a","prompt":{"locale":"vi-VN","text":"Sắp xếp thành câu đúng: \"Chúng tôi đi công viên vào Chủ nhật.\""},"skillIds":["speaking","u10.grammar"],"type":"sentenceOrder","vocabularyIds":["u5.go","u5.sunday","u10.park"]},"prompt":{"audioAssetId":"a.u10.s11.n","locale":"en-US","text":"Nói câu sau: \"We go to the park on Sunday.\""},"skillIds":["speaking","u10.grammar"],"type":"speakRepeat","vocabularyIds":["u5.go","u5.sunday","u10.park"]},{"content":{"tokens":[{"id":"t1","text":"tìm"},{"id":"t2","text":"bầu"},{"id":"t3","text":"áp"},{"id":"t4","text":"ngon"},{"id":"t5","text":"không"},{"id":"t6","text":"Tôi"},{"id":"t7","text":"thấy"},{"id":"t8","text":"cái"},{"id":"t9","text":"ngân"},{"id":"t10","text":"hàng"}]},"explanation":"Câu đúng: \"Tôi không tìm thấy ngân hàng.\".","gradingRule":{"caseSensitive":false,"correctTokenIds":["t6","t5","t1","t7","t9","t10"],"ignoreDiacritics":false,"ignorePunctuation":false},"hint":"\"bank\" = ngân hàng; \"find\" = tìm","id":"u10n7l1-e14","prompt":{"locale":"vi-VN","text":"Dịch sang tiếng Việt: \"I cannot find the bank.\""},"skillIds":["u10.grammar"],"type":"wordBank","vocabularyIds":["u10.bank","u10.find"]},{"content":{"maxChars":200,"placeholder":"Viết bằng tiếng Anh"},"explanation":"Đáp án: \"The bridge is near my house.\".","gradingRule":{"acceptedText":["The bridge is near my house."],"caseSensitive":false,"ignoreDiacritics":false,"ignorePunctuation":true},"hint":"\"house\" = ngôi nhà; \"near\" = gần; \"bridge\" = cây cầu","id":"u10n7l1-e15","prompt":{"locale":"vi-VN","text":"Cây cầu ở gần nhà tôi."},"skillIds":["u10.grammar"],"type":"textTranslation","vocabularyIds":["u6.house","u10.near","u10.bridge"]}],"gradingRulesVersion":"g1","guideText":"Mẫu câu chính: \"Excuse me, where is the bank?\" (Xin lỗi, ngân hàng ở đâu?) — \"Go straight and turn left.\" (Đi thẳng rồi rẽ trái.) — \"Is it far?\" (Có xa không?)\nChỉ đường dùng câu mệnh lệnh: Go straight. Turn right. Turn left at the corner.\nVị trí: on the left / on the right (bên trái / bên phải), next to (bên cạnh), opposite (đối diện), near (gần), on the corner (ở góc đường).\n\"Near\" không cần \"to\": \"near the school\" (không nói \"near to the school\" trong văn nói chuẩn A2).\nHỏi khoảng cách: \"Is it far from here?\" — Trả lời: \"No, you can walk.\" (Không, bạn có thể đi bộ.)","lessonId":"u10n7l1","lessonVersion":"v2.u10n7l1","manifestHash":"013672aa5927648264926e14d514d9d670ba04f547fc10aba6d50095b8e8b587","nodeId":"u10n7","order":78,"rewardIdentity":"v2.u10n7l1","schemaVersion":1,"sectionId":"sec2","signature":"f3OBVMwVcqLEstfk_QdqZTZvN2u2wQDVwL3Y78Y_ogoUr0wFeSGNKfjr3dff7NOOR6LFWyYuI4poYAx9Ayv4BA","signatureKeyId":"dev-content-1","skillIds":["u10.grammar","listening","speaking","u10.dialogue","reading","u10.story","u10.vocab"],"title":"Ôn tập cửa ải · Bài 1","unitId":"u10"}