enceOrder","vocabularyIds":["u1.meet","u4.nine","u12.meeting","u12.start"]},{"content":{"locale":"en-US","maxSeconds":7,"referenceText":"I write many emails every day."},"explanation":"Câu mẫu: \"I write many emails every day.\".","gradingRule":{"acceptedText":["I write many emails every day."],"caseSensitive":false,"ignoreDiacritics":false,"ignorePunctuation":true},"hint":"Nghĩa: \"Tôi viết nhiều email mỗi ngày.\"","id":"u12n6l4-e11","nonSpeechAlternative":{"content":{"tokens":[{"id":"t1","text":"write"},{"id":"t2","text":"every"},{"id":"t3","text":"emails"},{"id":"t4","text":"I"},{"id":"t5","text":"many"},{"id":"t6","text":"day"}]},"explanation":"Câu đúng: \"I write many emails every day.\".","gradingRule":{"caseSensitive":false,"correctTokenIds":["t4","t1","t5","t3","t2","t6"],"ignoreDiacritics":false,"ignorePunctuation":false},"hint":"Câu bắt đầu bằng \"I\".","id":"u12n6l4-e11a","prompt":{"locale":"vi-VN","text":"Sắp xếp thành câu đúng: \"Tôi viết nhiều email mỗi ngày.\""},"skillIds":["speaking","u12.grammar"],"type":"sentenceOrder","vocabularyIds":["u4.many","u5.day","u5.every","u7.write","u12.email"]},"prompt":{"audioAssetId":"a.u12.s19.n","locale":"en-US","text":"Nói câu sau: \"I write many emails every day.\""},"skillIds":["speaking","u12.grammar"],"type":"speakRepeat","vocabularyIds":["u4.many","u5.day","u5.every","u7.write","u12.email"]},{"content":{"maxChars":200,"placeholder":"Viết bằng tiếng Việt (có dấu)"},"explanation":"Đáp án: \"Đồng nghiệp của tôi đến từ Canada.\". Cũng đúng: \"Đồng nghiệp tôi là người Canada.\", \"Đồng nghiệp của mình đến từ Canada.\".","gradingRule":{"acceptedText":["Đồng nghiệp của tôi đến từ Canada.","Đồng nghiệp tôi là người Canada.","Đồng nghiệp của mình đến từ Canada.","Đồng nghiệp mình là người Canada."],"caseSensitive":false,"ignoreDiacritics":false,"ignorePunctuation":true},"hint":"\"from\" = từ; \"Canada\" = Canada; \"colleague\" = đồng nghiệp","id":"u12n6l4-e12","prompt":{"locale":"en-US","text":"My colleague is from Canada."},"skillIds":["u12.grammar"],"type":"textTranslation","vocabularyIds":["u1.from","u1.canada","u12.colleague"]}],"gradingRulesVersion":"g1","guideText":"Mẫu câu chính: \"What do you do?\" (Bạn làm nghề gì?) — \"I am an engineer.\" (Tôi là kỹ sư.) — \"I worked late yesterday.\" (Hôm qua tôi làm việc muộn.)\nNghề nghiệp luôn có a/an: \"She is a nurse\", \"He is an engineer\" (an trước nguyên âm).\nThì quá khứ đơn (động từ có quy tắc): thêm -ed: work → worked, start → started, finish → finished. Quá khứ của \"be\": I/he/she was, you/we/they were.\nCâu hỏi quá khứ dùng \"did\" + động từ nguyên mẫu: \"Did you finish your work?\" (không nói \"Did you finished\").\nMốc thời gian quá khứ: yesterday (hôm qua), last week (tuần trước).","lessonId":"u12n6l4","lessonVersion":"v2.u12n6l4","manifestHash":"013672aa5927648264926e14d514d9d670ba04f547fc10aba6d50095b8e8b587","nodeId":"u12n6","order":93,"rewardIdentity":"v2.u12n6l4","schemaVersion":1,"sectionId":"sec2","signature":"Mp5-MS3Xa7JZTglTWvmeMD8PTfwmwMpZv-PuwJVM8F1GbIfVUh1EMhiIcfG1IGK7vL5ZAFi61SRh8mKUBKuQAQ","signatureKeyId":"dev-content-1","skillIds":["speaking","u12.grammar","u12.dialogue","u12.vocab"],"title":"Hôm qua · Bài 4","unitId":"u12"}