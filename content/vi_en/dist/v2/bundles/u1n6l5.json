Ids":["u1.friend","u1.where"]},"prompt":{"audioAssetId":"a.u1.s34.n","locale":"vi-VN","text":"Nghe và viết lại bằng tiếng Anh"},"skillIds":["listening","u1.grammar"],"type":"dictation","vocabularyIds":["u1.friend","u1.where"]},{"content":{"tokens":[{"id":"t1","text":"Goodbye"},{"id":"t2","text":"a"},{"id":"t3","text":"Linh"},{"id":"t4","text":"Nam"},{"id":"t5","text":"too"},{"id":"t6","text":"student"},{"id":"t7","text":"your"},{"id":"t8","text":"is"}]},"explanation":"Câu đúng: \"Linh is a student too.\".","gradingRule":{"caseSensitive":false,"correctTokenIds":["t3","t8","t2","t6","t5"],"ignoreDiacritics":false,"ignorePunctuation":false},"hint":"\"student\" = học sinh","id":"u1n6l5-e11","prompt":{"locale":"vi-VN","text":"Dịch câu này: \"Linh cũng là học sinh.\""},"skillIds":["u1.grammar"],"type":"wordBank","vocabularyIds":["u1.student"]},{"content":{"maxChars":200,"placeholder":"Viết bằng tiếng Anh"},"explanation":"Đáp án: \"I meet my friend in the morning.\".","gradingRule":{"acceptedText":["I meet my friend in the morning."],"caseSensitive":false,"ignoreDiacritics":false,"ignorePunctuation":true},"hint":"\"friend\" = bạn; \"morning\" = buổi sáng; \"meet\" = gặp","id":"u1n6l5-e12","prompt":{"locale":"vi-VN","text":"Tôi gặp bạn tôi vào buổi sáng."},"skillIds":["u1.grammar"],"type":"textTranslation","vocabularyIds":["u1.friend","u1.morning","u1.meet"]}],"gradingRulesVersion":"g1","guideText":"Mẫu câu chính: \"Hello, I am Mai.\" (Xin chào, tôi là Mai.) — \"What is your name?\" (Bạn tên là gì?) — \"Nice to meet you.\" (Rất vui được gặp bạn.)\nNgữ pháp: động từ \"to be\": I am, you are, he/she is. Khi nói, người bản xứ hay rút gọn: I'm, you're, he's, she's. Cả hai cách viết đều được chấp nhận.\nMẹo: \"I\" luôn viết hoa. Dùng \"a\" trước nghề nghiệp: \"I am a student.\" Tiếng Việt có thể bỏ \"một\", tiếng Anh thì không.\nLịch sự: \"Excuse me\" dùng để bắt chuyện, \"Sorry\" dùng khi xin lỗi vì lỗi của mình.","lessonId":"u1n6l5","lessonVersion":"v2.u1n6l5","manifestHash":"