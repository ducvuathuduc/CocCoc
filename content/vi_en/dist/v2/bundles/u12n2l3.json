maxChars":200,"placeholder":"Viết những gì bạn nghe"},"explanation":"Bạn nghe: \"The office is on the third floor.\".","gradingRule":{"acceptedText":["The office is on the third floor."],"caseSensitive":false,"ignoreDiacritics":false,"ignorePunctuation":true},"hint":"Câu có 7 từ. Nghĩa: \"Văn phòng ở tầng ba.\"","id":"u12n2l3-e12","nonAudioAlternative":{"content":{"maxChars":200,"placeholder":"Viết bằng tiếng Anh"},"explanation":"Đáp án: \"The office is on the third floor.\".","gradingRule":{"acceptedText":["The office is on the third floor."],"caseSensitive":false,"ignoreDiacritics":false,"ignorePunctuation":true},"hint":"\"floor\" = tầng; \"office\" = văn phòng","id":"u12n2l3-e12a","prompt":{"locale":"vi-VN","text":"Văn phòng ở tầng ba."},"skillIds":["listening","u12.grammar"],"type":"textTranslation","vocabularyIds":["u6.floor","u12.office"]},"prompt":{"audioAssetId":"a.u12.s6.n","locale":"vi-VN","text":"Nghe và viết lại bằng tiếng Anh"},"skillIds":["listening","u12.grammar"],"type":"dictation","vocabularyIds":["u6.floor","u12.office"]}],"gradingRulesVersion":"g1","guideText":"Mẫu câu chính: \"What do you do?\" (Bạn làm nghề gì?) — \"I am an engineer.\" (Tôi là kỹ sư.) — \"I worked late yesterday.\" (Hôm qua tôi làm việc muộn.)\nNghề nghiệp luôn có a/an: \"She is a nurse\", \"He is an engineer\" (an trước nguyên âm).\nThì quá khứ đơn (động từ có quy tắc): thêm -ed: work → worked, start → started, finish → finished. Quá khứ của \"be\": I/he/she was, you/we/they were.\nCâu hỏi quá khứ dùng \"did\" + động từ nguyên mẫu: \"Did you finish your work?\" (không nói \"Did you finished\").\nMốc thời gian quá khứ: yesterday (hôm qua), last week (tuần trước).","lessonId":"u12n2l3","lessonVersion":"v2.u12n2l3","manifestHash":"013672aa5927648264926e14d514d9d670ba04f547fc10aba6d50095b8e8b587","nodeId":"u12n2","order":89,"rewardIdentity":"v2.u12n2l3","schemaVersion":1,"sectionId":"sec2","signature":"Swq1cx0CpZhB4KG3v3InuX7gdpOyahDWsQwimuZwffI_WjEQf0rX0L4KCdF7cWc_UvE1f999X3TTg3IF