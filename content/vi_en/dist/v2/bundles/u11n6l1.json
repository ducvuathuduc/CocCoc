uation":true},"hint":"\"get up\" = thức dậy; \"tomorrow\" = ngày mai; \"early\" = sớm","id":"u11n6l1-e12","prompt":{"locale":"vi-VN","text":"Ngày mai tôi dậy sớm."},"skillIds":["u11.grammar"],"type":"textTranslation","vocabularyIds":["u5.get_up","u11.tomorrow","u11.early"]},{"content":{"tokens":[{"id":"t1","text":"Three"},{"id":"t2","text":"island"},{"id":"t3","text":"Vietnam"},{"id":"t4","text":"in"},{"id":"t5","text":"an"},{"id":"t6","text":"sunny"},{"id":"t7","text":"Quoc"},{"id":"t8","text":"is"},{"id":"t9","text":"coat"},{"id":"t10","text":"Phu"}]},"explanation":"Câu đúng: \"Phu Quoc is an island in Vietnam.\".","gradingRule":{"caseSensitive":false,"correctTokenIds":["t10","t7","t8","t5","t2","t4","t3"],"ignoreDiacritics":false,"ignorePunctuation":false},"hint":"\"Vietnam\" = Việt Nam; \"island\" = hòn đảo","id":"u11n6l1-e13","prompt":{"locale":"vi-VN","text":"Dịch câu này: \"Phú Quốc là một hòn đảo ở Việt Nam.\""},"skillIds":["u11.grammar"],"type":"wordBank","vocabularyIds":["u1.vietnam","u11.island"]}],"gradingRulesVersion":"g1","guideText":"Mẫu câu chính: \"I want to visit Hanoi.\" (Tôi muốn đi thăm Hà Nội.) — \"When does the train leave?\" (Khi nào tàu chạy?) — \"Can I have a ticket, please?\" (Cho tôi một vé.)\nPhương tiện: by plane, by train, by bus, by taxi (không có \"the\"). Hoặc: take the bus / take a taxi.\nLịch trình dùng hiện tại đơn: \"The train leaves at six.\" \"The plane arrives at nine o'clock.\"\n\"Arrive at\" + địa điểm nhỏ (at the airport), \"arrive in\" + thành phố/quốc gia (arrive in Da Nang).\n\"Visit\" + nơi chốn/người, không cần giới từ: \"visit my grandmother\", không nói \"visit to\".","lessonId":"u11n6l1","lessonVersion":"v2.u11n6l1","manifestHash":"013672aa5927648264926e14d514d9d670ba04f547fc10aba6d50095b8e8b587","nodeId":"u11n6","order":85,"rewardIdentity":"v2.u11n6l1","schemaVersion":1,"sectionId":"sec2","signature":"UnNjjIEDXSy5rO2yMa2wdF2D6iXF5Fj6OVXE03VIjA2coJe1i4g0LTaq3yrPdm3_m5vhiFMoj6oUArnQ1nHrAQ","signatureKeyId":"dev-cont