":["I saw Mr. Long at the park."],"caseSensitive":false,"ignoreDiacritics":false,"ignorePunctuation":true},"hint":"\"park\" = công viên; \"saw\" = đã thấy","id":"u16n3l5-e12","prompt":{"locale":"vi-VN","text":"Tôi đã thấy thầy Long ở công viên."},"skillIds":["u16.grammar"],"type":"textTranslation","vocabularyIds":["u10.park","u16.saw"]}],"gradingRulesVersion":"g1","guideText":"Mẫu câu chính: \"What will you do this weekend?\" (Cuối tuần này bạn sẽ làm gì?) — \"I went to the museum.\" (Tôi đã đi bảo tàng.) — \"That is a good idea!\" (Ý hay đấy!)\nTương lai: will + động từ nguyên mẫu: \"I will call you.\" Rút gọn: I'll, you'll, we'll. Phủ định: will not = won't.\nQuá khứ bất quy tắc phải học thuộc: go → went, see → saw, eat → ate, buy → bought, forget → forgot.\n\"Maybe\" (có lẽ) đứng đầu câu: \"Maybe it will rain tomorrow.\"\nRủ rê: \"Let's ...\" (Chúng ta hãy ... nhé): \"Let's have a picnic.\"","lessonId":"u16n3l5","lessonVersion":"v2.u16n3l5","manifestHash":"013672aa5927648264926e14d514d9d670ba04f547fc10aba6d50095b8e8b587","nodeId":"u16n3","order":122,"rewardIdentity":"v2.u16n3l5","schemaVersion":1,"sectionId":"sec2","signature":"_6kBluoRcJW3t743IV5ENkWH5dCAlB23EjcY1EDmpwPPab7plXmE_5slldsN9sWie5owlJGKtUG44cnMHmKxCw","signatureKeyId":"dev-content-1","skillIds":["u16.vocab","u16.grammar","listening"],"title":"Hòa nhạc và lễ hội · Bài 5","unitId":"u16"}