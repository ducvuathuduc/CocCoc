\" (cùng nhau) thường đứng cuối câu: \"We play games together.\"","lessonId":"u13n3l1","lessonVersion":"v2.u13n3l1","manifestHash":"013672aa5927648264926e14d514d9d670ba04f547fc10aba6d50095b8e8b587","nodeId":"u13n3","order":98,"rewardIdentity":"v2.u13n3l1","schemaVersion":1,"sectionId":"sec2","signature":"4nYikJEKKD9BPpd9UBUsIaof2n5doUGY0w6HTFLWNsgEqb7OCpCXIOweno2Vac_qOQnRlLziSDm4UuDeYtCAAA","signatureKeyId":"dev-content-1","skillIds":["u13.vocab","u13.grammar","listening"],"title":"Bóng đá và đàn · Bài 1","unitId":"u13"}