ritics":false,"ignorePunctuation":true},"hint":"\"have\" = có; \"question\" = câu hỏi","id":"u7n3l5-e10a","prompt":{"locale":"vi-VN","text":"Tôi có một câu hỏi."},"skillIds":["listening","u7.grammar"],"type":"textTranslation","vocabularyIds":["u2.have","u7.question"]},"prompt":{"audioAssetId":"a.u7.s18.n","locale":"vi-VN","text":"Nghe và viết lại bằng tiếng Anh"},"skillIds":["listening","u7.grammar"],"type":"dictation","vocabularyIds":["u2.have","u7.question"]},{"content":{"tokens":[{"id":"t1","text":"aunt"},{"id":"t2","text":"classroom"},{"id":"t3","text":"is"},{"id":"t4","text":"clean"},{"id":"t5","text":"The"},{"id":"t6","text":"room"},{"id":"t7","text":"small"}]},"explanation":"Câu đúng: \"The classroom is clean.\".","gradingRule":{"caseSensitive":false,"correctTokenIds":["t5","t2","t3","t4"],"ignoreDiacritics":false,"ignorePunctuation":false},"hint":"\"clean\" = sạch; \"classroom\" = phòng học","id":"u7n3l5-e11","prompt":{"locale":"vi-VN","text":"Dịch câu này: \"Phòng học sạch sẽ.\""},"skillIds":["u7.grammar"],"type":"wordBank","vocabularyIds":["u6.clean","u7.classroom"]},{"content":{"maxChars":200,"placeholder":"Viết bằng tiếng Anh"},"explanation":"Đáp án: \"We study English at school.\".","gradingRule":{"acceptedText":["We study English at school."],"caseSensitive":false,"ignoreDiacritics":false,"ignorePunctuation":true},"hint":"\"school\" = trường; \"English\" = tiếng Anh; \"study\" = học bài","id":"u7n3l5-e12","prompt":{"locale":"vi-VN","text":"Chúng tôi học tiếng Anh ở trường."},"skillIds":["u7.grammar"],"type":"textTranslation","vocabularyIds":["u5.school","u7.english","u7.study"]}],"gradingRulesVersion":"g1","guideText":"Mẫu câu chính: \"Can you help me?\" (Bạn có thể giúp tôi không?) — \"I do not understand.\" (Tôi không hiểu.) — \"Please open your books.\" (Hãy mở sách ra.)\n\"Can\" + động từ nguyên mẫu (không thêm -s, không \"to\"): \"She can speak English\", không nói \"She cans speaks\".\nCâu mệnh lệnh: bắt đầu bằng động từ: \"Open the window.\" Thêm \"please\" cho lịch sự.\nCâu hỏi \"What does this word mean?\" — dùng khi gặp từ mới. Trả lời: \"It means ...\".\nHọc sinh Việt hay nhầm: \"learn\" (học, tiếp thu) và \"study\" (học bài, nghiên cứu) — cả hai đều dịch là \"học\".","lessonId":"u7n3l5","lessonVersion":"v2.u7n3l5","manifestHash":"013672aa5927648264926e14d514d9d670ba04f547fc10aba6d50095b8e8b587","nodeId":"u7n3","order":50,"rewardIdentity":"v2.u7n3l5","schemaVersion":1,"sectionId":"sec1","signature":"4e5fqDOhLvnzw6GQFyHJ7IDT2jubvImnWEq7e3eDyjswa3ANAm0HBNfUFh29Z3q71sMMrM60bueXWjV5Bm0wBA","signatureKeyId":"dev-content-1","skillIds":["u7.vocab","u7.grammar","listening"],"title":"Tôi có thể · Bài 5","unitId":"u7"}