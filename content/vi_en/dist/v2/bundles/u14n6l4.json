":"textTranslation","vocabularyIds":["u2.have","u14.cough"]},{"content":{"tokens":[{"id":"t1","text":"tooth"},{"id":"t2","text":"My"},{"id":"t3","text":"hurts"}]},"explanation":"Câu đúng: \"My tooth hurts.\".","gradingRule":{"caseSensitive":false,"correctTokenIds":["t2","t1","t3"],"ignoreDiacritics":false,"ignorePunctuation":false},"hint":"Câu bắt đầu bằng \"My\".","id":"u14n6l4-e10","prompt":{"locale":"vi-VN","text":"Sắp xếp thành câu đúng: \"Răng tôi bị đau.\""},"skillIds":["u14.grammar"],"type":"sentenceOrder","vocabularyIds":["u14.hurt","u14.tooth"]},{"content":{"locale":"en-US","maxSeconds":6,"referenceText":"Are you tired?"},"explanation":"Câu mẫu: \"Are you tired?\".","gradingRule":{"acceptedText":["Are you tired?"],"caseSensitive":false,"ignoreDiacritics":false,"ignorePunctuation":true},"hint":"Nghĩa: \"Bạn có mệt không?\"","id":"u14n6l4-e11","nonSpeechAlternative":{"content":{"tokens":[{"id":"t1","text":"you"},{"id":"t2","text":"tired"},{"id":"t3","text":"Are"}]},"explanation":"Câu đúng: \"Are you tired?\".","gradingRule":{"caseSensitive":false,"correctTokenIds":["t3","t1","t2"],"ignoreDiacritics":false,"ignorePunctuation":false},"hint":"Câu bắt đầu bằng \"Are\".","id":"u14n6l4-e11a","prompt":{"locale":"vi-VN","text":"Sắp xếp thành câu đúng: \"Bạn có mệt không?\""},"skillIds":["speaking","u14.grammar"],"type":"sentenceOrder","vocabularyIds":["u14.tired"]},"prompt":{"audioAssetId":"a.u14.s2.n","locale":"en-US","text":"Nói câu sau: \"Are you tired?\""},"skillIds":["speaking","u14.grammar"],"type":"speakRepeat","vocabularyIds":["u14.tired"]},{"content":{"maxChars":200,"placeholder":"Viết bằng tiếng Việt (có dấu)"},"explanation":"Đáp án: \"Tôi bị đau đầu.\". Cũng đúng: \"Tôi bị nhức đầu.\", \"Tôi đau đầu.\".","gradingRule":{"acceptedText":["Tôi bị đau đầu.","Tôi bị nhức đầu.","Tôi đau đầu.","Mình bị đau đầu.","Mình bị nhức đầu.","Mình đau đầu."],"caseSensitive":false,"ignoreDiacritics":false,"ignorePunctuation":true},"hint":"\"have\" = có; \"headache\" = đau đầu","id":"u14n6l4-e12","prompt":{"locale":"en-US","text":"I have a headache."},"skillIds":["u14.grammar"],"type":"textTranslation","vocabularyIds":["u2.have","u14.headache"]}],"gradingRulesVersion":"g1","guideText":"Mẫu câu chính: \"How do you feel?\" (Bạn thấy thế nào?) — \"I have a headache.\" (Tôi bị đau đầu.) — \"You should rest.\" (Bạn nên nghỉ ngơi.)\nBệnh dùng \"have\": have a fever (bị sốt), have a cough (bị ho), have a headache (bị đau đầu). Tính từ dùng \"be\": I am sick, I am tired.\nChỗ đau: \"My stomach hurts\" (Tôi bị đau bụng) — động từ \"hurt\" thêm -s với he/she/it và danh từ số ít.\nLời khuyên: should / should not (shouldn't) + động từ nguyên mẫu: \"You should eat more vegetables.\"\nSố nhiều bất quy tắc: one tooth → two teeth.","lessonId":"u14n6l4","lessonVersion":"v2.u14n6l4","manifestHash":"013672aa5927648264926e14d514d9d670ba04f547fc10aba6d50095b8e8b587","nodeId":"u14n6","order":109,"rewardIdentity":"v2.u14n6l4","schemaVersion":1,"sectionId":"sec2","signature":"rARo-QZbCmgoRR29NWPUiLi0xPMImFIE0WhZSiAsO1j4QZNQS6W81GaRb0TwpVqNEj8wd4vIKSfZyOZ-LmC1Bg","signatureKeyId":"dev-content-1","skillIds":["speaking","u14.grammar","u14.dialogue","u14.vocab"],"title":"Đi nha sĩ · Bài 4","unitId":"u14"}