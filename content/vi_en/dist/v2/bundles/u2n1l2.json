ritics":false,"ignorePunctuation":true},"hint":"\"mother\" = mẹ","id":"u2n1l2-e10a","prompt":{"locale":"vi-VN","text":"Đây là mẹ tôi."},"skillIds":["listening","u2.grammar"],"type":"textTranslation","vocabularyIds":["u2.mother"]},"prompt":{"audioAssetId":"a.u2.s1.n","locale":"vi-VN","text":"Nghe và viết lại bằng tiếng Anh"},"skillIds":["listening","u2.grammar"],"type":"dictation","vocabularyIds":["u2.mother"]},{"content":{"tokens":[{"id":"t1","text":"Linh"},{"id":"t2","text":"Sorry"},{"id":"t3","text":"Vietnam"},{"id":"t4","text":"Long"},{"id":"t5","text":"to"}]},"explanation":"Câu đúng: \"Sorry, Linh!\".","gradingRule":{"caseSensitive":false,"correctTokenIds":["t2","t1"],"ignoreDiacritics":false,"ignorePunctuation":false},"hint":"\"sorry\" = xin lỗi","id":"u2n1l2-e11","prompt":{"locale":"vi-VN","text":"Dịch câu này: \"Xin lỗi, Linh!\""},"skillIds":["u2.grammar"],"type":"wordBank","vocabularyIds":["u1.sorry"]},{"content":{"maxChars":200,"placeholder":"Viết bằng tiếng Anh"},"explanation":"Đáp án: \"Good morning, Mr. Long!\".","gradingRule":{"acceptedText":["Good morning, Mr. Long!"],"caseSensitive":false,"ignoreDiacritics":false,"ignorePunctuation":true},"hint":"\"good\" = tốt; \"morning\" = buổi sáng","id":"u2n1l2-e12","prompt":{"locale":"vi-VN","text":"Chào buổi sáng, thầy Long!"},"skillIds":["u2.grammar"],"type":"textTranslation","vocabularyIds":["u1.good","u1.morning"]}],"gradingRulesVersion":"g1","guideText":"Mẫu câu chính: \"This is my mother.\" (Đây là mẹ tôi.) — \"I have a brother.\" (Tôi có một anh/em trai.)\nTính từ sở hữu: my (của tôi), your (của bạn), his (của anh ấy), her (của cô ấy), their (của họ). Đặt TRƯỚC danh từ: \"my father\", không nói \"father my\".\nĐộng từ \"have\": I/you/we/they have — he/she has. \"Mai has a cat.\"\nLưu ý: tiếng Anh không phân biệt anh/em: \"brother\" = anh trai hoặc em trai, \"sister\" = chị gái hoặc em gái. \"Aunt/uncle\" gồm cả cô, dì, chú, cậu, bác.","lessonId":"u2n1l2","lessonVersion":"v2.u2n1l2","manifestHash":"013672a