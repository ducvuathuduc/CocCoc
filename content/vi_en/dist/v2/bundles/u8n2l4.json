eechAlternative":{"content":{"tokens":[{"id":"t1","text":"It"},{"id":"t2","text":"hot"},{"id":"t3","text":"is"},{"id":"t4","text":"today"}]},"explanation":"Câu đúng: \"It is hot today.\".","gradingRule":{"caseSensitive":false,"correctTokenIds":["t1","t3","t2","t4"],"ignoreDiacritics":false,"ignorePunctuation":false},"hint":"Câu bắt đầu bằng \"It\".","id":"u8n2l4-e11a","prompt":{"locale":"vi-VN","text":"Sắp xếp thành câu đúng: \"Hôm nay trời nóng.\""},"skillIds":["speaking","u8.grammar"],"type":"sentenceOrder","vocabularyIds":["u5.today","u8.hot"]},"prompt":{"audioAssetId":"a.u8.s1.n","locale":"en-US","text":"Nói câu sau: \"It is hot today.\""},"skillIds":["speaking","u8.grammar"],"type":"speakRepeat","vocabularyIds":["u5.today","u8.hot"]},{"content":{"maxChars":200,"placeholder":"Viết bằng tiếng Việt (có dấu)"},"explanation":"Đáp án: \"Nước ấm.\". Cũng đúng: \"Nước thì ấm.\".","gradingRule":{"acceptedText":["Nước ấm.","Nước thì ấm."],"caseSensitive":false,"ignoreDiacritics":false,"ignorePunctuation":true},"hint":"\"water\" = nước; \"warm\" = ấm","id":"u8n2l4-e12","prompt":{"locale":"en-US","text":"The water is warm."},"skillIds":["u8.grammar"],"type":"textTranslation","vocabularyIds":["u3.water","u8.warm"]}],"gradingRulesVersion":"g1","guideText":"Mẫu câu chính: \"How is the weather today?\" (Thời tiết hôm nay thế nào?) — \"It is sunny.\" (Trời nắng.) — \"It is raining.\" (Trời đang mưa.)\nChủ ngữ giả \"it\": tiếng Việt nói \"trời nắng\", tiếng Anh phải có chủ ngữ: \"It is sunny\", không nói \"Is sunny\".\nThì hiện tại tiếp diễn cho việc đang xảy ra: It is raining now. So sánh: It is rainy (trời có mưa — mô tả chung).\nMùa: in (the) summer, in winter. Miền Nam Việt Nam có hai mùa: the dry season (mùa khô) và the rainy season (mùa mưa).\n\"Fall\" là cách Mỹ gọi mùa thu; \"autumn\" dùng ở Anh — cả hai đều đúng.","lessonId":"u8n2l4","lessonVersion":"v2.u8n2l4","manifestHash":"013672aa5927648264926e14d514d9d670ba04f547fc10aba6d50095b8e8b587","nodeId":"u8n2","order":57,"