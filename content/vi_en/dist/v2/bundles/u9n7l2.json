ds":["u9.shirt"]},{"content":{"pairs":[{"id":"p1","left":{"id":"p1l","text":"market"},"right":{"id":"p1r","text":"chợ"}},{"id":"p2","left":{"id":"p2l","text":"dress"},"right":{"id":"p2r","text":"váy"}},{"id":"p3","left":{"id":"p3l","text":"cheap"},"right":{"id":"p3r","text":"rẻ"}},{"id":"p4","left":{"id":"p4l","text":"color"},"right":{"id":"p4r","text":"màu"}},{"id":"p5","left":{"id":"p5l","text":"shop"},"right":{"id":"p5r","text":"cửa hàng"}}]},"explanation":"market = chợ; dress = váy; cheap = rẻ; color = màu; shop = cửa hàng","gradingRule":{"caseSensitive":false,"correctPairIds":["p1","p2","p3","p4","p5"],"ignoreDiacritics":false,"ignorePunctuation":false},"hint":"Ví dụ: \"market\" = \"chợ\".","id":"u9n7l2-e11","prompt":{"locale":"vi-VN","text":"Nối các cặp từ tương ứng"},"skillIds":["u9.vocab"],"type":"matchPairs","vocabularyIds":["u9.market","u9.dress","u9.cheap","u9.color","u9.shop"]},{"content":{"choices":[{"id":"c1","text":"night"},{"id":"c2","text":"understand"},{"id":"c3","text":"nice"},{"id":"c4","text":"buy"}]},"explanation":"\"buy\" = \"mua\".","gradingRule":{"caseSensitive":false,"correctChoiceId":"c4","ignoreDiacritics":false,"ignorePunctuation":false},"hint":"\"buy\" nghĩa là \"mua\".","id":"u9n7l2-e12","prompt":{"locale":"vi-VN","text":"\"mua\" trong tiếng Anh là gì?"},"skillIds":["u9.vocab"],"type":"choice","vocabularyIds":["u9.buy"]},{"content":{"locale":"en-US","maxSeconds":7,"referenceText":"We buy fish at the market."},"explanation":"Câu mẫu: \"We buy fish at the market.\".","gradingRule":{"acceptedText":["We buy fish at the market."],"caseSensitive":false,"ignoreDiacritics":false,"ignorePunctuation":true},"hint":"Nghĩa: \"Chúng tôi mua cá ở chợ.\"","id":"u9n7l2-e13","nonSpeechAlternative":{"content":{"tokens":[{"id":"t1","text":"at"},{"id":"t2","text":"fish"},{"id":"t3","text":"buy"},{"id":"t4","text":"the"},{"id":"t5","text":"market"},{"id":"t6","text":"We"}]},"explanation":"Câu đúng: \"We buy fish at the market.\".","gradingRule":{"caseSensitive":false,"correctTokenIds":["t6","t3","t2","t1","t4","t5"],"ignoreDiacritics":false,"ignorePunctuation":false},"hint":"Câu bắt đầu bằng \"We\".","id":"u9n7l2-e13a","prompt":{"locale":"vi-VN","text":"Sắp xếp thành câu đúng: \"Chúng tôi mua cá ở chợ.\""},"skillIds":["speaking","u9.grammar"],"type":"sentenceOrder","vocabularyIds":["u3.fish","u9.buy","u9.market"]},"prompt":{"audioAssetId":"a.u9.s25.n","locale":"en-US","text":"Nói câu sau: \"We buy fish at the market.\""},"skillIds":["speaking","u9.grammar"],"type":"speakRepeat","vocabularyIds":["u3.fish","u9.buy","u9.market"]},{"content":{"tokens":[{"id":"t1","text":"Tôi"},{"id":"t2","text":"lạnh"},{"id":"t3","text":"cho"},{"id":"t4","text":"muốn"},{"id":"t5","text":"mua"},{"id":"t6","text":"quà"},{"id":"t7","text":"nay"},{"id":"t8","text":"hộ"},{"id":"t9","text":"Nước"},{"id":"t10","text":"Anna"}]},"explanation":"Câu đúng: \"Tôi muốn mua quà cho Anna.\".","gradingRule":{"caseSensitive":false,"correctTokenIds":["t1","t4","t5","t6","t3","t10"],"ignoreDiacritics":false,"ignorePunctuation":false},"hint":"\"want\" = muốn; \"buy\" = mua; \"gift\" = món quà","id":"u9n7l2-e14","prompt":{"locale":"vi-VN","text":"Dịch sang tiếng Việt: \"I want to buy a gift for Anna.\""},"skillIds":["u9.grammar"],"type":"wordBank","vocabularyIds":["u3.want","u9.buy","u9.gift"]},{"content":{"maxChars":200,"placeholder":"Viết bằng tiếng Anh"},"explanation":"Đáp án: \"Tom wants a blue shirt.\".","gradingRule":{"acceptedText":["Tom wants a blue shirt."],"caseSensitive":false,"ignoreDiacritics":false,"ignorePunctuation":true},"hint":"\"want\" = muốn; \"shirt\" = áo sơ mi; \"blue\" = màu xanh dương","id":"u9n7l2-e15","prompt":{"locale":"vi-VN","text":"Tom muốn một cái áo sơ mi màu xanh dương."},"skillIds":["u9.grammar"],"type":"textTranslation","vocabularyIds":["u3.want","u9.shirt","u9.blue"]}],"gradingRulesVersion":"g1","guideText":"Mẫu câu chính: \"How much is this dress?\" (Cái váy này bao nhiêu tiền?) — \"Can I pay by card?\" (Tôi trả bằng thẻ được không?) — \"It is on sale.\" (Nó đang giảm giá.)\nHow much is + số ít / How much are + số nhiều: \"How much are the shoes?\"\n\"Shoes\" luôn ở dạng số nhiều (một đôi giày = a pair of shoes).\nMàu sắc đứng trước danh từ: \"a red dress\" (một cái váy đỏ). Hỏi màu: \"What color is it?\"\nTrả tiền: pay in cash (tiền mặt) / pay by card (bằng thẻ). \"Expensive\" (đắt) ↔ \"cheap\" (rẻ).","lessonId":"u9n7l2","lessonVersion":"v2.u9n7l2","manifestHash":"013672aa5927648264926e14d514d9d670ba04f547fc10aba6d50095b8e8b587","nodeId":"u9n7","order":70,"rewardIdentity":"v2.u9n7l2","schemaVersion":1,"sectionId":"sec2","signature":"AnpdqrCi0BGkignHmstbEHdXdnuxas_gu5GJy9NmtmUmzpR1N22dzK32MCKtFUAA3huo5Ji0QrHwjk77dig6Bw","signatureKeyId":"dev-content-1","skillIds":["u9.grammar","listening","speaking","u9.dialogue","reading","u9.story","u9.vocab"],"title":"Ôn tập cửa ải · Bài 2","unitId":"u9"}