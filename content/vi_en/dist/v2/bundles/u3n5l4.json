":{"audioAssetId":"a.u3.s7.n","locale":"en-US","text":"Nói câu sau: \"Tea, please.\""},"skillIds":["speaking","u3.grammar"],"type":"speakRepeat","vocabularyIds":["u1.please","u3.tea"]},{"content":{"maxChars":200,"placeholder":"Viết bằng tiếng Việt (có dấu)"},"explanation":"Đáp án: \"Kiko thích sữa.\". Cũng đúng: \"Kiko thích uống sữa.\".","gradingRule":{"acceptedText":["Kiko thích sữa.","Kiko thích uống sữa."],"caseSensitive":false,"ignoreDiacritics":false,"ignorePunctuation":true},"hint":"\"milk\" = sữa; \"like\" = thích","id":"u3n5l4-e12","prompt":{"locale":"en-US","text":"Kiko likes milk."},"skillIds":["u3.grammar"],"type":"textTranslation","vocabularyIds":["u3.milk","u3.like"]}],"gradingRulesVersion":"g1","guideText":"Mẫu câu chính: \"Water, please.\" (Cho tôi nước.) — \"I like tea.\" (Tôi thích trà.) — \"Do you want coffee?\" (Bạn có muốn cà phê không?)\nMạo từ: \"a\" trước phụ âm (a banana), \"an\" trước nguyên âm (an apple, an egg).\nThì hiện tại đơn: he/she thêm -s: \"Kiko likes fish.\" Câu phủ định dùng do not / does not: \"Tom does not like coffee.\" (hay: doesn't).\nLịch sự khi gọi món: thêm \"please\" ở cuối câu. \"I want ...\" hơi thẳng; dùng \"..., please\" khi nói với người phục vụ.\nBữa ăn: breakfast (bữa sáng), lunch (bữa trưa), dinner (bữa tối) — nói \"for breakfast\" (cho bữa sáng).","lessonId":"u3n5l4","lessonVersion":"v2.u3n5l4","manifestHash":"013672aa5927648264926e14d514d9d670ba04f547fc10aba6d50095b8e8b587","nodeId":"u3n5","order":20,"rewardIdentity":"v2.u3n5l4","schemaVersion":1,"sectionId":"sec1","signature":"1mbHeTnB5S8SG0E76ZWg06J4gSmB-v7dV8Du4qHN__r8OMhfqDBtHEm0xytnuHtpkvIc9L-r3CafdjnX81YaCQ","signatureKeyId":"dev-content-1","skillIds":["speaking","u3.grammar","u3.dialogue","u3.vocab"],"title":"Bữa ăn trong ngày · Bài 4","unitId":"u3"}