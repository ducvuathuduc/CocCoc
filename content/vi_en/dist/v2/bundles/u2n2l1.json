ation":"Câu đúng: \"Where is the baby?\".","gradingRule":{"caseSensitive":false,"correctTokenIds":["t2","t1","t7","t4"],"ignoreDiacritics":false,"ignorePunctuation":false},"hint":"\"where\" = ở đâu; \"baby\" = em bé","id":"u2n2l1-e06","prompt":{"locale":"vi-VN","text":"Dịch câu này: \"Em bé ở đâu?\""},"skillIds":["u2.grammar"],"type":"wordBank","vocabularyIds":["u1.where","u2.baby"]},{"content":{"choices":[{"id":"c1","text":"I meet my friend in the morning."},{"id":"c2","text":"My grandmother is nice."},{"id":"c3","text":"Thank you, my friend."}]},"explanation":"Bạn nghe: \"My grandmother is nice.\" (Bà tôi rất tốt bụng.).","gradingRule":{"caseSensitive":false,"correctChoiceId":"c2","ignoreDiacritics":false,"ignorePunctuation":false},"hint":"Câu có nghĩa: \"Bà tôi rất tốt bụng.\"","id":"u2n2l1-e07","nonAudioAlternative":{"content":{"choices":[{"id":"c1","text":"I meet my friend in the morning."},{"id":"c2","text":"My grandmother is nice."},{"id":"c3","text":"Thank you, my friend."}]},"explanation":"Bạn nghe: \"My grandmother is nice.\" (Bà tôi rất tốt bụng.).","gradingRule":{"caseSensitive":false,"correctChoiceId":"c2","ignoreDiacritics":false,"ignorePunctuation":false},"hint":"Câu có nghĩa: \"Bà tôi rất tốt bụng.\"","id":"u2n2l1-e07a","prompt":{"locale":"vi-VN","text":"Chọn câu tiếng Anh có nghĩa: \"Bà tôi rất tốt bụng.\""},"skillIds":["listening","u2.grammar"],"type":"choice","vocabularyIds":["u1.nice","u2.grandmother"]},"prompt":{"audioAssetId":"a.u2.s8.n","locale":"vi-VN","text":"Nghe và chọn câu bạn nghe được"},"skillIds":["listening","u2.grammar"],"type":"listenChoice","vocabularyIds":["u1.nice","u2.grandmother"]},{"content":{"choices":[{"id":"c1","text":"excuse me"},{"id":"c2","text":"hello"},{"id":"c3","text":"grandmother"},{"id":"c4","text":"mother"}]},"explanation":"\"grandmother\" = \"bà\".","gradingRule":{"caseSensitive":false,"correctChoiceId":"c3","ignoreDiacritics":false,"ignorePunctuation":false},"hint":"\"grandmother\" nghĩa là \"bà\".","id":"u2n2l1-e08","prompt":{"locale":"vi-VN","text":"\"bà\" trong tiếng Anh là gì?"},"skillIds":["u2.vocab"],"type":"choice","vocabularyIds":["u2.grandmother"]},{"content":{"tokens":[{"id":"t1","text":"em"},{"id":"t2","text":"Long"},{"id":"t3","text":"là"},{"id":"t4","text":"ơn"},{"id":"t5","text":"tôi"},{"id":"t6","text":"ông"},{"id":"t7","text":"Em"},{"id":"t8","text":"bé"},{"id":"t9","text":"anh"},{"id":"t10","text":"gái"}]},"explanation":"Câu đúng: \"Em bé là em gái tôi.\".","gradingRule":{"caseSensitive":false,"correctTokenIds":["t7","t8","t3","t1","t10","t5"],"ignoreDiacritics":false,"ignorePunctuation":false},"hint":"\"sister\" = chị gái; \"baby\" = em bé","id":"u2n2l1-e09","prompt":{"locale":"vi-VN","text":"Dịch sang tiếng Việt: \"The baby is my sister.\""},"skillIds":["u2.grammar"],"type":"wordBank","vocabularyIds":["u2.sister","u2.baby"]},{"content":{"tokens":[{"id":"t1","text":"My"},{"id":"t2","text":"a"},{"id":"t3","text":"grandfather"},{"id":"t4","text":"teacher"},{"id":"t5","text":"is"}]},"explanation":"Câu đúng: \"My grandfather is a teacher.\".","gradingRule":{"caseSensitive":false,"correctTokenIds":["t1","t3","t5","t2","t4"],"ignoreDiacritics":false,"ignorePunctuation":false},"hint":"Câu bắt đầu bằng \"My\".","id":"u2n2l1-e10","prompt":{"locale":"vi-VN","text":"Sắp xếp thành câu đúng: \"Ông tôi là giáo viên.\""},"skillIds":["u2.grammar"],"type":"sentenceOrder","vocabularyIds":["u1.teacher","u2.grandfather"]},{"content":{"maxChars":40,"placeholder":"Điền từ còn thiếu"},"explanation":"Từ đúng: \"sister\" → Anna is Tom's sister.","gradingRule":{"acceptedText":["sister"],"caseSensitive":false,"ignoreDiacritics":false,"ignorePunctuation":true},"hint":"\"chị gái\" trong tiếng Anh là \"s...\"","id":"u2n2l1-e11","prompt":{"locale":"en-US","text":"Anna is Tom's ___. — \"Anna là em gái của Tom.\""},"skillIds":["u2.grammar"],"type":"fillBlank","vocabularyIds":["u2.sister"]},{"content":{"maxChars":200,"placeholder":"Viết bằng tiếng Anh"},"explanation":"Đáp án: \"Good morning, Grandpa!\". Cũng đúng: \"Good morning, Grandfather!\".","gradingRule":{"acceptedText":["Good morning, Grandpa!","Good morning, Grandfather!"],"caseSensitive":false,"ignoreDiacritics":false,"ignorePunctuation":true},"hint":"\"good\" = tốt; \"morning\" = buổi sáng; \"grandfather\" = ông","id":"u2n2l1-e12","prompt":{"locale":"vi-VN","text":"Chào buổi sáng, ông!"},"skillIds":["u2.grammar"],"type":"textTranslation","vocabularyIds":["u1.good","u1.morning","u2.grandfather"]},{"content":{"tokens":[{"id":"t1","text":"brother"},{"id":"t2","text":"you"},{"id":"t3","text":"my"},{"id":"t4","text":"is"},{"id":"t5","text":"Anna"},{"id":"t6","text":"This"},{"id":"t7","text":"mother"}]},"explanation":"Câu đúng: \"This is my mother.\".","gradingRule":{"caseSensitive":false,"correctTokenIds":["t6","t4","t3","t7"],"ignoreDiacritics":false,"ignorePunctuation":false},"hint":"\"mother\" = mẹ","id":"u2n2l1-e13","prompt":{"locale":"vi-VN","text":"Dịch câu này: \"Đây là mẹ tôi.\""},"skillIds":["u2.grammar"],"type":"wordBank","vocabularyIds":["u2.mother"]}],"gradingRulesVersion":"g1","guideText":"Mẫu câu chính: \"This is my mother.\" (Đây là mẹ tôi.) — \"I have a brother.\" (Tôi có một anh/em trai.)\nTính từ sở hữu: my (của tôi), your (của bạn), his (của anh ấy), her (của cô ấy), their (của họ). Đặt TRƯỚC danh từ: \"my father\", không nói \"father my\".\nĐộng từ \"have\": I/you/we/they have — he/she has. \"Mai has a cat.\"\nLưu ý: tiếng Anh không phân biệt anh/em: \"brother\" = anh trai hoặc em trai, \"sister\" = chị gái hoặc em gái. \"Aunt/uncle\" gồm cả cô, dì, chú, cậu, bác.","lessonId":"u2n2l1","lessonVersion":"v2.u2n2l1","manifestHash":"013672aa5927648264926e14d514d9d670ba04f547fc10aba6d50095b8e8b587","nodeId":"u2n2","order":9,"rewardIdentity":"v2.u2n2l1","schemaVersion":1,"sectionId":"sec1","signature":"kZV5vWjNJANdqLw2_93-_CrLWJz0hCRKrmi-bKIAIWgUNw4iULilIZl2qon4WigIrraCH4jTXENDooWJce0gCA","signatureKeyId":"dev-content-1","skillIds":["u2.vocab","u2.grammar","listening"],"title":"Ông