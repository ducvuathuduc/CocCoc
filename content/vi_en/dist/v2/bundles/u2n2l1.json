ularyIds":["u1.good","u1.morning","u2.grandfather"]},{"content":{"tokens":[{"id":"t1","text":"brother"},{"id":"t2","text":"you"},{"id":"t3","text":"my"},{"id":"t4","text":"is"},{"id":"t5","text":"Anna"},{"id":"t6","text":"This"},{"id":"t7","text":"mother"}]},"explanation":"Câu đúng: \"This is my mother.\".","gradingRule":{"caseSensitive":false,"correctTokenIds":["t6","t4","t3","t7"],"ignoreDiacritics":false,"ignorePunctuation":false},"hint":"\"mother\" = mẹ","id":"u2n2l1-e13","prompt":{"locale":"vi-VN","text":"Dịch câu này: \"Đây là mẹ tôi.\""},"skillIds":["u2.grammar"],"type":"wordBank","vocabularyIds":["u2.mother"]}],"gradingRulesVersion":"g1","guideText":"Mẫu câu chính: \"This is my mother.\" (Đây là mẹ tôi.) — \"I have a brother.\" (Tôi có một anh/em trai.)\nTính từ sở hữu: my (của tôi), your (của bạn), his (của anh ấy), her (của cô ấy), their (của họ). Đặt TRƯỚC danh từ: \"my father\", không nói \"father my\".\nĐộng từ \"have\": I/you/we/they have — he/she has. \"Mai has a cat.\"\nLưu ý: tiếng Anh không phân biệt anh/em: \"brother\" = anh trai hoặc em trai, \"sister\" = chị gái hoặc em gái. \"Aunt/uncle\" gồm cả cô, dì, chú, cậu, bác.","lessonId":"u2n2l1","lessonVersion":"v2.u2n2l1","manifestHash":"013672aa5927648264926e14d514d9d670ba04f547fc10aba6d50095b8e8b587","nodeId":"u2n2","order":9,"rewardIdentity":"v2.u2n2l1","schemaVersion":1,"sectionId":"sec1","signature":"gQuQAjJoJk_DWb3jkcG-VW7QQV5o-gq5EsySp16A3Kof3nBkL2rAu3Hq5ZZQHdSsj9ahTWhJ0TnySrN_KZkFAw","signatureKeyId":"dev-content-1","skillIds":["u2.vocab","u2.grammar","listening"],"title":"Ông bà và em bé · Bài 1","unitId":"u2"}