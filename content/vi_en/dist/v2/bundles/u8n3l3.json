8n3l3-e12a","prompt":{"locale":"vi-VN","text":"Bây giờ trời đang mưa."},"skillIds":["listening","u8.grammar"],"type":"textTranslation","vocabularyIds":["u5.now","u8.rainy"]},"prompt":{"audioAssetId":"a.u8.s8.n","locale":"vi-VN","text":"Nghe và viết lại bằng tiếng Anh"},"skillIds":["listening","u8.grammar"],"type":"dictation","vocabularyIds":["u5.now","u8.rainy"]}],"gradingRulesVersion":"g1","guideText":"Mẫu câu chính: \"How is the weather today?\" (Thời tiết hôm nay thế nào?) — \"It is sunny.\" (Trời nắng.) — \"It is raining.\" (Trời đang mưa.)\nChủ ngữ giả \"it\": tiếng Việt nói \"trời nắng\", tiếng Anh phải có chủ ngữ: \"It is sunny\", không nói \"Is sunny\".\nThì hiện tại tiếp diễn cho việc đang xảy ra: It is raining now. So sánh: It is rainy (trời có mưa — mô tả chung).\nMùa: in (the) summer, in winter. Miền Nam Việt Nam có hai mùa: the dry season (mùa khô) và the rainy season (mùa mưa).\n\"Fall\" là cách Mỹ gọi mùa thu; \"autumn\" dùng ở Anh — cả hai đều đúng.","lessonId":"u8n3l3","lessonVersion":"v2.u8n3l3","manifestHash":"013672aa5927648264926e14d514d9d670ba04f547fc10aba6d50095b8e8b587","nodeId":"u8n3","order":58,"rewardIdentity":"v2.u8n3l3","schemaVersion":1,"sectionId":"sec1","signature":"nwZ_Ig822WX92oQ4GBvL8BS9GnVEhEpm8oVjb6ZS1Weg1uZE2FrpYrCv2cfjerT1VLckAVITU1nCTJnPd1FfCw","signatureKeyId":"dev-content-1","skillIds":["listening","u8.grammar","u8.vocab"],"title":"Mùa hè, mùa đông · Bài 3","unitId":"u8"}