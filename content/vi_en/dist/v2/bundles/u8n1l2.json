:"textTranslation","vocabularyIds":["u5.evening","u8.cool"]},"prompt":{"audioAssetId":"a.u8.s4.n","locale":"vi-VN","text":"Nghe và viết lại bằng tiếng Anh"},"skillIds":["listening","u8.grammar"],"type":"dictation","vocabularyIds":["u5.evening","u8.cool"]},{"content":{"tokens":[{"id":"t1","text":"husband"},{"id":"t2","text":"my"},{"id":"t3","text":"friend"},{"id":"t4","text":"Apple"},{"id":"t5","text":"Good"},{"id":"t6","text":"teacher"},{"id":"t7","text":"morning"}]},"explanation":"Câu đúng: \"Good morning, my friend.\".","gradingRule":{"caseSensitive":false,"correctTokenIds":["t5","t7","t2","t3"],"ignoreDiacritics":false,"ignorePunctuation":false},"hint":"\"friend\" = bạn; \"good\" = tốt; \"morning\" = buổi sáng","id":"u8n1l2-e11","prompt":{"locale":"vi-VN","text":"Dịch câu này: \"Chào buổi sáng, bạn của tôi.\""},"skillIds":["u8.grammar"],"type":"wordBank","vocabularyIds":["u1.friend","u1.good","u1.morning"]},{"content":{"maxChars":200,"placeholder":"Viết bằng tiếng Anh"},"explanation":"Đáp án: \"Thank you, Mr. Long.\". Cũng đúng: \"Thanks, Mr. Long.\".","gradingRule":{"acceptedText":["Thank you, Mr. Long.","Thanks, Mr. Long."],"caseSensitive":false,"ignoreDiacritics":false,"ignorePunctuation":true},"hint":"\"thank you\" = cảm ơn","id":"u8n1l2-e12","prompt":{"locale":"vi-VN","text":"Cảm ơn thầy Long."},"skillIds":["u8.grammar"],"type":"textTranslation","vocabularyIds":["u1.thank_you"]}],"gradingRulesVersion":"g1","guideText":"Mẫu câu chính: \"How is the weather today?\" (Thời tiết hôm nay thế nào?) — \"It is sunny.\" (Trời nắng.) — \"It is raining.\" (Trời đang mưa.)\nChủ ngữ giả \"it\": tiếng Việt nói \"trời nắng\", tiếng Anh phải có chủ ngữ: \"It is sunny\", không nói \"Is sunny\".\nThì hiện tại tiếp diễn cho việc đang xảy ra: It is raining now. So sánh: It is rainy (trời có mưa — mô tả chung).\nMùa: in (the) summer, in winter. Miền Nam Việt Nam có hai mùa: the dry season (mùa khô) và the rainy season (mùa mưa).\n\"Fall\" là cách Mỹ gọi mùa thu; \"autumn\" dùng ở Anh — cả hai đều đúng.","lessonId":"u8n1l2","lessonVersion":"v2.u8n1l2","manifestHash":"013672aa5927648264926e14d514d9d670ba04f547fc10aba6d50095b8e8b587","nodeId":"u8n1","order":56,"rewardIdentity":"v2.u8n1l2","schemaVersion":1,"sectionId":"sec1","signature":"2hPuoO6l0xBXY9Yhut5YvTgNWeMp5noa2uFKYb8sZYuOtmmHiG-cxyx49chQP3rkYXUAfW7SuiMRcgq47UYJDQ","signatureKeyId":"dev-content-1","skillIds":["u8.vocab","u8.grammar","listening"],"title":"Nóng hay lạnh? · Bài 2","unitId":"u8"}