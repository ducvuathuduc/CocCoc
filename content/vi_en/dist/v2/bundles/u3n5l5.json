,{"id":"t4","text":"has"},{"id":"t5","text":"Tom"}]},"explanation":"Câu đúng: \"Tom has rice for lunch.\".","gradingRule":{"caseSensitive":false,"correctTokenIds":["t5","t4","t1","t3","t2"],"ignoreDiacritics":false,"ignorePunctuation":false},"hint":"Câu bắt đầu bằng \"Tom\".","id":"u3n5l5-e09","prompt":{"locale":"vi-VN","text":"Sắp xếp thành câu đúng: \"Tom ăn cơm vào bữa trưa.\""},"skillIds":["u3.grammar"],"type":"sentenceOrder","vocabularyIds":["u2.have","u3.rice","u3.lunch"]},{"content":{"maxChars":200,"placeholder":"Viết những gì bạn nghe"},"explanation":"Bạn nghe: \"I eat bread for breakfast.\".","gradingRule":{"acceptedText":["I eat bread for breakfast."],"caseSensitive":false,"ignoreDiacritics":false,"ignorePunctuation":true},"hint":"Câu có 5 từ. Nghĩa: \"Tôi ăn bánh mì vào bữa sáng.\"","id":"u3n5l5-e10","nonAudioAlternative":{"content":{"maxChars":200,"placeholder":"Viết bằng tiếng Anh"},"explanation":"Đáp án: \"I eat bread for breakfast.\".","gradingRule":{"acceptedText":["I eat bread for breakfast."],"caseSensitive":false,"ignoreDiacritics":false,"ignorePunctuation":true},"hint":"\"bread\" = bánh mì; \"eat\" = ăn; \"breakfast\" = bữa sáng","id":"u3n5l5-e10a","prompt":{"locale":"vi-VN","text":"Tôi ăn bánh mì vào bữa sáng."},"skillIds":["listening","u3.grammar"],"type":"textTranslation","vocabularyIds":["u3.bread","u3.eat","u3.breakfast"]},"prompt":{"audioAssetId":"a.u3.s21.n","locale":"vi-VN","text":"Nghe và viết lại bằng tiếng Anh"},"skillIds":["listening","u3.grammar"],"type":"dictation","vocabularyIds":["u3.bread","u3.eat","u3.breakfast"]},{"content":{"tokens":[{"id":"t1","text":"juice"},{"id":"t2","text":"Apple"},{"id":"t3","text":"please"},{"id":"t4","text":"aunt"},{"id":"t5","text":"Is"},{"id":"t6","text":"Goodbye"}]},"explanation":"Câu đúng: \"Apple juice, please.\".","gradingRule":{"caseSensitive":false,"correctTokenIds":["t2","t1","t3"],"ignoreDiacritics":false,"ignorePunctuation":false},"hint":"\"please\" = làm ơn; \"apple\" = quả táo; \"juice\" = nước ép","id":"u3n5l5-e11","prompt":{"locale":"vi-VN","text":"Dịch câu này: \"Làm ơn cho tôi nước ép táo.\""},"skillIds":["u3.grammar"],"type":"wordBank","vocabularyIds":["u1.please","u3.apple","u3.juice"]},{"content":{"maxChars":200,"placeholder":"Viết bằng tiếng Anh"},"explanation":"Đáp án: \"I want some water.\". Cũng đúng: \"I want water.\".","gradingRule":{"acceptedText":["I want some water.","I want water."],"caseSensitive":false,"ignoreDiacritics":false,"ignorePunctuation":true},"hint":"\"water\" = nước; \"want\" = muốn","id":"u3n5l5-e12","prompt":{"locale":"vi-VN","text":"Tôi muốn một ít nước."},"skillIds":["u3.grammar"],"type":"textTranslation","vocabularyIds":["u3.water","u3.want"]}],"gradingRulesVersion":"g1","guideText":"Mẫu câu chính: \"Water, please.\" (Cho tôi nước.) — \"I like tea.\" (Tôi thích trà.) — \"Do you want coffee?\" (Bạn có muốn cà phê không?)\nMạo từ: \"a\" trước phụ âm (a banana), \"an\" trước nguyên âm (an apple, an egg).\nThì hiện tại đơn: he/she thêm -s: \"Kiko likes fish.\" Câu phủ định dùng do not / does not: \"Tom does not like coffee.\" (hay: doesn't).\nLịch sự khi gọi món: thêm \"please\" ở cuối câu. \"I want ...\" hơi thẳng; dùng \"..., please\" khi nói với người phục vụ.\nBữa ăn: breakfast (bữa sáng), lunch (bữa trưa), dinner (bữa tối) — nói \"for breakfast\" (cho bữa sáng).","lessonId":"u3n5l5","lessonVersion":"v2.u3n5l5","manifestHash":"013672aa5927648264926e14d514d9d670ba04f547fc10aba6d50095b8e8b587","nodeId":"u3n5","order":20,"rewardIdentity":"v2.u3n5l5","schemaVersion":1,"sectionId":"sec1","signature":"xyfAWUk74m_GJNTae7kNEbqeR1ZFEkGQ4HzfPLEOnQcPn6WCEH9GHg4bRcFImhNCv915RkotiOwHv411SpBhDQ","signatureKeyId":"dev-content-1","skillIds":["u3.vocab","u3.grammar","listening"],"title":"Bữa ăn trong ngày · Bài 5","unitId":"u3"}