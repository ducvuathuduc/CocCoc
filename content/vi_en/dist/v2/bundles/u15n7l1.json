c vào Chủ nhật.\""},"skillIds":["speaking","u15.grammar"],"type":"sentenceOrder","vocabularyIds":["u5.sunday","u15.party"]},"prompt":{"audioAssetId":"a.u15.s29.n","locale":"en-US","text":"Nói câu sau: \"The party is on Sunday.\""},"skillIds":["speaking","u15.grammar"],"type":"speakRepeat","vocabularyIds":["u5.sunday","u15.party"]},{"content":{"tokens":[{"id":"t1","text":"Giày"},{"id":"t2","text":"bị"},{"id":"t3","text":"chút"},{"id":"t4","text":"bộ"},{"id":"t5","text":"phim"},{"id":"t6","text":"hức"},{"id":"t7","text":"Tom"},{"id":"t8","text":"về"},{"id":"t9","text":"điện"},{"id":"t10","text":"háo"}]},"explanation":"Câu đúng: \"Tom háo hức về bộ phim.\".","gradingRule":{"caseSensitive":false,"correctTokenIds":["t7","t10","t6","t8","t4","t5"],"ignoreDiacritics":false,"ignorePunctuation":false},"hint":"\"movie\" = bộ phim; \"excited\" = háo hức","id":"u15n7l1-e14","prompt":{"locale":"vi-VN","text":"Dịch sang tiếng Việt: \"Tom is excited about the movie.\""},"skillIds":["u15.grammar"],"type":"wordBank","vocabularyIds":["u13.movie","u15.excited"]},{"content":{"maxChars":200,"placeholder":"Viết bằng tiếng Anh"},"explanation":"Đáp án: \"My classmates are friendly.\".","gradingRule":{"acceptedText":["My classmates are friendly."],"caseSensitive":false,"ignoreDiacritics":false,"ignorePunctuation":true},"hint":"\"friendly\" = thân thiện","id":"u15n7l1-e15","prompt":{"locale":"vi-VN","text":"Các bạn cùng lớp của tôi thân thiện."},"skillIds":["u15.grammar"],"type":"textTranslation","vocabularyIds":["u15.friendly"]}],"gradingRulesVersion":"g1","guideText":"Mẫu câu chính: \"Why are you sad?\" (Sao bạn buồn?) — \"Nam is taller than Tom.\" (Nam cao hơn Tom.) — \"Happy birthday!\" (Chúc mừng sinh nhật!)\nSo sánh hơn với tính từ ngắn: thêm -er + than: tall → taller than, young → younger than, smart → smarter than.\nTính từ cảm xúc đuôi -ed mô tả cảm giác của người: I am bored, I am excited, She was surprised.\nGiới từ đi kèm: afraid of (sợ), worried about (lo về), excited about (háo hức về).\nLời khuyên nhẹ nhàng: \"Don't be sad.\" (Đừng buồn.)","lessonId":"u15n7l1","lessonVersion":"v2.u15n7l1","manifestHash":"013672aa5927648264926e14d514d9d670ba04f547fc10aba6d50095b8e8b587","nodeId":"u15n7","order":118,"rewardIdentity":"v2.u15n7l1","schemaVersion":1,"sectionId":"sec2","signature":"FwNfwb_kLCO027xlOrsqAzfTErXw4oqyvKhG45XNag38lAojcXCinIV2p_IrpG1sH-NZi8k14NBgIaVTFu5KBg","signatureKeyId":"dev-content-1","skillIds":["u15.grammar","listening","speaking","u15.dialogue","reading","u15.story","u15.vocab"],"title":"Ôn tập cửa ải · Bài 1","unitId":"u15"}