nonAudioAlternative":{"content":{"choices":[{"id":"c1","text":"We are excited about the trip."},{"id":"c2","text":"Ho Chi Minh City is very big."},{"id":"c3","text":"We go to the beach every summer."}]},"explanation":"Bạn nghe: \"We are excited about the trip.\" (Chúng tôi háo hức về chuyến đi.).","gradingRule":{"caseSensitive":false,"correctChoiceId":"c1","ignoreDiacritics":false,"ignorePunctuation":false},"hint":"Câu có nghĩa: \"Chúng tôi háo hức về chuyến đi.\"","id":"u15n7l1-e07a","prompt":{"locale":"vi-VN","text":"Chọn câu tiếng Anh có nghĩa: \"Chúng tôi háo hức về chuyến đi.\""},"skillIds":["listening","u15.grammar"],"type":"choice","vocabularyIds":["u11.trip","u15.excited"]},"prompt":{"audioAssetId":"a.u15.s20.n","locale":"vi-VN","text":"Nghe và chọn câu bạn nghe được"},"skillIds":["listening","u15.grammar"],"type":"listenChoice","vocabularyIds":["u11.trip","u15.excited"]},{"content":{"locale":"en-US","maxSeconds":12,"referenceText":"It is in May."},"explanation":"Câu trả lời mẫu: \"It is in May.\". Cũng đúng: \"In May.\", \"It's in May.\".","gradingRule":{"acceptedText":["It is in May.","In May.","It's in May."],"caseSensitive":false,"ignoreDiacritics":false,"ignorePunctuation":true},"hint":"Gợi ý trả lời: \"Sinh nhật tôi vào tháng Năm.\"","id":"u15n7l1-e08","nonSpeechAlternative":{"content":{"choices":[{"id":"c1","text":"Yes, I am cold."},{"id":"c2","text":"I like old movies."},{"id":"c3","text":"It is in May."}]},"explanation":"Câu trả lời mẫu: \"It is in May.\".","gradingRule":{"caseSensitive":false,"correctChoiceId":"c3","ignoreDiacritics":false,"ignorePunctuation":false},"hint":"Gợi ý trả lời: \"Sinh nhật tôi vào tháng Năm.\"","id":"u15n7l1-e08a","prompt":{"locale":"vi-VN","text":"\"When is your birthday?\" — chọn câu trả lời phù hợp"},"skillIds":["speaking","u15.dialogue"],"type":"choice","vocabularyIds":["u15.birthday"]},"prompt":{"audioAssetId":"a.u15.d5.n","locale":"en-US","text":"When is your birthday?"},"skillIds":["speaking","u15.dialogue"],"type":"dialogueTurn","vocabularyIds":["u15.birthday"]},{"content":{"choices":[{"id":"c1","text":"Linh"},{"id":"c2","text":"Her mother"},{"id":"c3","text":"Tom"}],"passage":"Saturday is Mai's birthday. Her friends want to celebrate, but it is a secret. Mai is a little sad because nobody says \"Happy birthday\" in the morning. She is bored at home. In the evening, Linh calls her: \"Come to the café, please.\" When Mai arrives, all her friends are there: Nam, Tom, Anna and Mr. Long. \"Surprise!\" they shout. Mai is very surprised and happy. Nam is funny and dances on a chair. Mrs. Rosa brings a big cake. \"Thank you for inviting me to my own party!\" Mai laughs.","question":"Who calls Mai in the evening?"},"explanation":"Đáp án: \"Linh\".","gradingRule":{"caseSensitive":false,"correctChoiceId":"c1","ignoreDiacritics":false,"ignorePunctuation":false},"hint":"Đọc lại câu chuyện \"Bữa tiệc bất ngờ\".","id":"u15n7l1-e09","prompt":{"locale":"en-US","text":"Who calls Mai in the evening?"},"skillIds":["reading","u15.story"],"type":"storyQuestion","vocabularyIds":[]},{"content":{"choices":[{"id":"c1","imageAssetId":"i.u8.spring","text":"spring"},{"id":"c2","imageAssetId":"i.u10.park","text":"park"},{"id":"c3","imageAssetId":"i.u10.city","text":"city"},{"id":"c4","imageAssetId":"i.u15.birthday","text":"birthday"}]},"explanation":"\"birthday\" = \"sinh nhật\".","gradingRule":{"caseSensitive":false,"correctChoiceId":"c4","ignoreDiacritics":false,"ignorePunctuation":false},"hint":"\"sinh nhật\" là \"birthday\".","id":"u15n7l1-e10","prompt":{"locale":"vi-VN","text":"Hình nào là \"sinh nhật\"?"},"skillIds":["u15.vocab"],"type":"imageChoice","vocabularyIds":["u15.birthday"]},{"content":{"pairs":[{"id":"p1","left":{"id":"p1l","text":"angry"},"right":{"id":"p1r","text":"tức giận"}},{"id":"p2","left":{"id":"p2l","text":"invite"},"right":{"id":"p2r","text":"mời"}},{"id":"p3","left":{"id":"p3l","text":"tall"},"right":{"id":"p3r","text":"cao"}},{"id":"p4","left":{"id":"p4l","text":"kind"},"right":{"id":"p4r","text":"tử tế"}},{"id":"p5","left":{"id":"p5l","text":"happy"},"right":{"id":"p5r","text":"vui"}}]},"explanation":"angry = tức giận; invite = mời; tall = cao; kind = tử tế; happy = vui","gradingRule":{"caseSensitive":false,"correctPairIds":["p1","p2","p3","p4","p5"],"ignoreDiacritics":false,"ignorePunctuation":false},"hint":"Ví dụ: \"angry\" = \"tức giận\".","id":"u15n7l1-e11","prompt":{"locale":"vi-VN","text":"Nối các cặp từ tương ứng"},"skillIds":["u15.vocab"],"type":"matchPairs","vocabularyIds":["u15.angry","u15.invite","u15.tall","u15.kind","u15.happy"]},{"content":{"choices":[{"id":"c1","text":"dance"},{"id":"c2","text":"angry"},{"id":"c3","text":"apple"},{"id":"c4","text":"never"}]},"explanation":"\"angry\" = \"tức giận\".","gradingRule":{"caseSensitive":false,"correctChoiceId":"c2","ignoreDiacritics":false,"ignorePunctuation":false},"hint":"\"angry\" nghĩa là \"tức giận\".","id":"u15n7l1-e12","prompt":{"locale":"vi-VN","text":"\"tức giận\" trong tiếng Anh là gì?"},"skillIds":["u15.vocab"],"type":"choice","vocabularyIds":["u15.angry"]},{"content":{"locale":"en-US","maxSeconds":7,"referenceText":"The party is on Sunday."},"explanation":"Câu mẫu: \"The party is on Sunday.\".","gradingRule":{"acceptedText":["The party is on Sunday."],"caseSensitive":false,"ignoreDiacritics":false,"ignorePunctuation":true},"hint":"Nghĩa: \"Bữa tiệc vào Chủ nhật.\"","id":"u15n7l1-e13","nonSpeechAlternative":{"content":{"tokens":[{"id":"t1","text":"Sunday"},{"id":"t2","text":"is"},{"id":"t3","text":"The"},{"id":"t4","text":"on"},{"id":"t5","text":"party"}]},"explanation":"Câu đúng: \"The party is on Sunday.\".","gradingRule":{"caseSensitive":false,"correctTokenIds":["t3","t5","t2","t4","t1"],"ignoreDiacritics":false,"ignorePunctuation":false},"hint":"Câu bắt đầu bằng \"The\".","id":"u15n7l1-e13a","prompt":{"locale":"vi-VN","text":"Sắp xếp thành câu đúng: \"Bữa tiệc vào Chủ nhật.\""},"skillIds":["speaking","u15.grammar"],"type":"sentenceOrder","vocabularyIds":["u5.sunday","u15.party"]},"prompt":{"audioAssetId":"a.u15.s29.n","locale":"en-US","text":"Nói câu sau: \"The party is on Sunday.\""},"skillIds":["speaking","u15.grammar"],"type":"speakRepeat","vocabularyIds":["u5.sunday","u15.party"]},{"content":{"tokens":[{"id":"t1","text":"Giày"},{"id":"t2","text":"bị"},{"id":"t3","text":"chút"},{"id":"t4","text":"bộ"},{"id":"t5","text":"phim"},{"id":"t6","text":"hức"},{"id":"t7","text":"Tom"},{"id":"t8","text":"về"},{"id":"t9","text":"điện"},{"id":"t10","text":"háo"}]},"explanation":"Câu đúng: \"Tom háo hức về bộ phim.\".","gradingRule":{"caseSensitive":false,"correctTokenIds":["t7","t10","t6","t8","t4","t5"],"ignoreDiacritics":false,"ignorePunctuation":false},"hint":"\"movie\" = bộ phim; \"excited\" = háo hức","id":"u15n7l1-e14","prompt":{"locale":"vi-VN","text":"Dịch sang tiếng Việt: \"Tom is excited about the movie.\""},"skillIds":["u15.grammar"],"type":"wordBank","vocabularyIds":["u13.movie","u15.excited"]},{"content":{"maxChars":200,"placeholder":"Viết bằng tiếng Anh"},"explanation":"Đáp án: \"My classmates are friendly.\".","gradingRule":{"acceptedText":["My classmates are friendly."],"caseSensitive":false,"ignoreDiacritics":false,"ignorePunctuation":true},"hint":"\"friendly\" = thân thiện","id":"u15n7l1-e15","prompt":{"locale":"vi-VN","text":"Các bạn cùng lớp của tôi thân thiện."},"skillIds":["u15.grammar"],"type":"textTranslation","vocabularyIds":["u15.friendly"]}],"gradingRulesVersion":"g1","guideText":"Mẫu câu chính: \"Why are you sad?\" (Sao bạn buồn?) — \"Nam is taller than Tom.\" (Nam cao hơn Tom.) — \"Happy birthday!\" (Chúc mừng sinh nhật!)\nSo sánh hơn với tính từ ngắn: thêm -er + than: tall → taller than, young → younger than, smart → smarter than.\nTính từ cảm xúc đuôi -ed mô tả cảm giác của người: I am bored, I am excited, She was surprised.\nGiới từ đi kèm: afraid of (sợ), worried about (lo về), excited about (háo hức về).\nLời khuyên nhẹ nhàng: \"Don't be sad.\" (Đừng buồn.)","lessonId":"u15n7l1","lessonVersion":"v2.u15n7l1","manifestHash":"013672aa5927648264926e14d514d9d670ba04f547fc10aba6d50095b8e8b587","nodeId":"u15n7","order":118,"rewardIdentity":"v2.u15n7l1","schemaVersion":1,"sectionId":"sec2","signature":"m3ljwZcTS_XwouM9de4yJd4SsaPzLbywnYnZGBWCDUAsfWbTY5FPtP6rYPsLzeSARWoKI5u2L_UxBjjNV7UJDA","signatureKeyId":"dev-content-1","skillIds":["u15.grammar","listening","speaking","u15.dialogue","reading","u15.story","u15.vocab"],"title":"Ôn tập cửa ải · Bài 1","unitId":"u15"}