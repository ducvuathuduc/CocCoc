:["u1.yes","u2.wife"]},{"content":{"tokens":[{"id":"t1","text":"family"},{"id":"t2","text":"your"},{"id":"t3","text":"My"},{"id":"t4","text":"student"},{"id":"t5","text":"nice"},{"id":"t6","text":"grandmother"},{"id":"t7","text":"is"}]},"explanation":"Câu đúng: \"My grandmother is nice.\".","gradingRule":{"caseSensitive":false,"correctTokenIds":["t3","t6","t7","t5"],"ignoreDiacritics":false,"ignorePunctuation":false},"hint":"\"nice\" = dễ thương; \"grandmother\" = bà","id":"u2n3l1-e13","prompt":{"locale":"vi-VN","text":"Dịch câu này: \"Bà tôi rất tốt bụng.\""},"skillIds":["u2.grammar"],"type":"wordBank","vocabularyIds":["u1.nice","u2.grandmother"]}],"gradingRulesVersion":"g1","guideText":"Mẫu câu chính: \"This is my mother.\" (Đây là mẹ tôi.) — \"I have a brother.\" (Tôi có một anh/em trai.)\nTính từ sở hữu: my (của tôi), your (của bạn), his (của anh ấy), her (của cô ấy), their (của họ). Đặt TRƯỚC danh từ: \"my father\", không nói \"father my\".\nĐộng từ \"have\": I/you/we/they have — he/she has. \"Mai has a cat.\"\nLưu ý: tiếng Anh không phân biệt anh/em: \"brother\" = anh trai hoặc em trai, \"sister\" = chị gái hoặc em gái. \"Aunt/uncle\" gồm cả cô, dì, chú, cậu, bác.","lessonId":"u2n3l1","lessonVersion":"v2.u2n3l1","manifestHash":"013672aa5927648264926e14d514d9d670ba04f547fc10aba6d50095b8e8b587","nodeId":"u2n3","order":10,"rewardIdentity":"v2.u2n3l1","schemaVersion":1,"sectionId":"sec1","signature":"NZhYg8SqKviMpXuvnO6875jshUpoLT9seutWk1hnQ7dYpuabJoiAQ-lThB6emVeZpRR5ZnnnpB4m_CqpxzLFDQ","signatureKeyId":"dev-content-1","skillIds":["u2.vocab","u2.grammar","listening"],"title":"Vợ chồng, con cái · Bài 1","unitId":"u2"}