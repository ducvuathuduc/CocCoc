"t3","t2","t6","t1"],"ignoreDiacritics":false,"ignorePunctuation":false},"hint":"\"hungry\" = đói; \"now\" = bây giờ","id":"u5n2l1-e13","prompt":{"locale":"vi-VN","text":"Dịch câu này: \"Bây giờ tôi đói.\""},"skillIds":["u5.grammar"],"type":"wordBank","vocabularyIds":["u3.hungry","u5.now"]}],"gradingRulesVersion":"g1","guideText":"Mẫu câu chính: \"What time is it?\" (Mấy giờ rồi?) — \"It is seven o'clock.\" (Bảy giờ rồi.) — \"I get up at six.\" (Tôi dậy lúc sáu giờ.)\nGiới từ thời gian: at + giờ (at six o'clock), on + thứ (on Monday), in + buổi (in the morning, in the evening).\nThì hiện tại đơn cho thói quen: \"Mai goes to school every day.\" Với he/she/it: go → goes, get up → gets up.\nTrạng từ tần suất đứng TRƯỚC động từ thường: \"I always eat breakfast\", \"Kiko never eats bread\". Thứ tự: always > usually > sometimes > never.\nThứ trong tuần luôn viết hoa: Monday, Sunday.","lessonId":"u5n2l1","lessonVersion":"v2.u5n2l1","manifestHash":"013672aa5927648264926e14d514d9d670ba04f547fc10aba6d50095b8e8b587","nodeId":"u5n2","order":33,"rewardIdentity":"v2.u5n2l1","schemaVersion":1,"sectionId":"sec1","signature":"tYG55pyJOKcIRnqkQv427bywmGGGgw0Cz1HZJx2N17zhYrxJ4TqOMqJvLZOAvxuzGb1HMv4mchffPMkLbI4GCw","signatureKeyId":"dev-content-1","skillIds":["u5.vocab","u5.grammar","listening"],"title":"Đi học, về nhà · Bài 1","unitId":"u5"}