oreDiacritics":false,"ignorePunctuation":true},"hint":"Nghĩa: \"Tom hơi nhút nhát.\"","id":"u15n4l1-e11","nonSpeechAlternative":{"content":{"tokens":[{"id":"t1","text":"is"},{"id":"t2","text":"a"},{"id":"t3","text":"little"},{"id":"t4","text":"shy"},{"id":"t5","text":"Tom"}]},"explanation":"Câu đúng: \"Tom is a little shy.\".","gradingRule":{"caseSensitive":false,"correctTokenIds":["t5","t1","t2","t3","t4"],"ignoreDiacritics":false,"ignorePunctuation":false},"hint":"Câu bắt đầu bằng \"Tom\".","id":"u15n4l1-e11a","prompt":{"locale":"vi-VN","text":"Sắp xếp thành câu đúng: \"Tom hơi nhút nhát.\""},"skillIds":["speaking","u15.grammar"],"type":"sentenceOrder","vocabularyIds":["u15.shy"]},"prompt":{"audioAssetId":"a.u15.s15.n","locale":"en-US","text":"Nói câu sau: \"Tom is a little shy.\""},"skillIds":["speaking","u15.grammar"],"type":"speakRepeat","vocabularyIds":["u15.shy"]}],"gradingRulesVersion":"g1","guideText":"Mẫu câu chính: \"Why are you sad?\" (Sao bạn buồn?) — \"Nam is taller than Tom.\" (Nam cao hơn Tom.) — \"Happy birthday!\" (Chúc mừng sinh nhật!)\nSo sánh hơn với tính từ ngắn: thêm -er + than: tall → taller than, young → younger than, smart → smarter than.\nTính từ cảm xúc đuôi -ed mô tả cảm giác của người: I am bored, I am excited, She was surprised.\nGiới từ đi kèm: afraid of (sợ), worried about (lo về), excited about (háo hức về).\nLời khuyên nhẹ nhàng: \"Don't be sad.\" (Đừng buồn.)","lessonId":"u15n4l1","lessonVersion":"v2.u15n4l1","manifestHash":"013672aa5927648264926e14d514d9d670ba04f547fc10aba6d50095b8e8b587","nodeId":"u15n4","order":115,"rewardIdentity":"v2.u15n4l1","schemaVersion":1,"sectionId":"sec2","signature":"oFyGxnFureNRQY1NcHjPX5TEdEXU5eVqMqp68HA0FdI_9ifSfYBbjf2k7KDa4gu6UatoXFeBGYrcGZ9dnZ3TDg","signatureKeyId":"dev-content-1","skillIds":["reading","u15.story","u15.vocab","u15.grammar","listening","speaking"],"title":"Truyện: Bữa tiệc bất ngờ · Bài 1","unitId":"u15"}