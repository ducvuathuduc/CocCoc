on":false},"hint":"Câu bắt đầu bằng \"My\".","id":"u12n3l4-e10","prompt":{"locale":"vi-VN","text":"Sắp xếp thành câu đúng: \"Đồng nghiệp của tôi đến từ Canada.\""},"skillIds":["u12.grammar"],"type":"sentenceOrder","vocabularyIds":["u1.from","u1.canada","u12.colleague"]},{"content":{"locale":"en-US","maxSeconds":6,"referenceText":"I love my job."},"explanation":"Câu mẫu: \"I love my job.\".","gradingRule":{"acceptedText":["I love my job."],"caseSensitive":false,"ignoreDiacritics":false,"ignorePunctuation":true},"hint":"Nghĩa: \"Tôi yêu công việc của tôi.\"","id":"u12n3l4-e11","nonSpeechAlternative":{"content":{"tokens":[{"id":"t1","text":"my"},{"id":"t2","text":"love"},{"id":"t3","text":"job"},{"id":"t4","text":"I"}]},"explanation":"Câu đúng: \"I love my job.\".","gradingRule":{"caseSensitive":false,"correctTokenIds":["t4","t2","t1","t3"],"ignoreDiacritics":false,"ignorePunctuation":false},"hint":"Câu bắt đầu bằng \"I\".","id":"u12n3l4-e11a","prompt":{"locale":"vi-VN","text":"Sắp xếp thành câu đúng: \"Tôi yêu công việc của tôi.\""},"skillIds":["speaking","u12.grammar"],"type":"sentenceOrder","vocabularyIds":["u2.love","u12.job"]},"prompt":{"audioAssetId":"a.u12.s5.n","locale":"en-US","text":"Nói câu sau: \"I love my job.\""},"skillIds":["speaking","u12.grammar"],"type":"speakRepeat","vocabularyIds":["u2.love","u12.job"]},{"content":{"maxChars":200,"placeholder":"Viết bằng tiếng Việt (có dấu)"},"explanation":"Đáp án: \"Tôi muốn trở thành bác sĩ.\". Cũng đúng: \"Tôi muốn làm bác sĩ.\", \"Mình muốn trở thành bác sĩ.\".","gradingRule":{"acceptedText":["Tôi muốn trở thành bác sĩ.","Tôi muốn làm bác sĩ.","Mình muốn trở thành bác sĩ.","Mình muốn làm bác sĩ."],"caseSensitive":false,"ignoreDiacritics":false,"ignorePunctuation":true},"hint":"\"want\" = muốn; \"doctor\" = bác sĩ","id":"u12n3l4-e12","prompt":{"locale":"en-US","text":"I want to be a doctor."},"skillIds":["u12.grammar"],"type":"textTranslation","vocabularyIds":["u3.want","u12.doctor"]}],"gradingRulesVersion":"g1","guideText":"Mẫu câu chính: \"What do you do?\" (Bạn làm nghề gì?) — \"I am an engineer.\" (Tôi là kỹ sư.) — \"I worked late yesterday.\" (Hôm qua tôi làm việc muộn.)\nNghề nghiệp luôn có a/an: \"She is a nurse\", \"He is an engineer\" (an trước nguyên âm).\nThì quá khứ đơn (động từ có quy tắc): thêm -ed: work → worked, start → started, finish → finished. Quá khứ của \"be\": I/he/she was, you/we/they were.\nCâu hỏi quá khứ dùng \"did\" + động từ nguyên mẫu: \"Did you finish your work?\" (không nói \"Did you finished\").\nMốc thời gian quá khứ: yesterday (hôm qua), last week (tuần trước).","lessonId":"u12n3l4","lessonVersion":"v2.u12n3l4","manifestHash":"013672aa5927648264926e14d514d9d670ba04f547fc10aba6d50095b8e8b587","nodeId":"u12n3","order":90,"rewardIdentity":"v2.u12n3l4","schemaVersion":1,"sectionId":"sec2","signature":"0Yzbe-eGNP_4NPnUYykmDYtpDHvNcG5kCwB1VTEeemqOg5tqZ-PHJhfFXZuve6tGiegwOTM-D6B16BIl7ajlAg","signatureKeyId":"dev-content-1","skillIds":["speaking","u12.grammar","u12.dialogue","u12.vocab"],"title":"Ở công ty · Bài 4","unitId":"u12"}