nt.\" Tầng nhà: \"on the fifth floor\".","lessonId":"u6n3l5","lessonVersion":"v2.u6n3l5","manifestHash":"013672aa5927648264926e14d514d9d670ba04f547fc10aba6d50095b8e8b587","nodeId":"u6n3","order":42,"rewardIdentity":"v2.u6n3l5","schemaVersion":1,"sectionId":"sec1","signature":"rCLkzXQj2JuRi5SOWzfdjoIzjVAmPjsXzgCWp1BsH6-rZWSJwUnfalwOytbILcLbA-Hw2aea8MlyacFJPGhIDw","signatureKeyId":"dev-content-1","skillIds":["u6.vocab","u6.grammar","listening"],"title":"Cửa sổ và đèn · Bài 5","unitId":"u6"}