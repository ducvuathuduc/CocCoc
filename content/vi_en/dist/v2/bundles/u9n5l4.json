"},{"id":"t6","text":"in"},{"id":"t7","text":"have"}]},"explanation":"Câu đúng: \"Do you have this shirt in black?\".","gradingRule":{"caseSensitive":false,"correctTokenIds":["t3","t2","t7","t1","t5","t6","t4"],"ignoreDiacritics":false,"ignorePunctuation":false},"hint":"Câu bắt đầu bằng \"Do\".","id":"u9n5l4-e11a","prompt":{"locale":"vi-VN","text":"Sắp xếp thành câu đúng: \"Bạn có áo sơ mi này màu đen không?\""},"skillIds":["speaking","u9.grammar"],"type":"sentenceOrder","vocabularyIds":["u2.have","u9.shirt","u9.black"]},"prompt":{"audioAssetId":"a.u9.s17.n","locale":"en-US","text":"Nói câu sau: \"Do you have this shirt in black?\""},"skillIds":["speaking","u9.grammar"],"type":"speakRepeat","vocabularyIds":["u2.have","u9.shirt","u9.black"]},{"content":{"maxChars":200,"placeholder":"Viết bằng tiếng Việt (có dấu)"},"explanation":"Đáp án: \"Anna mua một cái váy.\". Cũng đúng: \"Anna mua một chiếc váy.\", \"Anna mua một cái đầm.\".","gradingRule":{"acceptedText":["Anna mua một cái váy.","Anna mua một chiếc váy.","Anna mua một cái đầm."],"caseSensitive":false,"ignoreDiacritics":false,"ignorePunctuation":true},"hint":"\"buy\" = mua; \"dress\" = váy","id":"u9n5l4-e12","prompt":{"locale":"en-US","text":"Anna buys a dress."},"skillIds":["u9.grammar"],"type":"textTranslation","vocabularyIds":["u9.buy","u9.dress"]}],"gradingRulesVersion":"g1","guideText":"Mẫu câu chính: \"How much is this dress?\" (Cái váy này bao nhiêu tiền?) — \"Can I pay by card?\" (Tôi trả bằng thẻ được không?) — \"It is on sale.\" (Nó đang giảm giá.)\nHow much is + số ít / How much are + số nhiều: \"How much are the shoes?\"\n\"Shoes\" luôn ở dạng số nhiều (một đôi giày = a pair of shoes).\nMàu sắc đứng trước danh từ: \"a red dress\" (một cái váy đỏ). Hỏi màu: \"What color is it?\"\nTrả tiền: pay in cash (tiền mặt) / pay by card (bằng thẻ). \"Expensive\" (đắt) ↔ \"cheap\" (rẻ).","lessonId":"u9n5l4","lessonVersion":"v2.u9n5l4","manifestHash":"013672aa5927648264926e14d514d9d670ba04f547fc10aba6d50095b8e8b587","nodeId":"u9n5","order":68,"rewardIdentity":"v2.u9n5l4","schemaVersion":1,"sectionId":"sec2","signature":"oytLHe4i1-0Ws6W6ScSTL9dUQxW91_UcABG5xKS7b_kMEooOxt0qQLxZyt_MZY0Xav262_5bI7VI7jFZ19KbDQ","signatureKeyId":"dev-content-1","skillIds":["speaking","u9.grammar","u9.dialogue","u9.vocab"],"title":"Trả tiền · Bài 4","unitId":"u9"}