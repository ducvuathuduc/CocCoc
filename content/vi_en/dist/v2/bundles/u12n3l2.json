Chars":200,"placeholder":"Viết bằng tiếng Anh"},"explanation":"Đáp án: \"Linh works for a big company.\".","gradingRule":{"acceptedText":["Linh works for a big company."],"caseSensitive":false,"ignoreDiacritics":false,"ignorePunctuation":true},"hint":"\"big\" = to; \"work\" = làm việc; \"company\" = công ty","id":"u12n3l2-e10a","prompt":{"locale":"vi-VN","text":"Linh làm việc cho một công ty lớn."},"skillIds":["listening","u12.grammar"],"type":"textTranslation","vocabularyIds":["u6.big","u12.work","u12.company"]},"prompt":{"audioAssetId":"a.u12.s13.n","locale":"vi-VN","text":"Nghe và viết lại bằng tiếng Anh"},"skillIds":["listening","u12.grammar"],"type":"dictation","vocabularyIds":["u6.big","u12.work","u12.company"]},{"content":{"tokens":[{"id":"t1","text":"Good"},{"id":"t2","text":"is"},{"id":"t3","text":"cannot"},{"id":"t4","text":"What"},{"id":"t5","text":"for"},{"id":"t6","text":"your"},{"id":"t7","text":"job"}]},"explanation":"Câu đúng: \"What is your job?\".","gradingRule":{"caseSensitive":false,"correctTokenIds":["t4","t2","t6","t7"],"ignoreDiacritics":false,"ignorePunctuation":false},"hint":"\"job\" = công việc","id":"u12n3l2-e11","prompt":{"locale":"vi-VN","text":"Dịch câu này: \"Công việc của bạn là gì?\""},"skillIds":["u12.grammar"],"type":"wordBank","vocabularyIds":["u12.job"]},{"content":{"maxChars":200,"placeholder":"Viết bằng tiếng Anh"},"explanation":"Đáp án: \"The taxi driver is from Hanoi.\".","gradingRule":{"acceptedText":["The taxi driver is from Hanoi."],"caseSensitive":false,"ignoreDiacritics":false,"ignorePunctuation":true},"hint":"\"from\" = từ; \"taxi\" = xe taxi; \"driver\" = tài xế","id":"u12n3l2-e12","prompt":{"locale":"vi-VN","text":"Tài xế taxi đến từ Hà Nội."},"skillIds":["u12.grammar"],"type":"textTranslation","vocabularyIds":["u1.from","u11.taxi","u12.driver"]}],"gradingRulesVersion":"g1","guideText":"Mẫu câu chính: \"What do you do?\" (Bạn làm nghề gì?) — \"I am an engineer.\" (Tôi là kỹ sư.) — \"I worked late yesterday.\" (Hôm qua tôi làm việc muộn.)\nNghề nghiệp luôn có a/an: \"She is a nurse\", \"He is an engineer\" (an trước nguyên âm).\nThì quá khứ đơn (động từ có quy tắc): thêm -ed: work → worked, start → started, finish → finished. Quá khứ của \"be\": I/he/she was, you/we/they were.\nCâu hỏi quá khứ dùng \"did\" + động từ nguyên mẫu: \"Did you finish your work?\" (không nói \"Did you finished\").\nMốc thời gian quá khứ: yesterday (hôm qua), last week (tuần trước).","lessonId":"u12n3l2","lessonVersion":"v2.u12n3l2","manifestHash":"013672aa5927648264926e14d514d9d670ba04f547fc10aba6d50095b8e8b587","nodeId":"u12n3","order":90,"rewardIdentity":"v2.u12n3l2","schemaVersion":1,"sectionId":"sec2","signature":"wWF-eSwJ7F__7LcR1Gg8QfQKDz4-lxduZo1MSADC-5nOOjuVWIJGt-fYvrlw_XxOCJUNnTk1wqR0HlHD1rZVBg","signatureKeyId":"dev-content-1","skillIds":["u12.vocab","u12.grammar","listening"],"title":"Ở công ty · Bài 2","unitId":"u12"}