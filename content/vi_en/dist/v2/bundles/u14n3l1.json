ensitive":false,"correctTokenIds":["t3","t1","t2"],"ignoreDiacritics":false,"ignorePunctuation":false},"hint":"Câu bắt đầu bằng \"My\".","id":"u14n3l1-e10","prompt":{"locale":"vi-VN","text":"Sắp xếp thành câu đúng: \"Chân tôi bị đau.\""},"skillIds":["u14.grammar"],"type":"sentenceOrder","vocabularyIds":["u14.hurt"]},{"content":{"maxChars":40,"placeholder":"Điền từ còn thiếu"},"explanation":"Từ đúng: \"stomach\" → My stomach hurts.","gradingRule":{"acceptedText":["stomach"],"caseSensitive":false,"ignoreDiacritics":false,"ignorePunctuation":true},"hint":"\"bụng\" trong tiếng Anh là \"s...\"","id":"u14n3l1-e11","prompt":{"locale":"en-US","text":"My ___ hurts. — \"Tôi bị đau bụng.\""},"skillIds":["u14.grammar"],"type":"fillBlank","vocabularyIds":["u14.stomach","u14.hurt"]},{"content":{"maxChars":200,"placeholder":"Viết bằng tiếng Anh"},"explanation":"Đáp án: \"How do you feel today?\".","gradingRule":{"acceptedText":["How do you feel today?"],"caseSensitive":false,"ignoreDiacritics":false,"ignorePunctuation":true},"hint":"\"today\" = hôm nay; \"feel\" = cảm thấy","id":"u14n3l1-e12","prompt":{"locale":"vi-VN","text":"Hôm nay bạn cảm thấy thế nào?"},"skillIds":["u14.grammar"],"type":"textTranslation","vocabularyIds":["u5.today","u14.feel"]},{"content":{"tokens":[{"id":"t1","text":"You"},{"id":"t2","text":"not"},{"id":"t3","text":"rest"},{"id":"t4","text":"need"},{"id":"t5","text":"to"},{"id":"t6","text":"works"},{"id":"t7","text":"draw"}]},"explanation":"Câu đúng: \"You need to rest.\".","gradingRule":{"caseSensitive":false,"correctTokenIds":["t1","t4","t5","t3"],"ignoreDiacritics":false,"ignorePunctuation":false},"hint":"\"rest\" = nghỉ ngơi","id":"u14n3l1-e13","prompt":{"locale":"vi-VN","text":"Dịch câu này: \"Bạn cần nghỉ ngơi.\""},"skillIds":["u14.grammar"],"type":"wordBank","vocabularyIds":["u14.rest"]}],"gradingRulesVersion":"g1","guideText":"Mẫu câu chính: \"How do you feel?\" (Bạn thấy thế nào?) — \"I have a headache.\" (Tôi bị đau đầu.) — \"You should rest.\" (Bạn nên nghỉ ngơi.)\nBệnh dùng \"have\": have a fever (bị sốt), have a cough (bị ho), have a headache (bị đau đầu). Tính từ dùng \"be\": I am sick, I am tired.\nChỗ đau: \"My stomach hurts\" (Tôi bị đau bụng) — động từ \"hurt\" thêm -s với he/she/it và danh từ số ít.\nLời khuyên: should / should not (shouldn't) + động từ nguyên mẫu: \"You should eat more vegetables.\"\nSố nhiều bất quy tắc: one tooth → two teeth.","lessonId":"u14n3l1","lessonVersion":"v2.u14n3l1","manifestHash":"013672aa5927648264926e14d514d9d670ba04f547fc10aba6d50095b8e8b587","nodeId":"u14n3","order":106,"rewardIdentity":"v2.u14n3l1","schemaVersion":1,"sectionId":"sec2","signature":"gIbNS-XamXEXlostfz_UAsk3mydmJlts0zxmD7axFh9OIb_sBRxAVgIVEZe5C-m6d8_FlsPEryKjKYLIPM1LBQ","signatureKeyId":"dev-content-1","skillIds":["u14.vocab","u14.grammar","listening"],"title":"Bạn nên... · Bài 1","unitId":"u14"}