ctTokenIds":["t4","t3","t1","t2"],"ignoreDiacritics":false,"ignorePunctuation":false},"hint":"Câu bắt đầu bằng \"I\".","id":"u7n5l4-e11a","prompt":{"locale":"vi-VN","text":"Sắp xếp thành câu đúng: \"Tôi có thể đọc tiếng Anh.\""},"skillIds":["speaking","u7.grammar"],"type":"sentenceOrder","vocabularyIds":["u7.english","u7.read","u7.can"]},"prompt":{"audioAssetId":"a.u7.s14.n","locale":"en-US","text":"Nói câu sau: \"I can read English.\""},"skillIds":["speaking","u7.grammar"],"type":"speakRepeat","vocabularyIds":["u7.english","u7.read","u7.can"]},{"content":{"maxChars":200,"placeholder":"Viết bằng tiếng Việt (có dấu)"},"explanation":"Đáp án: \"Mai học tiếng Anh với Tom.\". Cũng đúng: \"Mai học tiếng Anh cùng Tom.\".","gradingRule":{"acceptedText":["Mai học tiếng Anh với Tom.","Mai học tiếng Anh cùng Tom."],"caseSensitive":false,"ignoreDiacritics":false,"ignorePunctuation":true},"hint":"\"English\" = tiếng Anh; \"learn\" = học","id":"u7n5l4-e12","prompt":{"locale":"en-US","text":"Mai learns English with Tom."},"skillIds":["u7.grammar"],"type":"textTranslation","vocabularyIds":["u7.english","u7.learn"]}],"gradingRulesVersion":"g1","guideText":"Mẫu câu chính: \"Can you help me?\" (Bạn có thể giúp tôi không?) — \"I do not understand.\" (Tôi không hiểu.) — \"Please open your books.\" (Hãy mở sách ra.)\n\"Can\" + động từ nguyên mẫu (không thêm -s, không \"to\"): \"She can speak English\", không nói \"She cans speaks\".\nCâu mệnh lệnh: bắt đầu bằng động từ: \"Open the window.\" Thêm \"please\" cho lịch sự.\nCâu hỏi \"What does this word mean?\" — dùng khi gặp từ mới. Trả lời: \"It means ...\".\nHọc sinh Việt hay nhầm: \"learn\" (học, tiếp thu) và \"study\" (học bài, nghiên cứu) — cả hai đều dịch là \"học\".","lessonId":"u7n5l4","lessonVersion":"v2.u7n5l4","manifestHash":"013672aa5927648264926e14d514d9d670ba04f547fc10aba6d50095b8e8b587","nodeId":"u7n5","order":52,"rewardIdentity":"v2.u7n5l4","schemaVersion":1,"sectionId":"sec1","signature":"wyMAeFnCSAqRS47T6nMQPV62-1IQxQlz5P7