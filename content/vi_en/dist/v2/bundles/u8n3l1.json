ularyIds":["u5.today","u8.weather"]},{"content":{"choices":[{"id":"c1","text":"winter"},{"id":"c2","text":"father"},{"id":"c3","text":"old"},{"id":"c4","text":"morning"}]},"explanation":"\"winter\" = \"mùa đông\".","gradingRule":{"caseSensitive":false,"correctChoiceId":"c1","ignoreDiacritics":false,"ignorePunctuation":false},"hint":"\"winter\" nghĩa là \"mùa đông\".","id":"u8n3l1-e08","prompt":{"locale":"vi-VN","text":"\"mùa đông\" trong tiếng Anh là gì?"},"skillIds":["u8.vocab"],"type":"choice","vocabularyIds":["u8.winter"]},{"content":{"tokens":[{"id":"t1","text":"Mùa"},{"id":"t2","text":"tiếng"},{"id":"t3","text":"trời"},{"id":"t4","text":"hè"},{"id":"t5","text":"hay"},{"id":"t6","text":"mưa"},{"id":"t7","text":"gái"},{"id":"t8","text":"cặp"},{"id":"t9","text":"mấy"}]},"explanation":"Câu đúng: \"Mùa hè trời hay mưa.\".","gradingRule":{"caseSensitive":false,"correctTokenIds":["t1","t4","t3","t5","t6"],"ignoreDiacritics":false,"ignorePunctuation":false},"hint":"\"rainy\" = mưa; \"summer\" = mùa hè","id":"u8n3l1-e09","prompt":{"locale":"vi-VN","text":"Dịch sang tiếng Việt: \"It is rainy in the summer.\""},"skillIds":["u8.grammar"],"type":"wordBank","vocabularyIds":["u8.rainy","u8.summer"]},{"content":{"tokens":[{"id":"t1","text":"is"},{"id":"t2","text":"cold"},{"id":"t3","text":"very"},{"id":"t4","text":"Winter"},{"id":"t5","text":"in"},{"id":"t6","text":"Canada"}]},"explanation":"Câu đúng: \"Winter in Canada is very cold.\".","gradingRule":{"caseSensitive":false,"correctTokenIds":["t4","t5","t6","t1","t3","t2"],"ignoreDiacritics":false,"ignorePunctuation":false},"hint":"Câu bắt đầu bằng \"Winter\".","id":"u8n3l1-e10","prompt":{"locale":"vi-VN","text":"Sắp xếp thành câu đúng: \"Mùa đông ở Canada rất lạnh.\""},"skillIds":["u8.grammar"],"type":"sentenceOrder","vocabularyIds":["u1.canada","u8.cold","u8.winter"]},{"content":{"maxChars":40,"placeholder":"Điền từ còn thiếu"},"explanation":"Từ đúng: \"Vietnam\" → The south of Vietnam has two seasons.","gradingRule":{"acceptedText":["Vietnam"],"caseSensitive":false,"ignoreDiacritics":false,"ignorePunctuation":true},"hint":"\"Việt Nam\" trong tiếng Anh là \"V...\"","id":"u8n3l1-e11","prompt":{"locale":"en-US","text":"The south of ___ has two seasons. — \"Miền Nam Việt Nam có hai mùa.\""},"skillIds":["u8.grammar"],"type":"fillBlank","vocabularyIds":["u1.vietnam","u2.have","u4.two","u8.season"]},{"content":{"maxChars":200,"placeholder":"Viết bằng tiếng Anh"},"explanation":"Đáp án: \"Summer is hot.\".","gradingRule":{"acceptedText":["Summer is hot."],"caseSensitive":false,"ignoreDiacritics":false,"ignorePunctuation":true},"hint":"\"hot\" = nóng; \"summer\" = mùa hè","id":"u8n3l1-e12","prompt":{"locale":"vi-VN","text":"Mùa hè nóng."},"skillIds":["u8.grammar"],"type":"textTranslation","vocabularyIds":["u8.hot","u8.summer"]},{"content":{"tokens":[{"id":"t1","text":"Today"},{"id":"t2","text":"windy"},{"id":"t3","text":"grandmother"},{"id":"t4","text":"cold"},{"id":"t5","text":"learn"},{"id":"t6","text":"is"}]},"explanation":"Câu đúng: \"Today is windy.\".","gradingRule":{"caseSensitive":false,"correctTokenIds":["t1","t6","t2"],"ignoreDiacritics":false,"ignorePunctuation":false},"hint":"\"today\" = hôm nay; \"windy\" = nhiều gió","id":"u8n3l1-e13","prompt":{"locale":"vi-VN","text":"Dịch câu này: \"Hôm nay trời nhiều gió.\""},"skillIds":["u8.grammar"],"type":"wordBank","vocabularyIds":["u5.today","u8.windy"]}],"gradingRulesVersion":"g1","guideText":"Mẫu câu chính: \"How is the weather today?\" (Thời tiết hôm nay thế nào?) — \"It is sunny.\" (Trời nắng.) — \"It is raining.\" (Trời đang mưa.)\nChủ ngữ giả \"it\": tiếng Việt nói \"trời nắng\", tiếng Anh phải có chủ ngữ: \"It is sunny\", không nói \"Is sunny\".\nThì hiện tại tiếp diễn cho việc đang xảy ra: It is raining now. So sánh: It is rainy (trời có mưa — mô tả chung).\nMùa: in (the) summer, in winter. Miền Nam Việt Nam có hai mùa: the dry season (mùa khô) và the rainy season (mùa mưa).\n\"Fall\" là cách Mỹ gọi mùa thu; \"autumn\" dùng ở Anh — cả hai đều đúng.","lessonId":"u8n3l1","lessonVersion":"v2.u8n3l1","manifestHash":"013672aa5927648264926e14d514d9d670ba04f547fc10aba6d50095b8e8b587","nodeId":"u8n3","order":58,"rewardIdentity":"v2.u8n3l1","schemaVersion":1,"sectionId":"sec1","signature":"Af1yVYp45ze5Mdq0vPw5UhJSZCFKQhyEpfoG4vblqLawZxxgzfjg_nuiJfVfjsnyCvreOZMLym12QCKKGoHSAQ","signatureKeyId":"dev-content-1","skillIds":["u8.vocab","u8.grammar","listening"],"title":"Mùa hè, mùa đông · Bài 1","unitId":"u8"}