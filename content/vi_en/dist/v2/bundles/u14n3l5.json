 + động từ nguyên mẫu: \"You should eat more vegetables.\"\nSố nhiều bất quy tắc: one tooth → two teeth.","lessonId":"u14n3l5","lessonVersion":"v2.u14n3l5","manifestHash":"013672aa5927648264926e14d514d9d670ba04f547fc10aba6d50095b8e8b587","nodeId":"u14n3","order":106,"rewardIdentity":"v2.u14n3l5","schemaVersion":1,"sectionId":"sec2","signature":"5AcNkcGQ0KTnoMpNLE36w7BC7v96FxUCry5Brmt_tkin6V-NdLfdlemxj8Zx6fsGYE9LBIfwHiIOWyAdtZW_Dw","signatureKeyId":"dev-content-1","skillIds":["u14.vocab","u14.grammar","listening"],"title":"Bạn nên... · Bài 5","unitId":"u14"}