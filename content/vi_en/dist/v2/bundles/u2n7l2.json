ectTokenIds":["t5","t3","t4","t2","t1"],"ignoreDiacritics":false,"ignorePunctuation":false},"hint":"Câu bắt đầu bằng \"The\".","id":"u2n7l2-e13a","prompt":{"locale":"vi-VN","text":"Sắp xếp thành câu đúng: \"Em bé là em gái tôi.\""},"skillIds":["speaking","u2.grammar"],"type":"sentenceOrder","vocabularyIds":["u2.sister","u2.baby"]},"prompt":{"audioAssetId":"a.u2.s10.n","locale":"en-US","text":"Nói câu sau: \"The baby is my sister.\""},"skillIds":["speaking","u2.grammar"],"type":"speakRepeat","vocabularyIds":["u2.sister","u2.baby"]},{"content":{"tokens":[{"id":"t1","text":"Chào"},{"id":"t2","text":"Bà"},{"id":"t3","text":"sáng"},{"id":"t4","text":"thương"},{"id":"t5","text":"sinh"},{"id":"t6","text":"ông"},{"id":"t7","text":"ơn"},{"id":"t8","text":"buổi"}]},"explanation":"Câu đúng: \"Chào buổi sáng, ông!\".","gradingRule":{"caseSensitive":false,"correctTokenIds":["t1","t8","t3","t6"],"ignoreDiacritics":false,"ignorePunctuation":false},"hint":"\"good\" = tốt; \"morning\" = buổi sáng; \"grandfather\" = ông","id":"u2n7l2-e14","prompt":{"locale":"vi-VN","text":"Dịch sang tiếng Việt: \"Good morning, Grandpa!\""},"skillIds":["u2.grammar"],"type":"wordBank","vocabularyIds":["u1.good","u1.morning","u2.grandfather"]},{"content":{"maxChars":200,"placeholder":"Viết bằng tiếng Anh"},"explanation":"Đáp án: \"This is my husband.\".","gradingRule":{"acceptedText":["This is my husband."],"caseSensitive":false,"ignoreDiacritics":false,"ignorePunctuation":true},"hint":"\"husband\" = chồng","id":"u2n7l2-e15","prompt":{"locale":"vi-VN","text":"Đây là chồng tôi."},"skillIds":["u2.grammar"],"type":"textTranslation","vocabularyIds":["u2.husband"]}],"gradingRulesVersion":"g1","guideText":"Mẫu câu chính: \"This is my mother.\" (Đây là mẹ tôi.) — \"I have a brother.\" (Tôi có một anh/em trai.)\nTính từ sở hữu: my (của tôi), your (của bạn), his (của anh ấy), her (của cô ấy), their (của họ). Đặt TRƯỚC danh từ: \"my father\", không nói \"father my\".\nĐộng từ \"have\": I/you/we/they have — he/she has. \"Mai has a cat.\"\nLưu ý: tiếng Anh không phân biệt anh/em: \"brother\" = anh trai hoặc em trai, \"sister\" = chị gái hoặc em gái. \"Aunt/uncle\" gồm cả cô, dì, chú, cậu, bác.","lessonId":"u2n7l2","lessonVersion":"v2.u2n7l2","manifestHash":"013672aa5927648264926e14d514d9d670ba04f547fc10aba6d50095b8e8b587","nodeId":"u2n7","order":14,"rewardIdentity":"v2.u2n7l2","schemaVersion":1,"sectionId":"sec1","signature":"x0xeTZFM5Cu9dFZ7bmJ3qHUXAVHO2X_tHzusGdW__mT5BBfjCRF6po0VbAI8RGFPEHDBhRjjmuPsPpZv2IvDCw","signatureKeyId":"dev-content-1","skillIds":["u2.grammar","listening","speaking","u2.dialogue","reading","u2.story","u2.vocab"],"title":"Ôn tập cửa ải · Bài 2","unitId":"u2"}