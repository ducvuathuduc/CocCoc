on","vocabularyIds":["u3.water","u3.want"]},{"content":{"tokens":[{"id":"t1","text":"sister"},{"id":"t2","text":"my"},{"id":"t3","text":"This"},{"id":"t4","text":"coffee"},{"id":"t5","text":"Long"},{"id":"t6","text":"likes"},{"id":"t7","text":"is"}]},"explanation":"Câu đúng: \"This is my coffee.\".","gradingRule":{"caseSensitive":false,"correctTokenIds":["t3","t7","t2","t4"],"ignoreDiacritics":false,"ignorePunctuation":false},"hint":"\"coffee\" = cà phê","id":"u3n3l2-e11","prompt":{"locale":"vi-VN","text":"Dịch câu này: \"Đây là cà phê của tôi.\""},"skillIds":["u3.grammar"],"type":"wordBank","vocabularyIds":["u3.coffee"]},{"content":{"maxChars":200,"placeholder":"Viết bằng tiếng Anh"},"explanation":"Đáp án: \"Mrs. Rosa has tea and coffee.\".","gradingRule":{"acceptedText":["Mrs. Rosa has tea and coffee."],"caseSensitive":false,"ignoreDiacritics":false,"ignorePunctuation":true},"hint":"\"have\" = có; \"tea\" = trà; \"coffee\" = cà phê","id":"u3n3l2-e12","prompt":{"locale":"vi-VN","text":"Bà Rosa có trà và cà phê."},"skillIds":["u3.grammar"],"type":"textTranslation","vocabularyIds":["u2.have","u3.tea","u3.coffee"]}],"gradingRulesVersion":"g1","guideText":"Mẫu câu chính: \"Water, please.\" (Cho tôi nước.) — \"I like tea.\" (Tôi thích trà.) — \"Do you want coffee?\" (Bạn có muốn cà phê không?)\nMạo từ: \"a\" trước phụ âm (a banana), \"an\" trước nguyên âm (an apple, an egg).\nThì hiện tại đơn: he/she thêm -s: \"Kiko likes fish.\" Câu phủ định dùng do not / does not: \"Tom does not like coffee.\" (hay: doesn't).\nLịch sự khi gọi món: thêm \"please\" ở cuối câu. \"I want ...\" hơi thẳng; dùng \"..., please\" khi nói với người phục vụ.\nBữa ăn: breakfast (bữa sáng), lunch (bữa trưa), dinner (bữa tối) — nói \"for breakfast\" (cho bữa sáng).","lessonId":"u3n3l2","lessonVersion":"v2.u3n3l2","manifestHash":"013672aa5927648264926e14d514d9d670ba04f547fc10aba6d50095b8e8b587","nodeId":"u3n3","order":18,"rewardIdentity":"v2.u3n3l2","schemaVersion":1,"sectionId":"sec1","signature":"