itics":false,"ignorePunctuation":false},"hint":"Câu bắt đầu bằng \"I\".","id":"u16n6l4-e10","prompt":{"locale":"vi-VN","text":"Sắp xếp thành câu đúng: \"Tôi hy vọng ngày mai trời sẽ nắng.\""},"skillIds":["u16.grammar"],"type":"sentenceOrder","vocabularyIds":["u8.sunny","u11.tomorrow","u16.will","u16.hope"]},{"content":{"locale":"en-US","maxSeconds":6,"referenceText":"I have a plan."},"explanation":"Câu mẫu: \"I have a plan.\".","gradingRule":{"acceptedText":["I have a plan."],"caseSensitive":false,"ignoreDiacritics":false,"ignorePunctuation":true},"hint":"Nghĩa: \"Tôi có một kế hoạch.\"","id":"u16n6l4-e11","nonSpeechAlternative":{"content":{"tokens":[{"id":"t1","text":"a"},{"id":"t2","text":"I"},{"id":"t3","text":"have"},{"id":"t4","text":"plan"}]},"explanation":"Câu đúng: \"I have a plan.\".","gradingRule":{"caseSensitive":false,"correctTokenIds":["t2","t3","t1","t4"],"ignoreDiacritics":false,"ignorePunctuation":false},"hint":"Câu bắt đầu bằng \"I\".","id":"u16n6l4-e11a","prompt":{"locale":"vi-VN","text":"Sắp xếp thành câu đúng: \"Tôi có một kế hoạch.\""},"skillIds":["speaking","u16.grammar"],"type":"sentenceOrder","vocabularyIds":["u2.have","u16.plan"]},"prompt":{"audioAssetId":"a.u16.s6.n","locale":"en-US","text":"Nói câu sau: \"I have a plan.\""},"skillIds":["speaking","u16.grammar"],"type":"speakRepeat","vocabularyIds":["u2.have","u16.plan"]},{"content":{"maxChars":200,"placeholder":"Viết bằng tiếng Việt (có dấu)"},"explanation":"Đáp án: \"Tôi yêu Tết Trung thu.\". Cũng đúng: \"Tôi thích Tết Trung thu.\", \"Mình yêu Tết Trung thu.\".","gradingRule":{"acceptedText":["Tôi yêu Tết Trung thu.","Tôi thích Tết Trung thu.","Mình yêu Tết Trung thu.","Mình thích Tết Trung thu."],"caseSensitive":false,"ignoreDiacritics":false,"ignorePunctuation":true},"hint":"\"love\" = yêu; \"autumn\" = mùa thu; \"festival\" = lễ hội","id":"u16n6l4-e12","prompt":{"locale":"en-US","text":"I love the Mid-Autumn Festival."},"skillIds":["u16.grammar"],"type":"textTranslation","vocabularyIds":["u2.love","u8.autumn","u16.festival"]}],"gradingRulesVersion":"g1","guideText":"Mẫu câu chính: \"What will you do this weekend?\" (Cuối tuần này bạn sẽ làm gì?) — \"I went to the museum.\" (Tôi đã đi bảo tàng.) — \"That is a good idea!\" (Ý hay đấy!)\nTương lai: will + động từ nguyên mẫu: \"I will call you.\" Rút gọn: I'll, you'll, we'll. Phủ định: will not = won't.\nQuá khứ bất quy tắc phải học thuộc: go → went, see → saw, eat → ate, buy → bought, forget → forgot.\n\"Maybe\" (có lẽ) đứng đầu câu: \"Maybe it will rain tomorrow.\"\nRủ rê: \"Let's ...\" (Chúng ta hãy ... nhé): \"Let's have a picnic.\"","lessonId":"u16n6l4","lessonVersion":"v2.u16n6l4","manifestHash":"013672aa5927648264926e14d514d9d670ba04f547fc10aba6d50095b8e8b587","nodeId":"u16n6","order":125,"rewardIdentity":"v2.u16n6l4","schemaVersion":1,"sectionId":"sec2","signature":"Gzj9XqGbwD6nwM1IgGdUqo7n1l_6KpqLrETso5GpaW9qmhFlRI5OMiREp2IWwXYajC5EHdJRblJtAYgp6JO3Ag","signatureKeyId":"dev-content-1","skillIds":["speaking","u16.grammar","u16.dialogue","u16.vocab"],"title":"Ước mơ của tôi · Bài 4","unitId":"u16"}