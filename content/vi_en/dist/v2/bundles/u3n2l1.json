r"],"type":"textTranslation","vocabularyIds":["u1.please","u2.baby","u3.milk"]},{"content":{"tokens":[{"id":"t1","text":"are"},{"id":"t2","text":"please"},{"id":"t3","text":"mother"},{"id":"t4","text":"An"},{"id":"t5","text":"Nam"},{"id":"t6","text":"apple"}]},"explanation":"Câu đúng: \"An apple, please.\".","gradingRule":{"caseSensitive":false,"correctTokenIds":["t4","t6","t2"],"ignoreDiacritics":false,"ignorePunctuation":false},"hint":"\"please\" = làm ơn; \"apple\" = quả táo","id":"u3n2l1-e13","prompt":{"locale":"vi-VN","text":"Dịch câu này: \"Làm ơn cho tôi một quả táo.\""},"skillIds":["u3.grammar"],"type":"wordBank","vocabularyIds":["u1.please","u3.apple"]}],"gradingRulesVersion":"g1","guideText":"Mẫu câu chính: \"Water, please.\" (Cho tôi nước.) — \"I like tea.\" (Tôi thích trà.) — \"Do you want coffee?\" (Bạn có muốn cà phê không?)\nMạo từ: \"a\" trước phụ âm (a banana), \"an\" trước nguyên âm (an apple, an egg).\nThì hiện tại đơn: he/she thêm -s: \"Kiko likes fish.\" Câu phủ định dùng do not / does not: \"Tom does not like coffee.\" (hay: doesn't).\nLịch sự khi gọi món: thêm \"please\" ở cuối câu. \"I want ...\" hơi thẳng; dùng \"..., please\" khi nói với người phục vụ.\nBữa ăn: breakfast (bữa sáng), lunch (bữa trưa), dinner (bữa tối) — nói \"for breakfast\" (cho bữa sáng).","lessonId":"u3n2l1","lessonVersion":"v2.u3n2l1","manifestHash":"013672aa5927648264926e14d514d9d670ba04f547fc10aba6d50095b8e8b587","nodeId":"u3n2","order":17,"rewardIdentity":"v2.u3n2l1","schemaVersion":1,"sectionId":"sec1","signature":"JIvl-JiRMzrtpynMAPMn8henaQTuqnwI1wmLhvHFZIQ4DGJ1bHw5BT5WBd66Fbgbz1wVdQ5a-Wj6aghJ_QSyCw","signatureKeyId":"dev-content-1","skillIds":["u3.vocab","u3.grammar","listening"],"title":"Trà hay cà phê? · Bài 1","unitId":"u3"}