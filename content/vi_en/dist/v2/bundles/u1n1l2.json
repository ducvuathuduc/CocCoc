anation":"Đáp án: \"Goodbye, Linh!\". Cũng đúng: \"Bye, Linh!\".","gradingRule":{"acceptedText":["Goodbye, Linh!","Bye, Linh!"],"caseSensitive":false,"ignoreDiacritics":false,"ignorePunctuation":true},"hint":"\"goodbye\" = tạm biệt","id":"u1n1l2-e12","prompt":{"locale":"vi-VN","text":"Tạm biệt, Linh!"},"skillIds":["u1.grammar"],"type":"textTranslation","vocabularyIds":["u1.goodbye"]}],"gradingRulesVersion":"g1","guideText":"Mẫu câu chính: \"Hello, I am Mai.\" (Xin chào, tôi là Mai.) — \"What is your name?\" (Bạn tên là gì?) — \"Nice to meet you.\" (Rất vui được gặp bạn.)\nNgữ pháp: động từ \"to be\": I am, you are, he/she is. Khi nói, người bản xứ hay rút gọn: I'm, you're, he's, she's. Cả hai cách viết đều được chấp nhận.\nMẹo: \"I\" luôn viết hoa. Dùng \"a\" trước nghề nghiệp: \"I am a student.\" Tiếng Việt có thể bỏ \"một\", tiếng Anh thì không.\nLịch sự: \"Excuse me\" dùng để bắt chuyện, \"Sorry\" dùng khi xin lỗi vì lỗi của mình.","lessonId":"u1n1l2","lessonVersion":"v2.u1n1l2","manifestHash":"013672aa5927648264926e14d514d9d670ba04f547fc10aba6d50095b8e8b587","nodeId":"u1n1","order":0,"rewardIdentity":"v2.u1n1l2","schemaVersion":1,"sectionId":"sec1","signature":"vX6pZ8vqlJ1jjzoveWMh-tkkTRkMNAmmcnuBEC7LRjgPAOWFOG6-DixS445eNnuKcdxzpoS_LFyVn5AiGgIXCQ","signatureKeyId":"dev-content-1","skillIds":["u1.vocab","u1.grammar","listening"],"title":"Xin chào · Bài 2","unitId":"u1"}