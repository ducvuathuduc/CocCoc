ái hoặc em gái. \"Aunt/uncle\" gồm cả cô, dì, chú, cậu, bác.","lessonId":"u2n3l2","lessonVersion":"v2.u2n3l2","manifestHash":"013672aa5927648264926e14d514d9d670ba04f547fc10aba6d50095b8e8b587","nodeId":"u2n3","order":10,"rewardIdentity":"v2.u2n3l2","schemaVersion":1,"sectionId":"sec1","signature":"rlhnAzsdfS2zmP7n-l-xJNuLrQH7qT0jnIDaB6htnopgT8QwWaWO-EPc2R53u2IQZ1H79FRTntzIp_gHOkCoAw","signatureKeyId":"dev-content-1","skillIds":["u2.vocab","u2.grammar","listening"],"title":"Vợ chồng, con cái · Bài 2","unitId":"u2"}