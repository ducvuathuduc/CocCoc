d"},{"id":"t3","text":"breakfast"},{"id":"t4","text":"for"},{"id":"t5","text":"I"}]},"explanation":"Câu đúng: \"I eat bread for breakfast.\".","gradingRule":{"caseSensitive":false,"correctTokenIds":["t5","t1","t2","t4","t3"],"ignoreDiacritics":false,"ignorePunctuation":false},"hint":"Câu bắt đầu bằng \"I\".","id":"u3n6l4-e11a","prompt":{"locale":"vi-VN","text":"Sắp xếp thành câu đúng: \"Tôi ăn bánh mì vào bữa sáng.\""},"skillIds":["speaking","u3.grammar"],"type":"sentenceOrder","vocabularyIds":["u3.bread","u3.eat","u3.breakfast"]},"prompt":{"audioAssetId":"a.u3.s21.n","locale":"en-US","text":"Nói câu sau: \"I eat bread for breakfast.\""},"skillIds":["speaking","u3.grammar"],"type":"speakRepeat","vocabularyIds":["u3.bread","u3.eat","u3.breakfast"]},{"content":{"maxChars":200,"placeholder":"Viết bằng tiếng Việt (có dấu)"},"explanation":"Đáp án: \"Cà phê hay trà?\". Cũng đúng: \"Cà phê hoặc trà?\".","gradingRule":{"acceptedText":["Cà phê hay trà?","Cà phê hoặc trà?"],"caseSensitive":false,"ignoreDiacritics":false,"ignorePunctuation":true},"hint":"\"tea\" = trà; \"coffee\" = cà phê","id":"u3n6l4-e12","prompt":{"locale":"en-US","text":"Coffee or tea?"},"skillIds":["u3.grammar"],"type":"textTranslation","vocabularyIds":["u3.tea","u3.coffee"]}],"gradingRulesVersion":"g1","guideText":"Mẫu câu chính: \"Water, please.\" (Cho tôi nước.) — \"I like tea.\" (Tôi thích trà.) — \"Do you want coffee?\" (Bạn có muốn cà phê không?)\nMạo từ: \"a\" trước phụ âm (a banana), \"an\" trước nguyên âm (an apple, an egg).\nThì hiện tại đơn: he/she thêm -s: \"Kiko likes fish.\" Câu phủ định dùng do not / does not: \"Tom does not like coffee.\" (hay: doesn't).\nLịch sự khi gọi món: thêm \"please\" ở cuối câu. \"I want ...\" hơi thẳng; dùng \"..., please\" khi nói với người phục vụ.\nBữa ăn: breakfast (bữa sáng), lunch (bữa trưa), dinner (bữa tối) — nói \"for breakfast\" (cho bữa sáng).","lessonId":"u3n6l4","lessonVersion":"v2.u3n6l4","manifestHash":"013672aa5927648264926e14d514d9d670ba04f547fc10