.dialogue"],"type":"dialogueTurn","vocabularyIds":["u1.thank_you","u5.today","u15.happy"]},{"content":{"choices":[{"id":"c1","text":"Mr. Long"},{"id":"c2","text":"Tom"},{"id":"c3","text":"Nam"}],"passage":"Saturday is Mai's birthday. Her friends want to celebrate, but it is a secret. Mai is a little sad because nobody says \"Happy birthday\" in the morning. She is bored at home. In the evening, Linh calls her: \"Come to the café, please.\" When Mai arrives, all her friends are there: Nam, Tom, Anna and Mr. Long. \"Surprise!\" they shout. Mai is very surprised and happy. Nam is funny and dances on a chair. Mrs. Rosa brings a big cake. \"Thank you for inviting me to my own party!\" Mai laughs.","question":"Who dances on a chair?"},"explanation":"Đáp án: \"Nam\".","gradingRule":{"caseSensitive":false,"correctChoiceId":"c3","ignoreDiacritics":false,"ignorePunctuation":false},"hint":"Đọc lại câu chuyện \"Bữa tiệc bất ngờ\".","id":"u15n7l2-e09","prompt":{"locale":"en-US","text":"Who dances on a chair?"},"skillIds":["reading","u15.story"],"type":"storyQuestion","vocabularyIds":[]},{"content":{"choices":[{"id":"c1","imageAssetId":"i.u15.party","text":"party"},{"id":"c2","imageAssetId":"i.u12.engineer","text":"engineer"},{"id":"c3","imageAssetId":"i.u3.juice","text":"juice"},{"id":"c4","imageAssetId":"i.u12.driver","text":"driver"}]},"explanation":"\"party\" = \"bữa tiệc\".","gradingRule":{"caseSensitive":false,"correctChoiceId":"c1","ignoreDiacritics":false,"ignorePunctuation":false},"hint":"\"bữa tiệc\" là \"party\".","id":"u15n7l2-e10","prompt":{"locale":"vi-VN","text":"Hình nào là \"bữa tiệc\"?"},"skillIds":["u15.vocab"],"type":"imageChoice","vocabularyIds":["u15.party"]},{"content":{"pairs":[{"id":"p1","left":{"id":"p1l","text":"kind"},"right":{"id":"p1r","text":"tử tế"}},{"id":"p2","left":{"id":"p2l","text":"worried"},"right":{"id":"p2r","text":"lo lắng"}},{"id":"p3","left":{"id":"p3l","text":"bored"},"right":{"id":"p3r","text":"chán"}},{"id":"p4","left":{"id":"p4l","text":"invite"},"right":{"id":"p4r","text":"mời"}},{"id":"p5","left":{"id":"p5l","text":"party"},"right":{"id":"p5r","text":"bữa tiệc"}}]},"explanation":"kind = tử tế; worried = lo lắng; bored = chán; invite = mời; party = bữa tiệc","gradingRule":{"caseSensitive":false,"correctPairIds":["p1","p2","p3","p4","p5"],"ignoreDiacritics":false,"ignorePunctuation":false},"hint":"Ví dụ: \"kind\" = \"tử tế\".","id":"u15n7l2-e11","prompt":{"locale":"vi-VN","text":"Nối các cặp từ tương ứng"},"skillIds":["u15.vocab"],"type":"matchPairs","vocabularyIds":["u15.kind","u15.worried","u15.bored","u15.invite","u15.party"]},{"content":{"choices":[{"id":"c1","text":"excited"},{"id":"c2","text":"rice"},{"id":"c3","text":"family"},{"id":"c4","text":"computer"}]},"explanation":"\"excited\" = \"háo hức\".","gradingRule":{"caseSensitive":false,"correctChoiceId":"c1","ignoreDiacritics":false,"ignorePunctuation":false},"hint":"\"excited\" nghĩa là \"háo hức\".","id":"u15n7l2-e12","prompt":{"locale":"vi-VN","text":"\"háo hức\" trong tiếng Anh là gì?"},"skillIds":["u15.vocab"],"type":"choice","vocabularyIds":["u15.excited"]},{"content":{"locale":"en-US","maxSeconds":6,"referenceText":"Mai was surprised."},"explanation":"Câu mẫu: \"Mai was surprised.\".","gradingRule":{"acceptedText":["Mai was surprised."],"caseSensitive":false,"ignoreDiacritics":false,"ignorePunctuation":true},"hint":"Nghĩa: \"Mai đã rất ngạc nhiên.\"","id":"u15n7l2-e13","nonSpeechAlternative":{"content":{"tokens":[{"id":"t1","text":"was"},{"id":"t2","text":"surprised"},{"id":"t3","text":"Mai"}]},"explanation":"Câu đúng: \"Mai was surprised.\".","gradingRule":{"caseSensitive":false,"correctTokenIds":["t3","t1","t2"],"ignoreDiacritics":false,"ignorePunctuation":false},"hint":"Câu bắt đầu bằng \"Mai\".","id":"u15n7l2-e13a","prompt":{"locale":"vi-VN","text":"Sắp xếp thành câu đúng: \"Mai đã rất ngạc nhiên.\""},"skillIds":["speaking","u15.grammar"],"type":"sentenceOrder","vocabularyIds":["u15.surprised"]},"prompt":{"audioAssetId":"a.u15.s21.n","locale":"en-US","text":"Nói câu sau: \"Mai was surprised.\""},"skillIds":["speaking","u15.grammar"],"type":"speakRepeat","vocabularyIds":["u15.surprised"]},{"content":{"tokens":[{"id":"t1","text":"Sao"},{"id":"t2","text":"bạn"},{"id":"t3","text":"Tiếng"},{"id":"t4","text":"buồn"},{"id":"t5","text":"ta"},{"id":"t6","text":"Sếp"},{"id":"t7","text":"Mai"}]},"explanation":"Câu đúng: \"Sao bạn buồn?\".","gradingRule":{"caseSensitive":false,"correctTokenIds":["t1","t2","t4"],"ignoreDiacritics":false,"ignorePunctuation":false},"hint":"\"sad\" = buồn","id":"u15n7l2-e14","prompt":{"locale":"vi-VN","text":"Dịch sang tiếng Việt: \"Why are you sad?\""},"skillIds":["u15.grammar"],"type":"wordBank","vocabularyIds":["u15.sad"]},{"content":{"maxChars":200,"placeholder":"Viết bằng tiếng Anh"},"explanation":"Đáp án: \"I am bored at home.\". Cũng đúng: \"I'm bored at home.\".","gradingRule":{"acceptedText":["I am bored at home.","I'm bored at home."],"caseSensitive":false,"ignoreDiacritics":false,"ignorePunctuation":true},"hint":"\"home\" = nhà; \"bored\" = chán","id":"u15n7l2-e15","prompt":{"locale":"vi-VN","text":"Ở nhà tôi thấy chán."},"skillIds":["u15.grammar"],"type":"textTranslation","vocabularyIds":["u5.home","u15.bored"]}],"gradingRulesVersion":"g1","guideText":"Mẫu câu chính: \"Why are you sad?\" (Sao bạn buồn?) — \"Nam is taller than Tom.\" (Nam cao hơn Tom.) — \"Happy birthday!\" (Chúc mừng sinh nhật!)\nSo sánh hơn với tính từ ngắn: thêm -er + than: tall → taller than, young → younger than, smart → smarter than.\nTính từ cảm xúc đuôi -ed mô tả cảm giác của người: I am bored, I am excited, She was surprised.\nGiới từ đi kèm: afraid of (sợ), worried about (lo về), excited about (háo hức về).\nLời khuyên nhẹ nhàng: \"Don't be sad.\" (Đừng buồn.)","lessonId":"u15n7l2","lessonVersion":"v2.u15n7l2","manifestHash":"013672aa5927648264926e14d514d9d670ba04f547fc10aba6d50095b8e8b587","nodeId":"u15n7","order":118,"rewardIdentity":"v2.u15n7l2","schemaVersion":1,"sectionId":"s