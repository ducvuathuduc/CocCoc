,"prompt":{"locale":"vi-VN","text":"\"cái ô\" trong tiếng Anh là gì?"},"skillIds":["u8.vocab"],"type":"choice","vocabularyIds":["u8.umbrella"]},{"content":{"locale":"en-US","maxSeconds":6,"referenceText":"The sky is cloudy."},"explanation":"Câu mẫu: \"The sky is cloudy.\".","gradingRule":{"acceptedText":["The sky is cloudy."],"caseSensitive":false,"ignoreDiacritics":false,"ignorePunctuation":true},"hint":"Nghĩa: \"Bầu trời nhiều mây.\"","id":"u8n7l1-e13","nonSpeechAlternative":{"content":{"tokens":[{"id":"t1","text":"sky"},{"id":"t2","text":"The"},{"id":"t3","text":"cloudy"},{"id":"t4","text":"is"}]},"explanation":"Câu đúng: \"The sky is cloudy.\".","gradingRule":{"caseSensitive":false,"correctTokenIds":["t2","t1","t4","t3"],"ignoreDiacritics":false,"ignorePunctuation":false},"hint":"Câu bắt đầu bằng \"The\".","id":"u8n7l1-e13a","prompt":{"locale":"vi-VN","text":"Sắp xếp thành câu đúng: \"Bầu trời nhiều mây.\""},"skillIds":["speaking","u8.grammar"],"type":"sentenceOrder","vocabularyIds":["u8.cloudy","u8.sky"]},"prompt":{"audioAssetId":"a.u8.s22.n","locale":"en-US","text":"Nói câu sau: \"The sky is cloudy.\""},"skillIds":["speaking","u8.grammar"],"type":"speakRepeat","vocabularyIds":["u8.cloudy","u8.sky"]},{"content":{"tokens":[{"id":"t1","text":"trời"},{"id":"t2","text":"ít"},{"id":"t3","text":"hè"},{"id":"t4","text":"khu"},{"id":"t5","text":"thứ"},{"id":"t6","text":"Mùa"},{"id":"t7","text":"hay"},{"id":"t8","text":"Rosa"},{"id":"t9","text":"mưa"}]},"explanation":"Câu đúng: \"Mùa hè trời hay mưa.\".","gradingRule":{"caseSensitive":false,"correctTokenIds":["t6","t3","t1","t7","t9"],"ignoreDiacritics":false,"ignorePunctuation":false},"hint":"\"rainy\" = mưa; \"summer\" = mùa hè","id":"u8n7l1-e14","prompt":{"locale":"vi-VN","text":"Dịch sang tiếng Việt: \"It is rainy in the summer.\""},"skillIds":["u8.grammar"],"type":"wordBank","vocabularyIds":["u8.rainy","u8.summer"]},{"content":{"maxChars":200,"placeholder":"Viết bằng tiếng Anh"},"explanation":"Đáp án: \"It is rainy on Sunday.\". Cũng đúng: \"It's rainy on Sunday.\".","gradingRule":{"acceptedText":["It is rainy on Sunday.","It's rainy on Sunday."],"caseSensitive":false,"ignoreDiacritics":false,"ignorePunctuation":true},"hint":"\"Sunday\" = Chủ nhật; \"rainy\" = mưa","id":"u8n7l1-e15","prompt":{"locale":"vi-VN","text":"Chủ nhật trời mưa."},"skillIds":["u8.grammar"],"type":"textTranslation","vocabularyIds":["u5.sunday","u8.rainy"]}],"gradingRulesVersion":"g1","guideText":"Mẫu câu chính: \"How is the weather today?\" (Thời tiết hôm nay thế nào?) — \"It is sunny.\" (Trời nắng.) — \"It is raining.\" (Trời đang mưa.)\nChủ ngữ giả \"it\": tiếng Việt nói \"trời nắng\", tiếng Anh phải có chủ ngữ: \"It is sunny\", không nói \"Is sunny\".\nThì hiện tại tiếp diễn cho việc đang xảy ra: It is raining now. So sánh: It is rainy (trời có mưa — mô tả chung).\nMùa: in (the) summer, in winter. Miền Nam Việt Nam có hai mùa: the dry season (mùa khô) và the rainy season (mùa mưa).\n\"Fall\" là cách Mỹ gọi mùa thu; \"autumn\" dùng ở Anh — cả hai đều đúng.","lessonId":"u8n7l1","lessonVersion":"v2.u8n7l1","manifestHash":"013672aa5927648264926e14d514d9d670ba04f547fc10aba6d50095b8e8b587","nodeId":"u8n7","order":62,"rewardIdentity":"v2.u8n7l1","schemaVersion":1,"sectionId":"sec1","signature":"ojxHVxNLGgI633yUZghTbKaEsTxQErOTMYh9OalGjb6ypeerF9t2oAar-GHDXBS_WvI8nH4NxRIp76C9fmrZBw","signatureKeyId":"dev-content-1","skillIds":["u8.grammar","listening","speaking","u8.dialogue","reading","u8.story","u8.vocab"],"title":"Ôn tập cửa ải · Bài 1","unitId":"u8"}