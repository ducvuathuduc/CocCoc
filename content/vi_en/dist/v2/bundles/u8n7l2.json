"locale":"vi-VN","text":"\"mưa\" trong tiếng Anh là gì?"},"skillIds":["u8.vocab"],"type":"choice","vocabularyIds":["u8.rainy"]},{"content":{"locale":"en-US","maxSeconds":7,"referenceText":"Autumn is cool and beautiful."},"explanation":"Câu mẫu: \"Autumn is cool and beautiful.\".","gradingRule":{"acceptedText":["Autumn is cool and beautiful.","Fall is cool and beautiful."],"caseSensitive":false,"ignoreDiacritics":false,"ignorePunctuation":true},"hint":"Nghĩa: \"Mùa thu mát mẻ và đẹp.\"","id":"u8n7l2-e13","nonSpeechAlternative":{"content":{"tokens":[{"id":"t1","text":"is"},{"id":"t2","text":"Autumn"},{"id":"t3","text":"cool"},{"id":"t4","text":"and"},{"id":"t5","text":"beautiful"}]},"explanation":"Câu đúng: \"Autumn is cool and beautiful.\".","gradingRule":{"caseSensitive":false,"correctTokenIds":["t2","t1","t3","t4","t5"],"ignoreDiacritics":false,"ignorePunctuation":false},"hint":"Câu bắt đầu bằng \"Autumn\".","id":"u8n7l2-e13a","prompt":{"locale":"vi-VN","text":"Sắp xếp thành câu đúng: \"Mùa thu mát mẻ và đẹp.\""},"skillIds":["speaking","u8.grammar"],"type":"sentenceOrder","vocabularyIds":["u8.cool","u8.autumn","u8.beautiful"]},"prompt":{"audioAssetId":"a.u8.s20.n","locale":"en-US","text":"Nói câu sau: \"Autumn is cool and beautiful.\""},"skillIds":["speaking","u8.grammar"],"type":"speakRepeat","vocabularyIds":["u8.cool","u8.autumn","u8.beautiful"]},{"content":{"tokens":[{"id":"t1","text":"nhiều"},{"id":"t2","text":"ăn"},{"id":"t3","text":"ngoài"},{"id":"t4","text":"Chúng"},{"id":"t5","text":"trưa"},{"id":"t6","text":"Phòng"},{"id":"t7","text":"nóng"},{"id":"t8","text":"bên"},{"id":"t9","text":"Câu"},{"id":"t10","text":"ở"},{"id":"t11","text":"tôi"}]},"explanation":"Câu đúng: \"Chúng tôi ăn trưa ở bên ngoài.\".","gradingRule":{"caseSensitive":false,"correctTokenIds":["t4","t11","t2","t5","t10","t8","t3"],"ignoreDiacritics":false,"ignorePunctuation":false},"hint":"\"eat\" = ăn; \"lunch\" = bữa trưa; \"outside\" = bên ngoài","id":"u8n7l2-e14","prompt":{"locale":"vi-VN","text":"Dịch sang tiếng Việt: \"We eat lunch outside.\""},"skillIds":["u8.grammar"],"type":"wordBank","vocabularyIds":["u3.eat","u3.lunch","u8.outside"]},{"content":{"maxChars":200,"placeholder":"Viết bằng tiếng Anh"},"explanation":"Đáp án: \"Canada is beautiful in autumn.\". Cũng đúng: \"Canada is beautiful in the fall.\".","gradingRule":{"acceptedText":["Canada is beautiful in autumn.","Canada is beautiful in the fall."],"caseSensitive":false,"ignoreDiacritics":false,"ignorePunctuation":true},"hint":"\"Canada\" = Canada; \"autumn\" = mùa thu; \"beautiful\" = đẹp","id":"u8n7l2-e15","prompt":{"locale":"vi-VN","text":"Canada rất đẹp vào mùa thu."},"skillIds":["u8.grammar"],"type":"textTranslation","vocabularyIds":["u1.canada","u8.autumn","u8.beautiful"]}],"gradingRulesVersion":"g1","guideText":"Mẫu câu chính: \"How is the weather today?\" (Thời tiết hôm nay thế nào?) — \"It is sunny.\" (Trời nắng.) — \"It is raining.\" (Trời đang mưa.)\nChủ ngữ giả \"it\": tiếng Việt nói \"trời nắng\", tiếng Anh phải có chủ ngữ: \"It is sunny\", không nói \"Is sunny\".\nThì hiện tại tiếp diễn cho việc đang xảy ra: It is raining now. So sánh: It is rainy (trời có mưa — mô tả chung).\nMùa: in (the) summer, in winter. Miền Nam Việt Nam có hai mùa: the dry season (mùa khô) và the rainy season (mùa mưa).\n\"Fall\" là cách Mỹ gọi mùa thu; \"autumn\" dùng ở Anh — cả hai đều đúng.","lessonId":"u8n7l2","lessonVersion":"v2.u8n7l2","manifestHash":"013672aa5927648264926e14d514d9d670ba04f547fc10aba6d50095b8e8b587","nodeId":"u8n7","order":62,"rewardIdentity":"v2.u8n7l2","schemaVersion":1,"sectionId":"sec1","signature":"4qBzIfN64QQbJgoxke33wqNxIzjkDLv2UTOjOXpXwpKfAyq53HjhqN4TgxrjV9emUVlEzkIrGOZh7pzBp_r0CQ","signatureKeyId":"dev-content-1","skillIds":["u8.grammar","listening","speaking","u8.dialogue","reading","u8.story","u8.vocab"],"title":"Ôn tập cửa ải · Bài 2","unitId":"u8"}