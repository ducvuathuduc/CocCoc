t tốt bụng.","Bà của tôi rất tốt bụng.","Bà tôi rất dễ thương.","Bà mình rất tốt bụng.","Bà của mình rất tốt bụng.","Bà mình rất dễ thương."],"caseSensitive":false,"ignoreDiacritics":false,"ignorePunctuation":true},"hint":"\"nice\" = dễ thương; \"grandmother\" = bà","id":"u2n3l4-e12","prompt":{"locale":"en-US","text":"My grandmother is nice."},"skillIds":["u2.grammar"],"type":"textTranslation","vocabularyIds":["u1.nice","u2.grandmother"]}],"gradingRulesVersion":"g1","guideText":"Mẫu câu chính: \"This is my mother.\" (Đây là mẹ tôi.) — \"I have a brother.\" (Tôi có một anh/em trai.)\nTính từ sở hữu: my (của tôi), your (của bạn), his (của anh ấy), her (của cô ấy), their (của họ). Đặt TRƯỚC danh từ: \"my father\", không nói \"father my\".\nĐộng từ \"have\": I/you/we/they have — he/she has. \"Mai has a cat.\"\nLưu ý: tiếng Anh không phân biệt anh/em: \"brother\" = anh trai hoặc em trai, \"sister\" = chị gái hoặc em gái. \"Aunt/uncle\" gồm cả cô, dì, chú, cậu, bác.","lessonId":"u2n3l4","lessonVersion":"v2.u2n3l4","manifestHash":"013672aa5927648264926e14d514d9d670ba04f547fc10aba6d50095b8e8b587","nodeId":"u2n3","order":10,"rewardIdentity":"v2.u2n3l4","schemaVersion":1,"sectionId":"sec1","signature":"1UVbBKcMh2VylpqgydMOYDuo9wBfeU30lWT9-Fu5S9uW1AQKoILBxQOnZgfO02u8PmZ5W89ls-7MKpiydz6-Bw","signatureKeyId":"dev-content-1","skillIds":["speaking","u2.grammar","u2.dialogue","u2.vocab"],"title":"Vợ chồng, con cái · Bài 4","unitId":"u2"}