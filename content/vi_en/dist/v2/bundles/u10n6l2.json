N","text":"Có xa không?"},"skillIds":["listening","u10.grammar"],"type":"textTranslation","vocabularyIds":["u10.far"]},"prompt":{"audioAssetId":"a.u10.s25.n","locale":"vi-VN","text":"Nghe và viết lại bằng tiếng Anh"},"skillIds":["listening","u10.grammar"],"type":"dictation","vocabularyIds":["u10.far"]},{"content":{"tokens":[{"id":"t1","text":"new"},{"id":"t2","text":"This"},{"id":"t3","text":"small"},{"id":"t4","text":"building"},{"id":"t5","text":"is"},{"id":"t6","text":"bridge"},{"id":"t7","text":"not"}]},"explanation":"Câu đúng: \"This building is new.\".","gradingRule":{"caseSensitive":false,"correctTokenIds":["t2","t4","t5","t1"],"ignoreDiacritics":false,"ignorePunctuation":false},"hint":"\"new\" = mới; \"building\" = tòa nhà","id":"u10n6l2-e11","prompt":{"locale":"vi-VN","text":"Dịch câu này: \"Tòa nhà này mới.\""},"skillIds":["u10.grammar"],"type":"wordBank","vocabularyIds":["u6.new","u10.building"]},{"content":{"maxChars":200,"placeholder":"Viết bằng tiếng Anh"},"explanation":"Đáp án: \"I love this city.\".","gradingRule":{"acceptedText":["I love this city."],"caseSensitive":false,"ignoreDiacritics":false,"ignorePunctuation":true},"hint":"\"love\" = yêu; \"city\" = thành phố","id":"u10n6l2-e12","prompt":{"locale":"vi-VN","text":"Tôi yêu thành phố này."},"skillIds":["u10.grammar"],"type":"textTranslation","vocabularyIds":["u2.love","u10.city"]}],"gradingRulesVersion":"g1","guideText":"Mẫu câu chính: \"Excuse me, where is the bank?\" (Xin lỗi, ngân hàng ở đâu?) — \"Go straight and turn left.\" (Đi thẳng rồi rẽ trái.) — \"Is it far?\" (Có xa không?)\nChỉ đường dùng câu mệnh lệnh: Go straight. Turn right. Turn left at the corner.\nVị trí: on the left / on the right (bên trái / bên phải), next to (bên cạnh), opposite (đối diện), near (gần), on the corner (ở góc đường).\n\"Near\" không cần \"to\": \"near the school\" (không nói \"near to the school\" trong văn nói chuẩn A2).\nHỏi khoảng cách: \"Is it far from here?\" — Trả lời: \"No, you can walk.\" (Không, bạn có thể đi bộ.)","lessonId":"u10n6l2","lessonVersion":"v2.u10n6l2","manifestHash":"013672aa5927648264926e14d514d9d670ba04f547fc10aba6d50095b8e8b587","nodeId":"u10n6","order":77,"rewardIdentity":"v2.u10n6l2","schemaVersion":1,"sectionId":"sec2","signature":"cbdgxv4T0We3d3f_8_VFM3qLd3plqmrFo9dyqH5z4KDuxENpORDVBZvcsH1RwZBdID1hC7nrReNCFJc7cJBgDw","signatureKeyId":"dev-content-1","skillIds":["u10.vocab","u10.grammar","listening"],"title":"Tôi bị lạc! · Bài 2","unitId":"u10"}