radingRule":{"acceptedText":["It is eight o'clock now.","It's eight o'clock now."],"caseSensitive":false,"ignoreDiacritics":false,"ignorePunctuation":true},"hint":"Nghĩa: \"Bây giờ là tám giờ.\"","id":"u5n2l4-e11","nonSpeechAlternative":{"content":{"tokens":[{"id":"t1","text":"It"},{"id":"t2","text":"o'clock"},{"id":"t3","text":"now"},{"id":"t4","text":"eight"},{"id":"t5","text":"is"}]},"explanation":"Câu đúng: \"It is eight o'clock now.\".","gradingRule":{"caseSensitive":false,"correctTokenIds":["t1","t5","t4","t2","t3"],"ignoreDiacritics":false,"ignorePunctuation":false},"hint":"Câu bắt đầu bằng \"It\".","id":"u5n2l4-e11a","prompt":{"locale":"vi-VN","text":"Sắp xếp thành câu đúng: \"Bây giờ là tám giờ.\""},"skillIds":["speaking","u5.grammar"],"type":"sentenceOrder","vocabularyIds":["u4.eight","u5.oclock","u5.now"]},"prompt":{"audioAssetId":"a.u5.s3.n","locale":"en-US","text":"Nói câu sau: \"It is eight o'clock now.\""},"skillIds":["speaking","u5.grammar"],"type":"speakRepeat","vocabularyIds":["u4.eight","u5.oclock","u5.now"]},{"content":{"maxChars":200,"placeholder":"Viết bằng tiếng Việt (có dấu)"},"explanation":"Đáp án: \"Chúc một ngày tốt lành!\". Cũng đúng: \"Chúc bạn một ngày tốt lành!\".","gradingRule":{"acceptedText":["Chúc một ngày tốt lành!","Chúc bạn một ngày tốt lành!"],"caseSensitive":false,"ignoreDiacritics":false,"ignorePunctuation":true},"hint":"\"nice\" = dễ thương; \"have\" = có; \"day\" = ngày","id":"u5n2l4-e12","prompt":{"locale":"en-US","text":"Have a nice day!"},"skillIds":["u5.grammar"],"type":"textTranslation","vocabularyIds":["u1.nice","u2.have","u5.day"]}],"gradingRulesVersion":"g1","guideText":"Mẫu câu chính: \"What time is it?\" (Mấy giờ rồi?) — \"It is seven o'clock.\" (Bảy giờ rồi.) — \"I get up at six.\" (Tôi dậy lúc sáu giờ.)\nGiới từ thời gian: at + giờ (at six o'clock), on + thứ (on Monday), in + buổi (in the morning, in the evening).\nThì hiện tại đơn cho thói quen: \"Mai goes to school every day.\" Với he/she/it: go → goes, get up → gets up.\nTrạng từ tần suất đứng TRƯỚC động từ thường: \"I always eat breakfast\", \"Kiko never eats bread\". Thứ tự: always > usually > sometimes > never.\nThứ trong tuần luôn viết hoa: Monday, Sunday.","lessonId":"u5n2l4","lessonVersion":"v2.u5n2l4","manifestHash":"013672aa5927648264926e14d514d9d670ba04f547fc10aba6d50095b8e8b587","nodeId":"u5n2","order":33,"rewardIdentity":"v2.u5n2l4","schemaVersion":1,"sectionId":"sec1","signature":"MPHDWpr9dVzLD0ply9XNNOodJ8nWb21NtxXD1GjKX2qKtqlcHfHGpakTtAylI8vZOB6k3QDWVOfyUJio1LpyDQ","signatureKeyId":"dev-content-1","skillIds":["speaking","u5.grammar","u5.dialogue","u5.vocab"],"title":"Đi học, về nhà · Bài 4","unitId":"u5"}