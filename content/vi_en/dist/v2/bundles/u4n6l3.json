4n6l3","lessonVersion":"v2.u4n6l3","manifestHash":"013672aa5927648264926e14d514d9d670ba04f547fc10aba6d50095b8e8b587","nodeId":"u4n6","order":29,"rewardIdentity":"v2.u4n6l3","schemaVersion":1,"sectionId":"sec1","signature":"TkTUzFsgwOrEn8MIp5cIC_ab6uHxrh67lwlKK0cyUyv6Kn1vxOcIdbC08Htc7TurPqNt9jq9rASPXo4fkeRbDw","signatureKeyId":"dev-content-1","skillIds":["listening","u4.grammar","u4.vocab"],"title":"Bao nhiêu? · Bài 3","unitId":"u4"}