s":false,"ignorePunctuation":false},"hint":"Thử thách Huyền thoại: dùng gợi ý sẽ tính là có trợ giúp. Câu có nghĩa: \"Hôm nay tôi rất bận.\"","id":"u12n8l2-e13a","prompt":{"locale":"vi-VN","text":"Chọn câu tiếng Anh có nghĩa: \"Hôm nay tôi rất bận.\""},"skillIds":["listening","u12.grammar"],"type":"choice","vocabularyIds":["u5.today","u12.busy"]},"prompt":{"audioAssetId":"a.u12.s17.n","locale":"vi-VN","text":"Nghe và chọn câu bạn nghe được"},"skillIds":["listening","u12.grammar"],"type":"listenChoice","vocabularyIds":["u5.today","u12.busy"]},{"content":{"maxChars":40,"placeholder":"Điền từ còn thiếu"},"explanation":"Từ đúng: \"father\" → Tom's father is an engineer.","gradingRule":{"acceptedText":["father"],"caseSensitive":false,"ignoreDiacritics":false,"ignorePunctuation":true},"hint":"Thử thách Huyền thoại: dùng gợi ý sẽ tính là có trợ giúp. \"bố\" trong tiếng Anh là \"f...\"","id":"u12n8l2-e14","prompt":{"locale":"en-US","text":"Tom's ___ is an engineer. — \"Bố của Tom là kỹ sư.\""},"skillIds":["u12.grammar"],"type":"fillBlank","vocabularyIds":["u2.father","u12.engineer"]},{"content":{"maxChars":200,"placeholder":"Viết bằng tiếng Anh"},"explanation":"Đáp án: \"I write many emails every day.\".","gradingRule":{"acceptedText":["I write many emails every day."],"caseSensitive":false,"ignoreDiacritics":false,"ignorePunctuation":true},"hint":"Thử thách Huyền thoại: dùng gợi ý sẽ tính là có trợ giúp. \"many\" = nhiều; \"day\" = ngày; \"every\" = mỗi; \"write\" = viết","id":"u12n8l2-e15","prompt":{"locale":"vi-VN","text":"Tôi viết nhiều email mỗi ngày."},"skillIds":["u12.grammar"],"type":"textTranslation","vocabularyIds":["u4.many","u5.day","u5.every","u7.write","u12.email"]}],"gradingRulesVersion":"g1","guideText":"Mẫu câu chính: \"What do you do?\" (Bạn làm nghề gì?) — \"I am an engineer.\" (Tôi là kỹ sư.) — \"I worked late yesterday.\" (Hôm qua tôi làm việc muộn.)\nNghề nghiệp luôn có a/an: \"She is a nurse\", \"He is an engineer\" (an trước nguyên âm).\nThì quá khứ đơn (động từ có quy tắc): thêm -ed: work → worked, start → started, finish → finished. Quá khứ của \"be\": I/he/she was, you/we/they were.\nCâu hỏi quá khứ dùng \"did\" + động từ nguyên mẫu: \"Did you finish your work?\" (không nói \"Did you finished\").\nMốc thời gian quá khứ: yesterday (hôm qua), last week (tuần trước).","lessonId":"u12n8l2","lessonVersion":"v2.u12n8l2","manifestHash":"013672aa5927648264926e14d514d9d670ba04f547fc10aba6d50095b8e8b587","nodeId":"u12n8","order":95,"rewardIdentity":"v2.u12n8l2","schemaVersion":1,"sectionId":"sec2","signature":"OEtquaTtIn0uFNNXv3MfHc6YhFsrgg2XQSCIeTmr_gLoZji91xtWYJIexh8uj8RgIwmiiFMMRi42m8k9BZTnBw","signatureKeyId":"dev-content-1","skillIds":["u12.grammar","listening","speaking","u12.dialogue"],"title":"Huyền thoại · Bài 2","unitId":"u12"}