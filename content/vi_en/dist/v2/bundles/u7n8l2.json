cceptedText":["answer"],"caseSensitive":false,"ignoreDiacritics":false,"ignorePunctuation":true},"hint":"Thử thách Huyền thoại: dùng gợi ý sẽ tính là có trợ giúp. \"câu trả lời\" trong tiếng Anh là \"a...\"","id":"u7n8l2-e14","prompt":{"locale":"en-US","text":"What is the ___? — \"Câu trả lời là gì?\""},"skillIds":["u7.grammar"],"type":"fillBlank","vocabularyIds":["u7.answer"]},{"content":{"maxChars":200,"placeholder":"Viết bằng tiếng Anh"},"explanation":"Đáp án: \"Bye, Tom!\". Cũng đúng: \"Goodbye, Tom!\".","gradingRule":{"acceptedText":["Bye, Tom!","Goodbye, Tom!"],"caseSensitive":false,"ignoreDiacritics":false,"ignorePunctuation":true},"hint":"Thử thách Huyền thoại: dùng gợi ý sẽ tính là có trợ giúp. \"goodbye\" = tạm biệt","id":"u7n8l2-e15","prompt":{"locale":"vi-VN","text":"Tạm biệt, Tom!"},"skillIds":["u7.grammar"],"type":"textTranslation","vocabularyIds":["u1.goodbye"]}],"gradingRulesVersion":"g1","guideText":"Mẫu câu chính: \"Can you help me?\" (Bạn có thể giúp tôi không?) — \"I do not understand.\" (Tôi không hiểu.) — \"Please open your books.\" (Hãy mở sách ra.)\n\"Can\" + động từ nguyên mẫu (không thêm -s, không \"to\"): \"She can speak English\", không nói \"She cans speaks\".\nCâu mệnh lệnh: bắt đầu bằng động từ: \"Open the window.\" Thêm \"please\" cho lịch sự.\nCâu hỏi \"What does this word mean?\" — dùng khi gặp từ mới. Trả lời: \"It means ...\".\nHọc sinh Việt hay nhầm: \"learn\" (học, tiếp thu) và \"study\" (học bài, nghiên cứu) — cả hai đều dịch là \"học\".","lessonId":"u7n8l2","lessonVersion":"v2.u7n8l2","manifestHash":"013672aa5927648264926e14d514d9d670ba04f547fc10aba6d50095b8e8b587","nodeId":"u7n8","order":55,"rewardIdentity":"v2.u7n8l2","schemaVersion":1,"sectionId":"sec1","signature":"3xPxTgi6CQXk1rd0C8aqG3TkbnGtWdqX-YepcdYyPj7okV3xjeeOg_o3EKtNswt9JrDLtgOEnLiimo2dSlEEAQ","signatureKeyId":"dev-content-1","skillIds":["u7.grammar","listening","speaking","u7.dialogue"],"title":"Huyền thoại · Bài 2","unitId":"u7"}