:false},"hint":"\"name\" = tên; \"street\" = đường","id":"u10n2l5-e11","prompt":{"locale":"vi-VN","text":"Dịch câu này: \"Con đường này tên là gì?\""},"skillIds":["u10.grammar"],"type":"wordBank","vocabularyIds":["u1.name","u10.street"]},{"content":{"maxChars":200,"placeholder":"Viết bằng tiếng Anh"},"explanation":"Đáp án: \"My house is on the left.\".","gradingRule":{"acceptedText":["My house is on the left."],"caseSensitive":false,"ignoreDiacritics":false,"ignorePunctuation":true},"hint":"\"house\" = ngôi nhà; \"left\" = bên trái","id":"u10n2l5-e12","prompt":{"locale":"vi-VN","text":"Nhà tôi ở bên trái."},"skillIds":["u10.grammar"],"type":"textTranslation","vocabularyIds":["u6.house","u10.left"]}],"gradingRulesVersion":"g1","guideText":"Mẫu câu chính: \"Excuse me, where is the bank?\" (Xin lỗi, ngân hàng ở đâu?) — \"Go straight and turn left.\" (Đi thẳng rồi rẽ trái.) — \"Is it far?\" (Có xa không?)\nChỉ đường dùng câu mệnh lệnh: Go straight. Turn right. Turn left at the corner.\nVị trí: on the left / on the right (bên trái / bên phải), next to (bên cạnh), opposite (đối diện), near (gần), on the corner (ở góc đường).\n\"Near\" không cần \"to\": \"near the school\" (không nói \"near to the school\" trong văn nói chuẩn A2).\nHỏi khoảng cách: \"Is it far from here?\" — Trả lời: \"No, you can walk.\" (Không, bạn có thể đi bộ.)","lessonId":"u10n2l5","lessonVersion":"v2.u10n2l5","manifestHash":"013672aa5927648264926e14d514d9d670ba04f547fc10aba6d50095b8e8b587","nodeId":"u10n2","order":73,"rewardIdentity":"v2.u10n2l5","schemaVersion":1,"sectionId":"sec2","signature":"k3uzluYzi2NQHGdYjSLSg8gZF_3jDzCEvBmXOeOvyGanA54URjo5p1hzzAYXhQyaLijUkrmtEyFgQPi1HqgbBw","signatureKeyId":"dev-content-1","skillIds":["u10.vocab","u10.grammar","listening"],"title":"Rẽ ở ngân hàng · Bài 5","unitId":"u10"}