Mr. Long!\".","gradingRule":{"acceptedText":["Good morning, Mr. Long!"],"caseSensitive":false,"ignoreDiacritics":false,"ignorePunctuation":true},"hint":"\"good\" = tốt; \"morning\" = buổi sáng","id":"u1n5l2-e10a","prompt":{"locale":"vi-VN","text":"Chào buổi sáng, thầy Long!"},"skillIds":["listening","u1.grammar"],"type":"textTranslation","vocabularyIds":["u1.good","u1.morning"]},"prompt":{"audioAssetId":"a.u1.s21.n","locale":"vi-VN","text":"Nghe và viết lại bằng tiếng Anh"},"skillIds":["listening","u1.grammar"],"type":"dictation","vocabularyIds":["u1.good","u1.morning"]},{"content":{"tokens":[{"id":"t1","text":"me"},{"id":"t2","text":"Excuse"},{"id":"t3","text":"are"},{"id":"t4","text":"is"},{"id":"t5","text":"you"},{"id":"t6","text":"Tom"},{"id":"t7","text":"Anna"},{"id":"t8","text":"name"}]},"explanation":"Câu đúng: \"Excuse me, are you Tom?\".","gradingRule":{"caseSensitive":false,"correctTokenIds":["t2","t1","t3","t5","t6"],"ignoreDiacritics":false,"ignorePunctuation":false},"hint":"\"excuse me\" = xin lỗi (bắt chuyện)","id":"u1n5l2-e11","prompt":{"locale":"vi-VN","text":"Dịch câu này: \"Xin lỗi, bạn có phải là Tom không?\""},"skillIds":["u1.grammar"],"type":"wordBank","vocabularyIds":["u1.excuse_me"]},{"content":{"maxChars":200,"placeholder":"Viết bằng tiếng Anh"},"explanation":"Đáp án: \"Bye, Tom!\". Cũng đúng: \"Goodbye, Tom!\".","gradingRule":{"acceptedText":["Bye, Tom!","Goodbye, Tom!"],"caseSensitive":false,"ignoreDiacritics":false,"ignorePunctuation":true},"hint":"\"goodbye\" = tạm biệt","id":"u1n5l2-e12","prompt":{"locale":"vi-VN","text":"Tạm biệt, Tom!"},"skillIds":["u1.grammar"],"type":"textTranslation","vocabularyIds":["u1.goodbye"]}],"gradingRulesVersion":"g1","guideText":"Mẫu câu chính: \"Hello, I am Mai.\" (Xin chào, tôi là Mai.) — \"What is your name?\" (Bạn tên là gì?) — \"Nice to meet you.\" (Rất vui được gặp bạn.)\nNgữ pháp: động từ \"to be\": I am, you are, he/she is. Khi nói, người bản xứ hay rút gọn: I'm, you're, he's, she's. Cả hai cách viết đều được chấp nhận.\nMẹo: \"I\" luôn viết hoa. Dùng \"a\" trước nghề nghiệp: \"I am a student.\" Tiếng Việt có thể bỏ \"một\", tiếng Anh thì không.\nLịch sự: \"Excuse me\" dùng để bắt chuyện, \"Sorry\" dùng khi xin lỗi vì lỗi của mình.","lessonId":"u1n5l2","lessonVersion":"v2.u1n5l2","manifestHash":"013672aa5927648264926e14d514d9d670ba04f547fc10aba6d50095b8e8b587","nodeId":"u1n5","order":4,"rewardIdentity":"v2.u1n5l2","schemaVersion":1,"sectionId":"sec1","signature":"QlXue6zNeEpPNtzJazqG1Beo1zL2eSWeYXVZQFLc2426fdb5ZBWhH9hjfbnmnF1oMJUXgCKW5iR18Rk2IaLqAw","signatureKeyId":"dev-content-1","skillIds":["u1.vocab","u1.grammar","listening"],"title":"Rất vui được gặp bạn · Bài 2","unitId":"u1"}