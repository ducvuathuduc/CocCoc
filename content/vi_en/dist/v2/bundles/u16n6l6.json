ocabularyIds":["u5.sunday","u13.movie","u16.saw"]},{"content":{"maxChars":200,"placeholder":"Viết bằng tiếng Việt (có dấu)"},"explanation":"Đáp án: \"Hẹn sớm gặp lại!\". Cũng đúng: \"Hẹn gặp lại sớm nhé!\", \"Sớm gặp lại nhé!\".","gradingRule":{"acceptedText":["Hẹn sớm gặp lại!","Hẹn gặp lại sớm nhé!","Sớm gặp lại nhé!"],"caseSensitive":false,"ignoreDiacritics":false,"ignorePunctuation":true},"hint":"\"soon\" = sớm","id":"u16n6l6-e12","prompt":{"locale":"en-US","text":"See you soon!"},"skillIds":["u16.grammar"],"type":"textTranslation","vocabularyIds":["u16.soon"]}],"gradingRulesVersion":"g1","guideText":"Mẫu câu chính: \"What will you do this weekend?\" (Cuối tuần này bạn sẽ làm gì?) — \"I went to the museum.\" (Tôi đã đi bảo tàng.) — \"That is a good idea!\" (Ý hay đấy!)\nTương lai: will + động từ nguyên mẫu: \"I will call you.\" Rút gọn: I'll, you'll, we'll. Phủ định: will not = won't.\nQuá khứ bất quy tắc phải học thuộc: go → went, see → saw, eat → ate, buy → bought, forget → forgot.\n\"Maybe\" (có lẽ) đứng đầu câu: \"Maybe it will rain tomorrow.\"\nRủ rê: \"Let's ...\" (Chúng ta hãy ... nhé): \"Let's have a picnic.\"","lessonId":"u16n6l6","lessonVersion":"v2.u16n6l6","manifestHash":"013672aa5927648264926e14d514d9d670ba04f547fc10aba6d50095b8e8b587","nodeId":"u16n6","order":125,"rewardIdentity":"v2.u16n6l6","schemaVersion":1,"sectionId":"sec2","signature":"LvvEqAsqukBnoKi3PWFcE4o_1svBKdRU-q_5ZHppq5PHhE1wAz1hkbitpW1BQpCpuTFk0Xnbr94ytpggKd3eBQ","signatureKeyId":"dev-content-1","skillIds":["speaking","u16.grammar","u16.dialogue","u16.vocab"],"title":"Ước mơ của tôi · Bài 6","unitId":"u16"}