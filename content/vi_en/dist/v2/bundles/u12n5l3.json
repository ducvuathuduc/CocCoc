orePunctuation":true},"hint":"\"now\" = bây giờ; \"busy\" = bận","id":"u12n5l3-e12a","prompt":{"locale":"vi-VN","text":"Bây giờ bạn có bận không?"},"skillIds":["listening","u12.grammar"],"type":"textTranslation","vocabularyIds":["u5.now","u12.busy"]},"prompt":{"audioAssetId":"a.u12.s15.n","locale":"vi-VN","text":"Nghe và viết lại bằng tiếng Anh"},"skillIds":["listening","u12.grammar"],"type":"dictation","vocabularyIds":["u5.now","u12.busy"]}],"gradingRulesVersion":"g1","guideText":"Mẫu câu chính: \"What do you do?\" (Bạn làm nghề gì?) — \"I am an engineer.\" (Tôi là kỹ sư.) — \"I worked late yesterday.\" (Hôm qua tôi làm việc muộn.)\nNghề nghiệp luôn có a/an: \"She is a nurse\", \"He is an engineer\" (an trước nguyên âm).\nThì quá khứ đơn (động từ có quy tắc): thêm -ed: work → worked, start → started, finish → finished. Quá khứ của \"be\": I/he/she was, you/we/they were.\nCâu hỏi quá khứ dùng \"did\" + động từ nguyên mẫu: \"Did you finish your work?\" (không nói \"Did you finished\").\nMốc thời gian quá khứ: yesterday (hôm qua), last week (tuần trước).","lessonId":"u12n5l3","lessonVersion":"v2.u12n5l3","manifestHash":"013672aa5927648264926e14d514d9d670ba04f547fc10aba6d50095b8e8b587","nodeId":"u12n5","order":92,"rewardIdentity":"v2.u12n5l3","schemaVersion":1,"sectionId":"sec2","signature":"ivbYvHa4hp-TBN2GUT9ZSi1BzjGRoRx-A1y4SX_koom42jQNa_RddjpZWtUDGxPRSQSXW1vR4c4xaMPqo_c2CQ","signatureKeyId":"dev-content-1","skillIds":["listening","u12.grammar","u12.vocab"],"title":"Email và phỏng vấn · Bài 3","unitId":"u12"}