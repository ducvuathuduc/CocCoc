s":40,"placeholder":"Điền từ còn thiếu"},"explanation":"Từ đúng: \"shirt\" → Is this shirt cheap?","gradingRule":{"acceptedText":["shirt"],"caseSensitive":false,"ignoreDiacritics":false,"ignorePunctuation":true},"hint":"\"áo sơ mi\" trong tiếng Anh là \"s...\"","id":"u9n2l1-e11","prompt":{"locale":"en-US","text":"Is this ___ cheap? — \"Áo sơ mi này có rẻ không?\""},"skillIds":["u9.grammar"],"type":"fillBlank","vocabularyIds":["u9.shirt","u9.cheap"]},{"content":{"maxChars":200,"placeholder":"Viết bằng tiếng Anh"},"explanation":"Đáp án: \"The shoes are cheap, but the shirt is expensive.\".","gradingRule":{"acceptedText":["The shoes are cheap, but the shirt is expensive."],"caseSensitive":false,"ignoreDiacritics":false,"ignorePunctuation":true},"hint":"\"cheap\" = rẻ; \"expensive\" = đắt; \"shirt\" = áo sơ mi; \"shoes\" = giày","id":"u9n2l1-e12","prompt":{"locale":"vi-VN","text":"Giày thì rẻ, nhưng áo sơ mi thì đắt."},"skillIds":["u9.grammar"],"type":"textTranslation","vocabularyIds":["u9.cheap","u9.expensive","u9.shirt","u9.shoes"]},{"content":{"tokens":[{"id":"t1","text":"not"},{"id":"t2","text":"autumn"},{"id":"t3","text":"study"},{"id":"t4","text":"money"},{"id":"t5","text":"have"},{"id":"t6","text":"His"},{"id":"t7","text":"I"},{"id":"t8","text":"do"}]},"explanation":"Câu đúng: \"I do not have money.\".","gradingRule":{"caseSensitive":false,"correctTokenIds":["t7","t8","t1","t5","t4"],"ignoreDiacritics":false,"ignorePunctuation":false},"hint":"\"have\" = có; \"money\" = tiền","id":"u9n2l1-e13","prompt":{"locale":"vi-VN","text":"Dịch câu này: \"Tôi không có tiền.\""},"skillIds":["u9.grammar"],"type":"wordBank","vocabularyIds":["u2.have","u9.money"]}],"gradingRulesVersion":"g1","guideText":"Mẫu câu chính: \"How much is this dress?\" (Cái váy này bao nhiêu tiền?) — \"Can I pay by card?\" (Tôi trả bằng thẻ được không?) — \"It is on sale.\" (Nó đang giảm giá.)\nHow much is + số ít / How much are + số nhiều: \"How much are the shoes?\"\n\"Shoes\" luôn ở dạng số nhiều (một đôi giày = a pair of shoes).\nMàu sắc đứng trước danh từ: \"a red dress\" (một cái váy đỏ). Hỏi màu: \"What color is it?\"\nTrả tiền: pay in cash (tiền mặt) / pay by card (bằng thẻ). \"Expensive\" (đắt) ↔ \"cheap\" (rẻ).","lessonId":"u9n2l1","lessonVersion":"v2.u9n2l1","manifestHash":"013672aa5927648264926e14d514d9d670ba04f547fc10aba6d50095b8e8b587","nodeId":"u9n2","order":65,"rewardIdentity":"v2.u9n2l1","schemaVersion":1,"sectionId":"sec2","signature":"IGhzZc6HbuP8_qcnYpiLWFIzjmAHWVs_ePYHn37g5F3XkorcWZV9r7TKNPWLW2cEyf8Ui5TrHte1Lo0tqMK4Cw","signatureKeyId":"dev-content-1","skillIds":["u9.vocab","u9.grammar","listening"],"title":"Áo, giày, váy · Bài 1","unitId":"u9"}