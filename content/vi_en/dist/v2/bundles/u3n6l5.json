hint":"\"rice\" = cơm; \"delicious\" = ngon","id":"u3n6l5-e10a","prompt":{"locale":"vi-VN","text":"Cơm này rất ngon."},"skillIds":["listening","u3.grammar"],"type":"textTranslation","vocabularyIds":["u3.rice","u3.delicious"]},"prompt":{"audioAssetId":"a.u3.s31.n","locale":"vi-VN","text":"Nghe và viết lại bằng tiếng Anh"},"skillIds":["listening","u3.grammar"],"type":"dictation","vocabularyIds":["u3.rice","u3.delicious"]},{"content":{"tokens":[{"id":"t1","text":"drink"},{"id":"t2","text":"name"},{"id":"t3","text":"Goodbye"},{"id":"t4","text":"like"},{"id":"t5","text":"tea"},{"id":"t6","text":"I"}]},"explanation":"Câu đúng: \"I like tea.\".","gradingRule":{"caseSensitive":false,"correctTokenIds":["t6","t4","t5"],"ignoreDiacritics":false,"ignorePunctuation":false},"hint":"\"tea\" = trà; \"like\" = thích","id":"u3n6l5-e11","prompt":{"locale":"vi-VN","text":"Dịch câu này: \"Tôi thích trà.\""},"skillIds":["u3.grammar"],"type":"wordBank","vocabularyIds":["u3.tea","u3.like"]},{"content":{"maxChars":200,"placeholder":"Viết bằng tiếng Anh"},"explanation":"Đáp án: \"Bread and water, please.\".","gradingRule":{"acceptedText":["Bread and water, please."],"caseSensitive":false,"ignoreDiacritics":false,"ignorePunctuation":true},"hint":"\"please\" = làm ơn; \"water\" = nước; \"bread\" = bánh mì","id":"u3n6l5-e12","prompt":{"locale":"vi-VN","text":"Làm ơn cho tôi bánh mì và nước."},"skillIds":["u3.grammar"],"type":"textTranslation","vocabularyIds":["u1.please","u3.water","u3.bread"]}],"gradingRulesVersion":"g1","guideText":"Mẫu câu chính: \"Water, please.\" (Cho tôi nước.) — \"I like tea.\" (Tôi thích trà.) — \"Do you want coffee?\" (Bạn có muốn cà phê không?)\nMạo từ: \"a\" trước phụ âm (a banana), \"an\" trước nguyên âm (an apple, an egg).\nThì hiện tại đơn: he/she thêm -s: \"Kiko likes fish.\" Câu phủ định dùng do not / does not: \"Tom does not like coffee.\" (hay: doesn't).\nLịch sự khi gọi món: thêm \"please\" ở cuối câu. \"I want ...\" hơi thẳng; dùng \"..., please\" khi nói với người phục vụ.\nBữa ăn: breakfast (bữa sáng), lunch (bữa trưa), dinner (bữa tối) — nói \"for breakfast\" (cho bữa sáng).","lessonId":"u3n6l5","lessonVersion":"v2.u3n6l5","manifestHash":"013672aa5927648264926e14d514d9d670ba04f547fc10aba6d50095b8e8b587","nodeId":"u3n6","order":21,"rewardIdentity":"v2.u3n6l5","schemaVersion":1,"sectionId":"sec1","signature":"9oC6F5z29wSW-3w9fMxu5-mYJZYN-Nkg-p-D7NECpfH8kbHlBFkt6MnV7XhYGx4M_95LlFVewJFqBQx250hiCQ","signatureKeyId":"dev-content-1","skillIds":["u3.vocab","u3.grammar","listening"],"title":"Ngon quá! · Bài 5","unitId":"u3"}