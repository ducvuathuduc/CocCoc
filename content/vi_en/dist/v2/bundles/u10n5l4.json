":"next"},{"id":"t3","text":"the"},{"id":"t4","text":"The"},{"id":"t5","text":"to"},{"id":"t6","text":"is"},{"id":"t7","text":"café"}]},"explanation":"Câu đúng: \"The café is next to the bank.\".","gradingRule":{"caseSensitive":false,"correctTokenIds":["t4","t7","t6","t2","t5","t3","t1"],"ignoreDiacritics":false,"ignorePunctuation":false},"hint":"Câu bắt đầu bằng \"The\".","id":"u10n5l4-e11a","prompt":{"locale":"vi-VN","text":"Sắp xếp thành câu đúng: \"Quán cà phê ở bên cạnh ngân hàng.\""},"skillIds":["speaking","u10.grammar"],"type":"sentenceOrder","vocabularyIds":["u10.bank","u10.next_to"]},"prompt":{"audioAssetId":"a.u10.s14.n","locale":"en-US","text":"Nói câu sau: \"The café is next to the bank.\""},"skillIds":["speaking","u10.grammar"],"type":"speakRepeat","vocabularyIds":["u10.bank","u10.next_to"]},{"content":{"maxChars":200,"placeholder":"Viết bằng tiếng Việt (có dấu)"},"explanation":"Đáp án: \"Bệnh viện ở đối diện công viên.\". Cũng đúng: \"Bệnh viện nằm đối diện công viên.\".","gradingRule":{"acceptedText":["Bệnh viện ở đối diện công viên.","Bệnh viện nằm đối diện công viên."],"caseSensitive":false,"ignoreDiacritics":false,"ignorePunctuation":true},"hint":"\"hospital\" = bệnh viện; \"park\" = công viên; \"opposite\" = đối diện","id":"u10n5l4-e12","prompt":{"locale":"en-US","text":"The hospital is opposite the park."},"skillIds":["u10.grammar"],"type":"textTranslation","vocabularyIds":["u10.hospital","u10.park","u10.opposite"]}],"gradingRulesVersion":"g1","guideText":"Mẫu câu chính: \"Excuse me, where is the bank?\" (Xin lỗi, ngân hàng ở đâu?) — \"Go straight and turn left.\" (Đi thẳng rồi rẽ trái.) — \"Is it far?\" (Có xa không?)\nChỉ đường dùng câu mệnh lệnh: Go straight. Turn right. Turn left at the corner.\nVị trí: on the left / on the right (bên trái / bên phải), next to (bên cạnh), opposite (đối diện), near (gần), on the corner (ở góc đường).\n\"Near\" không cần \"to\": \"near the school\" (không nói \"near to the school\" trong văn nói chuẩn A2).\nHỏi khoảng cách: \"Is it far from here?\" — Trả lời: \"No, you can walk.\" (Không, bạn có thể đi bộ.)","lessonId":"u10n5l4","lessonVersion":"v2.u10n5l4","manifestHash":"013672aa5927648264926e14d514d9d670ba04f547fc10aba6d50095b8e8b587","nodeId":"u10n5","order":76,"rewardIdentity":"v2.u10n5l4","schemaVersion":1,"sectionId":"sec2","signature":"5sNC5pKx4T0ALCMa2SkOT05V1P5LNksC7WPYbWJL3WgES_bGxfV8LBAqy6WhbK_2l5lb2yCGnoGSmU55_RG9Cg","signatureKeyId":"dev-content-1","skillIds":["speaking","u10.grammar","u10.dialogue","u10.vocab"],"title":"Thành phố của tôi · Bài 4","unitId":"u10"}