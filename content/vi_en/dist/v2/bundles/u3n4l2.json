tent":{"maxChars":200,"placeholder":"Viết bằng tiếng Việt (có dấu)"},"explanation":"Đáp án: \"Chúng tôi uống nước ép.\". Cũng đúng: \"Chúng ta uống nước ép.\", \"Chúng mình uống nước ép.\".","gradingRule":{"acceptedText":["Chúng tôi uống nước ép.","Chúng ta uống nước ép.","Chúng mình uống nước ép."],"caseSensitive":false,"ignoreDiacritics":false,"ignorePunctuation":true},"hint":"\"juice\" = nước ép; \"drink\" = uống","id":"u3n4l2-e07","prompt":{"locale":"en-US","text":"We drink juice."},"skillIds":["u3.grammar"],"type":"textTranslation","vocabularyIds":["u3.juice","u3.drink"]},{"content":{"tokens":[{"id":"t1","text":"the"},{"id":"t2","text":"please"},{"id":"t3","text":"baby"},{"id":"t4","text":"for"},{"id":"t5","text":"Milk"}]},"explanation":"Câu đúng: \"Milk for the baby, please.\".","gradingRule":{"caseSensitive":false,"correctTokenIds":["t5","t4","t1","t3","t2"],"ignoreDiacritics":false,"ignorePunctuation":false},"hint":"Câu bắt đầu bằng \"Milk\".","id":"u3n4l2-e08","prompt":{"locale":"vi-VN","text":"Sắp xếp thành câu đúng: \"Làm ơn cho em bé sữa.\""},"skillIds":["u3.grammar"],"type":"sentenceOrder","vocabularyIds":["u1.please","u2.baby","u3.milk"]},{"content":{"pairs":[{"id":"p1","left":{"id":"p1l","text":"want"},"right":{"id":"p1r","text":"muốn"}},{"id":"p2","left":{"id":"p2l","text":"tea"},"right":{"id":"p2r","text":"trà"}},{"id":"p3","left":{"id":"p3l","text":"coffee"},"right":{"id":"p3r","text":"cà phê"}},{"id":"p4","left":{"id":"p4l","text":"rice"},"right":{"id":"p4r","text":"cơm"}},{"id":"p5","left":{"id":"p5l","text":"water"},"right":{"id":"p5r","text":"nước"}}]},"explanation":"want = muốn; tea = trà; coffee = cà phê; rice = cơm; water = nước","gradingRule":{"caseSensitive":false,"correctPairIds":["p1","p2","p3","p4","p5"],"ignoreDiacritics":false,"ignorePunctuation":false},"hint":"Ví dụ: \"want\" = \"muốn\".","id":"u3n4l2-e09","prompt":{"locale":"vi-VN","text":"Nối các cặp từ tương ứng"},"skillIds":["u3.vocab"],"type":"matchPairs","vocabularyIds":["u3.want","u3.tea","u3.coffee","u3.rice","u3.water"]},{"content":{"maxChars":200,"placeholder":"Viết bằng tiếng Anh"},"explanation":"Đáp án: \"Mrs. Rosa has tea and coffee.\".","gradingRule":{"acceptedText":["Mrs. Rosa has tea and coffee."],"caseSensitive":false,"ignoreDiacritics":false,"ignorePunctuation":true},"hint":"\"have\" = có; \"tea\" = trà; \"coffee\" = cà phê","id":"u3n4l2-e10","prompt":{"locale":"vi-VN","text":"Bà Rosa có trà và cà phê."},"skillIds":["u3.grammar"],"type":"textTranslation","vocabularyIds":["u2.have","u3.tea","u3.coffee"]},{"content":{"choices":[{"id":"c1","imageAssetId":"i.u2.grandmother","text":"grandmother"},{"id":"c2","imageAssetId":"i.u3.tea","text":"tea"},{"id":"c3","imageAssetId":"i.u2.baby","text":"baby"},{"id":"c4","imageAssetId":"i.u3.water","text":"water"}]},"explanation":"\"water\" = \"nước\".","gradingRule":{"caseSensitive":false,"correctChoiceId":"c4","ignoreDiacritics":false,"ignorePunctuation":false},"hint":"\"nước\" là \"water\".","id":"u3n4l2-e11","prompt":{"locale":"vi-VN","text":"Hình nào là \"nước\"?"},"skillIds":["u3.vocab"],"type":"imageChoice","vocabularyIds":["u3.water"]}],"gradingRulesVersion":"g1","guideText":"Mẫu câu chính: \"Water, please.\" (Cho tôi nước.) — \"I like tea.\" (Tôi thích trà.) — \"Do you want coffee?\" (Bạn có muốn cà phê không?)\nMạo từ: \"a\" trước phụ âm (a banana), \"an\" trước nguyên âm (an apple, an egg).\nThì hiện tại đơn: he/she thêm -s: \"Kiko likes fish.\" Câu phủ định dùng do not / does not: \"Tom does not like coffee.\" (hay: doesn't).\nLịch sự khi gọi món: thêm \"please\" ở cuối câu. \"I want ...\" hơi thẳng; dùng \"..., please\" khi nói với người phục vụ.\nBữa ăn: breakfast (bữa sáng), lunch (bữa trưa), dinner (bữa tối) — nói \"for breakfast\" (cho bữa sáng).","lessonId":"u3n4l2","lessonVersion":"v2.u3n4l2","manifestHash":"013672aa5927648264926e14d514d9d670ba04f547fc10aba6d50095b8e8b587","nodeId":"u3n4","order":19,"rewardIdentity":"v2.u3n4l2","schemaVersion":1,"sectionId":"sec1","signature":"ytdTKxcJxew5FhoVlzyg5R_E7bQrvgiC4hVNNFP46KpuP-Z-To_2hiNgu5nKLAKjdC7R5I4jPiF1amICZu-UDw","signatureKeyId":"dev-content-1","skillIds":["reading","u3.story","u3.grammar","speaking","u3.dialogue","listening","u3.vocab"],"title":"Truyện: Ở quán của bà Rosa · Bài 2","unitId":"u3"}