have","u2.cat","u4.seven"]},{"content":{"locale":"en-US","maxSeconds":6,"referenceText":"My grandfather is old."},"explanation":"Câu mẫu: \"My grandfather is old.\".","gradingRule":{"acceptedText":["My grandfather is old.","My grandpa is old."],"caseSensitive":false,"ignoreDiacritics":false,"ignorePunctuation":true},"hint":"Nghĩa: \"Ông tôi già rồi.\"","id":"u4n4l1-e11","nonSpeechAlternative":{"content":{"tokens":[{"id":"t1","text":"grandfather"},{"id":"t2","text":"is"},{"id":"t3","text":"old"},{"id":"t4","text":"My"}]},"explanation":"Câu đúng: \"My grandfather is old.\".","gradingRule":{"caseSensitive":false,"correctTokenIds":["t4","t1","t2","t3"],"ignoreDiacritics":false,"ignorePunctuation":false},"hint":"Câu bắt đầu bằng \"My\".","id":"u4n4l1-e11a","prompt":{"locale":"vi-VN","text":"Sắp xếp thành câu đúng: \"Ông tôi già rồi.\""},"skillIds":["speaking","u4.grammar"],"type":"sentenceOrder","vocabularyIds":["u2.grandfather","u4.old"]},"prompt":{"audioAssetId":"a.u4.s16.n","locale":"en-US","text":"Nói câu sau: \"My grandfather is old.\""},"skillIds":["speaking","u4.grammar"],"type":"speakRepeat","vocabularyIds":["u2.grandfather","u4.old"]}],"gradingRulesVersion":"g1","guideText":"Mẫu câu chính: \"How old are you?\" (Bạn bao nhiêu tuổi?) — \"I am twenty years old.\" (Tôi hai mươi tuổi.) — \"How many books do you have?\" (Bạn có bao nhiêu quyển sách?)\nSố nhiều: thêm -s sau danh từ khi nhiều hơn một: one cat, two cats; one egg, six eggs. Tiếng Việt không đổi danh từ, nhưng tiếng Anh thì có.\nTuổi: dùng \"be\", không dùng \"have\": \"I am ten years old\" hoặc ngắn gọn \"I am ten\". Không nói \"I have ten years\".\nSố: 20 = twenty, 28 = twenty-eight (có gạch nối), 100 = a hundred / one hundred.\n\"How many + danh từ số nhiều\": How many pens? How many cats?","lessonId":"u4n4l1","lessonVersion":"v2.u4n4l1","manifestHash":"013672aa5927648264926e14d514d9d670ba04f547fc10aba6d50095b8e8b587","nodeId":"u4n4","order":27,"rewardIdentity":"v2.u4n4l1","schemaVersion":1,"sectionId":