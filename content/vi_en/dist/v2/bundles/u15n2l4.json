t":"Câu bắt đầu bằng \"Linh\".","id":"u15n2l4-e11a","prompt":{"locale":"vi-VN","text":"Sắp xếp thành câu đúng: \"Linh hài lòng với công việc mới.\""},"skillIds":["speaking","u15.grammar"],"type":"sentenceOrder","vocabularyIds":["u6.new","u12.job","u15.happy"]},"prompt":{"audioAssetId":"a.u15.s5.n","locale":"en-US","text":"Nói câu sau: \"Linh is happy with her new job.\""},"skillIds":["speaking","u15.grammar"],"type":"speakRepeat","vocabularyIds":["u6.new","u12.job","u15.happy"]},{"content":{"maxChars":200,"placeholder":"Viết bằng tiếng Việt (có dấu)"},"explanation":"Đáp án: \"Đừng buồn.\". Cũng đúng: \"Đừng buồn nhé.\".","gradingRule":{"acceptedText":["Đừng buồn.","Đừng buồn nhé."],"caseSensitive":false,"ignoreDiacritics":false,"ignorePunctuation":true},"hint":"\"sad\" = buồn","id":"u15n2l4-e12","prompt":{"locale":"en-US","text":"Do not be sad."},"skillIds":["u15.grammar"],"type":"textTranslation","vocabularyIds":["u15.sad"]}],"gradingRulesVersion":"g1","guideText":"Mẫu câu chính: \"Why are you sad?\" (Sao bạn buồn?) — \"Nam is taller than Tom.\" (Nam cao hơn Tom.) — \"Happy birthday!\" (Chúc mừng sinh nhật!)\nSo sánh hơn với tính từ ngắn: thêm -er + than: tall → taller than, young → younger than, smart → smarter than.\nTính từ cảm xúc đuôi -ed mô tả cảm giác của người: I am bored, I am excited, She was surprised.\nGiới từ đi kèm: afraid of (sợ), worried about (lo về), excited about (háo hức về).\nLời khuyên nhẹ nhàng: \"Don't be sad.\" (Đừng buồn.)","lessonId":"u15n2l4","lessonVersion":"v2.u15n2l4","manifestHash":"013672aa5927648264926e14d514d9d670ba04f547fc10aba6d50095b8e8b587","nodeId":"u15n2","order":113,"rewardIdentity":"v2.u15n2l4","schemaVersion":1,"sectionId":"sec2","signature":"vtlycE4IQwZn4LwSZnhtMrs4BwdnNCQXxYmxILcROR-_4OJe64aNhlok0OcZKOVbwLb0ns4CcEhIahxhahdQAA","signatureKeyId":"dev-content-1","skillIds":["speaking","u15.grammar","u15.dialogue","u15.vocab"],"title":"Cao hơn, trẻ hơn · Bài 4","unitId":"u15"}