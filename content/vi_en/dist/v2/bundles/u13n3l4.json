nation":"Câu đúng: \"I play games on my phone.\".","gradingRule":{"caseSensitive":false,"correctTokenIds":["t6","t4","t5","t2","t3","t1"],"ignoreDiacritics":false,"ignorePunctuation":false},"hint":"Câu bắt đầu bằng \"I\".","id":"u13n3l4-e11a","prompt":{"locale":"vi-VN","text":"Sắp xếp thành câu đúng: \"Tôi chơi trò chơi trên điện thoại.\""},"skillIds":["speaking","u13.grammar"],"type":"sentenceOrder","vocabularyIds":["u4.phone","u13.game","u13.play"]},"prompt":{"audioAssetId":"a.u13.s7.n","locale":"en-US","text":"Nói câu sau: \"I play games on my phone.\""},"skillIds":["speaking","u13.grammar"],"type":"speakRepeat","vocabularyIds":["u4.phone","u13.game","u13.play"]},{"content":{"maxChars":200,"placeholder":"Viết bằng tiếng Việt (có dấu)"},"explanation":"Đáp án: \"Họ hát và nhảy.\". Cũng đúng: \"Họ ca hát và nhảy múa.\".","gradingRule":{"acceptedText":["Họ hát và nhảy.","Họ ca hát và nhảy múa."],"caseSensitive":false,"ignoreDiacritics":false,"ignorePunctuation":true},"hint":"\"sing\" = hát; \"dance\" = nhảy","id":"u13n3l4-e12","prompt":{"locale":"en-US","text":"They sing and dance."},"skillIds":["u13.grammar"],"type":"textTranslation","vocabularyIds":["u13.sing","u13.dance"]}],"gradingRulesVersion":"g1","guideText":"Mẫu câu chính: \"What is your hobby?\" (Sở thích của bạn là gì?) — \"I like to draw.\" (Tôi thích vẽ.) — \"My favorite sport is football.\" (Môn thể thao yêu thích của tôi là bóng đá.)\nLike + to V hoặc like + V-ing đều đúng: \"I like to dance\" = \"I like dancing\".\nPlay + môn thể thao (play football — không có \"the\"); play + the + nhạc cụ (play the piano, play the guitar).\nTrạng từ tần suất \"often\" đứng trước động từ thường: \"I often listen to music.\"\n\"Together\" (cùng nhau) thường đứng cuối câu: \"We play games together.\"","lessonId":"u13n3l4","lessonVersion":"v2.u13n3l4","manifestHash":"013672aa5927648264926e14d514d9d670ba04f547fc10aba6d50095b8e8b587","nodeId":"u13n3","order":98,"rewardIdentity":"v2.u13n3l4","schemaVersion":1,"sectionId":"s