pe":"choice","vocabularyIds":["u8.windy"]},{"content":{"tokens":[{"id":"t1","text":"ấy"},{"id":"t2","text":"Buổi"},{"id":"t3","text":"Trời"},{"id":"t4","text":"thích"},{"id":"t5","text":"và"},{"id":"t6","text":"của"},{"id":"t7","text":"mây"},{"id":"t8","text":"nhiều"},{"id":"t9","text":"mát"}]},"explanation":"Câu đúng: \"Trời nhiều mây và mát.\".","gradingRule":{"caseSensitive":false,"correctTokenIds":["t3","t8","t7","t5","t9"],"ignoreDiacritics":false,"ignorePunctuation":false},"hint":"\"cool\" = mát; \"cloudy\" = nhiều mây","id":"u8n2l1-e09","prompt":{"locale":"vi-VN","text":"Dịch sang tiếng Việt: \"It is cloudy and cool.\""},"skillIds":["u8.grammar"],"type":"wordBank","vocabularyIds":["u8.cool","u8.cloudy"]},{"content":{"tokens":[{"id":"t1","text":"raining"},{"id":"t2","text":"is"},{"id":"t3","text":"It"},{"id":"t4","text":"now"}]},"explanation":"Câu đúng: \"It is raining now.\".","gradingRule":{"caseSensitive":false,"correctTokenIds":["t3","t2","t1","t4"],"ignoreDiacritics":false,"ignorePunctuation":false},"hint":"Câu bắt đầu bằng \"It\".","id":"u8n2l1-e10","prompt":{"locale":"vi-VN","text":"Sắp xếp thành câu đúng: \"Bây giờ trời đang mưa.\""},"skillIds":["u8.grammar"],"type":"sentenceOrder","vocabularyIds":["u5.now","u8.rainy"]},{"content":{"maxChars":40,"placeholder":"Điền từ còn thiếu"},"explanation":"Từ đúng: \"windy\" → Today is windy.","gradingRule":{"acceptedText":["windy"],"caseSensitive":false,"ignoreDiacritics":false,"ignorePunctuation":true},"hint":"\"nhiều gió\" trong tiếng Anh là \"w...\"","id":"u8n2l1-e11","prompt":{"locale":"en-US","text":"Today is ___. — \"Hôm nay trời nhiều gió.\""},"skillIds":["u8.grammar"],"type":"fillBlank","vocabularyIds":["u8.windy","u5.today"]},{"content":{"maxChars":200,"placeholder":"Viết bằng tiếng Anh"},"explanation":"Đáp án: \"It is sunny today.\". Cũng đúng: \"It's sunny today.\".","gradingRule":{"acceptedText":["It is sunny today.","It's sunny today."],"caseSensitive":false,"ignoreDiacritics":false,"ignorePunctuation":true},"hint":"\"today\" = hôm nay; \"sunny\" = nắng","id":"u8n2l1-e12","prompt":{"locale":"vi-VN","text":"Hôm nay trời nắng."},"skillIds":["u8.grammar"],"type":"textTranslation","vocabularyIds":["u5.today","u8.sunny"]},{"content":{"tokens":[{"id":"t1","text":"warm"},{"id":"t2","text":"Have"},{"id":"t3","text":"water"},{"id":"t4","text":"bathroom"},{"id":"t5","text":"The"},{"id":"t6","text":"understand"},{"id":"t7","text":"is"}]},"explanation":"Câu đúng: \"The water is warm.\".","gradingRule":{"caseSensitive":false,"correctTokenIds":["t5","t3","t7","t1"],"ignoreDiacritics":false,"ignorePunctuation":false},"hint":"\"water\" = nước; \"warm\" = ấm","id":"u8n2l1-e13","prompt":{"locale":"vi-VN","text":"Dịch câu này: \"Nước ấm.\""},"skillIds":["u8.grammar"],"type":"wordBank","vocabularyIds":["u3.water","u8.warm"]}],"gradingRulesVersion":"g1","guideText":"Mẫu câu chính: \"How is the weather today?\" (Thời tiết hôm nay thế nào?) — \"It is sunny.\" (Trời nắng.) — \"It is raining.\" (Trời đang mưa.)\nChủ ngữ giả \"it\": tiếng Việt nói \"trời nắng\", tiếng Anh phải có chủ ngữ: \"It is sunny\", không nói \"Is sunny\".\nThì hiện tại tiếp diễn cho việc đang xảy ra: It is raining now. So sánh: It is rainy (trời có mưa — mô tả chung).\nMùa: in (the) summer, in winter. Miền Nam Việt Nam có hai mùa: the dry season (mùa khô) và the rainy season (mùa mưa).\n\"Fall\" là cách Mỹ gọi mùa thu; \"autumn\" dùng ở Anh — cả hai đều đúng.","lessonId":"u8n2l1","lessonVersion":"v2.u8n2l1","manifestHash":"013672aa5927648264926e14d514d9d670ba04f547fc10aba6d50095b8e8b587","nodeId":"u8n2","order":57,"rewardIdentity":"v2.u8n2l1","schemaVersion":1,"sectionId":"sec1","signature":"gS52qMkA-k7eouGOgxhiKMLMCaOUHWfGyBlTPe831DnWD9hIT-Bwgjv2Cl5Kg4C_i_bsP91RlwZNHVAOCiq8Dg","signatureKeyId":"dev-content-1","skillIds":["u8.vocab","u8.grammar","listening"],"title":"Nắng và mưa · Bài 1","unitId":"u8"}