holder":"Viết những gì bạn nghe"},"explanation":"Bạn nghe: \"Goodbye, Linh!\".","gradingRule":{"acceptedText":["Goodbye, Linh!","Bye, Linh!"],"caseSensitive":false,"ignoreDiacritics":false,"ignorePunctuation":true},"hint":"Câu có 2 từ. Nghĩa: \"Tạm biệt, Linh!\"","id":"u1n5l3-e12","nonAudioAlternative":{"content":{"maxChars":200,"placeholder":"Viết bằng tiếng Anh"},"explanation":"Đáp án: \"Goodbye, Linh!\". Cũng đúng: \"Bye, Linh!\".","gradingRule":{"acceptedText":["Goodbye, Linh!","Bye, Linh!"],"caseSensitive":false,"ignoreDiacritics":false,"ignorePunctuation":true},"hint":"\"goodbye\" = tạm biệt","id":"u1n5l3-e12a","prompt":{"locale":"vi-VN","text":"Tạm biệt, Linh!"},"skillIds":["listening","u1.grammar"],"type":"textTranslation","vocabularyIds":["u1.goodbye"]},"prompt":{"audioAssetId":"a.u1.s3.n","locale":"vi-VN","text":"Nghe và viết lại bằng tiếng Anh"},"skillIds":["listening","u1.grammar"],"type":"dictation","vocabularyIds":["u1.goodbye"]}],"gradingRulesVersion":"g1","guideText":"Mẫu câu chính: \"Hello, I am Mai.\" (Xin chào, tôi là Mai.) — \"What is your name?\" (Bạn tên là gì?) — \"Nice to meet you.\" (Rất vui được gặp bạn.)\nNgữ pháp: động từ \"to be\": I am, you are, he/she is. Khi nói, người bản xứ hay rút gọn: I'm, you're, he's, she's. Cả hai cách viết đều được chấp nhận.\nMẹo: \"I\" luôn viết hoa. Dùng \"a\" trước nghề nghiệp: \"I am a student.\" Tiếng Việt có thể bỏ \"một\", tiếng Anh thì không.\nLịch sự: \"Excuse me\" dùng để bắt chuyện, \"Sorry\" dùng khi xin lỗi vì lỗi của mình.","lessonId":"u1n5l3","lessonVersion":"v2.u1n5l3","manifestHash":"013672aa5927648264926e14d514d9d670ba04f547fc10aba6d50095b8e8b587","nodeId":"u1n5","order":4,"rewardIdentity":"v2.u1n5l3","schemaVersion":1,"sectionId":"sec1","signature":"ioCBr6dMtJX0D55uD3aKRptjCzIv1awlwObmYo21qarT_rvgzy0rOMqskVa7y02Z7I2THeHSjyC7AJddJyLPDQ","signatureKeyId":"dev-content-1","skillIds":["listening","u1.grammar","u1.vocab"],"title":"Rất vui được gặp bạn · Bài 3","unitId":"u1"}