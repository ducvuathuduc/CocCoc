ock"]},{"content":{"tokens":[{"id":"t1","text":"old"},{"id":"t2","text":"friend"},{"id":"t3","text":"like"},{"id":"t4","text":"you"},{"id":"t5","text":"Thank"},{"id":"t6","text":"my"},{"id":"t7","text":"at"}]},"explanation":"Câu đúng: \"Thank you, my friend.\".","gradingRule":{"caseSensitive":false,"correctTokenIds":["t5","t4","t6","t2"],"ignoreDiacritics":false,"ignorePunctuation":false},"hint":"\"friend\" = bạn; \"thank you\" = cảm ơn","id":"u5n1l1-e13","prompt":{"locale":"vi-VN","text":"Dịch câu này: \"Cảm ơn bạn nhé.\""},"skillIds":["u5.grammar"],"type":"wordBank","vocabularyIds":["u1.friend","u1.thank_you"]}],"gradingRulesVersion":"g1","guideText":"Mẫu câu chính: \"What time is it?\" (Mấy giờ rồi?) — \"It is seven o'clock.\" (Bảy giờ rồi.) — \"I get up at six.\" (Tôi dậy lúc sáu giờ.)\nGiới từ thời gian: at + giờ (at six o'clock), on + thứ (on Monday), in + buổi (in the morning, in the evening).\nThì hiện tại đơn cho thói quen: \"Mai goes to school every day.\" Với he/she/it: go → goes, get up → gets up.\nTrạng từ tần suất đứng TRƯỚC động từ thường: \"I always eat breakfast\", \"Kiko never eats bread\". Thứ tự: always > usually > sometimes > never.\nThứ trong tuần luôn viết hoa: Monday, Sunday.","lessonId":"u5n1l1","lessonVersion":"v2.u5n1l1","manifestHash":"013672aa5927648264926e14d514d9d670ba04f547fc10aba6d50095b8e8b587","nodeId":"u5n1","order":32,"rewardIdentity":"v2.u5n1l1","schemaVersion":1,"sectionId":"sec1","signature":"Mpz__n44xpYRdB5JhctLnp2qUkFjtEroA3i5byM1B2Gn06t0EJLzp_OuyuTEJEqC9DbRsfc9O3OpO6oPjc3NAg","signatureKeyId":"dev-content-1","skillIds":["u5.vocab","u5.grammar","listening"],"title":"Mấy giờ rồi? · Bài 1","unitId":"u5"}