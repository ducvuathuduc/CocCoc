ingRule":{"caseSensitive":false,"correctTokenIds":["t3","t1","t2","t4"],"ignoreDiacritics":false,"ignorePunctuation":false},"hint":"Câu bắt đầu bằng \"I\".","id":"u4n2l4-e11a","prompt":{"locale":"vi-VN","text":"Sắp xếp thành câu đúng: \"Tôi có hai con mèo.\""},"skillIds":["speaking","u4.grammar"],"type":"sentenceOrder","vocabularyIds":["u2.have","u2.cat","u4.two"]},"prompt":{"audioAssetId":"a.u4.s2.n","locale":"en-US","text":"Nói câu sau: \"I have two cats.\""},"skillIds":["speaking","u4.grammar"],"type":"speakRepeat","vocabularyIds":["u2.have","u2.cat","u4.two"]},{"content":{"maxChars":200,"placeholder":"Viết bằng tiếng Việt (có dấu)"},"explanation":"Đáp án: \"Mai có ba người anh em họ.\". Cũng đúng: \"Mai có ba anh chị em họ.\".","gradingRule":{"acceptedText":["Mai có ba người anh em họ.","Mai có ba anh chị em họ."],"caseSensitive":false,"ignoreDiacritics":false,"ignorePunctuation":true},"hint":"\"have\" = có; \"cousin\" = anh chị em họ; \"three\" = ba (số 3)","id":"u4n2l4-e12","prompt":{"locale":"en-US","text":"Mai has three cousins."},"skillIds":["u4.grammar"],"type":"textTranslation","vocabularyIds":["u2.have","u2.cousin","u4.three"]}],"gradingRulesVersion":"g1","guideText":"Mẫu câu chính: \"How old are you?\" (Bạn bao nhiêu tuổi?) — \"I am twenty years old.\" (Tôi hai mươi tuổi.) — \"How many books do you have?\" (Bạn có bao nhiêu quyển sách?)\nSố nhiều: thêm -s sau danh từ khi nhiều hơn một: one cat, two cats; one egg, six eggs. Tiếng Việt không đổi danh từ, nhưng tiếng Anh thì có.\nTuổi: dùng \"be\", không dùng \"have\": \"I am ten years old\" hoặc ngắn gọn \"I am ten\". Không nói \"I have ten years\".\nSố: 20 = twenty, 28 = twenty-eight (có gạch nối), 100 = a hundred / one hundred.\n\"How many + danh từ số nhiều\": How many pens? How many cats?","lessonId":"u4n2l4","lessonVersion":"v2.u4n2l4","manifestHash":"013672aa5927648264926e14d514d9d670ba04f547fc10aba6d50095b8e8b587","nodeId":"u4n2","order":25,"rewardIdentity":"v2.u4n2l4","schemaVersion":1,"sectionId":"sec1","signature":"7xP-Eig9uv2j5hNAYWDDZR-2Qn5R5RdTcycnKIlMIkLVfupZxwaVT5AflyirUDUBe1ZQnLcoqJqto0q6_gJKDw","signatureKeyId":"dev-content-1","skillIds":["speaking","u4.grammar","u4.dialogue","u4.vocab"],"title":"Năm đến tám · Bài 4","unitId":"u4"}