,"type":"choice","vocabularyIds":["u14.tired"]},"prompt":{"audioAssetId":"a.u14.s2.n","locale":"vi-VN","text":"Nghe và chọn câu bạn nghe được"},"skillIds":["listening","u14.grammar"],"type":"listenChoice","vocabularyIds":["u14.tired"]},{"content":{"locale":"en-US","maxSeconds":7,"referenceText":"How do you feel today?"},"explanation":"Câu mẫu: \"How do you feel today?\".","gradingRule":{"acceptedText":["How do you feel today?"],"caseSensitive":false,"ignoreDiacritics":false,"ignorePunctuation":true},"hint":"Nghĩa: \"Hôm nay bạn cảm thấy thế nào?\"","id":"u14n4l1-e11","nonSpeechAlternative":{"content":{"tokens":[{"id":"t1","text":"do"},{"id":"t2","text":"you"},{"id":"t3","text":"How"},{"id":"t4","text":"feel"},{"id":"t5","text":"today"}]},"explanation":"Câu đúng: \"How do you feel today?\".","gradingRule":{"caseSensitive":false,"correctTokenIds":["t3","t1","t2","t4","t5"],"ignoreDiacritics":false,"ignorePunctuation":false},"hint":"Câu bắt đầu bằng \"How\".","id":"u14n4l1-e11a","prompt":{"locale":"vi-VN","text":"Sắp xếp thành câu đúng: \"Hôm nay bạn cảm thấy thế nào?\""},"skillIds":["speaking","u14.grammar"],"type":"sentenceOrder","vocabularyIds":["u5.today","u14.feel"]},"prompt":{"audioAssetId":"a.u14.s15.n","locale":"en-US","text":"Nói câu sau: \"How do you feel today?\""},"skillIds":["speaking","u14.grammar"],"type":"speakRepeat","vocabularyIds":["u5.today","u14.feel"]}],"gradingRulesVersion":"g1","guideText":"Mẫu câu chính: \"How do you feel?\" (Bạn thấy thế nào?) — \"I have a headache.\" (Tôi bị đau đầu.) — \"You should rest.\" (Bạn nên nghỉ ngơi.)\nBệnh dùng \"have\": have a fever (bị sốt), have a cough (bị ho), have a headache (bị đau đầu). Tính từ dùng \"be\": I am sick, I am tired.\nChỗ đau: \"My stomach hurts\" (Tôi bị đau bụng) — động từ \"hurt\" thêm -s với he/she/it và danh từ số ít.\nLời khuyên: should / should not (shouldn't) + động từ nguyên mẫu: \"You should eat more vegetables.\"\nSố nhiều bất quy tắc: one tooth → two teeth.","lessonId":"u14n4l1","le