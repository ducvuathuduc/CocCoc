,"t3"],"ignoreDiacritics":false,"ignorePunctuation":false},"hint":"\"good\" = tốt; \"morning\" = buổi sáng; \"grandfather\" = ông","id":"u2n5l2-e11","prompt":{"locale":"vi-VN","text":"Dịch câu này: \"Chào buổi sáng, ông!\""},"skillIds":["u2.grammar"],"type":"wordBank","vocabularyIds":["u1.good","u1.morning","u2.grandfather"]},{"content":{"maxChars":200,"placeholder":"Viết bằng tiếng Anh"},"explanation":"Đáp án: \"Is she your daughter?\".","gradingRule":{"acceptedText":["Is she your daughter?"],"caseSensitive":false,"ignoreDiacritics":false,"ignorePunctuation":true},"hint":"\"daughter\" = con gái","id":"u2n5l2-e12","prompt":{"locale":"vi-VN","text":"Cô bé là con gái bạn à?"},"skillIds":["u2.grammar"],"type":"textTranslation","vocabularyIds":["u2.daughter"]}],"gradingRulesVersion":"g1","guideText":"Mẫu câu chính: \"This is my mother.\" (Đây là mẹ tôi.) — \"I have a brother.\" (Tôi có một anh/em trai.)\nTính từ sở hữu: my (của tôi), your (của bạn), his (của anh ấy), her (của cô ấy), their (của họ). Đặt TRƯỚC danh từ: \"my father\", không nói \"father my\".\nĐộng từ \"have\": I/you/we/they have — he/she has. \"Mai has a cat.\"\nLưu ý: tiếng Anh không phân biệt anh/em: \"brother\" = anh trai hoặc em trai, \"sister\" = chị gái hoặc em gái. \"Aunt/uncle\" gồm cả cô, dì, chú, cậu, bác.","lessonId":"u2n5l2","lessonVersion":"v2.u2n5l2","manifestHash":"013672aa5927648264926e14d514d9d670ba04f547fc10aba6d50095b8e8b587","nodeId":"u2n5","order":12,"rewardIdentity":"v2.u2n5l2","schemaVersion":1,"sectionId":"sec1","signature":"SERx9TD54fD_EMXEd7GkgCnBN4Qt8BMnYBvT3qVeCh0bxEKkZ7f-YK5nhIs1F0uq_l_NwzQbkVMrC19efZ52Dg","signatureKeyId":"dev-content-1","skillIds":["u2.vocab","u2.grammar","listening"],"title":"Tôi có một con mèo · Bài 2","unitId":"u2"}