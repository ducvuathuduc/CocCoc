yIds":["u15.young"]},"prompt":{"audioAssetId":"a.u15.s10.n","locale":"en-US","text":"Nói câu sau: \"Huy is younger than Mai.\""},"skillIds":["speaking","u15.grammar"],"type":"speakRepeat","vocabularyIds":["u15.young"]},{"content":{"maxChars":200,"placeholder":"Viết bằng tiếng Việt (có dấu)"},"explanation":"Đáp án: \"Tôi lo lắng về bài kiểm tra.\". Cũng đúng: \"Tôi lo về bài kiểm tra.\", \"Mình lo lắng về bài kiểm tra.\".","gradingRule":{"acceptedText":["Tôi lo lắng về bài kiểm tra.","Tôi lo về bài kiểm tra.","Mình lo lắng về bài kiểm tra.","Mình lo về bài kiểm tra."],"caseSensitive":false,"ignoreDiacritics":false,"ignorePunctuation":true},"hint":"\"worried\" = lo lắng","id":"u15n6l6-e12","prompt":{"locale":"en-US","text":"I am worried about the test."},"skillIds":["u15.grammar"],"type":"textTranslation","vocabularyIds":["u15.worried"]}],"gradingRulesVersion":"g1","guideText":"Mẫu câu chính: \"Why are you sad?\" (Sao bạn buồn?) — \"Nam is taller than Tom.\" (Nam cao hơn Tom.) — \"Happy birthday!\" (Chúc mừng sinh nhật!)\nSo sánh hơn với tính từ ngắn: thêm -er + than: tall → taller than, young → younger than, smart → smarter than.\nTính từ cảm xúc đuôi -ed mô tả cảm giác của người: I am bored, I am excited, She was surprised.\nGiới từ đi kèm: afraid of (sợ), worried about (lo về), excited about (háo hức về).\nLời khuyên nhẹ nhàng: \"Don't be sad.\" (Đừng buồn.)","lessonId":"u15n6l6","lessonVersion":"v2.u15n6l6","manifestHash":"013672aa5927648264926e14d514d9d670ba04f547fc10aba6d50095b8e8b587","nodeId":"u15n6","order":117,"rewardIdentity":"v2.u15n6l6","schemaVersion":1,"sectionId":"sec2","signature":"1SKaS-6YbUNDm7HmfxDy1PcFzqHBVMe5DJlsID_W9HlMK4w1cDs7y7SUkok7gg9EWEQGwhHPn0el3RQ1sCVUCQ","signatureKeyId":"dev-content-1","skillIds":["speaking","u15.grammar","u15.dialogue","u15.vocab"],"title":"Bữa tiệc sinh nhật · Bài 6","unitId":"u15"}