"dialogueTurn","vocabularyIds":["u1.no","u1.please","u9.pay","u9.cash","u9.card"]},{"content":{"choices":[{"id":"c1","text":"Linh"},{"id":"c2","text":"Tom"},{"id":"c3","text":"Anna"}],"passage":"Mai and Anna go shopping. Mai wants to buy a gift for her mother. At the first shop, there is a beautiful red dress. \"How much is it?\" Mai asks. \"Nine hundred thousand dong.\" It is too expensive! They go to the market. A woman sells nice bags. \"This black bag is on sale,\" she says. \"Two hundred thousand dong.\" Mai likes it. She pays in cash. \"Your mother will love it,\" Anna says.","question":"Who goes shopping with Mai?"},"explanation":"Đáp án: \"Anna\".","gradingRule":{"caseSensitive":false,"correctChoiceId":"c3","ignoreDiacritics":false,"ignorePunctuation":false},"hint":"Đọc lại câu chuyện \"Món quà cho mẹ\".","id":"u9n7l1-e09","prompt":{"locale":"en-US","text":"Who goes shopping with Mai?"},"skillIds":["reading","u9.story"],"type":"storyQuestion","vocabularyIds":[]},{"content":{"choices":[{"id":"c1","imageAssetId":"i.u3.chicken","text":"chicken"},{"id":"c2","imageAssetId":"i.u9.red","text":"red"},{"id":"c3","imageAssetId":"i.u9.wallet","text":"wallet"},{"id":"c4","imageAssetId":"i.u6.door","text":"door"}]},"explanation":"\"red\" = \"màu đỏ\".","gradingRule":{"caseSensitive":false,"correctChoiceId":"c2","ignoreDiacritics":false,"ignorePunctuation":false},"hint":"\"màu đỏ\" là \"red\".","id":"u9n7l1-e10","prompt":{"locale":"vi-VN","text":"Hình nào là \"màu đỏ\"?"},"skillIds":["u9.vocab"],"type":"imageChoice","vocabularyIds":["u9.red"]},{"content":{"pairs":[{"id":"p1","left":{"id":"p1l","text":"cheap"},"right":{"id":"p1r","text":"rẻ"}},{"id":"p2","left":{"id":"p2l","text":"money"},"right":{"id":"p2r","text":"tiền"}},{"id":"p3","left":{"id":"p3l","text":"red"},"right":{"id":"p3r","text":"màu đỏ"}},{"id":"p4","left":{"id":"p4l","text":"gift"},"right":{"id":"p4r","text":"món quà"}},{"id":"p5","left":{"id":"p5l","text":"expensive"},"right":{"id":"p5r","text":"đắt"}}]},