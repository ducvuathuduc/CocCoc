lanation":"\"red\" = \"màu đỏ\".","gradingRule":{"caseSensitive":false,"correctChoiceId":"c2","ignoreDiacritics":false,"ignorePunctuation":false},"hint":"\"màu đỏ\" là \"red\".","id":"u9n7l1-e10","prompt":{"locale":"vi-VN","text":"Hình nào là \"màu đỏ\"?"},"skillIds":["u9.vocab"],"type":"imageChoice","vocabularyIds":["u9.red"]},{"content":{"pairs":[{"id":"p1","left":{"id":"p1l","text":"cheap"},"right":{"id":"p1r","text":"rẻ"}},{"id":"p2","left":{"id":"p2l","text":"money"},"right":{"id":"p2r","text":"tiền"}},{"id":"p3","left":{"id":"p3l","text":"red"},"right":{"id":"p3r","text":"màu đỏ"}},{"id":"p4","left":{"id":"p4l","text":"gift"},"right":{"id":"p4r","text":"món quà"}},{"id":"p5","left":{"id":"p5l","text":"expensive"},"right":{"id":"p5r","text":"đắt"}}]},"explanation":"cheap = rẻ; money = tiền; red = màu đỏ; gift = món quà; expensive = đắt","gradingRule":{"caseSensitive":false,"correctPairIds":["p1","p2","p3","p4","p5"],"ignoreDiacritics":false,"ignorePunctuation":false},"hint":"Ví dụ: \"cheap\" = \"rẻ\".","id":"u9n7l1-e11","prompt":{"locale":"vi-VN","text":"Nối các cặp từ tương ứng"},"skillIds":["u9.vocab"],"type":"matchPairs","vocabularyIds":["u9.cheap","u9.money","u9.red","u9.gift","u9.expensive"]},{"content":{"choices":[{"id":"c1","text":"always"},{"id":"c2","text":"card"},{"id":"c3","text":"four"},{"id":"c4","text":"grandmother"}]},"explanation":"\"card\" = \"thẻ\".","gradingRule":{"caseSensitive":false,"correctChoiceId":"c2","ignoreDiacritics":false,"ignorePunctuation":false},"hint":"\"card\" nghĩa là \"thẻ\".","id":"u9n7l1-e12","prompt":{"locale":"vi-VN","text":"\"thẻ\" trong tiếng Anh là gì?"},"skillIds":["u9.vocab"],"type":"choice","vocabularyIds":["u9.card"]},{"content":{"locale":"en-US","maxSeconds":7,"referenceText":"The shoes are on sale."},"explanation":"Câu mẫu: \"The shoes are on sale.\".","gradingRule":{"acceptedText":["The shoes are on sale."],"caseSensitive":false,"ignoreDiacritics":false,"ignorePunctuation":true},"hint":"Nghĩa: \"Đôi giày đang giảm giá.\"","id":"u9n7l1-e13","nonSpeechAlternative":{"content":{"tokens":[{"id":"t1","text":"are"},{"id":"t2","text":"shoes"},{"id":"t3","text":"on"},{"id":"t4","text":"The"},{"id":"t5","text":"sale"}]},"explanation":"Câu đúng: \"The shoes are on sale.\".","gradingRule":{"caseSensitive":false,"correctTokenIds":["t4","t2","t1","t3","t5"],"ignoreDiacritics":false,"ignorePunctuation":false},"hint":"Câu bắt đầu bằng \"The\".","id":"u9n7l1-e13a","prompt":{"locale":"vi-VN","text":"Sắp xếp thành câu đúng: \"Đôi giày đang giảm giá.\""},"skillIds":["speaking","u9.grammar"],"type":"sentenceOrder","vocabularyIds":["u9.shoes","u9.sale"]},"prompt":{"audioAssetId":"a.u9.s21.n","locale":"en-US","text":"Nói câu sau: \"The shoes are on sale.\""},"skillIds":["speaking","u9.grammar"],"type":"speakRepeat","vocabularyIds":["u9.shoes","u9.sale"]},{"content":{"tokens":[{"id":"t1","text":"mươi"},{"id":"t2","text":"mặt"},{"id":"t3","text":"Tôi"},{"id":"t4","text":"tiền"},{"id":"t5","text":"mát"},{"id":"t6","text":"bằng"},{"id":"t7","text":"ghế"},{"id":"t8","text":"hộ"},{"id":"t9","text":"trả"}]},"explanation":"Câu đúng: \"Tôi trả bằng tiền mặt.\".","gradingRule":{"caseSensitive":false,"correctTokenIds":["t3","t9","t6","t4","t2"],"ignoreDiacritics":false,"ignorePunctuation":false},"hint":"\"pay\" = trả tiền; \"cash\" = tiền mặt","id":"u9n7l1-e14","prompt":{"locale":"vi-VN","text":"Dịch sang tiếng Việt: \"I pay in cash.\""},"skillIds":["u9.grammar"],"type":"wordBank","vocabularyIds":["u9.pay","u9.cash"]},{"content":{"maxChars":200,"placeholder":"Viết bằng tiếng Anh"},"explanation":"Đáp án: \"The shoes are cheap, but the shirt is expensive.\".","gradingRule":{"acceptedText":["The shoes are cheap, but the shirt is expensive."],"caseSensitive":false,"ignoreDiacritics":false,"ignorePunctuation":true},"hint":"\"cheap\" = rẻ; \"expensive\" = đắt; \"shirt\" = áo sơ mi; \"shoes\" = giày","id":"u9n7l1-e15","prompt":{"locale":"vi-VN","text":"Giày thì rẻ, nhưng áo sơ mi thì đắt."},"skillIds":["u9.grammar"],"type":"textTranslation","vocabularyIds":["u9.cheap","u9.expensive","u9.shirt","u9.shoes"]}],"gradingRulesVersion":"g1","guideText":"Mẫu câu chính: \"How much is this dress?\" (Cái váy này bao nhiêu tiền?) — \"Can I pay by card?\" (Tôi trả bằng thẻ được không?) — \"It is on sale.\" (Nó đang giảm giá.)\nHow much is + số ít / How much are + số nhiều: \"How much are the shoes?\"\n\"Shoes\" luôn ở dạng số nhiều (một đôi giày = a pair of shoes).\nMàu sắc đứng trước danh từ: \"a red dress\" (một cái váy đỏ). Hỏi màu: \"What color is it?\"\nTrả tiền: pay in cash (tiền mặt) / pay by card (bằng thẻ). \"Expensive\" (đắt) ↔ \"cheap\" (rẻ).","lessonId":"u9n7l1","lessonVersion":"v2.u9n7l1","manifestHash":"013672aa5927648264926e14d514d9d670ba04f547fc10aba6d50095b8e8b587","nodeId":"u9n7","order":70,"rewardIdentity":"v2.u9n7l1","schemaVersion":1,"sectionId":"sec2","signature":"LwcpNFP-0FB_0MU_yWZbxktFPQhpC9iM-1FO5ySNqwZkMFewlB_IUH4HouUCiyeQ3ek32xb9nsb_ZhakGVgNDA","signatureKeyId":"dev-content-1","skillIds":["u9.grammar","listening","speaking","u9.dialogue","reading","u9.story","u9.vocab"],"title":"Ôn tập cửa ải · Bài 1","unitId":"u9"}