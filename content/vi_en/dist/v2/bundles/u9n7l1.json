.grammar"],"type":"speakRepeat","vocabularyIds":["u9.shoes","u9.sale"]},{"content":{"tokens":[{"id":"t1","text":"mươi"},{"id":"t2","text":"mặt"},{"id":"t3","text":"Tôi"},{"id":"t4","text":"tiền"},{"id":"t5","text":"mát"},{"id":"t6","text":"bằng"},{"id":"t7","text":"ghế"},{"id":"t8","text":"hộ"},{"id":"t9","text":"trả"}]},"explanation":"Câu đúng: \"Tôi trả bằng tiền mặt.\".","gradingRule":{"caseSensitive":false,"correctTokenIds":["t3","t9","t6","t4","t2"],"ignoreDiacritics":false,"ignorePunctuation":false},"hint":"\"pay\" = trả tiền; \"cash\" = tiền mặt","id":"u9n7l1-e14","prompt":{"locale":"vi-VN","text":"Dịch sang tiếng Việt: \"I pay in cash.\""},"skillIds":["u9.grammar"],"type":"wordBank","vocabularyIds":["u9.pay","u9.cash"]},{"content":{"maxChars":200,"placeholder":"Viết bằng tiếng Anh"},"explanation":"Đáp án: \"The shoes are cheap, but the shirt is expensive.\".","gradingRule":{"acceptedText":["The shoes are cheap, but the shirt is expensive."],"caseSensitive":false,"ignoreDiacritics":false,"ignorePunctuation":true},"hint":"\"cheap\" = rẻ; \"expensive\" = đắt; \"shirt\" = áo sơ mi; \"shoes\" = giày","id":"u9n7l1-e15","prompt":{"locale":"vi-VN","text":"Giày thì rẻ, nhưng áo sơ mi thì đắt."},"skillIds":["u9.grammar"],"type":"textTranslation","vocabularyIds":["u9.cheap","u9.expensive","u9.shirt","u9.shoes"]}],"gradingRulesVersion":"g1","guideText":"Mẫu câu chính: \"How much is this dress?\" (Cái váy này bao nhiêu tiền?) — \"Can I pay by card?\" (Tôi trả bằng thẻ được không?) — \"It is on sale.\" (Nó đang giảm giá.)\nHow much is + số ít / How much are + số nhiều: \"How much are the shoes?\"\n\"Shoes\" luôn ở dạng số nhiều (một đôi giày = a pair of shoes).\nMàu sắc đứng trước danh từ: \"a red dress\" (một cái váy đỏ). Hỏi màu: \"What color is it?\"\nTrả tiền: pay in cash (tiền mặt) / pay by card (bằng thẻ). \"Expensive\" (đắt) ↔ \"cheap\" (rẻ).","lessonId":"u9n7l1","lessonVersion":"v2.u9n7l1","manifestHash":"013672aa5927648264926e14d514d9d670ba04f547fc10aba6d50095b8e