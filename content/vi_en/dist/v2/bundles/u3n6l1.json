"},{"id":"t4","text":"egg"},{"id":"t5","text":"breakfast"},{"id":"t6","text":"eat"}]},"explanation":"Câu đúng: \"I eat an egg for breakfast.\".","gradingRule":{"caseSensitive":false,"correctTokenIds":["t1","t6","t2","t4","t3","t5"],"ignoreDiacritics":false,"ignorePunctuation":false},"hint":"Câu bắt đầu bằng \"I\".","id":"u3n6l1-e10","prompt":{"locale":"vi-VN","text":"Sắp xếp thành câu đúng: \"Tôi ăn một quả trứng vào bữa sáng.\""},"skillIds":["u3.grammar"],"type":"sentenceOrder","vocabularyIds":["u3.eat","u3.breakfast","u3.egg"]},{"content":{"maxChars":40,"placeholder":"Điền từ còn thiếu"},"explanation":"Từ đúng: \"delicious\" → This rice is delicious.","gradingRule":{"acceptedText":["delicious"],"caseSensitive":false,"ignoreDiacritics":false,"ignorePunctuation":true},"hint":"\"ngon\" trong tiếng Anh là \"d...\"","id":"u3n6l1-e11","prompt":{"locale":"en-US","text":"This rice is ___. — \"Cơm này rất ngon.\""},"skillIds":["u3.grammar"],"type":"fillBlank","vocabularyIds":["u3.delicious","u3.rice"]},{"content":{"maxChars":200,"placeholder":"Viết bằng tiếng Anh"},"explanation":"Đáp án: \"The chicken is delicious.\".","gradingRule":{"acceptedText":["The chicken is delicious."],"caseSensitive":false,"ignoreDiacritics":false,"ignorePunctuation":true},"hint":"\"delicious\" = ngon; \"chicken\" = thịt gà","id":"u3n6l1-e12","prompt":{"locale":"vi-VN","text":"Thịt gà rất ngon."},"skillIds":["u3.grammar"],"type":"textTranslation","vocabularyIds":["u3.delicious","u3.chicken"]},{"content":{"tokens":[{"id":"t1","text":"has"},{"id":"t2","text":"fish"},{"id":"t3","text":"wife"},{"id":"t4","text":"lunch"},{"id":"t5","text":"for"},{"id":"t6","text":"mother"},{"id":"t7","text":"Tom"},{"id":"t8","text":"rice"}]},"explanation":"Câu đúng: \"Tom has rice for lunch.\".","gradingRule":{"caseSensitive":false,"correctTokenIds":["t7","t1","t8","t5","t4"],"ignoreDiacritics":false,"ignorePunctuation":false},"hint":"\"have\" = có; \"rice\" = cơm; \"lunch\" = bữa trưa","id":"u3n6l1-e13","prompt":{"locale":"vi-VN","text":"Dịch câu này: \"Tom ăn cơm vào bữa trưa.\""},"skillIds":["u3.grammar"],"type":"wordBank","vocabularyIds":["u2.have","u3.rice","u3.lunch"]}],"gradingRulesVersion":"g1","guideText":"Mẫu câu chính: \"Water, please.\" (Cho tôi nước.) — \"I like tea.\" (Tôi thích trà.) — \"Do you want coffee?\" (Bạn có muốn cà phê không?)\nMạo từ: \"a\" trước phụ âm (a banana), \"an\" trước nguyên âm (an apple, an egg).\nThì hiện tại đơn: he/she thêm -s: \"Kiko likes fish.\" Câu phủ định dùng do not / does not: \"Tom does not like coffee.\" (hay: doesn't).\nLịch sự khi gọi món: thêm \"please\" ở cuối câu. \"I want ...\" hơi thẳng; dùng \"..., please\" khi nói với người phục vụ.\nBữa ăn: breakfast (bữa sáng), lunch (bữa trưa), dinner (bữa tối) — nói \"for breakfast\" (cho bữa sáng).","lessonId":"u3n6l1","lessonVersion":"v2.u3n6l1","manifestHash":"013672aa5927648264926e14d514d9d670ba04f547fc10aba6d50095b8e8b587","nodeId":"u3n6","order":21,"rewardIdentity":"v2.u3n6l1","schemaVersion":1,"sectionId":"sec1","signature":"IYl72q8pj2q5BmXKGKmQzh80QLmR80Rqw0rDzapT7-I1yVWpMB5KsDjEvN9fdWqcD__IwSGhc0x6N26yh3MrAg","signatureKeyId":"dev-content-1","skillIds":["u3.vocab","u3.grammar","listening"],"title":"Ngon quá! · Bài 1","unitId":"u3"}