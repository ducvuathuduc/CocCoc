rked late yesterday."],"caseSensitive":false,"ignoreDiacritics":false,"ignorePunctuation":true},"hint":"Câu có 4 từ. Nghĩa: \"Hôm qua tôi làm việc muộn.\"","id":"u12n6l2-e10","nonAudioAlternative":{"content":{"maxChars":200,"placeholder":"Viết bằng tiếng Anh"},"explanation":"Đáp án: \"I worked late yesterday.\".","gradingRule":{"acceptedText":["I worked late yesterday."],"caseSensitive":false,"ignoreDiacritics":false,"ignorePunctuation":true},"hint":"\"work\" = làm việc; \"yesterday\" = hôm qua; \"late\" = muộn","id":"u12n6l2-e10a","prompt":{"locale":"vi-VN","text":"Hôm qua tôi làm việc muộn."},"skillIds":["listening","u12.grammar"],"type":"textTranslation","vocabularyIds":["u12.work","u12.yesterday","u12.late"]},"prompt":{"audioAssetId":"a.u12.s25.n","locale":"vi-VN","text":"Nghe và viết lại bằng tiếng Anh"},"skillIds":["listening","u12.grammar"],"type":"dictation","vocabularyIds":["u12.work","u12.yesterday","u12.late"]},{"content":{"tokens":[{"id":"t1","text":"day"},{"id":"t2","text":"every"},{"id":"t3","text":"Chi"},{"id":"t4","text":"coffee"},{"id":"t5","text":"ticket"},{"id":"t6","text":"emails"},{"id":"t7","text":"many"},{"id":"t8","text":"write"},{"id":"t9","text":"I"}]},"explanation":"Câu đúng: \"I write many emails every day.\".","gradingRule":{"caseSensitive":false,"correctTokenIds":["t9","t8","t7","t6","t2","t1"],"ignoreDiacritics":false,"ignorePunctuation":false},"hint":"\"many\" = nhiều; \"day\" = ngày; \"every\" = mỗi; \"write\" = viết","id":"u12n6l2-e11","prompt":{"locale":"vi-VN","text":"Dịch câu này: \"Tôi viết nhiều email mỗi ngày.\""},"skillIds":["u12.grammar"],"type":"wordBank","vocabularyIds":["u4.many","u5.day","u5.every","u7.write","u12.email"]},{"content":{"maxChars":200,"placeholder":"Viết bằng tiếng Anh"},"explanation":"Đáp án: \"I have a job interview today.\".","gradingRule":{"acceptedText":["I have a job interview today."],"caseSensitive":false,"ignoreDiacritics":false,"ignorePunctuation":true},"hint":"\"have\" = có; \"today\" = hôm nay; \"job\" = công việc; \"interview\" = buổi phỏng vấn","id":"u12n6l2-e12","prompt":{"locale":"vi-VN","text":"Hôm nay tôi có buổi phỏng vấn xin việc."},"skillIds":["u12.grammar"],"type":"textTranslation","vocabularyIds":["u2.have","u5.today","u12.job","u12.interview"]}],"gradingRulesVersion":"g1","guideText":"Mẫu câu chính: \"What do you do?\" (Bạn làm nghề gì?) — \"I am an engineer.\" (Tôi là kỹ sư.) — \"I worked late yesterday.\" (Hôm qua tôi làm việc muộn.)\nNghề nghiệp luôn có a/an: \"She is a nurse\", \"He is an engineer\" (an trước nguyên âm).\nThì quá khứ đơn (động từ có quy tắc): thêm -ed: work → worked, start → started, finish → finished. Quá khứ của \"be\": I/he/she was, you/we/they were.\nCâu hỏi quá khứ dùng \"did\" + động từ nguyên mẫu: \"Did you finish your work?\" (không nói \"Did you finished\").\nMốc thời gian quá khứ: yesterday (hôm qua), last week (tuần trước).","lessonId":"u12n6l2","lessonVersion":"v2.u12n6l2","manifestHash":"013672aa5927648264926e14d514d9d670ba04f547fc10aba6d50095b8e8b587","nodeId":"u12n6","order":93,"rewardIdentity":"v2.u12n6l2","schemaVersion":1,"sectionId":"sec2","signature":"fLlr9mksRD2LJ_j2f_F1e3CGKKuOc8qlFFU_uPnalePrwcXwT5O2WLM0pAv7632LRey19ZJGEJR22oOgy8AMCA","signatureKeyId":"dev-content-1","skillIds":["u12.vocab","u12.grammar","listening"],"title":"Hôm qua · Bài 2","unitId":"u12"}