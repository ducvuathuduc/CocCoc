","gradingRule":{"caseSensitive":false,"correctTokenIds":["t6","t4","t8","t3"],"ignoreDiacritics":false,"ignorePunctuation":false},"hint":"\"mother\" = mẹ; \"home\" = nhà","id":"u5n7l1-e14","prompt":{"locale":"vi-VN","text":"Dịch sang tiếng Việt: \"My mother is at home.\""},"skillIds":["u5.grammar"],"type":"wordBank","vocabularyIds":["u2.mother","u5.home"]},{"content":{"maxChars":200,"placeholder":"Viết bằng tiếng Anh"},"explanation":"Đáp án: \"I get up at six o'clock.\".","gradingRule":{"acceptedText":["I get up at six o'clock."],"caseSensitive":false,"ignoreDiacritics":false,"ignorePunctuation":true},"hint":"\"six\" = sáu; \"o'clock\" = giờ (đúng); \"get up\" = thức dậy","id":"u5n7l1-e15","prompt":{"locale":"vi-VN","text":"Tôi thức dậy lúc sáu giờ."},"skillIds":["u5.grammar"],"type":"textTranslation","vocabularyIds":["u4.six","u5.oclock","u5.get_up"]}],"gradingRulesVersion":"g1","guideText":"Mẫu câu chính: \"What time is it?\" (Mấy giờ rồi?) — \"It is seven o'clock.\" (Bảy giờ rồi.) — \"I get up at six.\" (Tôi dậy lúc sáu giờ.)\nGiới từ thời gian: at + giờ (at six o'clock), on + thứ (on Monday), in + buổi (in the morning, in the evening).\nThì hiện tại đơn cho thói quen: \"Mai goes to school every day.\" Với he/she/it: go → goes, get up → gets up.\nTrạng từ tần suất đứng TRƯỚC động từ thường: \"I always eat breakfast\", \"Kiko never eats bread\". Thứ tự: always > usually > sometimes > never.\nThứ trong tuần luôn viết hoa: Monday, Sunday.","lessonId":"u5n7l1","lessonVersion":"v2.u5n7l1","manifestHash":"013672aa5927648264926e14d514d9d670ba04f547fc10aba6d50095b8e8b587","nodeId":"u5n7","order":38,"rewardIdentity":"v2.u5n7l1","schemaVersion":1,"sectionId":"sec1","signature":"k-A5OTRgHdF8P8iz2IK8w1pekFy7LejA6CBZQ3JUNIjtTb6W2DHXn81PrCEVFSw4UJUDFhK6KRYguhVJ9fkiAw","signatureKeyId":"dev-content-1","skillIds":["u5.grammar","listening","speaking","u5.dialogue","reading","u5.story","u5.vocab"],"title":"Ôn tập cửa ải · Bài 1","unitId":"u5"}