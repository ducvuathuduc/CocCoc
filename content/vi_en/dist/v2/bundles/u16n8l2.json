.\"","lessonId":"u16n8l2","lessonVersion":"v2.u16n8l2","manifestHash":"013672aa5927648264926e14d514d9d670ba04f547fc10aba6d50095b8e8b587","nodeId":"u16n8","order":127,"rewardIdentity":"v2.u16n8l2","schemaVersion":1,"sectionId":"sec2","signature":"rukhHpSBRzxJ6LtMaXwtt7cU6_MzDTr2SNcCL6AVEck65PtinHV1pnZfM8Cc3MU7nQ9pd3W6bckVHfazIMOYDA","signatureKeyId":"dev-content-1","skillIds":["u16.grammar","listening","speaking","u16.dialogue"],"title":"Huyền thoại · Bài 2","unitId":"u16"}