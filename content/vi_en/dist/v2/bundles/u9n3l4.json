ngRule":{"acceptedText":["How much is this dress?"],"caseSensitive":false,"ignoreDiacritics":false,"ignorePunctuation":true},"hint":"Nghĩa: \"Cái váy này bao nhiêu tiền?\"","id":"u9n3l4-e11","nonSpeechAlternative":{"content":{"tokens":[{"id":"t1","text":"this"},{"id":"t2","text":"How"},{"id":"t3","text":"dress"},{"id":"t4","text":"much"},{"id":"t5","text":"is"}]},"explanation":"Câu đúng: \"How much is this dress?\".","gradingRule":{"caseSensitive":false,"correctTokenIds":["t2","t4","t5","t1","t3"],"ignoreDiacritics":false,"ignorePunctuation":false},"hint":"Câu bắt đầu bằng \"How\".","id":"u9n3l4-e11a","prompt":{"locale":"vi-VN","text":"Sắp xếp thành câu đúng: \"Cái váy này bao nhiêu tiền?\""},"skillIds":["speaking","u9.grammar"],"type":"sentenceOrder","vocabularyIds":["u9.dress"]},"prompt":{"audioAssetId":"a.u9.s9.n","locale":"en-US","text":"Nói câu sau: \"How much is this dress?\""},"skillIds":["speaking","u9.grammar"],"type":"speakRepeat","vocabularyIds":["u9.dress"]},{"content":{"maxChars":200,"placeholder":"Viết bằng tiếng Việt (có dấu)"},"explanation":"Đáp án: \"Tôi có thể mua điện thoại ở đâu?\". Cũng đúng: \"Tôi mua điện thoại ở đâu được?\", \"Mình có thể mua điện thoại ở đâu?\".","gradingRule":{"acceptedText":["Tôi có thể mua điện thoại ở đâu?","Tôi mua điện thoại ở đâu được?","Mình có thể mua điện thoại ở đâu?","Mình mua điện thoại ở đâu được?"],"caseSensitive":false,"ignoreDiacritics":false,"ignorePunctuation":true},"hint":"\"where\" = ở đâu; \"phone\" = điện thoại; \"can\" = có thể; \"buy\" = mua","id":"u9n3l4-e12","prompt":{"locale":"en-US","text":"Where can I buy a phone?"},"skillIds":["u9.grammar"],"type":"textTranslation","vocabularyIds":["u1.where","u4.phone","u7.can","u9.buy"]}],"gradingRulesVersion":"g1","guideText":"Mẫu câu chính: \"How much is this dress?\" (Cái váy này bao nhiêu tiền?) — \"Can I pay by card?\" (Tôi trả bằng thẻ được không?) — \"It is on sale.\" (Nó đang giảm giá.)\nHow much is + số ít / How much are + số nhiều: \"How much are the shoes?\"\n\"Shoes\" luôn ở dạng số nhiều (một đôi giày = a pair of shoes).\nMàu sắc đứng trước danh từ: \"a red dress\" (một cái váy đỏ). Hỏi màu: \"What color is it?\"\nTrả tiền: pay in cash (tiền mặt) / pay by card (bằng thẻ). \"Expensive\" (đắt) ↔ \"cheap\" (rẻ).","lessonId":"u9n3l4","lessonVersion":"v2.u9n3l4","manifestHash":"013672aa5927648264926e14d514d9d670ba04f547fc10aba6d50095b8e8b587","nodeId":"u9n3","order":66,"rewardIdentity":"v2.u9n3l4","schemaVersion":1,"sectionId":"sec2","signature":"yVNzNpwl7s-NCObJtOWjr4GJZDk7DPh8qQ6n5uxr8Ux3J-f4dubQcX5ZmNvUWW9ZHMVZaLdsOmfRFZkCbL2vBw","signatureKeyId":"dev-content-1","skillIds":["speaking","u9.grammar","u9.dialogue","u9.vocab"],"title":"Màu sắc · Bài 4","unitId":"u9"}