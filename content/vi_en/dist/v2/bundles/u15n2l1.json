d."],"caseSensitive":false,"ignoreDiacritics":false,"ignorePunctuation":true},"hint":"\"kind\" = tử tế","id":"u15n2l1-e12","prompt":{"locale":"vi-VN","text":"Bà Rosa rất tử tế."},"skillIds":["u15.grammar"],"type":"textTranslation","vocabularyIds":["u15.kind"]},{"content":{"tokens":[{"id":"t1","text":"take"},{"id":"t2","text":"My"},{"id":"t3","text":"bored"},{"id":"t4","text":"straight"},{"id":"t5","text":"is"},{"id":"t6","text":"father"},{"id":"t7","text":"angry"}]},"explanation":"Câu đúng: \"My father is angry.\".","gradingRule":{"caseSensitive":false,"correctTokenIds":["t2","t6","t5","t7"],"ignoreDiacritics":false,"ignorePunctuation":false},"hint":"\"father\" = bố; \"angry\" = tức giận","id":"u15n2l1-e13","prompt":{"locale":"vi-VN","text":"Dịch câu này: \"Bố tôi đang tức giận.\""},"skillIds":["u15.grammar"],"type":"wordBank","vocabularyIds":["u2.father","u15.angry"]}],"gradingRulesVersion":"g1","guideText":"Mẫu câu chính: \"Why are you sad?\" (Sao bạn buồn?) — \"Nam is taller than Tom.\" (Nam cao hơn Tom.) — \"Happy birthday!\" (Chúc mừng sinh nhật!)\nSo sánh hơn với tính từ ngắn: thêm -er + than: tall → taller than, young → younger than, smart → smarter than.\nTính từ cảm xúc đuôi -ed mô tả cảm giác của người: I am bored, I am excited, She was surprised.\nGiới từ đi kèm: afraid of (sợ), worried about (lo về), excited about (háo hức về).\nLời khuyên nhẹ nhàng: \"Don't be sad.\" (Đừng buồn.)","lessonId":"u15n2l1","lessonVersion":"v2.u15n2l1","manifestHash":"013672aa5927648264926e14d514d9d670ba04f547fc10aba6d50095b8e8b587","nodeId":"u15n2","order":113,"rewardIdentity":"v2.u15n2l1","schemaVersion":1,"sectionId":"sec2","signature":"ryXd_54n193L7aMoiW5bR29qPQmjDoABkbpT3f8QnlA8BU6807Wm8GqvEqFuvmqY1RqPXWDRDvYQ59mdaYydCg","signatureKeyId":"dev-content-1","skillIds":["u15.vocab","u15.grammar","listening"],"title":"Cao hơn, trẻ hơn · Bài 1","unitId":"u15"}