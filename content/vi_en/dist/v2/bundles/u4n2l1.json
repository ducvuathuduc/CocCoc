":{"caseSensitive":false,"correctTokenIds":["t6","t5","t1"],"ignoreDiacritics":false,"ignorePunctuation":false},"hint":"\"please\" = làm ơn; \"apple\" = quả táo; \"three\" = ba (số 3)","id":"u4n2l1-e13","prompt":{"locale":"vi-VN","text":"Dịch câu này: \"Làm ơn cho tôi ba quả táo.\""},"skillIds":["u4.grammar"],"type":"wordBank","vocabularyIds":["u1.please","u3.apple","u4.three"]}],"gradingRulesVersion":"g1","guideText":"Mẫu câu chính: \"How old are you?\" (Bạn bao nhiêu tuổi?) — \"I am twenty years old.\" (Tôi hai mươi tuổi.) — \"How many books do you have?\" (Bạn có bao nhiêu quyển sách?)\nSố nhiều: thêm -s sau danh từ khi nhiều hơn một: one cat, two cats; one egg, six eggs. Tiếng Việt không đổi danh từ, nhưng tiếng Anh thì có.\nTuổi: dùng \"be\", không dùng \"have\": \"I am ten years old\" hoặc ngắn gọn \"I am ten\". Không nói \"I have ten years\".\nSố: 20 = twenty, 28 = twenty-eight (có gạch nối), 100 = a hundred / one hundred.\n\"How many + danh từ số nhiều\": How many pens? How many cats?","lessonId":"u4n2l1","lessonVersion":"v2.u4n2l1","manifestHash":"013672aa5927648264926e14d514d9d670ba04f547fc10aba6d50095b8e8b587","nodeId":"u4n2","order":25,"rewardIdentity":"v2.u4n2l1","schemaVersion":1,"sectionId":"sec1","signature":"zjMyBbfm-_mu2FJA0PA15yjAiGnaAP35F4QkQESQHazsQ4Kbwo4aAHf-Ej2Ygi3A0qqte5eqj2AstSSg7TkQAQ","signatureKeyId":"dev-content-1","skillIds":["u4.vocab","u4.grammar","listening"],"title":"Năm đến tám · Bài 1","unitId":"u4"}