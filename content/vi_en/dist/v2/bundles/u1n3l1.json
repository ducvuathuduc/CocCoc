ent":{"tokens":[{"id":"t1","text":"a"},{"id":"t2","text":"too"},{"id":"t3","text":"my"},{"id":"t4","text":"Linh"},{"id":"t5","text":"Mai"},{"id":"t6","text":"is"},{"id":"t7","text":"Mr"},{"id":"t8","text":"student"}]},"explanation":"Câu đúng: \"Linh is a student too.\".","gradingRule":{"caseSensitive":false,"correctTokenIds":["t4","t6","t1","t8","t2"],"ignoreDiacritics":false,"ignorePunctuation":false},"hint":"\"student\" = học sinh","id":"u1n3l1-e13","prompt":{"locale":"vi-VN","text":"Dịch câu này: \"Linh cũng là học sinh.\""},"skillIds":["u1.grammar"],"type":"wordBank","vocabularyIds":["u1.student"]}],"gradingRulesVersion":"g1","guideText":"Mẫu câu chính: \"Hello, I am Mai.\" (Xin chào, tôi là Mai.) — \"What is your name?\" (Bạn tên là gì?) — \"Nice to meet you.\" (Rất vui được gặp bạn.)\nNgữ pháp: động từ \"to be\": I am, you are, he/she is. Khi nói, người bản xứ hay rút gọn: I'm, you're, he's, she's. Cả hai cách viết đều được chấp nhận.\nMẹo: \"I\" luôn viết hoa. Dùng \"a\" trước nghề nghiệp: \"I am a student.\" Tiếng Việt có thể bỏ \"một\", tiếng Anh thì không.\nLịch sự: \"Excuse me\" dùng để bắt chuyện, \"Sorry\" dùng khi xin lỗi vì lỗi của mình.","lessonId":"u1n3l1","lessonVersion":"v2.u1n3l1","manifestHash":"013672aa5927648264926e14d514d9d670ba04f547fc10aba6d50095b8e8b587","nodeId":"u1n3","order":2,"rewardIdentity":"v2.u1n3l1","schemaVersion":1,"sectionId":"sec1","signature":"VpPPCjp56qdGWBqAmYi-6hYiVaWdmi4PTSTndblCGYa_9PE2mB2NPJ88czkP4Onbon7Up_gwxZT5GU7VKG1lAA","signatureKeyId":"dev-content-1","skillIds":["u1.vocab","u1.grammar","listening"],"title":"Lời lịch sự · Bài 1","unitId":"u1"}