llIds":["u5.grammar"],"type":"textTranslation","vocabularyIds":["u3.eat","u3.breakfast","u4.six","u5.oclock"]}],"gradingRulesVersion":"g1","guideText":"Mẫu câu chính: \"What time is it?\" (Mấy giờ rồi?) — \"It is seven o'clock.\" (Bảy giờ rồi.) — \"I get up at six.\" (Tôi dậy lúc sáu giờ.)\nGiới từ thời gian: at + giờ (at six o'clock), on + thứ (on Monday), in + buổi (in the morning, in the evening).\nThì hiện tại đơn cho thói quen: \"Mai goes to school every day.\" Với he/she/it: go → goes, get up → gets up.\nTrạng từ tần suất đứng TRƯỚC động từ thường: \"I always eat breakfast\", \"Kiko never eats bread\". Thứ tự: always > usually > sometimes > never.\nThứ trong tuần luôn viết hoa: Monday, Sunday.","lessonId":"u5n2l2","lessonVersion":"v2.u5n2l2","manifestHash":"013672aa5927648264926e14d514d9d670ba04f547fc10aba6d50095b8e8b587","nodeId":"u5n2","order":33,"rewardIdentity":"v2.u5n2l2","schemaVersion":1,"sectionId":"sec1","signature":"Jaw-pS_-_9W-qS1-55C091xox3gYrdVPnURZxc5_q1fTwE5CMy_mtO_t8vIza2NTJB14xrtiqWkqIP9DAO1CDQ","signatureKeyId":"dev-content-1","skillIds":["u5.vocab","u5.grammar","listening"],"title":"Đi học, về nhà · Bài 2","unitId":"u5"}