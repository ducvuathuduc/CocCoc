ng Việt (có dấu)"},"explanation":"Đáp án: \"Tôi bị đau bụng.\". Cũng đúng: \"Bụng tôi đau.\", \"Mình bị đau bụng.\".","gradingRule":{"acceptedText":["Tôi bị đau bụng.","Bụng tôi đau.","Mình bị đau bụng.","Bụng mình đau."],"caseSensitive":false,"ignoreDiacritics":false,"ignorePunctuation":true},"hint":"\"hurt\" = đau; \"stomach\" = bụng","id":"u14n4l2-e07","prompt":{"locale":"en-US","text":"My stomach hurts."},"skillIds":["u14.grammar"],"type":"textTranslation","vocabularyIds":["u14.hurt","u14.stomach"]},{"content":{"tokens":[{"id":"t1","text":"have"},{"id":"t2","text":"headache"},{"id":"t3","text":"a"},{"id":"t4","text":"I"}]},"explanation":"Câu đúng: \"I have a headache.\".","gradingRule":{"caseSensitive":false,"correctTokenIds":["t4","t1","t3","t2"],"ignoreDiacritics":false,"ignorePunctuation":false},"hint":"Câu bắt đầu bằng \"I\".","id":"u14n4l2-e08","prompt":{"locale":"vi-VN","text":"Sắp xếp thành câu đúng: \"Tôi bị đau đầu.\""},"skillIds":["u14.grammar"],"type":"sentenceOrder","vocabularyIds":["u2.have","u14.headache"]},{"content":{"pairs":[{"id":"p1","left":{"id":"p1l","text":"feel"},"right":{"id":"p1r","text":"cảm thấy"}},{"id":"p2","left":{"id":"p2l","text":"stomach"},"right":{"id":"p2r","text":"bụng"}},{"id":"p3","left":{"id":"p3l","text":"sick"},"right":{"id":"p3r","text":"ốm"}},{"id":"p4","left":{"id":"p4l","text":"fever"},"right":{"id":"p4r","text":"sốt"}},{"id":"p5","left":{"id":"p5l","text":"medicine"},"right":{"id":"p5r","text":"thuốc"}}]},"explanation":"feel = cảm thấy; stomach = bụng; sick = ốm; fever = sốt; medicine = thuốc","gradingRule":{"caseSensitive":false,"correctPairIds":["p1","p2","p3","p4","p5"],"ignoreDiacritics":false,"ignorePunctuation":false},"hint":"Ví dụ: \"feel\" = \"cảm thấy\".","id":"u14n4l2-e09","prompt":{"locale":"vi-VN","text":"Nối các cặp từ tương ứng"},"skillIds":["u14.vocab"],"type":"matchPairs","vocabularyIds":["u14.feel","u14.stomach","u14.sick","u14.fever","u14.medicine"]},{"content":{"maxChars":200,"placeholder":"Viết bằng tiếng Anh"},"explanation":"Đáp án: \"Take this medicine.\".","gradingRule":{"acceptedText":["Take this medicine."],"caseSensitive":false,"ignoreDiacritics":false,"ignorePunctuation":true},"hint":"\"medicine\" = thuốc","id":"u14n4l2-e10","prompt":{"locale":"vi-VN","text":"Hãy uống thuốc này."},"skillIds":["u14.grammar"],"type":"textTranslation","vocabularyIds":["u14.medicine"]},{"content":{"choices":[{"id":"c1","imageAssetId":"i.u6.sofa","text":"sofa"},{"id":"c2","imageAssetId":"i.u14.pharmacy","text":"pharmacy"},{"id":"c3","imageAssetId":"i.u6.lamp","text":"lamp"},{"id":"c4","imageAssetId":"i.u3.water","text":"water"}]},"explanation":"\"pharmacy\" = \"hiệu thuốc\".","gradingRule":{"caseSensitive":false,"correctChoiceId":"c2","ignoreDiacritics":false,"ignorePunctuation":false},"hint":"\"hiệu thuốc\" là \"pharmacy\".","id":"u14n4l2-e11","prompt":{"locale":"vi-VN","text":"Hình nào là \"hiệu thuốc\"?"},"skillIds":["u14.vocab"],"type":"imageChoice","vocabularyIds":["u14.pharmacy"]}],"gradingRulesVersion":"g1","guideText":"Mẫu câu chính: \"How do you feel?\" (Bạn thấy thế nào?) — \"I have a headache.\" (Tôi bị đau đầu.) — \"You should rest.\" (Bạn nên nghỉ ngơi.)\nBệnh dùng \"have\": have a fever (bị sốt), have a cough (bị ho), have a headache (bị đau đầu). Tính từ dùng \"be\": I am sick, I am tired.\nChỗ đau: \"My stomach hurts\" (Tôi bị đau bụng) — động từ \"hurt\" thêm -s với he/she/it và danh từ số ít.\nLời khuyên: should / should not (shouldn't) + động từ nguyên mẫu: \"You should eat more vegetables.\"\nSố nhiều bất quy tắc: one tooth → two teeth.","lessonId":"u14n4l2","lessonVersion":"v2.u14n4l2","manifestHash":"013672aa5927648264926e14d514d9d670ba04f547fc10aba6d50095b8e8b587","nodeId":"u14n4","order":107,"rewardIdentity":"v2.u14n4l2","schemaVersion":1,"sectionId":"sec2","signature":"WlpzKd8vq7rdwC1uk61_Yh6lakrHCqmyJFtJHdQzTDMnyCsaFhGQEPOsblCrUdi8kBjBu2x_B6Z9GRVkdG8GAw","signatureKeyId":"dev-content-1","skillIds":["reading","u14.story","u14.grammar","speaking","u14.dialogue","listening","u14.vocab"],"title":"Truyện: Nam bị ốm · Bài 2","unitId":"u14"}