er"]},"prompt":{"audioAssetId":"a.u3.s1.n","locale":"en-US","text":"Nói câu sau: \"Water, please.\""},"skillIds":["speaking","u3.grammar"],"type":"speakRepeat","vocabularyIds":["u1.please","u3.water"]},{"content":{"maxChars":200,"placeholder":"Viết bằng tiếng Việt (có dấu)"},"explanation":"Đáp án: \"Tôi có bánh mì.\". Cũng đúng: \"Mình có bánh mì.\".","gradingRule":{"acceptedText":["Tôi có bánh mì.","Mình có bánh mì."],"caseSensitive":false,"ignoreDiacritics":false,"ignorePunctuation":true},"hint":"\"have\" = có; \"bread\" = bánh mì","id":"u3n2l4-e12","prompt":{"locale":"en-US","text":"I have bread."},"skillIds":["u3.grammar"],"type":"textTranslation","vocabularyIds":["u2.have","u3.bread"]}],"gradingRulesVersion":"g1","guideText":"Mẫu câu chính: \"Water, please.\" (Cho tôi nước.) — \"I like tea.\" (Tôi thích trà.) — \"Do you want coffee?\" (Bạn có muốn cà phê không?)\nMạo từ: \"a\" trước phụ âm (a banana), \"an\" trước nguyên âm (an apple, an egg).\nThì hiện tại đơn: he/she thêm -s: \"Kiko likes fish.\" Câu phủ định dùng do not / does not: \"Tom does not like coffee.\" (hay: doesn't).\nLịch sự khi gọi món: thêm \"please\" ở cuối câu. \"I want ...\" hơi thẳng; dùng \"..., please\" khi nói với người phục vụ.\nBữa ăn: breakfast (bữa sáng), lunch (bữa trưa), dinner (bữa tối) — nói \"for breakfast\" (cho bữa sáng).","lessonId":"u3n2l4","lessonVersion":"v2.u3n2l4","manifestHash":"013672aa5927648264926e14d514d9d670ba04f547fc10aba6d50095b8e8b587","nodeId":"u3n2","order":17,"rewardIdentity":"v2.u3n2l4","schemaVersion":1,"sectionId":"sec1","signature":"Y08r5gtfJm7fLWlTyY5-oYBeF5v3EqU-NV43TqYBMrTMyGHDThAcs4XAXwXPcvBhkTMeZ_-8085rolXqorCBCQ","signatureKeyId":"dev-content-1","skillIds":["speaking","u3.grammar","u3.dialogue","u3.vocab"],"title":"Trà hay cà phê? · Bài 4","unitId":"u3"}