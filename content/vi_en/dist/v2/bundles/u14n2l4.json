t4","text":"headache"}]},"explanation":"Câu đúng: \"I have a headache.\".","gradingRule":{"caseSensitive":false,"correctTokenIds":["t3","t2","t1","t4"],"ignoreDiacritics":false,"ignorePunctuation":false},"hint":"Câu bắt đầu bằng \"I\".","id":"u14n2l4-e11a","prompt":{"locale":"vi-VN","text":"Sắp xếp thành câu đúng: \"Tôi bị đau đầu.\""},"skillIds":["speaking","u14.grammar"],"type":"sentenceOrder","vocabularyIds":["u2.have","u14.headache"]},"prompt":{"audioAssetId":"a.u14.s3.n","locale":"en-US","text":"Nói câu sau: \"I have a headache.\""},"skillIds":["speaking","u14.grammar"],"type":"speakRepeat","vocabularyIds":["u2.have","u14.headache"]},{"content":{"maxChars":200,"placeholder":"Viết bằng tiếng Việt (có dấu)"},"explanation":"Đáp án: \"Tôi rất mệt sau giờ làm.\". Cũng đúng: \"Sau giờ làm tôi rất mệt.\", \"Mình rất mệt sau giờ làm.\".","gradingRule":{"acceptedText":["Tôi rất mệt sau giờ làm.","Sau giờ làm tôi rất mệt.","Mình rất mệt sau giờ làm.","Sau giờ làm mình rất mệt."],"caseSensitive":false,"ignoreDiacritics":false,"ignorePunctuation":true},"hint":"\"work\" = làm việc; \"tired\" = mệt","id":"u14n2l4-e12","prompt":{"locale":"en-US","text":"I am very tired after work."},"skillIds":["u14.grammar"],"type":"textTranslation","vocabularyIds":["u12.work","u14.tired"]}],"gradingRulesVersion":"g1","guideText":"Mẫu câu chính: \"How do you feel?\" (Bạn thấy thế nào?) — \"I have a headache.\" (Tôi bị đau đầu.) — \"You should rest.\" (Bạn nên nghỉ ngơi.)\nBệnh dùng \"have\": have a fever (bị sốt), have a cough (bị ho), have a headache (bị đau đầu). Tính từ dùng \"be\": I am sick, I am tired.\nChỗ đau: \"My stomach hurts\" (Tôi bị đau bụng) — động từ \"hurt\" thêm -s với he/she/it và danh từ số ít.\nLời khuyên: should / should not (shouldn't) + động từ nguyên mẫu: \"You should eat more vegetables.\"\nSố nhiều bất quy tắc: one tooth → two teeth.","lessonId":"u14n2l4","lessonVersion":"v2.u14n2l4","manifestHash":"013672aa5927648264926e14d514d9d670ba04f547fc10aba6d50095b8e8b587",