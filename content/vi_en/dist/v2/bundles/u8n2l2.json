mmar"],"type":"textTranslation","vocabularyIds":["u5.today","u8.sunny"]},"prompt":{"audioAssetId":"a.u8.s7.n","locale":"vi-VN","text":"Nghe và viết lại bằng tiếng Anh"},"skillIds":["listening","u8.grammar"],"type":"dictation","vocabularyIds":["u5.today","u8.sunny"]},{"content":{"tokens":[{"id":"t1","text":"Water"},{"id":"t2","text":"hot"},{"id":"t3","text":"sunny"},{"id":"t4","text":"today"},{"id":"t5","text":"hungry"},{"id":"t6","text":"It"},{"id":"t7","text":"is"}]},"explanation":"Câu đúng: \"It is hot today.\".","gradingRule":{"caseSensitive":false,"correctTokenIds":["t6","t7","t2","t4"],"ignoreDiacritics":false,"ignorePunctuation":false},"hint":"\"today\" = hôm nay; \"hot\" = nóng","id":"u8n2l2-e11","prompt":{"locale":"vi-VN","text":"Dịch câu này: \"Hôm nay trời nóng.\""},"skillIds":["u8.grammar"],"type":"wordBank","vocabularyIds":["u5.today","u8.hot"]},{"content":{"maxChars":200,"placeholder":"Viết bằng tiếng Anh"},"explanation":"Đáp án: \"Is it cold now?\".","gradingRule":{"acceptedText":["Is it cold now?"],"caseSensitive":false,"ignoreDiacritics":false,"ignorePunctuation":true},"hint":"\"now\" = bây giờ; \"cold\" = lạnh","id":"u8n2l2-e12","prompt":{"locale":"vi-VN","text":"Bây giờ trời có lạnh không?"},"skillIds":["u8.grammar"],"type":"textTranslation","vocabularyIds":["u5.now","u8.cold"]}],"gradingRulesVersion":"g1","guideText":"Mẫu câu chính: \"How is the weather today?\" (Thời tiết hôm nay thế nào?) — \"It is sunny.\" (Trời nắng.) — \"It is raining.\" (Trời đang mưa.)\nChủ ngữ giả \"it\": tiếng Việt nói \"trời nắng\", tiếng Anh phải có chủ ngữ: \"It is sunny\", không nói \"Is sunny\".\nThì hiện tại tiếp diễn cho việc đang xảy ra: It is raining now. So sánh: It is rainy (trời có mưa — mô tả chung).\nMùa: in (the) summer, in winter. Miền Nam Việt Nam có hai mùa: the dry season (mùa khô) và the rainy season (mùa mưa).\n\"Fall\" là cách Mỹ gọi mùa thu; \"autumn\" dùng ở Anh — cả hai đều đúng.","lessonId":"u8n2l2","lessonVersion":"v2.u8n2l2","manifestHash":"013