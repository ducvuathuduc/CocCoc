acritics":false,"ignorePunctuation":true},"hint":"Nghĩa: \"Nam thức dậy lúc bảy giờ.\"","id":"u5n6l4-e11","nonSpeechAlternative":{"content":{"tokens":[{"id":"t1","text":"seven"},{"id":"t2","text":"at"},{"id":"t3","text":"Nam"},{"id":"t4","text":"gets"},{"id":"t5","text":"up"}]},"explanation":"Câu đúng: \"Nam gets up at seven.\".","gradingRule":{"caseSensitive":false,"correctTokenIds":["t3","t4","t5","t2","t1"],"ignoreDiacritics":false,"ignorePunctuation":false},"hint":"Câu bắt đầu bằng \"Nam\".","id":"u5n6l4-e11a","prompt":{"locale":"vi-VN","text":"Sắp xếp thành câu đúng: \"Nam thức dậy lúc bảy giờ.\""},"skillIds":["speaking","u5.grammar"],"type":"sentenceOrder","vocabularyIds":["u4.seven","u5.get_up"]},"prompt":{"audioAssetId":"a.u5.s10.n","locale":"en-US","text":"Nói câu sau: \"Nam gets up at seven.\""},"skillIds":["speaking","u5.grammar"],"type":"speakRepeat","vocabularyIds":["u4.seven","u5.get_up"]},{"content":{"maxChars":200,"placeholder":"Viết bằng tiếng Việt (có dấu)"},"explanation":"Đáp án: \"Chúng tôi ăn tối vào buổi tối.\". Cũng đúng: \"Chúng tôi ăn bữa tối vào buổi tối.\", \"Chúng mình ăn tối vào buổi tối.\".","gradingRule":{"acceptedText":["Chúng tôi ăn tối vào buổi tối.","Chúng tôi ăn bữa tối vào buổi tối.","Chúng mình ăn tối vào buổi tối.","Chúng mình ăn bữa tối vào buổi tối."],"caseSensitive":false,"ignoreDiacritics":false,"ignorePunctuation":true},"hint":"\"eat\" = ăn; \"dinner\" = bữa tối; \"evening\" = buổi tối","id":"u5n6l4-e12","prompt":{"locale":"en-US","text":"We eat dinner in the evening."},"skillIds":["u5.grammar"],"type":"textTranslation","vocabularyIds":["u3.eat","u3.dinner","u5.evening"]}],"gradingRulesVersion":"g1","guideText":"Mẫu câu chính: \"What time is it?\" (Mấy giờ rồi?) — \"It is seven o'clock.\" (Bảy giờ rồi.) — \"I get up at six.\" (Tôi dậy lúc sáu giờ.)\nGiới từ thời gian: at + giờ (at six o'clock), on + thứ (on Monday), in + buổi (in the morning, in the evening).\nThì hiện tại đơn cho thói quen: \"Mai goes to school every day.\" Với he/she/it: go → goes, get up → gets up.\nTrạng từ tần suất đứng TRƯỚC động từ thường: \"I always eat breakfast\", \"Kiko never eats bread\". Thứ tự: always > usually > sometimes > never.\nThứ trong tuần luôn viết hoa: Monday, Sunday.","lessonId":"u5n6l4","lessonVersion":"v2.u5n6l4","manifestHash":"013672aa5927648264926e14d514d9d670ba04f547fc10aba6d50095b8e8b587","nodeId":"u5n6","order":37,"rewardIdentity":"v2.u5n6l4","schemaVersion":1,"sectionId":"sec1","signature":"-tXevZ4rg7bASP78qKDZrIFDZvYaTH0PcnP-W4uHF76vxr2lyQGQMFRmAIR2RptBmvvwxh6zmJIeIyBbUN_vDw","signatureKeyId":"dev-content-1","skillIds":["speaking","u5.grammar","u5.dialogue","u5.vocab"],"title":"Luôn luôn, thỉnh thoảng · Bài 4","unitId":"u5"}