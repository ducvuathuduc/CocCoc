skillIds":["u7.grammar"],"type":"textTranslation","vocabularyIds":["u7.english","u7.read","u7.can"]},{"content":{"tokens":[{"id":"t1","text":"Mai"},{"id":"t2","text":"learns"},{"id":"t3","text":"Vietnam"},{"id":"t4","text":"English"},{"id":"t5","text":"Tom"},{"id":"t6","text":"with"},{"id":"t7","text":"and"},{"id":"t8","text":"you"}]},"explanation":"Câu đúng: \"Mai learns English with Tom.\".","gradingRule":{"caseSensitive":false,"correctTokenIds":["t1","t2","t4","t6","t5"],"ignoreDiacritics":false,"ignorePunctuation":false},"hint":"\"English\" = tiếng Anh; \"learn\" = học","id":"u7n3l1-e13","prompt":{"locale":"vi-VN","text":"Dịch câu này: \"Mai học tiếng Anh với Tom.\""},"skillIds":["u7.grammar"],"type":"wordBank","vocabularyIds":["u7.english","u7.learn"]}],"gradingRulesVersion":"g1","guideText":"Mẫu câu chính: \"Can you help me?\" (Bạn có thể giúp tôi không?) — \"I do not understand.\" (Tôi không hiểu.) — \"Please open your books.\" (Hãy mở sách ra.)\n\"Can\" + động từ nguyên mẫu (không thêm -s, không \"to\"): \"She can speak English\", không nói \"She cans speaks\".\nCâu mệnh lệnh: bắt đầu bằng động từ: \"Open the window.\" Thêm \"please\" cho lịch sự.\nCâu hỏi \"What does this word mean?\" — dùng khi gặp từ mới. Trả lời: \"It means ...\".\nHọc sinh Việt hay nhầm: \"learn\" (học, tiếp thu) và \"study\" (học bài, nghiên cứu) — cả hai đều dịch là \"học\".","lessonId":"u7n3l1","lessonVersion":"v2.u7n3l1","manifestHash":"013672aa5927648264926e14d514d9d670ba04f547fc10aba6d50095b8e8b587","nodeId":"u7n3","order":50,"rewardIdentity":"v2.u7n3l1","schemaVersion":1,"sectionId":"sec1","signature":"L_AOqFVNTybzabNZwW_9Ojopf0q58bcG6iR7WNzAcSoZeOLI2wbt1H6JunEWKxQcIMJLxUUAoaHkqVZK3-QiAg","signatureKeyId":"dev-content-1","skillIds":["u7.vocab","u7.grammar","listening"],"title":"Tôi có thể · Bài 1","unitId":"u7"}