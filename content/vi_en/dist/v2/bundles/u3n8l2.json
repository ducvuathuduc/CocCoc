type":"textTranslation","vocabularyIds":["u1.from","u1.canada"]}],"gradingRulesVersion":"g1","guideText":"Mẫu câu chính: \"Water, please.\" (Cho tôi nước.) — \"I like tea.\" (Tôi thích trà.) — \"Do you want coffee?\" (Bạn có muốn cà phê không?)\nMạo từ: \"a\" trước phụ âm (a banana), \"an\" trước nguyên âm (an apple, an egg).\nThì hiện tại đơn: he/she thêm -s: \"Kiko likes fish.\" Câu phủ định dùng do not / does not: \"Tom does not like coffee.\" (hay: doesn't).\nLịch sự khi gọi món: thêm \"please\" ở cuối câu. \"I want ...\" hơi thẳng; dùng \"..., please\" khi nói với người phục vụ.\nBữa ăn: breakfast (bữa sáng), lunch (bữa trưa), dinner (bữa tối) — nói \"for breakfast\" (cho bữa sáng).","lessonId":"u3n8l2","lessonVersion":"v2.u3n8l2","manifestHash":"013672aa5927648264926e14d514d9d670ba04f547fc10aba6d50095b8e8b587","nodeId":"u3n8","order":23,"rewardIdentity":"v2.u3n8l2","schemaVersion":1,"sectionId":"sec1","signature":"M_hs-Mm5QFiOpI_hel_H4g9b_x0_xds1N1Ee4DJl86trXtqNZeLfZQRp24gGlz6ZZnhRsL82D8VOxCd6O0qWAQ","signatureKeyId":"dev-content-1","skillIds":["u3.grammar","listening","speaking","u3.dialogue"],"title":"Huyền thoại · Bài 2","unitId":"u3"}