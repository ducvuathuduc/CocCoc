":"husband"},{"id":"c4","text":"sell"}]},"explanation":"\"driver\" = \"tài xế\".","gradingRule":{"caseSensitive":false,"correctChoiceId":"c2","ignoreDiacritics":false,"ignorePunctuation":false},"hint":"\"driver\" nghĩa là \"tài xế\".","id":"u12n2l1-e08","prompt":{"locale":"vi-VN","text":"\"tài xế\" trong tiếng Anh là gì?"},"skillIds":["u12.vocab"],"type":"choice","vocabularyIds":["u12.driver"]},{"content":{"tokens":[{"id":"t1","text":"Cô"},{"id":"t2","text":"lúc"},{"id":"t3","text":"Thỉnh"},{"id":"t4","text":"kỹ"},{"id":"t5","text":"bác"},{"id":"t6","text":"sĩ"},{"id":"t7","text":"buổi"},{"id":"t8","text":"tôi"},{"id":"t9","text":"là"}]},"explanation":"Câu đúng: \"Cô tôi là bác sĩ.\".","gradingRule":{"caseSensitive":false,"correctTokenIds":["t1","t8","t9","t5","t6"],"ignoreDiacritics":false,"ignorePunctuation":false},"hint":"\"aunt\" = cô; \"doctor\" = bác sĩ","id":"u12n2l1-e09","prompt":{"locale":"vi-VN","text":"Dịch sang tiếng Việt: \"My aunt is a doctor.\""},"skillIds":["u12.grammar"],"type":"wordBank","vocabularyIds":["u2.aunt","u12.doctor"]},{"content":{"tokens":[{"id":"t1","text":"I"},{"id":"t2","text":"doctor"},{"id":"t3","text":"to"},{"id":"t4","text":"want"},{"id":"t5","text":"a"},{"id":"t6","text":"be"}]},"explanation":"Câu đúng: \"I want to be a doctor.\".","gradingRule":{"caseSensitive":false,"correctTokenIds":["t1","t4","t3","t6","t5","t2"],"ignoreDiacritics":false,"ignorePunctuation":false},"hint":"Câu bắt đầu bằng \"I\".","id":"u12n2l1-e10","prompt":{"locale":"vi-VN","text":"Sắp xếp thành câu đúng: \"Tôi muốn trở thành bác sĩ.\""},"skillIds":["u12.grammar"],"type":"sentenceOrder","vocabularyIds":["u3.want","u12.doctor"]},{"content":{"maxChars":40,"placeholder":"Điền từ còn thiếu"},"explanation":"Từ đúng: \"hospital\" → Doctors and nurses work at the hospital.","gradingRule":{"acceptedText":["hospital"],"caseSensitive":false,"ignoreDiacritics":false,"ignorePunctuation":true},"hint":"\"bệnh viện\" trong tiếng Anh là \"h...\"","id":"u12n2l1-e11","prompt":{"locale":"en-US","text":"Doctors and nurses work at the ___. — \"Bác sĩ và y tá làm việc ở bệnh viện.\""},"skillIds":["u12.grammar"],"type":"fillBlank","vocabularyIds":["u10.hospital","u12.work","u12.doctor","u12.nurse"]},{"content":{"maxChars":200,"placeholder":"Viết bằng tiếng Anh"},"explanation":"Đáp án: \"She is a nurse at the hospital.\". Cũng đúng: \"She's a nurse at the hospital.\".","gradingRule":{"acceptedText":["She is a nurse at the hospital.","She's a nurse at the hospital."],"caseSensitive":false,"ignoreDiacritics":false,"ignorePunctuation":true},"hint":"\"hospital\" = bệnh viện; \"nurse\" = y tá","id":"u12n2l1-e12","prompt":{"locale":"vi-VN","text":"Cô ấy là y tá ở bệnh viện."},"skillIds":["u12.grammar"],"type":"textTranslation","vocabularyIds":["u10.hospital","u12.nurse"]},{"content":{"tokens":[{"id":"t1","text":"I"},{"id":"t2","text":"Hello"},{"id":"t3","text":"office"},{"id":"t4","text":"of"},{"id":"t5","text":"in"},{"id":"t6","text":"an"},{"id":"t7","text":"shopping"},{"id":"t8","text":"work"}]},"explanation":"Câu đúng: \"I work in an office.\".","gradingRule":{"caseSensitive":false,"correctTokenIds":["t1","t8","t5","t6","t3"],"ignoreDiacritics":false,"ignorePunctuation":false},"hint":"\"work\" = làm việc; \"office\" = văn phòng","id":"u12n2l1-e13","prompt":{"locale":"vi-VN","text":"Dịch câu này: \"Tôi làm việc ở văn phòng.\""},"skillIds":["u12.grammar"],"type":"wordBank","vocabularyIds":["u12.work","u12.office"]}],"gradingRulesVersion":"g1","guideText":"Mẫu câu chính: \"What do you do?\" (Bạn làm nghề gì?) — \"I am an engineer.\" (Tôi là kỹ sư.) — \"I worked late yesterday.\" (Hôm qua tôi làm việc muộn.)\nNghề nghiệp luôn có a/an: \"She is a nurse\", \"He is an engineer\" (an trước nguyên âm).\nThì quá khứ đơn (động từ có quy tắc): thêm -ed: work → worked, start → started, finish → finished. Quá khứ của \"be\": I/he/she was, you/we/they were.\nCâu hỏi quá khứ dùng \"did\" + động từ nguyên mẫu: \"Did you finish your work?\" (không nói \"Did you finished\").\nMốc thời gian quá khứ: yesterday (hôm qua), last week (tuần trước).","lessonId":"u12n2l1","lessonVersion":"v2.u12n2l1","manifestHash":"013672aa5927648264926e14d514d9d670ba04f547fc10aba6d50095b8e8b587","nodeId":"u12n2","order":89,"rewardIdentity":"v2.u12n2l1","schemaVersion":1,"sectionId":"sec2","signature":"Bn12XOQnkxu9laHPqIr0xKiQTPDazuPjaX9WE7_kH-HYu2ZPnEX2OPD-VEhOK7tPNFdzbTOozn_A7hXMUCJzAQ","signatureKeyId":"dev-content-1","skillIds":["u12.vocab","u12.grammar","listening"],"title":"Nghề nghiệp · Bài 1","unitId":"u12"}