ort","u11.passport","u11.suitcase"]},{"content":{"choices":[{"id":"c1","text":"trip"},{"id":"c2","text":"umbrella"},{"id":"c3","text":"book"},{"id":"c4","text":"two"}]},"explanation":"\"trip\" = \"chuyến đi\".","gradingRule":{"caseSensitive":false,"correctChoiceId":"c1","ignoreDiacritics":false,"ignorePunctuation":false},"hint":"\"trip\" nghĩa là \"chuyến đi\".","id":"u11n7l1-e12","prompt":{"locale":"vi-VN","text":"\"chuyến đi\" trong tiếng Anh là gì?"},"skillIds":["u11.vocab"],"type":"choice","vocabularyIds":["u11.trip"]},{"content":{"locale":"en-US","maxSeconds":7,"referenceText":"We take the bus to school."},"explanation":"Câu mẫu: \"We take the bus to school.\".","gradingRule":{"acceptedText":["We take the bus to school."],"caseSensitive":false,"ignoreDiacritics":false,"ignorePunctuation":true},"hint":"Nghĩa: \"Chúng tôi đi xe buýt đến trường.\"","id":"u11n7l1-e13","nonSpeechAlternative":{"content":{"tokens":[{"id":"t1","text":"the"},{"id":"t2","text":"bus"},{"id":"t3","text":"to"},{"id":"t4","text":"take"},{"id":"t5","text":"We"},{"id":"t6","text":"school"}]},"explanation":"Câu đúng: \"We take the bus to school.\".","gradingRule":{"caseSensitive":false,"correctTokenIds":["t5","t4","t1","t2","t3","t6"],"ignoreDiacritics":false,"ignorePunctuation":false},"hint":"Câu bắt đầu bằng \"We\".","id":"u11n7l1-e13a","prompt":{"locale":"vi-VN","text":"Sắp xếp thành câu đúng: \"Chúng tôi đi xe buýt đến trường.\""},"skillIds":["speaking","u11.grammar"],"type":"sentenceOrder","vocabularyIds":["u5.school","u11.bus"]},"prompt":{"audioAssetId":"a.u11.s7.n","locale":"en-US","text":"Nói câu sau: \"We take the bus to school.\""},"skillIds":["speaking","u11.grammar"],"type":"speakRepeat","vocabularyIds":["u5.school","u11.bus"]},{"content":{"tokens":[{"id":"t1","text":"Nước"},{"id":"t2","text":"Bãi"},{"id":"t3","text":"đẹp"},{"id":"t4","text":"Hãy"},{"id":"t5","text":"Minh"},{"id":"t6","text":"biển"},{"id":"t7","text":"anh"}]},"explanation":"Câu đúng: \"Bãi biển đẹp.\".","gradingRule":{"caseSensitive":false,"correctTokenIds":["t2","t6","t3"],"ignoreDiacritics":false,"ignorePunctuation":false},"hint":"\"beautiful\" = đẹp; \"beach\" = bãi biển","id":"u11n7l1-e14","prompt":{"locale":"vi-VN","text":"Dịch sang tiếng Việt: \"The beach is beautiful.\""},"skillIds":["u11.grammar"],"type":"wordBank","vocabularyIds":["u8.beautiful","u11.beach"]},{"content":{"maxChars":200,"placeholder":"Viết bằng tiếng Anh"},"explanation":"Đáp án: \"My suitcase is very big.\".","gradingRule":{"acceptedText":["My suitcase is very big."],"caseSensitive":false,"ignoreDiacritics":false,"ignorePunctuation":true},"hint":"\"big\" = to; \"suitcase\" = va li","id":"u11n7l1-e15","prompt":{"locale":"vi-VN","text":"Va li của tôi rất to."},"skillIds":["u11.grammar"],"type":"textTranslation","vocabularyIds":["u6.big","u11.suitcase"]}],"gradingRulesVersion":"g1","guideText":"Mẫu câu chính: \"I want to visit Hanoi.\" (Tôi muốn đi thăm Hà Nội.) — \"When does the train leave?\" (Khi nào tàu chạy?) — \"Can I have a ticket, please?\" (Cho tôi một vé.)\nPhương tiện: by plane, by train, by bus, by taxi (không có \"the\"). Hoặc: take the bus / take a taxi.\nLịch trình dùng hiện tại đơn: \"The train leaves at six.\" \"The plane arrives at nine o'clock.\"\n\"Arrive at\" + địa điểm nhỏ (at the airport), \"arrive in\" + thành phố/quốc gia (arrive in Da Nang).\n\"Visit\" + nơi chốn/người, không cần giới từ: \"visit my grandmother\", không nói \"visit to\".","lessonId":"u11n7l1","lessonVersion":"v2.u11n7l1","manifestHash":"013672aa5927648264926e14d514d9d670ba04f547fc10aba6d50095b8e8b587","nodeId":"u11n7","order":86,"rewardIdentity":"v2.u11n7l1","schemaVersion":1,"sectionId":"sec2","signature":"Drc83ZoRZkWIl9Pd7KnisM72IKFD1egOKj4e_BV8Xdqr-Erzg3ZZ9k3kEHSkrM_rcTGo2yoOi1Le4rM5vCVwCw","signatureKeyId":"dev-content-1","skillIds":["u11.grammar","listening","speaking","u11.dialogue","reading","u11.story","u11.vocab"],"title":"Ôn tập cửa ải · Bài 1","unitId":"u11"}