uộc họp lúc mười giờ.\".","gradingRule":{"acceptedText":["Tôi có cuộc họp lúc mười giờ.","Tôi có một cuộc họp lúc mười giờ.","Mình có cuộc họp lúc mười giờ.","Mình có một cuộc họp lúc mười giờ."],"caseSensitive":false,"ignoreDiacritics":false,"ignorePunctuation":true},"hint":"\"meet\" = gặp; \"have\" = có; \"ten\" = mười; \"meeting\" = cuộc họp","id":"u12n5l4-e12","prompt":{"locale":"en-US","text":"I have a meeting at ten."},"skillIds":["u12.grammar"],"type":"textTranslation","vocabularyIds":["u1.meet","u2.have","u4.ten","u12.meeting"]}],"gradingRulesVersion":"g1","guideText":"Mẫu câu chính: \"What do you do?\" (Bạn làm nghề gì?) — \"I am an engineer.\" (Tôi là kỹ sư.) — \"I worked late yesterday.\" (Hôm qua tôi làm việc muộn.)\nNghề nghiệp luôn có a/an: \"She is a nurse\", \"He is an engineer\" (an trước nguyên âm).\nThì quá khứ đơn (động từ có quy tắc): thêm -ed: work → worked, start → started, finish → finished. Quá khứ của \"be\": I/he/she was, you/we/they were.\nCâu hỏi quá khứ dùng \"did\" + động từ nguyên mẫu: \"Did you finish your work?\" (không nói \"Did you finished\").\nMốc thời gian quá khứ: yesterday (hôm qua), last week (tuần trước).","lessonId":"u12n5l4","lessonVersion":"v2.u12n5l4","manifestHash":"013672aa5927648264926e14d514d9d670ba04f547fc10aba6d50095b8e8b587","nodeId":"u12n5","order":92,"rewardIdentity":"v2.u12n5l4","schemaVersion":1,"sectionId":"sec2","signature":"7mJUQakA2RVfuqubv4oWhL_qeFuy36ETY5d5MeuYg2rYdyxS3eG07sEcXq2f9L3BttDTAGKrMkkh1M7jfShZCw","signatureKeyId":"dev-content-1","skillIds":["speaking","u12.grammar","u12.dialogue","u12.vocab"],"title":"Email và phỏng vấn · Bài 4","unitId":"u12"}