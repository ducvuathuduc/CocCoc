Ids":["u11.grammar"],"type":"textTranslation","vocabularyIds":["u5.get_up","u11.tomorrow","u11.early"]},{"content":{"tokens":[{"id":"t1","text":"beach"},{"id":"t2","text":"tomorrow"},{"id":"t3","text":"to"},{"id":"t4","text":"We"},{"id":"t5","text":"go"},{"id":"t6","text":"the"}]},"explanation":"Câu đúng: \"We go to the beach tomorrow.\".","gradingRule":{"caseSensitive":false,"correctTokenIds":["t4","t5","t3","t6","t1","t2"],"ignoreDiacritics":false,"ignorePunctuation":false},"hint":"Câu bắt đầu bằng \"We\".","id":"u11n6l4-e10","prompt":{"locale":"vi-VN","text":"Sắp xếp thành câu đúng: \"Ngày mai chúng tôi đi biển.\""},"skillIds":["u11.grammar"],"type":"sentenceOrder","vocabularyIds":["u5.go","u11.beach","u11.tomorrow"]},{"content":{"locale":"en-US","maxSeconds":7,"referenceText":"Our trip is in the summer."},"explanation":"Câu mẫu: \"Our trip is in the summer.\".","gradingRule":{"acceptedText":["Our trip is in the summer."],"caseSensitive":false,"ignoreDiacritics":false,"ignorePunctuation":true},"hint":"Nghĩa: \"Chuyến đi của chúng tôi vào mùa hè.\"","id":"u11n6l4-e11","nonSpeechAlternative":{"content":{"tokens":[{"id":"t1","text":"the"},{"id":"t2","text":"summer"},{"id":"t3","text":"in"},{"id":"t4","text":"is"},{"id":"t5","text":"Our"},{"id":"t6","text":"trip"}]},"explanation":"Câu đúng: \"Our trip is in the summer.\".","gradingRule":{"caseSensitive":false,"correctTokenIds":["t5","t6","t4","t3","t1","t2"],"ignoreDiacritics":false,"ignorePunctuation":false},"hint":"Câu bắt đầu bằng \"Our\".","id":"u11n6l4-e11a","prompt":{"locale":"vi-VN","text":"Sắp xếp thành câu đúng: \"Chuyến đi của chúng tôi vào mùa hè.\""},"skillIds":["speaking","u11.grammar"],"type":"sentenceOrder","vocabularyIds":["u8.summer","u11.trip"]},"prompt":{"audioAssetId":"a.u11.s4.n","locale":"en-US","text":"Nói câu sau: \"Our trip is in the summer.\""},"skillIds":["speaking","u11.grammar"],"type":"speakRepeat","vocabularyIds":["u8.summer","u11.trip"]},{"content":{"maxChars":200,"placeholder":"Viết bằng tiếng Việt (có dấu)"},"explanation":"Đáp án: \"Chúng tôi ở một khách sạn nhỏ.\". Cũng đúng: \"Chúng tôi ở tại một khách sạn nhỏ.\", \"Chúng mình ở một khách sạn nhỏ.\".","gradingRule":{"acceptedText":["Chúng tôi ở một khách sạn nhỏ.","Chúng tôi ở tại một khách sạn nhỏ.","Chúng mình ở một khách sạn nhỏ.","Chúng mình ở tại một khách sạn nhỏ."],"caseSensitive":false,"ignoreDiacritics":false,"ignorePunctuation":true},"hint":"\"small\" = nhỏ; \"hotel\" = khách sạn","id":"u11n6l4-e12","prompt":{"locale":"en-US","text":"We stay at a small hotel."},"skillIds":["u11.grammar"],"type":"textTranslation","vocabularyIds":["u6.small","u11.hotel"]}],"gradingRulesVersion":"g1","guideText":"Mẫu câu chính: \"I want to visit Hanoi.\" (Tôi muốn đi thăm Hà Nội.) — \"When does the train leave?\" (Khi nào tàu chạy?) — \"Can I have a ticket, please?\" (Cho tôi một vé.)\nPhương tiện: by plane, by train, by bus, by taxi (không có \"the\"). Hoặc: take the bus / take a taxi.\nLịch trình dùng hiện tại đơn: \"The train leaves at six.\" \"The plane arrives at nine o'clock.\"\n\"Arrive at\" + địa điểm nhỏ (at the airport), \"arrive in\" + thành phố/quốc gia (arrive in Da Nang).\n\"Visit\" + nơi chốn/người, không cần giới từ: \"visit my grandmother\", không nói \"visit to\".","lessonId":"u11n6l4","lessonVersion":"v2.u11n6l4","manifestHash":"013672aa5927648264926e14d514d9d670ba04f547fc10aba6d50095b8e8b587","nodeId":"u11n6","order":85,"rewardIdentity":"v2.u11n6l4","schemaVersion":1,"sectionId":"sec2","signature":"3QMvg1udrI9HjzpB4fPOQShxF-UdiBV1Z9jBYbGcj_qeGbVSmuAIellnSLjEsvVH3Le4h9hp588qae2cl-2OAA","signatureKeyId":"dev-content-1","skillIds":["speaking","u11.grammar","u11.dialogue","u11.vocab"],"title":"Khởi hành sớm · Bài 4","unitId":"u11"}