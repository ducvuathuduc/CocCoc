4","text":"the"},{"id":"t5","text":"at"},{"id":"t6","text":"Minh"},{"id":"t7","text":"tomorrow"},{"id":"t8","text":"and"},{"id":"t9","text":"work"},{"id":"t10","text":"Doctors"}]},"explanation":"Câu đúng: \"Doctors and nurses work at the hospital.\".","gradingRule":{"caseSensitive":false,"correctTokenIds":["t10","t8","t2","t9","t5","t4","t3"],"ignoreDiacritics":false,"ignorePunctuation":false},"hint":"\"hospital\" = bệnh viện; \"work\" = làm việc; \"doctor\" = bác sĩ; \"nurse\" = y tá","id":"u12n5l1-e13","prompt":{"locale":"vi-VN","text":"Dịch câu này: \"Bác sĩ và y tá làm việc ở bệnh viện.\""},"skillIds":["u12.grammar"],"type":"wordBank","vocabularyIds":["u10.hospital","u12.work","u12.doctor","u12.nurse"]}],"gradingRulesVersion":"g1","guideText":"Mẫu câu chính: \"What do you do?\" (Bạn làm nghề gì?) — \"I am an engineer.\" (Tôi là kỹ sư.) — \"I worked late yesterday.\" (Hôm qua tôi làm việc muộn.)\nNghề nghiệp luôn có a/an: \"She is a nurse\", \"He is an engineer\" (an trước nguyên âm).\nThì quá khứ đơn (động từ có quy tắc): thêm -ed: work → worked, start → started, finish → finished. Quá khứ của \"be\": I/he/she was, you/we/they were.\nCâu hỏi quá khứ dùng \"did\" + động từ nguyên mẫu: \"Did you finish your work?\" (không nói \"Did you finished\").\nMốc thời gian quá khứ: yesterday (hôm qua), last week (tuần trước).","lessonId":"u12n5l1","lessonVersion":"v2.u12n5l1","manifestHash":"013672aa5927648264926e14d514d9d670ba04f547fc10aba6d50095b8e8b587","nodeId":"u12n5","order":92,"rewardIdentity":"v2.u12n5l1","schemaVersion":1,"sectionId":"sec2","signature":"pAclxZcFTvWBCajjrhX25egf-uHG53rzbq2Np23gG_Yl1EPHvkmcdxn9ddgDrSAESNDGZ1caadX1fL0LemtNAQ","signatureKeyId":"dev-content-1","skillIds":["u12.vocab","u12.grammar","listening"],"title":"Email và phỏng vấn · Bài 1","unitId":"u12"}