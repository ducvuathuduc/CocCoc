u: \"We play games together.\"","lessonId":"u13n5l4","lessonVersion":"v2.u13n5l4","manifestHash":"013672aa5927648264926e14d514d9d670ba04f547fc10aba6d50095b8e8b587","nodeId":"u13n5","order":100,"rewardIdentity":"v2.u13n5l4","schemaVersion":1,"sectionId":"sec2","signature":"jBL4a38wnPKTNoJT4GPZagvCOfXFde6VP0613W9iSNJIKFlcFuGkhrZx3cKOJAnChIog7Sh1A5RFngEq5S4zDw","signatureKeyId":"dev-content-1","skillIds":["speaking","u13.grammar","u13.dialogue","u13.vocab"],"title":"Sở thích của tôi · Bài 4","unitId":"u13"}