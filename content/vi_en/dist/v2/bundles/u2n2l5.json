ics":false,"ignorePunctuation":false},"hint":"\"father\" = bố","id":"u2n2l5-e11","prompt":{"locale":"vi-VN","text":"Dịch câu này: \"Đây là bố tôi.\""},"skillIds":["u2.grammar"],"type":"wordBank","vocabularyIds":["u2.father"]},{"content":{"maxChars":200,"placeholder":"Viết bằng tiếng Anh"},"explanation":"Đáp án: \"Nam is my brother.\".","gradingRule":{"acceptedText":["Nam is my brother."],"caseSensitive":false,"ignoreDiacritics":false,"ignorePunctuation":true},"hint":"\"brother\" = anh trai","id":"u2n2l5-e12","prompt":{"locale":"vi-VN","text":"Nam là anh trai tôi."},"skillIds":["u2.grammar"],"type":"textTranslation","vocabularyIds":["u2.brother"]}],"gradingRulesVersion":"g1","guideText":"Mẫu câu chính: \"This is my mother.\" (Đây là mẹ tôi.) — \"I have a brother.\" (Tôi có một anh/em trai.)\nTính từ sở hữu: my (của tôi), your (của bạn), his (của anh ấy), her (của cô ấy), their (của họ). Đặt TRƯỚC danh từ: \"my father\", không nói \"father my\".\nĐộng từ \"have\": I/you/we/they have — he/she has. \"Mai has a cat.\"\nLưu ý: tiếng Anh không phân biệt anh/em: \"brother\" = anh trai hoặc em trai, \"sister\" = chị gái hoặc em gái. \"Aunt/uncle\" gồm cả cô, dì, chú, cậu, bác.","lessonId":"u2n2l5","lessonVersion":"v2.u2n2l5","manifestHash":"013672aa5927648264926e14d514d9d670ba04f547fc10aba6d50095b8e8b587","nodeId":"u2n2","order":9,"rewardIdentity":"v2.u2n2l5","schemaVersion":1,"sectionId":"sec1","signature":"I64jvzCd-dhOuboITm_UDb03uuavSpENdRe5Y0nmOaZNtTq35-9jD9xbQBxgdbNYmKi2-PNaLqzF7wduV68OCQ","signatureKeyId":"dev-content-1","skillIds":["u2.vocab","u2.grammar","listening"],"title":"Ông bà và em bé · Bài 5","unitId":"u2"}