d":"t9","text":"cô"},{"id":"t10","text":"là"},{"id":"t11","text":"ấy"}]},"explanation":"Câu đúng: \"Con gái cô ấy là học sinh.\".","gradingRule":{"caseSensitive":false,"correctTokenIds":["t7","t6","t9","t11","t10","t5","t8"],"ignoreDiacritics":false,"ignorePunctuation":false},"hint":"\"student\" = học sinh; \"daughter\" = con gái","id":"u2n7l1-e14","prompt":{"locale":"vi-VN","text":"Dịch sang tiếng Việt: \"Her daughter is a student.\""},"skillIds":["u2.grammar"],"type":"wordBank","vocabularyIds":["u1.student","u2.daughter"]},{"content":{"maxChars":200,"placeholder":"Viết bằng tiếng Anh"},"explanation":"Đáp án: \"I have a brother.\".","gradingRule":{"acceptedText":["I have a brother."],"caseSensitive":false,"ignoreDiacritics":false,"ignorePunctuation":true},"hint":"\"brother\" = anh trai; \"have\" = có","id":"u2n7l1-e15","prompt":{"locale":"vi-VN","text":"Tôi có một anh trai."},"skillIds":["u2.grammar"],"type":"textTranslation","vocabularyIds":["u2.brother","u2.have"]}],"gradingRulesVersion":"g1","guideText":"Mẫu câu chính: \"This is my mother.\" (Đây là mẹ tôi.) — \"I have a brother.\" (Tôi có một anh/em trai.)\nTính từ sở hữu: my (của tôi), your (của bạn), his (của anh ấy), her (của cô ấy), their (của họ). Đặt TRƯỚC danh từ: \"my father\", không nói \"father my\".\nĐộng từ \"have\": I/you/we/they have — he/she has. \"Mai has a cat.\"\nLưu ý: tiếng Anh không phân biệt anh/em: \"brother\" = anh trai hoặc em trai, \"sister\" = chị gái hoặc em gái. \"Aunt/uncle\" gồm cả cô, dì, chú, cậu, bác.","lessonId":"u2n7l1","lessonVersion":"v2.u2n7l1","manifestHash":"013672aa5927648264926e14d514d9d670ba04f547fc10aba6d50095b8e8b587","nodeId":"u2n7","order":14,"rewardIdentity":"v2.u2n7l1","schemaVersion":1,"sectionId":"sec1","signature":"UPO6YqT_A8-_3udW3VvxrJG6FY_XpoZJVzvkHNrwa9QWjcdKYrRgaEWVsfjOveZ-C1_glWt6YSNK3PYD8KPRAA","signatureKeyId":"dev-content-1","skillIds":["u2.grammar","listening","speaking","u2.dialogue","reading","u2.story","u2.vocab"],"title":"Ôn tập cửa ải · Bài 1",