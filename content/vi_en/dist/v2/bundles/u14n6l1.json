"caseSensitive":false,"correctTokenIds":["t3","t2","t4"],"ignoreDiacritics":false,"ignorePunctuation":false},"hint":"\"healthy\" = khỏe mạnh; \"vegetable\" = rau","id":"u14n6l1-e13","prompt":{"locale":"vi-VN","text":"Dịch câu này: \"Rau tốt cho sức khỏe.\""},"skillIds":["u14.grammar"],"type":"wordBank","vocabularyIds":["u14.healthy","u14.vegetable"]}],"gradingRulesVersion":"g1","guideText":"Mẫu câu chính: \"How do you feel?\" (Bạn thấy thế nào?) — \"I have a headache.\" (Tôi bị đau đầu.) — \"You should rest.\" (Bạn nên nghỉ ngơi.)\nBệnh dùng \"have\": have a fever (bị sốt), have a cough (bị ho), have a headache (bị đau đầu). Tính từ dùng \"be\": I am sick, I am tired.\nChỗ đau: \"My stomach hurts\" (Tôi bị đau bụng) — động từ \"hurt\" thêm -s với he/she/it và danh từ số ít.\nLời khuyên: should / should not (shouldn't) + động từ nguyên mẫu: \"You should eat more vegetables.\"\nSố nhiều bất quy tắc: one tooth → two teeth.","lessonId":"u14n6l1","lessonVersion":"v2.u14n6l1","manifestHash":"013672aa5927648264926e14d514d9d670ba04f547fc10aba6d50095b8e8b587","nodeId":"u14n6","order":109,"rewardIdentity":"v2.u14n6l1","schemaVersion":1,"sectionId":"sec2","signature":"ZDeNitcw_qCxputA0cSA4DbjZjtxc9ExvcJqu64pVZmfrCPx5KSahc3WXxFxflGgFePbrtvUNvqNKXs7XUv-Bg","signatureKeyId":"dev-content-1","skillIds":["u14.vocab","u14.grammar","listening"],"title":"Đi nha sĩ · Bài 1","unitId":"u14"}