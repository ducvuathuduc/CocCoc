ranslation","vocabularyIds":["u1.friend","u1.where"]},"prompt":{"audioAssetId":"a.u1.s34.n","locale":"vi-VN","text":"Nghe và viết lại bằng tiếng Anh"},"skillIds":["listening","u1.grammar"],"type":"dictation","vocabularyIds":["u1.friend","u1.where"]},{"content":{"tokens":[{"id":"t1","text":"Mr"},{"id":"t2","text":"is"},{"id":"t3","text":"a"},{"id":"t4","text":"Long"},{"id":"t5","text":"good"},{"id":"t6","text":"What"},{"id":"t7","text":"Hi"},{"id":"t8","text":"teacher"},{"id":"t9","text":"thank"}]},"explanation":"Câu đúng: \"Mr. Long is a good teacher.\".","gradingRule":{"caseSensitive":false,"correctTokenIds":["t1","t4","t2","t3","t5","t8"],"ignoreDiacritics":false,"ignorePunctuation":false},"hint":"\"teacher\" = giáo viên; \"good\" = tốt","id":"u1n6l2-e11","prompt":{"locale":"vi-VN","text":"Dịch câu này: \"Thầy Long là một giáo viên giỏi.\""},"skillIds":["u1.grammar"],"type":"wordBank","vocabularyIds":["u1.teacher","u1.good"]},{"content":{"maxChars":200,"placeholder":"Viết bằng tiếng Anh"},"explanation":"Đáp án: \"I meet my friend in the morning.\".","gradingRule":{"acceptedText":["I meet my friend in the morning."],"caseSensitive":false,"ignoreDiacritics":false,"ignorePunctuation":true},"hint":"\"friend\" = bạn; \"morning\" = buổi sáng; \"meet\" = gặp","id":"u1n6l2-e12","prompt":{"locale":"vi-VN","text":"Tôi gặp bạn tôi vào buổi sáng."},"skillIds":["u1.grammar"],"type":"textTranslation","vocabularyIds":["u1.friend","u1.morning","u1.meet"]}],"gradingRulesVersion":"g1","guideText":"Mẫu câu chính: \"Hello, I am Mai.\" (Xin chào, tôi là Mai.) — \"What is your name?\" (Bạn tên là gì?) — \"Nice to meet you.\" (Rất vui được gặp bạn.)\nNgữ pháp: động từ \"to be\": I am, you are, he/she is. Khi nói, người bản xứ hay rút gọn: I'm, you're, he's, she's. Cả hai cách viết đều được chấp nhận.\nMẹo: \"I\" luôn viết hoa. Dùng \"a\" trước nghề nghiệp: \"I am a student.\" Tiếng Việt có thể bỏ \"một\", tiếng Anh thì không.\nLịch sự: \"Excuse me\" dùng để bắt chuyện, \"Sorry\" dùng khi xin lỗi vì lỗi của mình.","lessonId":"u1n6l2","lessonVersion":"v2.u1n6l2","manifestHash":"013672aa5927648264926e14d514d9d670ba04f547fc10aba6d50095b8e8b587","nodeId":"u1n6","order":5,"rewardIdentity":"v2.u1n6l2","schemaVersion":1,"sectionId":"sec1","signature":"Z9Tms10Ico0NRiHZIPw7P5T00b9YDytVtIiD3-gcOHduuPKgENM20mhWil1pUBz4wvNOW1m46sv9H3JuJtWMAA","signatureKeyId":"dev-content-1","skillIds":["u1.vocab","u1.grammar","listening"],"title":"Bạn đến từ đâu? · Bài 2","unitId":"u1"}