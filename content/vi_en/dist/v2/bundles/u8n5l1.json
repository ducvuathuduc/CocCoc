,{"id":"t2","text":"Bạn"},{"id":"t3","text":"áp"},{"id":"t4","text":"Làm"},{"id":"t5","text":"bảy"},{"id":"t6","text":"cá"},{"id":"t7","text":"Mùa"},{"id":"t8","text":"xuân"}]},"explanation":"Câu đúng: \"Mùa xuân ấm áp.\".","gradingRule":{"caseSensitive":false,"correctTokenIds":["t7","t8","t1","t3"],"ignoreDiacritics":false,"ignorePunctuation":false},"hint":"\"warm\" = ấm; \"spring\" = mùa xuân","id":"u8n5l1-e09","prompt":{"locale":"vi-VN","text":"Dịch sang tiếng Việt: \"Spring is warm.\""},"skillIds":["u8.grammar"],"type":"wordBank","vocabularyIds":["u8.warm","u8.spring"]},{"content":{"tokens":[{"id":"t1","text":"The"},{"id":"t2","text":"is"},{"id":"t3","text":"cloudy"},{"id":"t4","text":"sky"}]},"explanation":"Câu đúng: \"The sky is cloudy.\".","gradingRule":{"caseSensitive":false,"correctTokenIds":["t1","t4","t2","t3"],"ignoreDiacritics":false,"ignorePunctuation":false},"hint":"Câu bắt đầu bằng \"The\".","id":"u8n5l1-e10","prompt":{"locale":"vi-VN","text":"Sắp xếp thành câu đúng: \"Bầu trời nhiều mây.\""},"skillIds":["u8.grammar"],"type":"sentenceOrder","vocabularyIds":["u8.cloudy","u8.sky"]},{"content":{"maxChars":40,"placeholder":"Điền từ còn thiếu"},"explanation":"Từ đúng: \"spring\" → I love spring.","gradingRule":{"acceptedText":["spring"],"caseSensitive":false,"ignoreDiacritics":false,"ignorePunctuation":true},"hint":"\"mùa xuân\" trong tiếng Anh là \"s...\"","id":"u8n5l1-e11","prompt":{"locale":"en-US","text":"I love ___. — \"Tôi yêu mùa xuân.\""},"skillIds":["u8.grammar"],"type":"fillBlank","vocabularyIds":["u8.spring","u2.love"]},{"content":{"maxChars":200,"placeholder":"Viết bằng tiếng Anh"},"explanation":"Đáp án: \"Canada is beautiful in autumn.\". Cũng đúng: \"Canada is beautiful in the fall.\".","gradingRule":{"acceptedText":["Canada is beautiful in autumn.","Canada is beautiful in the fall."],"caseSensitive":false,"ignoreDiacritics":false,"ignorePunctuation":true},"hint":"\"Canada\" = Canada; \"autumn\" = mùa thu; \"beautiful\" = đẹp","id":"u8n5l1-e12","prompt":{"locale":"vi-VN","text":"Canada rất đẹp vào mùa thu."},"skillIds":["u8.grammar"],"type":"textTranslation","vocabularyIds":["u1.canada","u8.autumn","u8.beautiful"]},{"content":{"tokens":[{"id":"t1","text":"Coffee"},{"id":"t2","text":"am"},{"id":"t3","text":"never"},{"id":"t4","text":"Sunday"},{"id":"t5","text":"It"},{"id":"t6","text":"on"},{"id":"t7","text":"rainy"},{"id":"t8","text":"is"}]},"explanation":"Câu đúng: \"It is rainy on Sunday.\".","gradingRule":{"caseSensitive":false,"correctTokenIds":["t5","t8","t7","t6","t4"],"ignoreDiacritics":false,"ignorePunctuation":false},"hint":"\"Sunday\" = Chủ nhật; \"rainy\" = mưa","id":"u8n5l1-e13","prompt":{"locale":"vi-VN","text":"Dịch câu này: \"Chủ nhật trời mưa.\""},"skillIds":["u8.grammar"],"type":"wordBank","vocabularyIds":["u5.sunday","u8.rainy"]}],"gradingRulesVersion":"g1","guideText":"Mẫu câu chính: \"How is the weather today?\" (Thời tiết hôm nay thế nào?) — \"It is sunny.\" (Trời nắng.) — \"It is raining.\" (Trời đang mưa.)\nChủ ngữ giả \"it\": tiếng Việt nói \"trời nắng\", tiếng Anh phải có chủ ngữ: \"It is sunny\", không nói \"Is sunny\".\nThì hiện tại tiếp diễn cho việc đang xảy ra: It is raining now. So sánh: It is rainy (trời có mưa — mô tả chung).\nMùa: in (the) summer, in winter. Miền Nam Việt Nam có hai mùa: the dry season (mùa khô) và the rainy season (mùa mưa).\n\"Fall\" là cách Mỹ gọi mùa thu; \"autumn\" dùng ở Anh — cả hai đều đúng.","lessonId":"u8n5l1","lessonVersion":"v2.u8n5l1","manifestHash":"013672aa5927648264926e14d514d9d670ba04f547fc10aba6d50095b8e8b587","nodeId":"u8n5","order":60,"rewardIdentity":"v2.u8n5l1","schemaVersion":1,"sectionId":"sec1","signature":"mdvlc13C3dtuj6QbWlbr46SDmVB8TEafT_7YTMBmquEwCimKcG9pbrQV8DuNsjSM_j2jG3tdpEmfatKUVxuyAQ","signatureKeyId":"dev-content-1","skillIds":["u8.vocab","u8.grammar","listening"],"title":"Mùa xuân, mùa thu · Bài 1","unitId":"u8"}