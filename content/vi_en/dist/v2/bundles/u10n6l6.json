ext":"is"},{"id":"t7","text":"café"}]},"explanation":"Câu đúng: \"The café is next to the bank.\".","gradingRule":{"caseSensitive":false,"correctTokenIds":["t1","t7","t6","t4","t2","t3","t5"],"ignoreDiacritics":false,"ignorePunctuation":false},"hint":"Câu bắt đầu bằng \"The\".","id":"u10n6l6-e11a","prompt":{"locale":"vi-VN","text":"Sắp xếp thành câu đúng: \"Quán cà phê ở bên cạnh ngân hàng.\""},"skillIds":["speaking","u10.grammar"],"type":"sentenceOrder","vocabularyIds":["u10.bank","u10.next_to"]},"prompt":{"audioAssetId":"a.u10.s14.n","locale":"en-US","text":"Nói câu sau: \"The café is next to the bank.\""},"skillIds":["speaking","u10.grammar"],"type":"speakRepeat","vocabularyIds":["u10.bank","u10.next_to"]},{"content":{"maxChars":200,"placeholder":"Viết bằng tiếng Việt (có dấu)"},"explanation":"Đáp án: \"Hãy nhìn vào bản đồ.\". Cũng đúng: \"Nhìn bản đồ đi.\", \"Xem bản đồ đi.\".","gradingRule":{"acceptedText":["Hãy nhìn vào bản đồ.","Nhìn bản đồ đi.","Xem bản đồ đi."],"caseSensitive":false,"ignoreDiacritics":false,"ignorePunctuation":true},"hint":"\"map\" = bản đồ","id":"u10n6l6-e12","prompt":{"locale":"en-US","text":"Look at the map."},"skillIds":["u10.grammar"],"type":"textTranslation","vocabularyIds":["u10.map"]}],"gradingRulesVersion":"g1","guideText":"Mẫu câu chính: \"Excuse me, where is the bank?\" (Xin lỗi, ngân hàng ở đâu?) — \"Go straight and turn left.\" (Đi thẳng rồi rẽ trái.) — \"Is it far?\" (Có xa không?)\nChỉ đường dùng câu mệnh lệnh: Go straight. Turn right. Turn left at the corner.\nVị trí: on the left / on the right (bên trái / bên phải), next to (bên cạnh), opposite (đối diện), near (gần), on the corner (ở góc đường).\n\"Near\" không cần \"to\": \"near the school\" (không nói \"near to the school\" trong văn nói chuẩn A2).\nHỏi khoảng cách: \"Is it far from here?\" — Trả lời: \"No, you can walk.\" (Không, bạn có thể đi bộ.)","lessonId":"u10n6l6","lessonVersion":"v2.u10n6l6","manifestHash":"013672aa5927648264926e14d514d9d670ba04f547fc10aba6d50095