tId":"a.u16.d3.n","locale":"en-US","text":"Are you ready?"},"skillIds":["speaking","u16.dialogue"],"type":"dialogueTurn","vocabularyIds":["u1.yes","u16.ready"]},{"content":{"choices":[{"id":"c1","text":"To visit Tom's family in Canada"},{"id":"c2","text":"To buy a camera"},{"id":"c3","text":"To be a doctor"}],"passage":"Last weekend, Mai and her friends went to the Mid-Autumn Festival. They saw lanterns and ate mooncakes. Now they have a plan for the summer. \"Let's go to Phu Quoc island!\" Tom says. \"That is a great idea,\" Anna says. Nam is worried: \"I do not have money.\" \"Maybe we can work at Mrs. Rosa's café,\" Mai says. \"Then we will have money soon.\" Nam smiles. \"I hope Mrs. Rosa will say yes!\" Mai thinks about the future. Her dream is to visit Tom's family in Canada one day.","question":"What is Mai's dream?"},"explanation":"Đáp án: \"To visit Tom's family in Canada\".","gradingRule":{"caseSensitive":false,"correctChoiceId":"c1","ignoreDiacritics":false,"ignorePunctuation":false},"hint":"Đọc lại câu chuyện \"Kế hoạch mùa hè\".","id":"u16n7l1-e09","prompt":{"locale":"en-US","text":"What is Mai's dream?"},"skillIds":["reading","u16.story"],"type":"storyQuestion","vocabularyIds":[]},{"content":{"choices":[{"id":"c1","imageAssetId":"i.u3.apple","text":"apple"},{"id":"c2","imageAssetId":"i.u12.computer","text":"computer"},{"id":"c3","imageAssetId":"i.u16.museum","text":"museum"},{"id":"c4","imageAssetId":"i.u6.sofa","text":"sofa"}]},"explanation":"\"museum\" = \"bảo tàng\".","gradingRule":{"caseSensitive":false,"correctChoiceId":"c3","ignoreDiacritics":false,"ignorePunctuation":false},"hint":"\"bảo tàng\" là \"museum\".","id":"u16n7l1-e10","prompt":{"locale":"vi-VN","text":"Hình nào là \"bảo tàng\"?"},"skillIds":["u16.vocab"],"type":"imageChoice","vocabularyIds":["u16.museum"]},{"content":{"pairs":[{"id":"p1","left":{"id":"p1l","text":"idea"},"right":{"id":"p1r","text":"ý tưởng"}},{"id":"p2","left":{"id":"p2l","text":"wait"},"right":{"id":"p2r","text":"đợi"}},{"id":"p3","left":{"id":"p3l","text":"dream"},"right":{"id":"p3r","text":"ước mơ"}},{"id":"p4","left":{"id":"p4l","text":"ready"},"right":{"id":"p4r","text":"sẵn sàng"}},{"id":"p5","left":{"id":"p5l","text":"picnic"},"right":{"id":"p5r","text":"dã ngoại"}}]},"explanation":"idea = ý tưởng; wait = đợi; dream = ước mơ; ready = sẵn sàng; picnic = dã ngoại","gradingRule":{"caseSensitive":false,"correctPairIds":["p1","p2","p3","p4","p5"],"ignoreDiacritics":false,"ignorePunctuation":false},"hint":"Ví dụ: \"idea\" = \"ý tưởng\".","id":"u16n7l1-e11","prompt":{"locale":"vi-VN","text":"Nối các cặp từ tương ứng"},"skillIds":["u16.vocab"],"type":"matchPairs","vocabularyIds":["u16.idea","u16.wait","u16.dream","u16.ready","u16.picnic"]},{"content":{"choices":[{"id":"c1","text":"juice"},{"id":"c2","text":"sometimes"},{"id":"c3","text":"sea"},{"id":"c4","text":"went"}]},"explanation":"\"went\" = \"đã đi\".","gradingRule":{"caseSensitive":false,"correctChoiceId":"c4","ignoreDiacritics":false,"ignorePunctuation":false},"hint":"\"went\" nghĩa là \"đã đi\".","id":"u16n7l1-e12","prompt":{"locale":"vi-VN","text":"\"đã đi\" trong tiếng Anh là gì?"},"skillIds":["u16.vocab"],"type":"choice","vocabularyIds":["u16.went"]},{"content":{"locale":"en-US","maxSeconds":7,"referenceText":"Do not forget your umbrella."},"explanation":"Câu mẫu: \"Do not forget your umbrella.\".","gradingRule":{"acceptedText":["Do not forget your umbrella.","Don't forget your umbrella."],"caseSensitive":false,"ignoreDiacritics":false,"ignorePunctuation":true},"hint":"Nghĩa: \"Đừng quên ô của bạn.\"","id":"u16n7l1-e13","nonSpeechAlternative":{"content":{"tokens":[{"id":"t1","text":"not"},{"id":"t2","text":"forget"},{"id":"t3","text":"umbrella"},{"id":"t4","text":"Do"},{"id":"t5","text":"your"}]},"explanation":"Câu đúng: \"Do not forget your umbrella.\".","gradingRule":{"caseSensitive":false,"correctTokenIds":["t4","t1","t2","t5","t3"],"ignoreDiacritics":false,"ignorePunctuation":false},"hint":"Câu bắt đầu bằng \"Do\".","id":"u16n7l1-e13a","prompt":{"locale":"vi-VN","text":"Sắp xếp thành câu đúng: \"Đừng quên ô của bạn.\""},"skillIds":["speaking","u16.grammar"],"type":"sentenceOrder","vocabularyIds":["u8.umbrella","u16.forget"]},"prompt":{"audioAssetId":"a.u16.s21.n","locale":"en-US","text":"Nói câu sau: \"Do not forget your umbrella.\""},"skillIds":["speaking","u16.grammar"],"type":"speakRepeat","vocabularyIds":["u8.umbrella","u16.forget"]},{"content":{"tokens":[{"id":"t1","text":"đây"},{"id":"t2","text":"Làm"},{"id":"t3","text":"tôi"},{"id":"t4","text":"xong"},{"id":"t5","text":"ơn"},{"id":"t6","text":"đợi"},{"id":"t7","text":"già"},{"id":"t8","text":"ấm"}]},"explanation":"Câu đúng: \"Làm ơn đợi tôi.\".","gradingRule":{"caseSensitive":false,"correctTokenIds":["t2","t5","t6","t3"],"ignoreDiacritics":false,"ignorePunctuation":false},"hint":"\"please\" = làm ơn; \"wait\" = đợi","id":"u16n7l1-e14","prompt":{"locale":"vi-VN","text":"Dịch sang tiếng Việt: \"Please wait for me.\""},"skillIds":["u16.grammar"],"type":"wordBank","vocabularyIds":["u1.please","u16.wait"]},{"content":{"maxChars":200,"placeholder":"Viết bằng tiếng Anh"},"explanation":"Đáp án: \"We waited for the bus.\".","gradingRule":{"acceptedText":["We waited for the bus."],"caseSensitive":false,"ignoreDiacritics":false,"ignorePunctuation":true},"hint":"\"bus\" = xe buýt; \"wait\" = đợi","id":"u16n7l1-e15","prompt":{"locale":"vi-VN","text":"Chúng tôi đã đợi xe buýt."},"skillIds":["u16.grammar"],"type":"textTranslation","vocabularyIds":["u11.bus","u16.wait"]}],"gradingRulesVersion":"g1","guideText":"Mẫu câu chính: \"What will you do this weekend?\" (Cuối tuần này bạn sẽ làm gì?) — \"I went to the museum.\" (Tôi đã đi bảo tàng.) — \"That is a good idea!\" (Ý hay đấy!)\nTương lai: will + động từ nguyên mẫu: \"I will call you.\" Rút gọn: I'll, you'll, we'll. Phủ định: will not = won't.\nQuá khứ bất quy tắc phải học thuộc: go → went, see → saw, eat → ate, buy → bought, forget → forgot.\n\"Maybe\" (có lẽ) đứng đầu câu: \"Maybe