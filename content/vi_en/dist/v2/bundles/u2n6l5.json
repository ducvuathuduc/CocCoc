edText":["Where are your parents?"],"caseSensitive":false,"ignoreDiacritics":false,"ignorePunctuation":true},"hint":"\"where\" = ở đâu; \"parents\" = bố mẹ","id":"u2n6l5-e10a","prompt":{"locale":"vi-VN","text":"Bố mẹ bạn ở đâu?"},"skillIds":["listening","u2.grammar"],"type":"textTranslation","vocabularyIds":["u1.where","u2.parents"]},"prompt":{"audioAssetId":"a.u2.s29.n","locale":"vi-VN","text":"Nghe và viết lại bằng tiếng Anh"},"skillIds":["listening","u2.grammar"],"type":"dictation","vocabularyIds":["u1.where","u2.parents"]},{"content":{"tokens":[{"id":"t1","text":"a"},{"id":"t2","text":"Mom"},{"id":"t3","text":"dog"},{"id":"t4","text":"a"},{"id":"t5","text":"cat"},{"id":"t6","text":"Thank"},{"id":"t7","text":"We"},{"id":"t8","text":"have"},{"id":"t9","text":"Nam"},{"id":"t10","text":"and"}]},"explanation":"Câu đúng: \"We have a dog and a cat.\".","gradingRule":{"caseSensitive":false,"correctTokenIds":["t7","t8","t4","t3","t10","t1","t5"],"ignoreDiacritics":false,"ignorePunctuation":false},"hint":"\"have\" = có; \"cat\" = con mèo; \"dog\" = con chó","id":"u2n6l5-e11","prompt":{"locale":"vi-VN","text":"Dịch câu này: \"Chúng tôi có một con chó và một con mèo.\""},"skillIds":["u2.grammar"],"type":"wordBank","vocabularyIds":["u2.have","u2.cat","u2.dog"]},{"content":{"maxChars":200,"placeholder":"Viết bằng tiếng Anh"},"explanation":"Đáp án: \"His wife is a teacher.\".","gradingRule":{"acceptedText":["His wife is a teacher."],"caseSensitive":false,"ignoreDiacritics":false,"ignorePunctuation":true},"hint":"\"teacher\" = giáo viên; \"wife\" = vợ","id":"u2n6l5-e12","prompt":{"locale":"vi-VN","text":"Vợ anh ấy là giáo viên."},"skillIds":["u2.grammar"],"type":"textTranslation","vocabularyIds":["u1.teacher","u2.wife"]}],"gradingRulesVersion":"g1","guideText":"Mẫu câu chính: \"This is my mother.\" (Đây là mẹ tôi.) — \"I have a brother.\" (Tôi có một anh/em trai.)\nTính từ sở hữu: my (của tôi), your (của bạn), his (của anh ấy), her (của cô ấy), their (của họ). Đặt TRƯỚC danh từ: \"my father\", không nói \"father my\".\nĐộng từ \"have\": I/you/we/they have — he/she has. \"Mai has a cat.\"\nLưu ý: tiếng Anh không phân biệt anh/em: \"brother\" = anh trai hoặc em trai, \"sister\" = chị gái hoặc em gái. \"Aunt/uncle\" gồm cả cô, dì, chú, cậu, bác.","lessonId":"u2n6l5","lessonVersion":"v2.u2n6l5","manifestHash":"013672aa5927648264926e14d514d9d670ba04f547fc10aba6d50095b8e8b587","nodeId":"u2n6","order":13,"rewardIdentity":"v2.u2n6l5","schemaVersion":1,"sectionId":"sec1","signature":"Vdg0tBRkUiInnzZycOnbj40RcfXvzyU5Za0-4sgNe0h09q2Ol6lPVbJXLMl0btm3GzsI4pSYsd-L6yUCK2BICw","signatureKeyId":"dev-content-1","skillIds":["u2.vocab","u2.grammar","listening"],"title":"Họ hàng · Bài 5","unitId":"u2"}