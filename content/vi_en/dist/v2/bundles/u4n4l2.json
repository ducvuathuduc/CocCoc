":{"id":"p5r","text":"tám"}}]},"explanation":"old = già; five = năm (số 5); one = một; two = hai; eight = tám","gradingRule":{"caseSensitive":false,"correctPairIds":["p1","p2","p3","p4","p5"],"ignoreDiacritics":false,"ignorePunctuation":false},"hint":"Ví dụ: \"old\" = \"già\".","id":"u4n4l2-e09","prompt":{"locale":"vi-VN","text":"Nối các cặp từ tương ứng"},"skillIds":["u4.vocab"],"type":"matchPairs","vocabularyIds":["u4.old","u4.five","u4.one","u4.two","u4.eight"]},{"content":{"maxChars":200,"placeholder":"Viết bằng tiếng Anh"},"explanation":"Đáp án: \"Three apples, please.\".","gradingRule":{"acceptedText":["Three apples, please."],"caseSensitive":false,"ignoreDiacritics":false,"ignorePunctuation":true},"hint":"\"please\" = làm ơn; \"apple\" = quả táo; \"three\" = ba (số 3)","id":"u4n4l2-e10","prompt":{"locale":"vi-VN","text":"Làm ơn cho tôi ba quả táo."},"skillIds":["u4.grammar"],"type":"textTranslation","vocabularyIds":["u1.please","u3.apple","u4.three"]},{"content":{"choices":[{"id":"c1","imageAssetId":"i.u2.family","text":"family"},{"id":"c2","imageAssetId":"i.u2.baby","text":"baby"},{"id":"c3","imageAssetId":"i.u3.juice","text":"juice"},{"id":"c4","imageAssetId":"i.u3.milk","text":"milk"}]},"explanation":"\"baby\" = \"em bé\".","gradingRule":{"caseSensitive":false,"correctChoiceId":"c2","ignoreDiacritics":false,"ignorePunctuation":false},"hint":"\"em bé\" là \"baby\".","id":"u4n4l2-e11","prompt":{"locale":"vi-VN","text":"Hình nào là \"em bé\"?"},"skillIds":["u4.vocab"],"type":"imageChoice","vocabularyIds":["u2.baby"]}],"gradingRulesVersion":"g1","guideText":"Mẫu câu chính: \"How old are you?\" (Bạn bao nhiêu tuổi?) — \"I am twenty years old.\" (Tôi hai mươi tuổi.) — \"How many books do you have?\" (Bạn có bao nhiêu quyển sách?)\nSố nhiều: thêm -s sau danh từ khi nhiều hơn một: one cat, two cats; one egg, six eggs. Tiếng Việt không đổi danh từ, nhưng tiếng Anh thì có.\nTuổi: dùng \"be\", không dùng \"have\": \"I am ten years old\" hoặc ngắn gọn \"I am ten\". Không nói \"I have ten years\".\nSố: 20 = twenty, 28 = twenty-eight (có gạch nối), 100 = a hundred / one hundred.\n\"How many + danh từ số nhiều\": How many pens? How many cats?","lessonId":"u4n4l2","lessonVersion":"v2.u4n4l2","manifestHash":"013672aa5927648264926e14d514d9d670ba04f547fc10aba6d50095b8e8b587","nodeId":"u4n4","order":27,"rewardIdentity":"v2.u4n4l2","schemaVersion":1,"sectionId":"sec1","signature":"gEBpNcsZ_TPda1MmQqsOlWoXb73iElUqUSI4gNP0neO5QFj-idiMvqm80Gs2I5rYtIdbRThJ-5OVVaIQlEJMCQ","signatureKeyId":"dev-content-1","skillIds":["reading","u4.story","u4.grammar","speaking","u4.dialogue","listening","u4.vocab"],"title":"Truyện: Ở hiệu sách · Bài 2","unitId":"u4"}