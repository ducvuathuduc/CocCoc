4","schemaVersion":1,"sectionId":"sec1","signature":"I6C4lLLFKN0LljB7DOPD1HpSQPlUK7hO9Jw1-phuoqHK9wYgn-_wsCqJDW7b8bHrYgw9ZVIyH34_eag8YZ_uAQ","signatureKeyId":"dev-content-1","skillIds":["speaking","u1.grammar","u1.dialogue","u1.vocab"],"title":"Bạn là ai? · Bài 4","unitId":"u1"}