ive":false,"ignoreDiacritics":false,"ignorePunctuation":true},"hint":"\"tall\" = cao","id":"u15n5l6-e12a","prompt":{"locale":"vi-VN","text":"Tom cao."},"skillIds":["listening","u15.grammar"],"type":"textTranslation","vocabularyIds":["u15.tall"]},"prompt":{"audioAssetId":"a.u15.s7.n","locale":"vi-VN","text":"Nghe và viết lại bằng tiếng Anh"},"skillIds":["listening","u15.grammar"],"type":"dictation","vocabularyIds":["u15.tall"]}],"gradingRulesVersion":"g1","guideText":"Mẫu câu chính: \"Why are you sad?\" (Sao bạn buồn?) — \"Nam is taller than Tom.\" (Nam cao hơn Tom.) — \"Happy birthday!\" (Chúc mừng sinh nhật!)\nSo sánh hơn với tính từ ngắn: thêm -er + than: tall → taller than, young → younger than, smart → smarter than.\nTính từ cảm xúc đuôi -ed mô tả cảm giác của người: I am bored, I am excited, She was surprised.\nGiới từ đi kèm: afraid of (sợ), worried about (lo về), excited about (háo hức về).\nLời khuyên nhẹ nhàng: \"Don't be sad.\" (Đừng buồn.)","lessonId":"u15n5l6","lessonVersion":"v2.u15n5l6","manifestHash":"013672aa5927648264926e14d514d9d670ba04f547fc10aba6d50095b8e8b587","nodeId":"u15n5","order":116,"rewardIdentity":"v2.u15n5l6","schemaVersion":1,"sectionId":"sec2","signature":"sGRNmksQrwC6QgYicxjbEOcApk-qaPF2X3D_qFeD5kfnt3eH5FXa4bjo-uJ0hzODeBbb0AqPfk8WSCf2vjA0BA","signatureKeyId":"dev-content-1","skillIds":["listening","u15.grammar","u15.vocab"],"title":"Lo lắng và hào hứng · Bài 6","unitId":"u15"}