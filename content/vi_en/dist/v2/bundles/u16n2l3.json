úng ta hãy ... nhé): \"Let's have a picnic.\"","lessonId":"u16n2l3","lessonVersion":"v2.u16n2l3","manifestHash":"013672aa5927648264926e14d514d9d670ba04f547fc10aba6d50095b8e8b587","nodeId":"u16n2","order":121,"rewardIdentity":"v2.u16n2l3","schemaVersion":1,"sectionId":"sec2","signature":"QwaMoXDtzt2XDBI66LOdSYdANo8h96JtgdZj4g0zQhBF0qKjfqXfjU3gIMAoosYdJnscRsQLQ8We1ApqVXmWCg","signatureKeyId":"dev-content-1","skillIds":["listening","u16.grammar","u16.vocab"],"title":"Cuối tuần trước · Bài 3","unitId":"u16"}