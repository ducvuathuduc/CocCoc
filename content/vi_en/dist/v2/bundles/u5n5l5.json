abularyIds":["u5.weekend"]},{"content":{"tokens":[{"id":"t1","text":"school"},{"id":"t2","text":"to"},{"id":"t3","text":"drink"},{"id":"t4","text":"Mai"},{"id":"t5","text":"goes"},{"id":"t6","text":"baby"},{"id":"t7","text":"up"}]},"explanation":"Câu đúng: \"Mai goes to school.\".","gradingRule":{"caseSensitive":false,"correctTokenIds":["t4","t5","t2","t1"],"ignoreDiacritics":false,"ignorePunctuation":false},"hint":"\"go\" = đi; \"school\" = trường","id":"u5n5l5-e11","prompt":{"locale":"vi-VN","text":"Dịch câu này: \"Mai đi học.\""},"skillIds":["u5.grammar"],"type":"wordBank","vocabularyIds":["u5.go","u5.school"]},{"content":{"maxChars":200,"placeholder":"Viết bằng tiếng Anh"},"explanation":"Đáp án: \"It is seven o'clock.\". Cũng đúng: \"It's seven o'clock.\".","gradingRule":{"acceptedText":["It is seven o'clock.","It's seven o'clock."],"caseSensitive":false,"ignoreDiacritics":false,"ignorePunctuation":true},"hint":"\"seven\" = bảy; \"o'clock\" = giờ (đúng)","id":"u5n5l5-e12","prompt":{"locale":"vi-VN","text":"Bây giờ là bảy giờ."},"skillIds":["u5.grammar"],"type":"textTranslation","vocabularyIds":["u4.seven","u5.oclock"]}],"gradingRulesVersion":"g1","guideText":"Mẫu câu chính: \"What time is it?\" (Mấy giờ rồi?) — \"It is seven o'clock.\" (Bảy giờ rồi.) — \"I get up at six.\" (Tôi dậy lúc sáu giờ.)\nGiới từ thời gian: at + giờ (at six o'clock), on + thứ (on Monday), in + buổi (in the morning, in the evening).\nThì hiện tại đơn cho thói quen: \"Mai goes to school every day.\" Với he/she/it: go → goes, get up → gets up.\nTrạng từ tần suất đứng TRƯỚC động từ thường: \"I always eat breakfast\", \"Kiko never eats bread\". Thứ tự: always > usually > sometimes > never.\nThứ trong tuần luôn viết hoa: Monday, Sunday.","lessonId":"u5n5l5","lessonVersion":"v2.u5n5l5","manifestHash":"013672aa5927648264926e14d514d9d670ba04f547fc10aba6d50095b8e8b587","nodeId":"u5n5","order":36,"rewardIdentity":"v2.u5n5l5","schemaVersion":1,"sectionId":"sec1","signature":"O3RZbikxPiJB91fH7HAXNawr