ffice = văn phòng","gradingRule":{"caseSensitive":false,"correctPairIds":["p1","p2","p3","p4","p5"],"ignoreDiacritics":false,"ignorePunctuation":false},"hint":"Ví dụ: \"work\" = \"làm việc\".","id":"u12n4l2-e09","prompt":{"locale":"vi-VN","text":"Nối các cặp từ tương ứng"},"skillIds":["u12.vocab"],"type":"matchPairs","vocabularyIds":["u12.work","u12.doctor","u12.boss","u12.busy","u12.office"]},{"content":{"maxChars":200,"placeholder":"Viết bằng tiếng Anh"},"explanation":"Đáp án: \"I work in an office.\".","gradingRule":{"acceptedText":["I work in an office."],"caseSensitive":false,"ignoreDiacritics":false,"ignorePunctuation":true},"hint":"\"work\" = làm việc; \"office\" = văn phòng","id":"u12n4l2-e10","prompt":{"locale":"vi-VN","text":"Tôi làm việc ở văn phòng."},"skillIds":["u12.grammar"],"type":"textTranslation","vocabularyIds":["u12.work","u12.office"]},{"content":{"choices":[{"id":"c1","imageAssetId":"i.u12.driver","text":"driver"},{"id":"c2","imageAssetId":"i.u6.sofa","text":"sofa"},{"id":"c3","imageAssetId":"i.u2.brother","text":"brother"},{"id":"c4","imageAssetId":"i.u6.house","text":"house"}]},"explanation":"\"driver\" = \"tài xế\".","gradingRule":{"caseSensitive":false,"correctChoiceId":"c1","ignoreDiacritics":false,"ignorePunctuation":false},"hint":"\"tài xế\" là \"driver\".","id":"u12n4l2-e11","prompt":{"locale":"vi-VN","text":"Hình nào là \"tài xế\"?"},"skillIds":["u12.vocab"],"type":"imageChoice","vocabularyIds":["u12.driver"]}],"gradingRulesVersion":"g1","guideText":"Mẫu câu chính: \"What do you do?\" (Bạn làm nghề gì?) — \"I am an engineer.\" (Tôi là kỹ sư.) — \"I worked late yesterday.\" (Hôm qua tôi làm việc muộn.)\nNghề nghiệp luôn có a/an: \"She is a nurse\", \"He is an engineer\" (an trước nguyên âm).\nThì quá khứ đơn (động từ có quy tắc): thêm -ed: work → worked, start → started, finish → finished. Quá khứ của \"be\": I/he/she was, you/we/they were.\nCâu hỏi quá khứ dùng \"did\" + động từ nguyên mẫu: \"Did you finish your work?\" (không nói \"Did you finished\").\nMốc thời gian quá khứ: yesterday (hôm qua), last week (tuần trước).","lessonId":"u12n4l2","lessonVersion":"v2.u12n4l2","manifestHash":"013672aa5927648264926e14d514d9d670ba04f547fc10aba6d50095b8e8b587","nodeId":"u12n4","order":91,"rewardIdentity":"v2.u12n4l2","schemaVersion":1,"sectionId":"sec2","signature":"mZWXoK8e8PQ9KpPpqUc0hXwmteFcOJmWvWvVZxahMczGZuC-Tu1EyLULrEkWl59_i_yWeHU1Ixgs3LslxFpJAg","signatureKeyId":"dev-content-1","skillIds":["reading","u12.story","u12.grammar","speaking","u12.dialogue","listening","u12.vocab"],"title":"Truyện: Ngày đầu đi làm của Linh · Bài 2","unitId":"u12"}