me":"image/webp","modelVersion":null,"provider":null,"sha256":"08ba3821b6b1a079e9db5169d3b2d2cff0b16ec29709b96e829896cec9c409b9","speed":null,"voice":null,"width":512},{"altText":"Hình minh họa: mùa hè (summer)","bytes":5984,"durationMs":null,"fileId":"i.u8.summer","height":512,"locale":null,"mime":"image/webp","modelVersion":null,"provider":null,"sha256":"3e18e2b5e87037490f2eea713d10b486e80efa6dc77fb04062e72f1f2f8889bf","speed":null,"voice":null,"width":512}],"courseId":"vi_en","courseVersion":"v2","exercises":[{"content":{"choices":[{"id":"c1","text":"Mai"},{"id":"c2","text":"Nam"},{"id":"c3","text":"Tom"}],"passage":"In Canada, Tom wears a coat in winter. It is very cold and there is snow. In Ho Chi Minh City, it is always hot. Today it is sunny in the morning. Tom does not take an umbrella. In the afternoon, the sky is cloudy and it starts to rain. Tom is outside! Mai has an umbrella. \"Here, Tom. Vietnam has two seasons: the dry season and the rainy season. Now it is the rainy season!\" Tom laughs. \"I love the weather here. It is never cold!\"","question":"Who has an umbrella?"},"explanation":"Đáp án: \"Mai\".","gradingRule":{"caseSensitive":false,"correctChoiceId":"c1","ignoreDiacritics":false,"ignorePunctuation":false},"hint":"Đọc lại câu chuyện \"Tom và mùa mưa\".","id":"u8n4l2-e01","prompt":{"locale":"en-US","text":"Who has an umbrella?"},"skillIds":["reading","u8.story"],"type":"storyQuestion","vocabularyIds":[]},{"content":{"choices":[{"id":"c1","text":"One"},{"id":"c2","text":"Two"},{"id":"c3","text":"Four"}],"passage":"In Canada, Tom wears a coat in winter. It is very cold and there is snow. In Ho Chi Minh City, it is always hot. Today it is sunny in the morning. Tom does not take an umbrella. In the afternoon, the sky is cloudy and it starts to rain. Tom is outside! Mai has an umbrella. \"Here, Tom. Vietnam has two seasons: the dry season and the rainy season. Now it is the rainy season!\" Tom laughs. \"I love the weather here. It is never cold!\"","q