p5l","text":"warm"},"right":{"id":"p5r","text":"ấm"}}]},"explanation":"hot = nóng; cool = mát; summer = mùa hè; cloudy = nhiều mây; warm = ấm","gradingRule":{"caseSensitive":false,"correctPairIds":["p1","p2","p3","p4","p5"],"ignoreDiacritics":false,"ignorePunctuation":false},"hint":"Ví dụ: \"hot\" = \"nóng\".","id":"u8n4l2-e09","prompt":{"locale":"vi-VN","text":"Nối các cặp từ tương ứng"},"skillIds":["u8.vocab"],"type":"matchPairs","vocabularyIds":["u8.hot","u8.cool","u8.summer","u8.cloudy","u8.warm"]},{"content":{"maxChars":200,"placeholder":"Viết bằng tiếng Anh"},"explanation":"Đáp án: \"It is cool in the evening.\". Cũng đúng: \"It's cool in the evening.\".","gradingRule":{"acceptedText":["It is cool in the evening.","It's cool in the evening."],"caseSensitive":false,"ignoreDiacritics":false,"ignorePunctuation":true},"hint":"\"evening\" = buổi tối; \"cool\" = mát","id":"u8n4l2-e10","prompt":{"locale":"vi-VN","text":"Buổi tối trời mát."},"skillIds":["u8.grammar"],"type":"textTranslation","vocabularyIds":["u5.evening","u8.cool"]},{"content":{"choices":[{"id":"c1","imageAssetId":"i.u6.garden","text":"garden"},{"id":"c2","imageAssetId":"i.u2.father","text":"father"},{"id":"c3","imageAssetId":"i.u8.summer","text":"summer"},{"id":"c4","imageAssetId":"i.u3.water","text":"water"}]},"explanation":"\"summer\" = \"mùa hè\".","gradingRule":{"caseSensitive":false,"correctChoiceId":"c3","ignoreDiacritics":false,"ignorePunctuation":false},"hint":"\"mùa hè\" là \"summer\".","id":"u8n4l2-e11","prompt":{"locale":"vi-VN","text":"Hình nào là \"mùa hè\"?"},"skillIds":["u8.vocab"],"type":"imageChoice","vocabularyIds":["u8.summer"]}],"gradingRulesVersion":"g1","guideText":"Mẫu câu chính: \"How is the weather today?\" (Thời tiết hôm nay thế nào?) — \"It is sunny.\" (Trời nắng.) — \"It is raining.\" (Trời đang mưa.)\nChủ ngữ giả \"it\": tiếng Việt nói \"trời nắng\", tiếng Anh phải có chủ ngữ: \"It is sunny\", không nói \"Is sunny\".\nThì hiện tại tiếp diễn cho việc đang xảy ra: It is raining now. So sánh: It is rainy (trời có mưa — mô tả chung).\nMùa: in (the) summer, in winter. Miền Nam Việt Nam có hai mùa: the dry season (mùa khô) và the rainy season (mùa mưa).\n\"Fall\" là cách Mỹ gọi mùa thu; \"autumn\" dùng ở Anh — cả hai đều đúng.","lessonId":"u8n4l2","lessonVersion":"v2.u8n4l2","manifestHash":"013672aa5927648264926e14d514d9d670ba04f547fc10aba6d50095b8e8b587","nodeId":"u8n4","order":59,"rewardIdentity":"v2.u8n4l2","schemaVersion":1,"sectionId":"sec1","signature":"B8Dar3VkUjIpiicAmq1IXiatgCmMiJcJq2N-99L7Lv6Y1cAJfk9iuX1R_L__YPQvCkTNzFdZ3nrivYvqL1CnBA","signatureKeyId":"dev-content-1","skillIds":["reading","u8.story","u8.grammar","speaking","u8.dialogue","listening","u8.vocab"],"title":"Truyện: Tom và mùa mưa · Bài 2","unitId":"u8"}