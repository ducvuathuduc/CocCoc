,"text":"có"},{"id":"t5","text":"hai"},{"id":"t6","text":"bảy"},{"id":"t7","text":"từ"},{"id":"t8","text":"tuần"},{"id":"t9","text":"mươi"}]},"explanation":"Câu đúng: \"Một tuần có bảy ngày.\".","gradingRule":{"caseSensitive":false,"correctTokenIds":["t1","t8","t4","t6","t3"],"ignoreDiacritics":false,"ignorePunctuation":false},"hint":"\"seven\" = bảy; \"day\" = ngày; \"week\" = tuần","id":"u5n5l1-e09","prompt":{"locale":"vi-VN","text":"Dịch sang tiếng Việt: \"There are seven days in a week.\""},"skillIds":["u5.grammar"],"type":"wordBank","vocabularyIds":["u4.seven","u5.day","u5.week"]},{"content":{"tokens":[{"id":"t1","text":"Sunday"},{"id":"t2","text":"not"},{"id":"t3","text":"go"},{"id":"t4","text":"on"},{"id":"t5","text":"do"},{"id":"t6","text":"to"},{"id":"t7","text":"We"},{"id":"t8","text":"school"}]},"explanation":"Câu đúng: \"We do not go to school on Sunday.\".","gradingRule":{"caseSensitive":false,"correctTokenIds":["t7","t5","t2","t3","t6","t8","t4","t1"],"ignoreDiacritics":false,"ignorePunctuation":false},"hint":"Câu bắt đầu bằng \"We\".","id":"u5n5l1-e10","prompt":{"locale":"vi-VN","text":"Sắp xếp thành câu đúng: \"Chúng tôi không đi học vào Chủ nhật.\""},"skillIds":["u5.grammar"],"type":"sentenceOrder","vocabularyIds":["u5.go","u5.school","u5.sunday"]},{"content":{"maxChars":40,"placeholder":"Điền từ còn thiếu"},"explanation":"Từ đúng: \"week\" → I meet my grandmother every week.","gradingRule":{"acceptedText":["week"],"caseSensitive":false,"ignoreDiacritics":false,"ignorePunctuation":true},"hint":"\"tuần\" trong tiếng Anh là \"w...\"","id":"u5n5l1-e11","prompt":{"locale":"en-US","text":"I meet my grandmother every ___. — \"Tôi gặp bà tôi mỗi tuần.\""},"skillIds":["u5.grammar"],"type":"fillBlank","vocabularyIds":["u5.week","u1.meet","u2.grandmother","u5.every"]},{"content":{"maxChars":200,"placeholder":"Viết bằng tiếng Anh"},"explanation":"Đáp án: \"Today is Monday.\".","gradingRule":{"acceptedText":["Today is Monday."],"caseSensitive":false,"ignoreDiacritics":false,"ignorePunctuation":true},"hint":"\"today\" = hôm nay; \"Monday\" = thứ Hai","id":"u5n5l1-e12","prompt":{"locale":"vi-VN","text":"Hôm nay là thứ Hai."},"skillIds":["u5.grammar"],"type":"textTranslation","vocabularyIds":["u5.today","u5.monday"]},{"content":{"tokens":[{"id":"t1","text":"One"},{"id":"t2","text":"Rosa"},{"id":"t3","text":"delicious"},{"id":"t4","text":"Good"},{"id":"t5","text":"evening"},{"id":"t6","text":"Mrs"},{"id":"t7","text":"every"}]},"explanation":"Câu đúng: \"Good evening, Mrs. Rosa.\".","gradingRule":{"caseSensitive":false,"correctTokenIds":["t4","t5","t6","t2"],"ignoreDiacritics":false,"ignorePunctuation":false},"hint":"\"good\" = tốt; \"evening\" = buổi tối","id":"u5n5l1-e13","prompt":{"locale":"vi-VN","text":"Dịch câu này: \"Chào buổi tối, bà Rosa.\""},"skillIds":["u5.grammar"],"type":"wordBank","vocabularyIds":["u1.good","u5.evening"]}],"gradingRulesVersion":"g1","guideText":"Mẫu câu chính: \"What time is it?\" (Mấy giờ rồi?) — \"It is seven o'clock.\" (Bảy giờ rồi.) — \"I get up at six.\" (Tôi dậy lúc sáu giờ.)\nGiới từ thời gian: at + giờ (at six o'clock), on + thứ (on Monday), in + buổi (in the morning, in the evening).\nThì hiện tại đơn cho thói quen: \"Mai goes to school every day.\" Với he/she/it: go → goes, get up → gets up.\nTrạng từ tần suất đứng TRƯỚC động từ thường: \"I always eat breakfast\", \"Kiko never eats bread\". Thứ tự: always > usually > sometimes > never.\nThứ trong tuần luôn viết hoa: Monday, Sunday.","lessonId":"u5n5l1","lessonVersion":"v2.u5n5l1","manifestHash":"013672aa5927648264926e14d514d9d670ba04f547fc10aba6d50095b8e8b587","nodeId":"u5n5","order":36,"rewardIdentity":"v2.u5n5l1","schemaVersion":1,"sectionId":"sec1","signature":"TdwgLk1g5dCLKVDWvYb5jLRDJJfPXJxGJmARkyZ7g7ABoXFtNUYnxKw4V9JH7nbIyXysHNMU91kVOfBx9biaBA","signatureKeyId":"dev-content-1","skillIds":["u5.vocab","u5.grammar","listening"],"title":"Các ngày trong tuần · Bài 1","unitId":"u5"}