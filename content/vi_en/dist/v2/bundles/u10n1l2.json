":"textTranslation","vocabularyIds":["u5.go","u10.street","u10.straight"]},"prompt":{"audioAssetId":"a.u10.s5.n","locale":"vi-VN","text":"Nghe và viết lại bằng tiếng Anh"},"skillIds":["listening","u10.grammar"],"type":"dictation","vocabularyIds":["u5.go","u10.street","u10.straight"]},{"content":{"tokens":[{"id":"t1","text":"has"},{"id":"t2","text":"time"},{"id":"t3","text":"seven"},{"id":"t4","text":"My"},{"id":"t5","text":"cats"},{"id":"t6","text":"students"},{"id":"t7","text":"grandmother"},{"id":"t8","text":"on"}]},"explanation":"Câu đúng: \"My grandmother has seven cats.\".","gradingRule":{"caseSensitive":false,"correctTokenIds":["t4","t7","t1","t3","t5"],"ignoreDiacritics":false,"ignorePunctuation":false},"hint":"\"grandmother\" = bà; \"have\" = có; \"cat\" = con mèo; \"seven\" = bảy","id":"u10n1l2-e11","prompt":{"locale":"vi-VN","text":"Dịch câu này: \"Bà tôi có bảy con mèo.\""},"skillIds":["u10.grammar"],"type":"wordBank","vocabularyIds":["u2.grandmother","u2.have","u2.cat","u4.seven"]},{"content":{"maxChars":200,"placeholder":"Viết bằng tiếng Anh"},"explanation":"Đáp án: \"I do not have money.\". Cũng đúng: \"I don't have money.\".","gradingRule":{"acceptedText":["I do not have money.","I don't have money."],"caseSensitive":false,"ignoreDiacritics":false,"ignorePunctuation":true},"hint":"\"have\" = có; \"money\" = tiền","id":"u10n1l2-e12","prompt":{"locale":"vi-VN","text":"Tôi không có tiền."},"skillIds":["u10.grammar"],"type":"textTranslation","vocabularyIds":["u2.have","u9.money"]}],"gradingRulesVersion":"g1","guideText":"Mẫu câu chính: \"Excuse me, where is the bank?\" (Xin lỗi, ngân hàng ở đâu?) — \"Go straight and turn left.\" (Đi thẳng rồi rẽ trái.) — \"Is it far?\" (Có xa không?)\nChỉ đường dùng câu mệnh lệnh: Go straight. Turn right. Turn left at the corner.\nVị trí: on the left / on the right (bên trái / bên phải), next to (bên cạnh), opposite (đối diện), near (gần), on the corner (ở góc đường).\n\"Near\" không cần \"to\": \"near the school\" (không nói \"near to the school\" trong văn nói chuẩn A2).\nHỏi khoảng cách: \"Is it far from here?\" — Trả lời: \"No, you can walk.\" (Không, bạn có thể đi bộ.)","lessonId":"u10n1l2","lessonVersion":"v2.u10n1l2","manifestHash":"013672aa5927648264926e14d514d9d670ba04f547fc10aba6d50095b8e8b587","nodeId":"u10n1","order":72,"rewardIdentity":"v2.u10n1l2","schemaVersion":1,"sectionId":"sec2","signature":"8G32Lc5aWNkmEgD8Ws0I-kBPxEqrU-mkrnO6W55oSt1DusM8bvBQLvpTc9imoGxtFhIIRjZdJK-YLdmUN1uWDQ","signatureKeyId":"dev-content-1","skillIds":["u10.vocab","u10.grammar","listening"],"title":"Trái, phải, thẳng · Bài 2","unitId":"u10"}