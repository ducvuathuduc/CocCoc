.story"],"type":"storyQuestion","vocabularyIds":[]},{"content":{"maxChars":200,"placeholder":"Viết những gì bạn nghe"},"explanation":"Bạn nghe: \"Turn left at the corner.\".","gradingRule":{"acceptedText":["Turn left at the corner."],"caseSensitive":false,"ignoreDiacritics":false,"ignorePunctuation":true},"hint":"Câu có 5 từ. Nghĩa: \"Rẽ trái ở góc đường.\"","id":"u10n4l2-e06","nonAudioAlternative":{"content":{"maxChars":200,"placeholder":"Viết bằng tiếng Anh"},"explanation":"Đáp án: \"Turn left at the corner.\".","gradingRule":{"acceptedText":["Turn left at the corner."],"caseSensitive":false,"ignoreDiacritics":false,"ignorePunctuation":true},"hint":"\"left\" = bên trái; \"turn\" = rẽ; \"corner\" = góc đường","id":"u10n4l2-e06a","prompt":{"locale":"vi-VN","text":"Rẽ trái ở góc đường."},"skillIds":["listening","u10.grammar"],"type":"textTranslation","vocabularyIds":["u10.left","u10.turn","u10.corner"]},"prompt":{"audioAssetId":"a.u10.s18.n","locale":"vi-VN","text":"Nghe và viết lại bằng tiếng Anh"},"skillIds":["listening","u10.grammar"],"type":"dictation","vocabularyIds":["u10.left","u10.turn","u10.corner"]},{"content":{"maxChars":200,"placeholder":"Viết bằng tiếng Việt (có dấu)"},"explanation":"Đáp án: \"Ngân hàng có gần đây không?\". Cũng đúng: \"Ngân hàng ở gần đây không?\".","gradingRule":{"acceptedText":["Ngân hàng có gần đây không?","Ngân hàng ở gần đây không?"],"caseSensitive":false,"ignoreDiacritics":false,"ignorePunctuation":true},"hint":"\"bank\" = ngân hàng; \"near\" = gần","id":"u10n4l2-e07","prompt":{"locale":"en-US","text":"Is the bank near here?"},"skillIds":["u10.grammar"],"type":"textTranslation","vocabularyIds":["u10.bank","u10.near"]},{"content":{"tokens":[{"id":"t1","text":"is"},{"id":"t2","text":"What"},{"id":"t3","text":"street"},{"id":"t4","text":"name"},{"id":"t5","text":"the"},{"id":"t6","text":"this"},{"id":"t7","text":"of"}]},"explanation":"Câu đúng: \"What is the name of this street?\".","gradingRule":{"caseSensitive":false,"correctTokenIds":["t2","t1","t5","t4","t7","t6","t3"],"ignoreDiacritics":false,"ignorePunctuation":false},"hint":"Câu bắt đầu bằng \"What\".","id":"u10n4l2-e08","prompt":{"locale":"vi-VN","text":"Sắp xếp thành câu đúng: \"Con đường này tên là gì?\""},"skillIds":["u10.grammar"],"type":"sentenceOrder","vocabularyIds":["u1.name","u10.street"]},{"content":{"pairs":[{"id":"p1","left":{"id":"p1l","text":"corner"},"right":{"id":"p1r","text":"góc đường"}},{"id":"p2","left":{"id":"p2l","text":"left"},"right":{"id":"p2r","text":"bên trái"}},{"id":"p3","left":{"id":"p3l","text":"park"},"right":{"id":"p3r","text":"công viên"}},{"id":"p4","left":{"id":"p4l","text":"hospital"},"right":{"id":"p4r","text":"bệnh viện"}},{"id":"p5","left":{"id":"p5l","text":"next to"},"right":{"id":"p5r","text":"bên cạnh"}}]},"explanation":"corner = góc đường; left = bên trái; park = công viên; hospital = bệnh viện; next to = bên cạnh","gradingRule":{"caseSensitive":false,"correctPairIds":["p1","p2","p3","p4","p5"],"ignoreDiacritics":false,"ignorePunctuation":false},"hint":"Ví dụ: \"corner\" = \"góc đường\".","id":"u10n4l2-e09","prompt":{"locale":"vi-VN","text":"Nối các cặp từ tương ứng"},"skillIds":["u10.vocab"],"type":"matchPairs","vocabularyIds":["u10.corner","u10.left","u10.park","u10.hospital","u10.next_to"]},{"content":{"maxChars":200,"placeholder":"Viết bằng tiếng Anh"},"explanation":"Đáp án: \"The school is on the right.\".","gradingRule":{"acceptedText":["The school is on the right."],"caseSensitive":false,"ignoreDiacritics":false,"ignorePunctuation":true},"hint":"\"school\" = trường; \"right\" = bên phải","id":"u10n4l2-e10","prompt":{"locale":"vi-VN","text":"Trường học ở bên phải."},"skillIds":["u10.grammar"],"type":"textTranslation","vocabularyIds":["u5.school","u10.right"]},{"content":{"choices":[{"id":"c1","imageAssetId":"i.u4.phone","text":"phone"},{"id":"c2","imageAssetId":"i.u10.bank","text":"bank"},{"id":"c3","imageAssetId":"i.u6.door","text":"door"},{"id":"c4","imageAssetId":"i.u5.night","text":"night"}]},"explanation":"\"bank\" = \"ngân hàng\".","gradingRule":{"caseSensitive":false,"correctChoiceId":"c2","ignoreDiacritics":false,"ignorePunctuation":false},"hint":"\"ngân hàng\" là \"bank\".","id":"u10n4l2-e11","prompt":{"locale":"vi-VN","text":"Hình nào là \"ngân hàng\"?"},"skillIds":["u10.vocab"],"type":"imageChoice","vocabularyIds":["u10.bank"]}],"gradingRulesVersion":"g1","guideText":"Mẫu câu chính: \"Excuse me, where is the bank?\" (Xin lỗi, ngân hàng ở đâu?) — \"Go straight and turn left.\" (Đi thẳng rồi rẽ trái.) — \"Is it far?\" (Có xa không?)\nChỉ đường dùng câu mệnh lệnh: Go straight. Turn right. Turn left at the corner.\nVị trí: on the left / on the right (bên trái / bên phải), next to (bên cạnh), opposite (đối diện), near (gần), on the corner (ở góc đường).\n\"Near\" không cần \"to\": \"near the school\" (không nói \"near to the school\" trong văn nói chuẩn A2).\nHỏi khoảng cách: \"Is it far from here?\" — Trả lời: \"No, you can walk.\" (Không, bạn có thể đi bộ.)","lessonId":"u10n4l2","lessonVersion":"v2.u10n4l2","manifestHash":"013672aa5927648264926e14d514d9d670ba04f547fc10aba6d50095b8e8b587","nodeId":"u10n4","order":75,"rewardIdentity":"v2.u10n4l2","schemaVersion":1,"sectionId":"sec2","signature":"iMUT4_e0JDH51qd7y-9PCSsh7O-kELr19sZZmh2R2Mw713z7GvVgNnhpVsVRzRPFdxfG9E2oQ_0UxiGxB-TcDA","signatureKeyId":"dev-content-1","skillIds":["reading","u10.story","u10.grammar","speaking","u10.dialogue","listening","u10.vocab"],"title":"Truyện: Tom bị lạc · Bài 2","unitId":"u10"}