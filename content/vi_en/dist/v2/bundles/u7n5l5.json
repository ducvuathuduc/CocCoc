Sensitive":false,"correctTokenIds":["t2","t7","t1","t6","t8"],"ignoreDiacritics":false,"ignorePunctuation":false},"hint":"\"understand\" = hiểu; \"question\" = câu hỏi","id":"u7n5l5-e11","prompt":{"locale":"vi-VN","text":"Dịch câu này: \"Bạn có hiểu câu hỏi không?\""},"skillIds":["u7.grammar"],"type":"wordBank","vocabularyIds":["u7.understand","u7.question"]},{"content":{"maxChars":200,"placeholder":"Viết bằng tiếng Anh"},"explanation":"Đáp án: \"I do not understand.\". Cũng đúng: \"I don't understand.\".","gradingRule":{"acceptedText":["I do not understand.","I don't understand."],"caseSensitive":false,"ignoreDiacritics":false,"ignorePunctuation":true},"hint":"\"understand\" = hiểu","id":"u7n5l5-e12","prompt":{"locale":"vi-VN","text":"Tôi không hiểu."},"skillIds":["u7.grammar"],"type":"textTranslation","vocabularyIds":["u7.understand"]}],"gradingRulesVersion":"g1","guideText":"Mẫu câu chính: \"Can you help me?\" (Bạn có thể giúp tôi không?) — \"I do not understand.\" (Tôi không hiểu.) — \"Please open your books.\" (Hãy mở sách ra.)\n\"Can\" + động từ nguyên mẫu (không thêm -s, không \"to\"): \"She can speak English\", không nói \"She cans speaks\".\nCâu mệnh lệnh: bắt đầu bằng động từ: \"Open the window.\" Thêm \"please\" cho lịch sự.\nCâu hỏi \"What does this word mean?\" — dùng khi gặp từ mới. Trả lời: \"It means ...\".\nHọc sinh Việt hay nhầm: \"learn\" (học, tiếp thu) và \"study\" (học bài, nghiên cứu) — cả hai đều dịch là \"học\".","lessonId":"u7n5l5","lessonVersion":"v2.u7n5l5","manifestHash":"013672aa5927648264926e14d514d9d670ba04f547fc10aba6d50095b8e8b587","nodeId":"u7n5","order":52,"rewardIdentity":"v2.u7n5l5","schemaVersion":1,"sectionId":"sec1","signature":"imUmfFYiW2pPCLLr1jdhALVZL7IP2ST0nE1Z0zmkeJ7IIz957FYT_vnSW0KVS1Uk_I6D0M1XruvoQqF3HyDbDg","signatureKeyId":"dev-content-1","skillIds":["u7.vocab","u7.grammar","listening"],"title":"Dễ hay khó? · Bài 5","unitId":"u7"}