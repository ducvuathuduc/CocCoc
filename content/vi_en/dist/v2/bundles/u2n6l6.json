itive":false,"correctTokenIds":["t3","t2","t1","t4"],"ignoreDiacritics":false,"ignorePunctuation":false},"hint":"Câu bắt đầu bằng \"Nam\".","id":"u2n6l6-e11a","prompt":{"locale":"vi-VN","text":"Sắp xếp thành câu đúng: \"Nam là anh trai tôi.\""},"skillIds":["speaking","u2.grammar"],"type":"sentenceOrder","vocabularyIds":["u2.brother"]},"prompt":{"audioAssetId":"a.u2.s4.n","locale":"en-US","text":"Nói câu sau: \"Nam is my brother.\""},"skillIds":["speaking","u2.grammar"],"type":"speakRepeat","vocabularyIds":["u2.brother"]},{"content":{"maxChars":200,"placeholder":"Viết bằng tiếng Việt (có dấu)"},"explanation":"Đáp án: \"Cô bé là con gái bạn à?\". Cũng đúng: \"Cô bé có phải là con gái của bạn không?\", \"Cô ấy có phải là con gái bạn không?\".","gradingRule":{"acceptedText":["Cô bé là con gái bạn à?","Cô bé có phải là con gái của bạn không?","Cô ấy có phải là con gái bạn không?"],"caseSensitive":false,"ignoreDiacritics":false,"ignorePunctuation":true},"hint":"\"daughter\" = con gái","id":"u2n6l6-e12","prompt":{"locale":"en-US","text":"Is she your daughter?"},"skillIds":["u2.grammar"],"type":"textTranslation","vocabularyIds":["u2.daughter"]}],"gradingRulesVersion":"g1","guideText":"Mẫu câu chính: \"This is my mother.\" (Đây là mẹ tôi.) — \"I have a brother.\" (Tôi có một anh/em trai.)\nTính từ sở hữu: my (của tôi), your (của bạn), his (của anh ấy), her (của cô ấy), their (của họ). Đặt TRƯỚC danh từ: \"my father\", không nói \"father my\".\nĐộng từ \"have\": I/you/we/they have — he/she has. \"Mai has a cat.\"\nLưu ý: tiếng Anh không phân biệt anh/em: \"brother\" = anh trai hoặc em trai, \"sister\" = chị gái hoặc em gái. \"Aunt/uncle\" gồm cả cô, dì, chú, cậu, bác.","lessonId":"u2n6l6","lessonVersion":"v2.u2n6l6","manifestHash":"013672aa5927648264926e14d514d9d670ba04f547fc10aba6d50095b8e8b587","nodeId":"u2n6","order":13,"rewardIdentity":"v2.u2n6l6","schemaVersion":1,"sectionId":"sec1","signature":"eqHiSWMao9gC5ZH7OJoTpdcLxDxEOJ2vcUScylubv5vOoz8lEOzQmDNugAjL0VhIDF9hMHiGEJYZSOVMAhVSAw","signatureKeyId":"dev-content-1","skillIds":["speaking","u2.grammar","u2.dialogue","u2.vocab"],"title":"Họ hàng · Bài 6","unitId":"u2"}