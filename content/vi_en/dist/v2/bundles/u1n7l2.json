"t10","text":"Vui"}]},"explanation":"Câu đúng: \"Vui lòng nói tên của bạn.\".","gradingRule":{"caseSensitive":false,"correctTokenIds":["t10","t9","t6","t5","t1","t4"],"ignoreDiacritics":false,"ignorePunctuation":false},"hint":"\"name\" = tên; \"please\" = làm ơn","id":"u1n7l2-e14","prompt":{"locale":"vi-VN","text":"Dịch sang tiếng Việt: \"Please say your name.\""},"skillIds":["u1.grammar"],"type":"wordBank","vocabularyIds":["u1.name","u1.please"]},{"content":{"maxChars":200,"placeholder":"Viết bằng tiếng Anh"},"explanation":"Đáp án: \"What is your name?\". Cũng đúng: \"What's your name?\".","gradingRule":{"acceptedText":["What is your name?","What's your name?"],"caseSensitive":false,"ignoreDiacritics":false,"ignorePunctuation":true},"hint":"\"name\" = tên","id":"u1n7l2-e15","prompt":{"locale":"vi-VN","text":"Bạn tên là gì?"},"skillIds":["u1.grammar"],"type":"textTranslation","vocabularyIds":["u1.name"]}],"gradingRulesVersion":"g1","guideText":"Mẫu câu chính: \"Hello, I am Mai.\" (Xin chào, tôi là Mai.) — \"What is your name?\" (Bạn tên là gì?) — \"Nice to meet you.\" (Rất vui được gặp bạn.)\nNgữ pháp: động từ \"to be\": I am, you are, he/she is. Khi nói, người bản xứ hay rút gọn: I'm, you're, he's, she's. Cả hai cách viết đều được chấp nhận.\nMẹo: \"I\" luôn viết hoa. Dùng \"a\" trước nghề nghiệp: \"I am a student.\" Tiếng Việt có thể bỏ \"một\", tiếng Anh thì không.\nLịch sự: \"Excuse me\" dùng để bắt chuyện, \"Sorry\" dùng khi xin lỗi vì lỗi của mình.","lessonId":"u1n7l2","lessonVersion":"v2.u1n7l2","manifestHash":"013672aa5927648264926e14d514d9d670ba04f547fc10aba6d50095b8e8b587","nodeId":"u1n7","order":6,"rewardIdentity":"v2.u1n7l2","schemaVersion":1,"sectionId":"sec1","signature":"NZ8tOltjK_aSRNRziZZ0fB87jCnjho627GXq3ovpspMAyvep6U-Sb1myNlHGVLJ33QUZIIEW33MPjSbPqejyDA","signatureKeyId":"dev-content-1","skillIds":["u1.grammar","listening","speaking","u1.dialogue","reading","u1.story","u1.vocab"],"title":"Ôn tập cửa ải · Bài 2","unitId":"u1"}