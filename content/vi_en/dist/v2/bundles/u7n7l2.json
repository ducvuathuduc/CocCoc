 \"Bạn có thể đóng cửa giúp tôi không?\"","id":"u7n7l2-e07a","prompt":{"locale":"vi-VN","text":"Chọn câu tiếng Anh có nghĩa: \"Bạn có thể đóng cửa giúp tôi không?\""},"skillIds":["listening","u7.grammar"],"type":"choice","vocabularyIds":["u1.please","u6.door","u7.can","u7.close"]},"prompt":{"audioAssetId":"a.u7.s26.n","locale":"vi-VN","text":"Nghe và chọn câu bạn nghe được"},"skillIds":["listening","u7.grammar"],"type":"listenChoice","vocabularyIds":["u1.please","u6.door","u7.can","u7.close"]},{"content":{"locale":"en-US","maxSeconds":12,"referenceText":"Yes, please."},"explanation":"Câu trả lời mẫu: \"Yes, please.\". Cũng đúng: \"Yes, you can.\".","gradingRule":{"acceptedText":["Yes, please.","Yes, you can."],"caseSensitive":false,"ignoreDiacritics":false,"ignorePunctuation":true},"hint":"Gợi ý trả lời: \"Vâng, bạn cứ mở.\"","id":"u7n7l2-e08","nonSpeechAlternative":{"content":{"choices":[{"id":"c1","text":"Yes, it is my book."},{"id":"c2","text":"Yes, a little."},{"id":"c3","text":"Yes, please."}]},"explanation":"Câu trả lời mẫu: \"Yes, please.\".","gradingRule":{"caseSensitive":false,"correctChoiceId":"c3","ignoreDiacritics":false,"ignorePunctuation":false},"hint":"Gợi ý trả lời: \"Vâng, bạn cứ mở.\"","id":"u7n7l2-e08a","prompt":{"locale":"vi-VN","text":"\"Can I open the window?\" — chọn câu trả lời phù hợp"},"skillIds":["speaking","u7.dialogue"],"type":"choice","vocabularyIds":["u1.yes","u1.please","u6.window","u7.can","u7.open"]},"prompt":{"audioAssetId":"a.u7.d6.n","locale":"en-US","text":"Can I open the window?"},"skillIds":["speaking","u7.dialogue"],"type":"dialogueTurn","vocabularyIds":["u1.yes","u1.please","u6.window","u7.can","u7.open"]},{"content":{"choices":[{"id":"c1","text":"Nam"},{"id":"c2","text":"Mai"},{"id":"c3","text":"Tom"}],"passage":"It is Monday. Mai, Nam and Tom are in English class. Mr. Long writes a question on the board: \"What do you do every day?\" Nam does not understand the question. \"Can you read it again, please?\" he asks. Mr. Long reads it again. Now Nam understands. He answers, \"I get up, I go to school and I study English!\" Everyone laughs. Then Mr. Long says, \"Please open your books. Today we learn ten new words.\" Tom thinks English is easy. Mai thinks it is a little difficult.","question":"Who thinks English is easy?"},"explanation":"Đáp án: \"Tom\".","gradingRule":{"caseSensitive":false,"correctChoiceId":"c3","ignoreDiacritics":false,"ignorePunctuation":false},"hint":"Đọc lại câu chuyện \"Giờ học tiếng Anh\".","id":"u7n7l2-e09","prompt":{"locale":"en-US","text":"Who thinks English is easy?"},"skillIds":["reading","u7.story"],"type":"storyQuestion","vocabularyIds":[]},{"content":{"choices":[{"id":"c1","imageAssetId":"i.u6.garden","text":"garden"},{"id":"c2","imageAssetId":"i.u6.chair","text":"chair"},{"id":"c3","imageAssetId":"i.u5.school","text":"school"},{"id":"c4","imageAssetId":"i.u7.classroom","text":"classroom"}]},"explanation":"\"classroom\" = \"phòng học\".","gradingRule":{"caseSensitive":false,"correctChoiceId":"c4","ignoreDiacritics":false,"ignorePunctuation":false},"hint":"\"phòng học\" là \"classroom\".","id":"u7n7l2-e10","prompt":{"locale":"vi-VN","text":"Hình nào là \"phòng học\"?"},"skillIds":["u7.vocab"],"type":"imageChoice","vocabularyIds":["u7.classroom"]},{"content":{"pairs":[{"id":"p1","left":{"id":"p1l","text":"answer"},"right":{"id":"p1r","text":"câu trả lời"}},{"id":"p2","left":{"id":"p2l","text":"sentence"},"right":{"id":"p2r","text":"câu"}},{"id":"p3","left":{"id":"p3l","text":"open"},"right":{"id":"p3r","text":"mở"}},{"id":"p4","left":{"id":"p4l","text":"can"},"right":{"id":"p4r","text":"có thể"}},{"id":"p5","left":{"id":"p5l","text":"close"},"right":{"id":"p5r","text":"đóng"}}]},"explanation":"answer = câu trả lời; sentence = câu; open = mở; can = có thể; close = đóng","gradingRule":{"caseSensitive":false,"correctPairIds":["p1","p2","p3","p4","p5"],"ignoreDiacritics":false,"ignorePunctuation":false},"hint":"Ví dụ: \"answer\" = \"câu trả lời\".","id":"u7n7l2-e11","prompt":{"locale":"vi-VN","text":"Nối các cặp từ tương ứng"},"skillIds":["u7.vocab"],"type":"matchPairs","vocabularyIds":["u7.answer","u7.sentence","u7.open","u7.can","u7.close"]},{"content":{"choices":[{"id":"c1","text":"answer"},{"id":"c2","text":"no"},{"id":"c3","text":"bed"},{"id":"c4","text":"bathroom"}]},"explanation":"\"answer\" = \"câu trả lời\".","gradingRule":{"caseSensitive":false,"correctChoiceId":"c1","ignoreDiacritics":false,"ignorePunctuation":false},"hint":"\"answer\" nghĩa là \"câu trả lời\".","id":"u7n7l2-e12","prompt":{"locale":"vi-VN","text":"\"câu trả lời\" trong tiếng Anh là gì?"},"skillIds":["u7.vocab"],"type":"choice","vocabularyIds":["u7.answer"]},{"content":{"locale":"en-US","maxSeconds":6,"referenceText":"Listen to the teacher."},"explanation":"Câu mẫu: \"Listen to the teacher.\".","gradingRule":{"acceptedText":["Listen to the teacher."],"caseSensitive":false,"ignoreDiacritics":false,"ignorePunctuation":true},"hint":"Nghĩa: \"Hãy nghe giáo viên.\"","id":"u7n7l2-e13","nonSpeechAlternative":{"content":{"tokens":[{"id":"t1","text":"to"},{"id":"t2","text":"the"},{"id":"t3","text":"teacher"},{"id":"t4","text":"Listen"}]},"explanation":"Câu đúng: \"Listen to the teacher.\".","gradingRule":{"caseSensitive":false,"correctTokenIds":["t4","t1","t2","t3"],"ignoreDiacritics":false,"ignorePunctuation":false},"hint":"Câu bắt đầu bằng \"Listen\".","id":"u7n7l2-e13a","prompt":{"locale":"vi-VN","text":"Sắp xếp thành câu đúng: \"Hãy nghe giáo viên.\""},"skillIds":["speaking","u7.grammar"],"type":"sentenceOrder","vocabularyIds":["u1.teacher","u7.listen"]},"prompt":{"audioAssetId":"a.u7.s27.n","locale":"en-US","text":"Nói câu sau: \"Listen to the teacher.\""},"skillIds":["speaking","u7.grammar"],"type":"speakRepeat","vocabularyIds":["u1.teacher","u7.listen"]},{"content":{"tokens":[{"id":"t1","text":"Câu"},{"id":"t2","text":"năm"},{"id":"t3","text":"này"},{"id":"t4","text":"Con"},{"id":"t5","text":"hỏi"},{"id":"t6","text":"nhiều"},{"id":"t7","text":"khó"},{"id":"t8","text":"biệt"}]},"explanation":"Câu đúng: \"Câu hỏi này khó.\".","gradingRule":{"caseSensitive":false,"correctTokenIds":["t1","t5","t3","t7"],"ignoreDiacritics":false,"ignorePunctuation":false},"hint":"\"question\" = câu hỏi; \"difficult\" = khó","id":"u7n7l2-e14","prompt":{"locale":"vi-VN","text":"Dịch sang tiếng Việt: \"This question is difficult.\""},"skillIds":["u7.grammar"],"type":"wordBank","vocabularyIds":["u7.question","u7.difficult"]},{"content":{"maxChars":200,"placeholder":"Viết bằng tiếng Anh"},"explanation":"Đáp án: \"I have a question.\".","gradingRule":{"acceptedText":["I have a question."],"caseSensitive":false,"ignoreDiacritics":false,"ignorePunctuation":true},"hint":"\"have\" = có; \"question\" = câu hỏi","id":"u7n7l2-e15","prompt":{"locale":"vi-VN","text":"Tôi có một câu hỏi."},"skillIds":["u7.grammar"],"type":"textTranslation","vocabularyIds":["u2.have","u7.question"]}],"gradingRulesVersion":"g1","guideText":"Mẫu câu chính: \"Can you help me?\" (Bạn có thể giúp tôi không?) — \"I do not understand.\" (Tôi không hiểu.) — \"Please open your books.\" (Hãy mở sách ra.)\n\"Can\" + động từ nguyên mẫu (không thêm -s, không \"to\"): \"She can speak English\", không nói \"She cans speaks\".\nCâu mệnh lệnh: bắt đầu bằng động từ: \"Open the window.\" Thêm \"please\" cho lịch sự.\nCâu hỏi \"What does this word mean?\" — dùng khi gặp từ mới. Trả lời: \"It means ...\".\nHọc sinh Việt hay nhầm: \"learn\" (học, tiếp thu) và \"study\" (học bài, nghiên cứu) — cả hai đều dịch là \"học\".","lessonId":"u7n7l2","lessonVersion":"v2.u7n7l2","manifestHash":"013672aa5927648264926e14d514d9d670ba04f547fc10aba6d50095b8e8b587","nodeId":"u7n7","order":54,"rewardIdentity":"v2.u7n7l2","schemaVersion":1,"sectionId":"sec1","signature":"ceJDXL7HKwmcN5H-69ncjttyT5Xm0-B7fW4jcxnOHpM9-eOSSyOiRE-7bn4bk-dURphaua2A1vZhsdxCl22yDg","signatureKeyId":"dev-content-1","skillIds":["u7.grammar","listening","speaking","u7.dialogue","reading","u7.story","u7.vocab"],"title":"Ôn tập cửa ải · Bài 2","unitId":"u7"}