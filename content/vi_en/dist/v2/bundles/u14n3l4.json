ành câu đúng: \"Bạn không nên uống cà phê vào ban đêm.\""},"skillIds":["u14.grammar"],"type":"sentenceOrder","vocabularyIds":["u3.coffee","u3.drink","u5.night","u14.should"]},{"content":{"locale":"en-US","maxSeconds":7,"referenceText":"I sleep eight hours every night."},"explanation":"Câu mẫu: \"I sleep eight hours every night.\".","gradingRule":{"acceptedText":["I sleep eight hours every night."],"caseSensitive":false,"ignoreDiacritics":false,"ignorePunctuation":true},"hint":"Nghĩa: \"Tôi ngủ tám tiếng mỗi đêm.\"","id":"u14n3l4-e11","nonSpeechAlternative":{"content":{"tokens":[{"id":"t1","text":"I"},{"id":"t2","text":"eight"},{"id":"t3","text":"hours"},{"id":"t4","text":"every"},{"id":"t5","text":"night"},{"id":"t6","text":"sleep"}]},"explanation":"Câu đúng: \"I sleep eight hours every night.\".","gradingRule":{"caseSensitive":false,"correctTokenIds":["t1","t6","t2","t3","t4","t5"],"ignoreDiacritics":false,"ignorePunctuation":false},"hint":"Câu bắt đầu bằng \"I\".","id":"u14n3l4-e11a","prompt":{"locale":"vi-VN","text":"Sắp xếp thành câu đúng: \"Tôi ngủ tám tiếng mỗi đêm.\""},"skillIds":["speaking","u14.grammar"],"type":"sentenceOrder","vocabularyIds":["u4.eight","u5.every","u5.night","u14.sleep"]},"prompt":{"audioAssetId":"a.u14.s10.n","locale":"en-US","text":"Nói câu sau: \"I sleep eight hours every night.\""},"skillIds":["speaking","u14.grammar"],"type":"speakRepeat","vocabularyIds":["u4.eight","u5.every","u5.night","u14.sleep"]},{"content":{"maxChars":200,"placeholder":"Viết bằng tiếng Việt (có dấu)"},"explanation":"Đáp án: \"Bạn cần nghỉ ngơi.\".","gradingRule":{"acceptedText":["Bạn cần nghỉ ngơi."],"caseSensitive":false,"ignoreDiacritics":false,"ignorePunctuation":true},"hint":"\"rest\" = nghỉ ngơi","id":"u14n3l4-e12","prompt":{"locale":"en-US","text":"You need to rest."},"skillIds":["u14.grammar"],"type":"textTranslation","vocabularyIds":["u14.rest"]}],"gradingRulesVersion":"g1","guideText":"Mẫu câu chính: \"How do you feel?\" (Bạn thấy thế nào?) — \"I have a headache.\" (Tôi bị đau đầu.) — \"You should rest.\" (Bạn nên nghỉ ngơi.)\nBệnh dùng \"have\": have a fever (bị sốt), have a cough (bị ho), have a headache (bị đau đầu). Tính từ dùng \"be\": I am sick, I am tired.\nChỗ đau: \"My stomach hurts\" (Tôi bị đau bụng) — động từ \"hurt\" thêm -s với he/she/it và danh từ số ít.\nLời khuyên: should / should not (shouldn't) + động từ nguyên mẫu: \"You should eat more vegetables.\"\nSố nhiều bất quy tắc: one tooth → two teeth.","lessonId":"u14n3l4","lessonVersion":"v2.u14n3l4","manifestHash":"013672aa5927648264926e14d514d9d670ba04f547fc10aba6d50095b8e8b587","nodeId":"u14n3","order":106,"rewardIdentity":"v2.u14n3l4","schemaVersion":1,"sectionId":"sec2","signature":"DBcKxuNgFD06osYi6MXhGSCiZG_xeDYyaIS6PWHYkeMfWlfn51QPwmlx1wvXNLga14HsokA949LEvr49kOCiBw","signatureKeyId":"dev-content-1","skillIds":["speaking","u14.grammar","u14.dialogue","u14.vocab"],"title":"Bạn nên... · Bài 4","unitId":"u14"}