s\" = xe buýt","id":"u11n3l3-e12a","prompt":{"locale":"vi-VN","text":"Chúng tôi đi xe buýt đến trường."},"skillIds":["listening","u11.grammar"],"type":"textTranslation","vocabularyIds":["u5.school","u11.bus"]},"prompt":{"audioAssetId":"a.u11.s7.n","locale":"vi-VN","text":"Nghe và viết lại bằng tiếng Anh"},"skillIds":["listening","u11.grammar"],"type":"dictation","vocabularyIds":["u5.school","u11.bus"]}],"gradingRulesVersion":"g1","guideText":"Mẫu câu chính: \"I want to visit Hanoi.\" (Tôi muốn đi thăm Hà Nội.) — \"When does the train leave?\" (Khi nào tàu chạy?) — \"Can I have a ticket, please?\" (Cho tôi một vé.)\nPhương tiện: by plane, by train, by bus, by taxi (không có \"the\"). Hoặc: take the bus / take a taxi.\nLịch trình dùng hiện tại đơn: \"The train leaves at six.\" \"The plane arrives at nine o'clock.\"\n\"Arrive at\" + địa điểm nhỏ (at the airport), \"arrive in\" + thành phố/quốc gia (arrive in Da Nang).\n\"Visit\" + nơi chốn/người, không cần giới từ: \"visit my grandmother\", không nói \"visit to\".","lessonId":"u11n3l3","lessonVersion":"v2.u11n3l3","manifestHash":"013672aa5927648264926e14d514d9d670ba04f547fc10aba6d50095b8e8b587","nodeId":"u11n3","order":82,"rewardIdentity":"v2.u11n3l3","schemaVersion":1,"sectionId":"sec2","signature":"JQQeYivOkbfWx6FQgJW42gQXMxtlDr-_RbW4jbLsLCWhQeYUpl0LSpMNyOkJkOT_qiEdTOUeOh25bjieguu-Bw","signatureKeyId":"dev-content-1","skillIds":["listening","u11.grammar","u11.vocab"],"title":"Khách sạn · Bài 3","unitId":"u11"}