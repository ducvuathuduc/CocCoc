:"t2","text":"tea"},{"id":"t3","text":"Coffee"}]},"explanation":"Câu đúng: \"Coffee or tea?\".","gradingRule":{"caseSensitive":false,"correctTokenIds":["t3","t1","t2"],"ignoreDiacritics":false,"ignorePunctuation":false},"hint":"Câu bắt đầu bằng \"Coffee\".","id":"u3n3l4-e11a","prompt":{"locale":"vi-VN","text":"Sắp xếp thành câu đúng: \"Cà phê hay trà?\""},"skillIds":["speaking","u3.grammar"],"type":"sentenceOrder","vocabularyIds":["u3.tea","u3.coffee"]},"prompt":{"audioAssetId":"a.u3.s8.n","locale":"en-US","text":"Nói câu sau: \"Coffee or tea?\""},"skillIds":["speaking","u3.grammar"],"type":"speakRepeat","vocabularyIds":["u3.tea","u3.coffee"]},{"content":{"maxChars":200,"placeholder":"Viết bằng tiếng Việt (có dấu)"},"explanation":"Đáp án: \"Làm ơn cho tôi trà.\". Cũng đúng: \"Cho tôi trà.\", \"Vui lòng cho tôi trà.\".","gradingRule":{"acceptedText":["Làm ơn cho tôi trà.","Cho tôi trà.","Vui lòng cho tôi trà.","Làm ơn cho mình trà.","Cho mình trà.","Vui lòng cho mình trà."],"caseSensitive":false,"ignoreDiacritics":false,"ignorePunctuation":true},"hint":"\"please\" = làm ơn; \"tea\" = trà","id":"u3n3l4-e12","prompt":{"locale":"en-US","text":"Tea, please."},"skillIds":["u3.grammar"],"type":"textTranslation","vocabularyIds":["u1.please","u3.tea"]}],"gradingRulesVersion":"g1","guideText":"Mẫu câu chính: \"Water, please.\" (Cho tôi nước.) — \"I like tea.\" (Tôi thích trà.) — \"Do you want coffee?\" (Bạn có muốn cà phê không?)\nMạo từ: \"a\" trước phụ âm (a banana), \"an\" trước nguyên âm (an apple, an egg).\nThì hiện tại đơn: he/she thêm -s: \"Kiko likes fish.\" Câu phủ định dùng do not / does not: \"Tom does not like coffee.\" (hay: doesn't).\nLịch sự khi gọi món: thêm \"please\" ở cuối câu. \"I want ...\" hơi thẳng; dùng \"..., please\" khi nói với người phục vụ.\nBữa ăn: breakfast (bữa sáng), lunch (bữa trưa), dinner (bữa tối) — nói \"for breakfast\" (cho bữa sáng).","lessonId":"u3n3l4","lessonVersion":"v2.u3n3l4","manifestHash":"013672aa5927648264926e14d514d9d670ba04f