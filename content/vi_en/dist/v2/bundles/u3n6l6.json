2","prompt":{"locale":"en-US","text":"Do you want coffee?"},"skillIds":["u3.grammar"],"type":"textTranslation","vocabularyIds":["u3.coffee","u3.want"]}],"gradingRulesVersion":"g1","guideText":"Mẫu câu chính: \"Water, please.\" (Cho tôi nước.) — \"I like tea.\" (Tôi thích trà.) — \"Do you want coffee?\" (Bạn có muốn cà phê không?)\nMạo từ: \"a\" trước phụ âm (a banana), \"an\" trước nguyên âm (an apple, an egg).\nThì hiện tại đơn: he/she thêm -s: \"Kiko likes fish.\" Câu phủ định dùng do not / does not: \"Tom does not like coffee.\" (hay: doesn't).\nLịch sự khi gọi món: thêm \"please\" ở cuối câu. \"I want ...\" hơi thẳng; dùng \"..., please\" khi nói với người phục vụ.\nBữa ăn: breakfast (bữa sáng), lunch (bữa trưa), dinner (bữa tối) — nói \"for breakfast\" (cho bữa sáng).","lessonId":"u3n6l6","lessonVersion":"v2.u3n6l6","manifestHash":"013672aa5927648264926e14d514d9d670ba04f547fc10aba6d50095b8e8b587","nodeId":"u3n6","order":21,"rewardIdentity":"v2.u3n6l6","schemaVersion":1,"sectionId":"sec1","signature":"uj-pc6ITly7S3kkQgkNTzPfDi13Q8QOufKyQLVuskuI9BtPZQ93RvV2S5OOv9J-yJJcQc4w5qxHwDGxutwQZAA","signatureKeyId":"dev-content-1","skillIds":["speaking","u3.grammar","u3.dialogue","u3.vocab"],"title":"Ngon quá! · Bài 6","unitId":"u3"}