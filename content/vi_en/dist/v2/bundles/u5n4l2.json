"],"type":"storyQuestion","vocabularyIds":[]},{"content":{"tokens":[{"id":"t1","text":"Không"},{"id":"t2","text":"trứng"},{"id":"t3","text":"uống"},{"id":"t4","text":"mẹ"},{"id":"t5","text":"ngon"},{"id":"t6","text":"già"},{"id":"t7","text":"ngủ"},{"id":"t8","text":"Chúc"}]},"explanation":"Câu đúng: \"Chúc mẹ ngủ ngon.\".","gradingRule":{"caseSensitive":false,"correctTokenIds":["t8","t4","t7","t5"],"ignoreDiacritics":false,"ignorePunctuation":false},"hint":"\"good\" = tốt; \"mother\" = mẹ; \"night\" = ban đêm","id":"u5n4l2-e03","prompt":{"locale":"vi-VN","text":"Dịch sang tiếng Việt: \"Good night, Mom.\""},"skillIds":["u5.grammar"],"type":"wordBank","vocabularyIds":["u1.good","u2.mother","u5.night"]},{"content":{"locale":"en-US","maxSeconds":12,"referenceText":"She is at home."},"explanation":"Câu trả lời mẫu: \"She is at home.\". Cũng đúng: \"At home.\", \"She's at home.\".","gradingRule":{"acceptedText":["She is at home.","At home.","She's at home."],"caseSensitive":false,"ignoreDiacritics":false,"ignorePunctuation":true},"hint":"Gợi ý trả lời: \"Mẹ tôi đang ở nhà.\"","id":"u5n4l2-e04","nonSpeechAlternative":{"content":{"choices":[{"id":"c1","text":"She is at home."},{"id":"c2","text":"Yes, I like coffee."},{"id":"c3","text":"Three pens, please."}]},"explanation":"Câu trả lời mẫu: \"She is at home.\".","gradingRule":{"caseSensitive":false,"correctChoiceId":"c1","ignoreDiacritics":false,"ignorePunctuation":false},"hint":"Gợi ý trả lời: \"Mẹ tôi đang ở nhà.\"","id":"u5n4l2-e04a","prompt":{"locale":"vi-VN","text":"\"Where is your mother now?\" — chọn câu trả lời phù hợp"},"skillIds":["speaking","u5.dialogue"],"type":"choice","vocabularyIds":["u1.where","u2.mother","u5.now","u5.home"]},"prompt":{"audioAssetId":"a.u5.d5.n","locale":"en-US","text":"Where is your mother now?"},"skillIds":["speaking","u5.dialogue"],"type":"dialogueTurn","vocabularyIds":["u1.where","u2.mother","u5.now","u5.home"]},{"content":{"choices":[{"id":"c1","text":"She meets Linh."},{"id":"c2","text