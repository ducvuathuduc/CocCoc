ọc bài, nghiên cứu) — cả hai đều dịch là \"học\".","lessonId":"u7n2l4","lessonVersion":"v2.u7n2l4","manifestHash":"013672aa5927648264926e14d514d9d670ba04f547fc10aba6d50095b8e8b587","nodeId":"u7n2","order":49,"rewardIdentity":"v2.u7n2l4","schemaVersion":1,"sectionId":"sec1","signature":"9_RnvLtRPrxlb0XgvyzvxMVHSayxEPWCSMBKWuQH7LAqyy0_kxWWHxfcqOOyqR1_UNiepIrO7U426QoSUfHRDQ","signatureKeyId":"dev-content-1","skillIds":["speaking","u7.grammar","u7.dialogue","u7.vocab"],"title":"Đọc và viết · Bài 4","unitId":"u7"}