ics":false,"ignorePunctuation":false},"hint":"Câu bắt đầu bằng \"Our\".","id":"u7n2l4-e11a","prompt":{"locale":"vi-VN","text":"Sắp xếp thành câu đúng: \"Lớp chúng tôi đông.\""},"skillIds":["speaking","u7.grammar"],"type":"sentenceOrder","vocabularyIds":["u6.big","u7.class"]},"prompt":{"audioAssetId":"a.u7.s1.n","locale":"en-US","text":"Nói câu sau: \"Our class is big.\""},"skillIds":["speaking","u7.grammar"],"type":"speakRepeat","vocabularyIds":["u6.big","u7.class"]},{"content":{"maxChars":200,"placeholder":"Viết bằng tiếng Việt (có dấu)"},"explanation":"Đáp án: \"Tom làm bài tập về nhà ở nhà.\". Cũng đúng: \"Tom làm bài tập ở nhà.\".","gradingRule":{"acceptedText":["Tom làm bài tập về nhà ở nhà.","Tom làm bài tập ở nhà."],"caseSensitive":false,"ignoreDiacritics":false,"ignorePunctuation":true},"hint":"\"home\" = nhà; \"homework\" = bài tập về nhà","id":"u7n2l4-e12","prompt":{"locale":"en-US","text":"Tom does his homework at home."},"skillIds":["u7.grammar"],"type":"textTranslation","vocabularyIds":["u5.home","u7.homework"]}],"gradingRulesVersion":"g1","guideText":"Mẫu câu chính: \"Can you help me?\" (Bạn có thể giúp tôi không?) — \"I do not understand.\" (Tôi không hiểu.) — \"Please open your books.\" (Hãy mở sách ra.)\n\"Can\" + động từ nguyên mẫu (không thêm -s, không \"to\"): \"She can speak English\", không nói \"She cans speaks\".\nCâu mệnh lệnh: bắt đầu bằng động từ: \"Open the window.\" Thêm \"please\" cho lịch sự.\nCâu hỏi \"What does this word mean?\" — dùng khi gặp từ mới. Trả lời: \"It means ...\".\nHọc sinh Việt hay nhầm: \"learn\" (học, tiếp thu) và \"study\" (học bài, nghiên cứu) — cả hai đều dịch là \"học\".","lessonId":"u7n2l4","lessonVersion":"v2.u7n2l4","manifestHash":"013672aa5927648264926e14d514d9d670ba04f547fc10aba6d50095b8e8b587","nodeId":"u7n2","order":49,"rewardIdentity":"v2.u7n2l4","schemaVersion":1,"sectionId":"sec1","signature":"TP9FToqik5FzzdtwbmFSv4LA--4N_3exX0yngkOU8GEvuOWnvr1DWn0Yc-15PLLTtBkQnJkbfuAlUBv3xjbmCg","signatureKeyId":"dev-c