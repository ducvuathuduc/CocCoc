itive":false,"ignoreDiacritics":false,"ignorePunctuation":true},"hint":"\"small\" = nhỏ; \"hotel\" = khách sạn","id":"u11n3l1-e12","prompt":{"locale":"vi-VN","text":"Chúng tôi ở một khách sạn nhỏ."},"skillIds":["u11.grammar"],"type":"textTranslation","vocabularyIds":["u6.small","u11.hotel"]},{"content":{"tokens":[{"id":"t1","text":"Hello"},{"id":"t2","text":"the"},{"id":"t3","text":"in"},{"id":"t4","text":"Our"},{"id":"t5","text":"write"},{"id":"t6","text":"is"},{"id":"t7","text":"summer"},{"id":"t8","text":"trip"},{"id":"t9","text":"likes"}]},"explanation":"Câu đúng: \"Our trip is in the summer.\".","gradingRule":{"caseSensitive":false,"correctTokenIds":["t4","t8","t6","t3","t2","t7"],"ignoreDiacritics":false,"ignorePunctuation":false},"hint":"\"summer\" = mùa hè; \"trip\" = chuyến đi","id":"u11n3l1-e13","prompt":{"locale":"vi-VN","text":"Dịch câu này: \"Chuyến đi của chúng tôi vào mùa hè.\""},"skillIds":["u11.grammar"],"type":"wordBank","vocabularyIds":["u8.summer","u11.trip"]}],"gradingRulesVersion":"g1","guideText":"Mẫu câu chính: \"I want to visit Hanoi.\" (Tôi muốn đi thăm Hà Nội.) — \"When does the train leave?\" (Khi nào tàu chạy?) — \"Can I have a ticket, please?\" (Cho tôi một vé.)\nPhương tiện: by plane, by train, by bus, by taxi (không có \"the\"). Hoặc: take the bus / take a taxi.\nLịch trình dùng hiện tại đơn: \"The train leaves at six.\" \"The plane arrives at nine o'clock.\"\n\"Arrive at\" + địa điểm nhỏ (at the airport), \"arrive in\" + thành phố/quốc gia (arrive in Da Nang).\n\"Visit\" + nơi chốn/người, không cần giới từ: \"visit my grandmother\", không nói \"visit to\".","lessonId":"u11n3l1","lessonVersion":"v2.u11n3l1","manifestHash":"013672aa5927648264926e14d514d9d670ba04f547fc10aba6d50095b8e8b587","nodeId":"u11n3","order":82,"rewardIdentity":"v2.u11n3l1","schemaVersion":1,"sectionId":"sec2","signature":"AKwAw4l3u91FAiIaA98Yq4f3x-5hXRZHjjq85dv9UiVVLoPjytkHj7nDqHE1sgp_dmMXL4OjROPK_SHLPjXBBg","signatureKeyId":"dev-content-1","skillIds":["u11.vocab