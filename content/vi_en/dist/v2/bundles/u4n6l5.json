ularyIds":["u2.baby","u4.one","u4.year","u4.old"]},{"content":{"maxChars":200,"placeholder":"Viết bằng tiếng Anh"},"explanation":"Đáp án: \"What is your phone number?\". Cũng đúng: \"What's your phone number?\".","gradingRule":{"acceptedText":["What is your phone number?","What's your phone number?"],"caseSensitive":false,"ignoreDiacritics":false,"ignorePunctuation":true},"hint":"\"number\" = số; \"phone\" = điện thoại","id":"u4n6l5-e12","prompt":{"locale":"vi-VN","text":"Số điện thoại của bạn là gì?"},"skillIds":["u4.grammar"],"type":"textTranslation","vocabularyIds":["u4.number","u4.phone"]}],"gradingRulesVersion":"g1","guideText":"Mẫu câu chính: \"How old are you?\" (Bạn bao nhiêu tuổi?) — \"I am twenty years old.\" (Tôi hai mươi tuổi.) — \"How many books do you have?\" (Bạn có bao nhiêu quyển sách?)\nSố nhiều: thêm -s sau danh từ khi nhiều hơn một: one cat, two cats; one egg, six eggs. Tiếng Việt không đổi danh từ, nhưng tiếng Anh thì có.\nTuổi: dùng \"be\", không dùng \"have\": \"I am ten years old\" hoặc ngắn gọn \"I am ten\". Không nói \"I have ten years\".\nSố: 20 = twenty, 28 = twenty-eight (có gạch nối), 100 = a hundred / one hundred.\n\"How many + danh từ số nhiều\": How many pens? How many cats?","lessonId":"u4n6l5","lessonVersion":"v2.u4n6l5","manifestHash":"013672aa5927648264926e14d514d9d670ba04f547fc10aba6d50095b8e8b587","nodeId":"u4n6","order":29,"rewardIdentity":"v2.u4n6l5","schemaVersion":1,"sectionId":"sec1","signature":"JrEUof8jMsiF5V7no4Bx9lG63d2xGykXg94W99EPnHzW8xL-s4yBSXdZ_ni6_3Shv2l9XNtfRHWvG-RhGc9PCg","signatureKeyId":"dev-content-1","skillIds":["u4.vocab","u4.grammar","listening"],"title":"Bao nhiêu? · Bài 5","unitId":"u4"}