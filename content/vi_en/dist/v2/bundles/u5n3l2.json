ry day."],"caseSensitive":false,"ignoreDiacritics":false,"ignorePunctuation":true},"hint":"\"day\" = ngày; \"go\" = đi; \"school\" = trường; \"every\" = mỗi","id":"u5n3l2-e10a","prompt":{"locale":"vi-VN","text":"Tôi đi học mỗi ngày."},"skillIds":["listening","u5.grammar"],"type":"textTranslation","vocabularyIds":["u5.day","u5.go","u5.school","u5.every"]},"prompt":{"audioAssetId":"a.u5.s18.n","locale":"vi-VN","text":"Nghe và viết lại bằng tiếng Anh"},"skillIds":["listening","u5.grammar"],"type":"dictation","vocabularyIds":["u5.day","u5.go","u5.school","u5.every"]},{"content":{"tokens":[{"id":"t1","text":"go"},{"id":"t2","text":"Tom"},{"id":"t3","text":"Five"},{"id":"t4","text":"eat"},{"id":"t5","text":"school"},{"id":"t6","text":"with"},{"id":"t7","text":"fish"},{"id":"t8","text":"We"},{"id":"t9","text":"to"}]},"explanation":"Câu đúng: \"We go to school with Tom.\".","gradingRule":{"caseSensitive":false,"correctTokenIds":["t8","t1","t9","t5","t6","t2"],"ignoreDiacritics":false,"ignorePunctuation":false},"hint":"\"go\" = đi; \"school\" = trường","id":"u5n3l2-e11","prompt":{"locale":"vi-VN","text":"Dịch câu này: \"Chúng tôi đi học với Tom.\""},"skillIds":["u5.grammar"],"type":"wordBank","vocabularyIds":["u5.go","u5.school"]},{"content":{"maxChars":200,"placeholder":"Viết bằng tiếng Anh"},"explanation":"Đáp án: \"I go home at five o'clock.\".","gradingRule":{"acceptedText":["I go home at five o'clock."],"caseSensitive":false,"ignoreDiacritics":false,"ignorePunctuation":true},"hint":"\"five\" = năm (số 5); \"o'clock\" = giờ (đúng); \"go\" = đi; \"home\" = nhà","id":"u5n3l2-e12","prompt":{"locale":"vi-VN","text":"Tôi về nhà lúc năm giờ."},"skillIds":["u5.grammar"],"type":"textTranslation","vocabularyIds":["u4.five","u5.oclock","u5.go","u5.home"]}],"gradingRulesVersion":"g1","guideText":"Mẫu câu chính: \"What time is it?\" (Mấy giờ rồi?) — \"It is seven o'clock.\" (Bảy giờ rồi.) — \"I get up at six.\" (Tôi dậy lúc sáu giờ.)\nGiới từ thời gian: at + giờ (at six o'clock), on + thứ (on Monday), in + buổi (in the morning, in the evening).\nThì hiện tại đơn cho thói quen: \"Mai goes to school every day.\" Với he/she/it: go → goes, get up → gets up.\nTrạng từ tần suất đứng TRƯỚC động từ thường: \"I always eat breakfast\", \"Kiko never eats bread\". Thứ tự: always > usually > sometimes > never.\nThứ trong tuần luôn viết hoa: Monday, Sunday.","lessonId":"u5n3l2","lessonVersion":"v2.u5n3l2","manifestHash":"013672aa5927648264926e14d514d9d670ba04f547fc10aba6d50095b8e8b587","nodeId":"u5n3","order":34,"rewardIdentity":"v2.u5n3l2","schemaVersion":1,"sectionId":"sec1","signature":"E3voAR7RHZ1G_c7gP1IgOYee45IcbnOyiAxhHA3k_T3rTi-JPGynWsPNIXXqundN6z6rCO1gNy4xWAVq8r5fDw","signatureKeyId":"dev-content-1","skillIds":["u5.vocab","u5.grammar","listening"],"title":"Buổi tối và hôm nay · Bài 2","unitId":"u5"}