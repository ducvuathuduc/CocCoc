ion":true},"hint":"Câu có 5 từ. Nghĩa: \"Hôm nay tôi rất bận.\"","id":"u12n3l5-e10","nonAudioAlternative":{"content":{"maxChars":200,"placeholder":"Viết bằng tiếng Anh"},"explanation":"Đáp án: \"I am very busy today.\". Cũng đúng: \"I'm very busy today.\".","gradingRule":{"acceptedText":["I am very busy today.","I'm very busy today."],"caseSensitive":false,"ignoreDiacritics":false,"ignorePunctuation":true},"hint":"\"today\" = hôm nay; \"busy\" = bận","id":"u12n3l5-e10a","prompt":{"locale":"vi-VN","text":"Hôm nay tôi rất bận."},"skillIds":["listening","u12.grammar"],"type":"textTranslation","vocabularyIds":["u5.today","u12.busy"]},"prompt":{"audioAssetId":"a.u12.s17.n","locale":"vi-VN","text":"Nghe và viết lại bằng tiếng Anh"},"skillIds":["listening","u12.grammar"],"type":"dictation","vocabularyIds":["u5.today","u12.busy"]},{"content":{"tokens":[{"id":"t1","text":"help"},{"id":"t2","text":"train"},{"id":"t3","text":"Tom's"},{"id":"t4","text":"father"},{"id":"t5","text":"an"},{"id":"t6","text":"engineer"},{"id":"t7","text":"is"},{"id":"t8","text":"gift"}]},"explanation":"Câu đúng: \"Tom's father is an engineer.\".","gradingRule":{"caseSensitive":false,"correctTokenIds":["t3","t4","t7","t5","t6"],"ignoreDiacritics":false,"ignorePunctuation":false},"hint":"\"father\" = bố; \"engineer\" = kỹ sư","id":"u12n3l5-e11","prompt":{"locale":"vi-VN","text":"Dịch câu này: \"Bố của Tom là kỹ sư.\""},"skillIds":["u12.grammar"],"type":"wordBank","vocabularyIds":["u2.father","u12.engineer"]},{"content":{"maxChars":200,"placeholder":"Viết bằng tiếng Anh"},"explanation":"Đáp án: \"My aunt is a doctor.\".","gradingRule":{"acceptedText":["My aunt is a doctor."],"caseSensitive":false,"ignoreDiacritics":false,"ignorePunctuation":true},"hint":"\"aunt\" = cô; \"doctor\" = bác sĩ","id":"u12n3l5-e12","prompt":{"locale":"vi-VN","text":"Cô tôi là bác sĩ."},"skillIds":["u12.grammar"],"type":"textTranslation","vocabularyIds":["u2.aunt","u12.doctor"]}],"gradingRulesVersion":"g1","guideText":"Mẫu câu chính: \"What do you do?\" (Bạn làm nghề gì?) — \"I am an engineer.\" (Tôi là kỹ sư.) — \"I worked late yesterday.\" (Hôm qua tôi làm việc muộn.)\nNghề nghiệp luôn có a/an: \"She is a nurse\", \"He is an engineer\" (an trước nguyên âm).\nThì quá khứ đơn (động từ có quy tắc): thêm -ed: work → worked, start → started, finish → finished. Quá khứ của \"be\": I/he/she was, you/we/they were.\nCâu hỏi quá khứ dùng \"did\" + động từ nguyên mẫu: \"Did you finish your work?\" (không nói \"Did you finished\").\nMốc thời gian quá khứ: yesterday (hôm qua), last week (tuần trước).","lessonId":"u12n3l5","lessonVersion":"v2.u12n3l5","manifestHash":"013672aa5927648264926e14d514d9d670ba04f547fc10aba6d50095b8e8b587","nodeId":"u12n3","order":90,"rewardIdentity":"v2.u12n3l5","schemaVersion":1,"sectionId":"sec2","signature":"CGkNTh0HbJNy3qF5md7d_koMsw6P5iFj-kaaV5RX-mmjrKOqvNCFW9WiiQiJbakSx5sY60Kr3inyVWoBI8UIAA","signatureKeyId":"dev-content-1","skillIds":["u12.vocab","u12.grammar","listening"],"title":"Ở công ty · Bài 5","unitId":"u12"}