hars":200,"placeholder":"Viết những gì bạn nghe"},"explanation":"Bạn nghe: \"The water is warm.\".","gradingRule":{"acceptedText":["The water is warm."],"caseSensitive":false,"ignoreDiacritics":false,"ignorePunctuation":true},"hint":"Câu có 4 từ. Nghĩa: \"Nước ấm.\"","id":"u8n5l6-e12","nonAudioAlternative":{"content":{"maxChars":200,"placeholder":"Viết bằng tiếng Anh"},"explanation":"Đáp án: \"The water is warm.\".","gradingRule":{"acceptedText":["The water is warm."],"caseSensitive":false,"ignoreDiacritics":false,"ignorePunctuation":true},"hint":"\"water\" = nước; \"warm\" = ấm","id":"u8n5l6-e12a","prompt":{"locale":"vi-VN","text":"Nước ấm."},"skillIds":["listening","u8.grammar"],"type":"textTranslation","vocabularyIds":["u3.water","u8.warm"]},"prompt":{"audioAssetId":"a.u8.s3.n","locale":"vi-VN","text":"Nghe và viết lại bằng tiếng Anh"},"skillIds":["listening","u8.grammar"],"type":"dictation","vocabularyIds":["u3.water","u8.warm"]}],"gradingRulesVersion":"g1","guideText":"Mẫu câu chính: \"How is the weather today?\" (Thời tiết hôm nay thế nào?) — \"It is sunny.\" (Trời nắng.) — \"It is raining.\" (Trời đang mưa.)\nChủ ngữ giả \"it\": tiếng Việt nói \"trời nắng\", tiếng Anh phải có chủ ngữ: \"It is sunny\", không nói \"Is sunny\".\nThì hiện tại tiếp diễn cho việc đang xảy ra: It is raining now. So sánh: It is rainy (trời có mưa — mô tả chung).\nMùa: in (the) summer, in winter. Miền Nam Việt Nam có hai mùa: the dry season (mùa khô) và the rainy season (mùa mưa).\n\"Fall\" là cách Mỹ gọi mùa thu; \"autumn\" dùng ở Anh — cả hai đều đúng.","lessonId":"u8n5l6","lessonVersion":"v2.u8n5l6","manifestHash":"013672aa5927648264926e14d514d9d670ba04f547fc10aba6d50095b8e8b587","nodeId":"u8n5","order":60,"rewardIdentity":"v2.u8n5l6","schemaVersion":1,"sectionId":"sec1","signature":"ftseREyDgZFHLv6xkfL63LDg1YUxStlQfjX-A491CLIU3lg2H3CJ-cbBx9rOnxBsJHh4BVGQTettIlkzfXJIAg","signatureKeyId":"dev-content-1","skillIds":["listening","u8.grammar","u8.vocab"],"title":"Mùa xuân, mùa thu · Bài 6","unitId":"u8"}