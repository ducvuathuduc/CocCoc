:false,"correctTokenIds":["t2","t9","t5","t4","t8","t7"],"ignoreDiacritics":false,"ignorePunctuation":false},"hint":"\"movie\" = bộ phim; \"excited\" = háo hức","id":"u15n6l1-e13","prompt":{"locale":"vi-VN","text":"Dịch câu này: \"Tom háo hức về bộ phim.\""},"skillIds":["u15.grammar"],"type":"wordBank","vocabularyIds":["u13.movie","u15.excited"]}],"gradingRulesVersion":"g1","guideText":"Mẫu câu chính: \"Why are you sad?\" (Sao bạn buồn?) — \"Nam is taller than Tom.\" (Nam cao hơn Tom.) — \"Happy birthday!\" (Chúc mừng sinh nhật!)\nSo sánh hơn với tính từ ngắn: thêm -er + than: tall → taller than, young → younger than, smart → smarter than.\nTính từ cảm xúc đuôi -ed mô tả cảm giác của người: I am bored, I am excited, She was surprised.\nGiới từ đi kèm: afraid of (sợ), worried about (lo về), excited about (háo hức về).\nLời khuyên nhẹ nhàng: \"Don't be sad.\" (Đừng buồn.)","lessonId":"u15n6l1","lessonVersion":"v2.u15n6l1","manifestHash":"013672aa5927648264926e14d514d9d670ba04f547fc10aba6d50095b8e8b587","nodeId":"u15n6","order":117,"rewardIdentity":"v2.u15n6l1","schemaVersion":1,"sectionId":"sec2","signature":"r-jTOr67_3CWBRXmwxt9CBwZbeJ6psZ8LysS6WGrABy8Ud_9dvhCMOeeBxGCnEqgrL8p54JsgcUxWNC4ZNWqDg","signatureKeyId":"dev-content-1","skillIds":["u15.vocab","u15.grammar","listening"],"title":"Bữa tiệc sinh nhật · Bài 1","unitId":"u15"}