u5n7l2-e08a","prompt":{"locale":"vi-VN","text":"\"Do you go to school on Sunday?\" — chọn câu trả lời phù hợp"},"skillIds":["speaking","u5.dialogue"],"type":"choice","vocabularyIds":["u1.no","u5.go","u5.school","u5.sunday"]},"prompt":{"audioAssetId":"a.u5.d3.n","locale":"en-US","text":"Do you go to school on Sunday?"},"skillIds":["speaking","u5.dialogue"],"type":"dialogueTurn","vocabularyIds":["u1.no","u5.go","u5.school","u5.sunday"]},{"content":{"choices":[{"id":"c1","text":"She goes to school."},{"id":"c2","text":"She meets Linh."},{"id":"c3","text":"She gets up at six."}],"passage":"Mai always gets up at six o'clock. She drinks tea and eats bread for breakfast. At seven, she goes to school with Nam. Mai has lunch at school. She usually goes home at five. In the evening, she eats dinner with her family. Kiko never gets up in the morning. Kiko sleeps all day! On Sunday, Mai does not go to school. She meets Linh and they drink coffee.","question":"What does Mai do on Sunday?"},"explanation":"Đáp án: \"She meets Linh.\".","gradingRule":{"caseSensitive":false,"correctChoiceId":"c2","ignoreDiacritics":false,"ignorePunctuation":false},"hint":"Đọc lại câu chuyện \"Một ngày của Mai\".","id":"u5n7l2-e09","prompt":{"locale":"en-US","text":"What does Mai do on Sunday?"},"skillIds":["reading","u5.story"],"type":"storyQuestion","vocabularyIds":[]},{"content":{"choices":[{"id":"c1","imageAssetId":"i.u1.morning","text":"morning"},{"id":"c2","imageAssetId":"i.u3.juice","text":"juice"},{"id":"c3","imageAssetId":"i.u5.night","text":"night"},{"id":"c4","imageAssetId":"i.u2.father","text":"father"}]},"explanation":"\"night\" = \"ban đêm\".","gradingRule":{"caseSensitive":false,"correctChoiceId":"c3","ignoreDiacritics":false,"ignorePunctuation":false},"hint":"\"ban đêm\" là \"night\".","id":"u5n7l2-e10","prompt":{"locale":"vi-VN","text":"Hình nào là \"ban đêm\"?"},"skillIds":["u5.vocab"],"type":"imageChoice","vocabularyIds":["u5.night"]},{"content":{"pairs":[{"id":"p1","left":{"id":"p