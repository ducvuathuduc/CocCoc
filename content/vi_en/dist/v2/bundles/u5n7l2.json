":false,"ignorePunctuation":false},"hint":"Câu bắt đầu bằng \"I\".","id":"u5n7l2-e13a","prompt":{"locale":"vi-VN","text":"Sắp xếp thành câu đúng: \"Thỉnh thoảng tôi uống cà phê.\""},"skillIds":["speaking","u5.grammar"],"type":"sentenceOrder","vocabularyIds":["u3.coffee","u3.drink","u5.sometimes"]},"prompt":{"audioAssetId":"a.u5.s27.n","locale":"en-US","text":"Nói câu sau: \"I sometimes drink coffee.\""},"skillIds":["speaking","u5.grammar"],"type":"speakRepeat","vocabularyIds":["u3.coffee","u3.drink","u5.sometimes"]},{"content":{"tokens":[{"id":"t1","text":"uống"},{"id":"t2","text":"phê"},{"id":"t3","text":"gia"},{"id":"t4","text":"vào"},{"id":"t5","text":"không"},{"id":"t6","text":"ban"},{"id":"t7","text":"giờ"},{"id":"t8","text":"cà"},{"id":"t9","text":"mỗi"},{"id":"t10","text":"Mai"},{"id":"t11","text":"Bố"},{"id":"t12","text":"bao"},{"id":"t13","text":"Chào"},{"id":"t14","text":"đêm"},{"id":"t15","text":"tôi"}]},"explanation":"Câu đúng: \"Bố tôi không bao giờ uống cà phê vào ban đêm.\".","gradingRule":{"caseSensitive":false,"correctTokenIds":["t11","t15","t5","t12","t7","t1","t8","t2","t4","t6","t14"],"ignoreDiacritics":false,"ignorePunctuation":false},"hint":"\"father\" = bố; \"coffee\" = cà phê; \"drink\" = uống; \"night\" = ban đêm","id":"u5n7l2-e14","prompt":{"locale":"vi-VN","text":"Dịch sang tiếng Việt: \"My father never drinks coffee at night.\""},"skillIds":["u5.grammar"],"type":"wordBank","vocabularyIds":["u2.father","u3.coffee","u3.drink","u5.night","u5.never"]},{"content":{"maxChars":200,"placeholder":"Viết bằng tiếng Anh"},"explanation":"Đáp án: \"Today is Monday.\".","gradingRule":{"acceptedText":["Today is Monday."],"caseSensitive":false,"ignoreDiacritics":false,"ignorePunctuation":true},"hint":"\"today\" = hôm nay; \"Monday\" = thứ Hai","id":"u5n7l2-e15","prompt":{"locale":"vi-VN","text":"Hôm nay là thứ Hai."},"skillIds":["u5.grammar"],"type":"textTranslation","vocabularyIds":["u5.today","u5.monday"]}],"gradingRulesVersion":"g1","guideText":"Mẫu câu chính: \"What time is it?\" (Mấy giờ rồi?) — \"It is seven o'clock.\" (Bảy giờ rồi.) — \"I get up at six.\" (Tôi dậy lúc sáu giờ.)\nGiới từ thời gian: at + giờ (at six o'clock), on + thứ (on Monday), in + buổi (in the morning, in the evening).\nThì hiện tại đơn cho thói quen: \"Mai goes to school every day.\" Với he/she/it: go → goes, get up → gets up.\nTrạng từ tần suất đứng TRƯỚC động từ thường: \"I always eat breakfast\", \"Kiko never eats bread\". Thứ tự: always > usually > sometimes > never.\nThứ trong tuần luôn viết hoa: Monday, Sunday.","lessonId":"u5n7l2","lessonVersion":"v2.u5n7l2","manifestHash":"013672aa5927648264926e14d514d9d670ba04f547fc10aba6d50095b8e8b587","nodeId":"u5n7","order":38,"rewardIdentity":"v2.u5n7l2","schemaVersion":1,"sectionId":"sec1","signature":"cTQ1YtaCqfM1p3OEqn6tr7EFEed_Kl0GFMHY4CyPqiQ1NZ_C13FYQJhhZxiOBSRZ5yuPED6onfu_BcxMpti6AA","signatureKeyId":"dev-content-1","skillIds":["u5.grammar","listening","speaking","u5.dialogue","reading","u5.story","u5.vocab"],"title":"Ôn tập cửa ải · Bài 2","unitId":"u5"}