aryIds":["u1.friend","u1.where"]},{"content":{"tokens":[{"id":"t1","text":"bạn"},{"id":"t2","text":"Rất"},{"id":"t3","text":"vui"},{"id":"t4","text":"gặp"},{"id":"t5","text":"Việt"},{"id":"t6","text":"Linh"},{"id":"t7","text":"nói"},{"id":"t8","text":"được"},{"id":"t9","text":"tôi"}]},"explanation":"Câu đúng: \"Rất vui được gặp bạn.\".","gradingRule":{"caseSensitive":false,"correctTokenIds":["t2","t3","t8","t4","t1"],"ignoreDiacritics":false,"ignorePunctuation":false},"hint":"\"nice\" = dễ thương; \"meet\" = gặp","id":"u1n7l1-e14","prompt":{"locale":"vi-VN","text":"Dịch sang tiếng Việt: \"Nice to meet you.\""},"skillIds":["u1.grammar"],"type":"wordBank","vocabularyIds":["u1.nice","u1.meet"]},{"content":{"maxChars":200,"placeholder":"Viết bằng tiếng Anh"},"explanation":"Đáp án: \"Hello, Mai!\". Cũng đúng: \"Hi, Mai!\".","gradingRule":{"acceptedText":["Hello, Mai!","Hi, Mai!"],"caseSensitive":false,"ignoreDiacritics":false,"ignorePunctuation":true},"hint":"\"hello\" = xin chào","id":"u1n7l1-e15","prompt":{"locale":"vi-VN","text":"Xin chào, Mai!"},"skillIds":["u1.grammar"],"type":"textTranslation","vocabularyIds":["u1.hello"]}],"gradingRulesVersion":"g1","guideText":"Mẫu câu chính: \"Hello, I am Mai.\" (Xin chào, tôi là Mai.) — \"What is your name?\" (Bạn tên là gì?) — \"Nice to meet you.\" (Rất vui được gặp bạn.)\nNgữ pháp: động từ \"to be\": I am, you are, he/she is. Khi nói, người bản xứ hay rút gọn: I'm, you're, he's, she's. Cả hai cách viết đều được chấp nhận.\nMẹo: \"I\" luôn viết hoa. Dùng \"a\" trước nghề nghiệp: \"I am a student.\" Tiếng Việt có thể bỏ \"một\", tiếng Anh thì không.\nLịch sự: \"Excuse me\" dùng để bắt chuyện, \"Sorry\" dùng khi xin lỗi vì lỗi của mình.","lessonId":"u1n7l1","lessonVersion":"v2.u1n7l1","manifestHash":"013672aa5927648264926e14d514d9d670ba04f547fc10aba6d50095b8e8b587","nodeId":"u1n7","order":6,"rewardIdentity":"v2.u1n7l1","schemaVersion":1,"sectionId":"sec1","signature":"P3rt09ZtiYV6G4vYC0NdbxnRt80l8YyqM4FXFQwOqOOSmb28CzaiTOsSZtNEqKypQN7Mw5fIu7P7HU-Kkz6IDw","signatureKeyId":"dev-content-1","skillIds":["u1.grammar","listening","speaking","u1.dialogue","reading","u1.story","u1.vocab"],"title":"Ôn tập cửa ải · Bài 1","unitId":"u1"}