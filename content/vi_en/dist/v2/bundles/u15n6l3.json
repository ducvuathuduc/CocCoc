y."],"caseSensitive":false,"ignoreDiacritics":false,"ignorePunctuation":true},"hint":"\"today\" = hôm nay; \"happy\" = vui","id":"u15n6l3-e12a","prompt":{"locale":"vi-VN","text":"Hôm nay tôi vui."},"skillIds":["listening","u15.grammar"],"type":"textTranslation","vocabularyIds":["u5.today","u15.happy"]},"prompt":{"audioAssetId":"a.u15.s1.n","locale":"vi-VN","text":"Nghe và viết lại bằng tiếng Anh"},"skillIds":["listening","u15.grammar"],"type":"dictation","vocabularyIds":["u5.today","u15.happy"]}],"gradingRulesVersion":"g1","guideText":"Mẫu câu chính: \"Why are you sad?\" (Sao bạn buồn?) — \"Nam is taller than Tom.\" (Nam cao hơn Tom.) — \"Happy birthday!\" (Chúc mừng sinh nhật!)\nSo sánh hơn với tính từ ngắn: thêm -er + than: tall → taller than, young → younger than, smart → smarter than.\nTính từ cảm xúc đuôi -ed mô tả cảm giác của người: I am bored, I am excited, She was surprised.\nGiới từ đi kèm: afraid of (sợ), worried about (lo về), excited about (háo hức về).\nLời khuyên nhẹ nhàng: \"Don't be sad.\" (Đừng buồn.)","lessonId":"u15n6l3","lessonVersion":"v2.u15n6l3","manifestHash":"013672aa5927648264926e14d514d9d670ba04f547fc10aba6d50095b8e8b587","nodeId":"u15n6","order":117,"rewardIdentity":"v2.u15n6l3","schemaVersion":1,"sectionId":"sec2","signature":"u3es2bbrOZXv3ro0Tu_rtpb2qzHg3gjsSbPh9XKMAt46EBPmQfDpn3GtOW-mZLcwTmycsM2VMaenH7Mkxa53Cg","signatureKeyId":"dev-content-1","skillIds":["listening","u15.grammar","u15.vocab"],"title":"Bữa tiệc sinh nhật · Bài 3","unitId":"u15"}