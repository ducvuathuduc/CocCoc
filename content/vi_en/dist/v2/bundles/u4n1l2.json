ht (có gạch nối), 100 = a hundred / one hundred.\n\"How many + danh từ số nhiều\": How many pens? How many cats?","lessonId":"u4n1l2","lessonVersion":"v2.u4n1l2","manifestHash":"013672aa5927648264926e14d514d9d670ba04f547fc10aba6d50095b8e8b587","nodeId":"u4n1","order":24,"rewardIdentity":"v2.u4n1l2","schemaVersion":1,"sectionId":"sec1","signature":"PEoedUpUJvYZZZIlwcLJVzLhR4t7OSEeGROD3FFI5c7C9YWHYdQZlyHpwl2dwWjQv1UaYDJpN321kTo-ewqcCg","signatureKeyId":"dev-content-1","skillIds":["u4.vocab","u4.grammar","listening"],"title":"Một, hai, ba · Bài 2","unitId":"u4"}