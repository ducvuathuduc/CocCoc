ompt":{"locale":"vi-VN","text":"Thầy Long là một giáo viên giỏi."},"skillIds":["listening","u1.grammar"],"type":"textTranslation","vocabularyIds":["u1.teacher","u1.good"]},"prompt":{"audioAssetId":"a.u1.s25.n","locale":"vi-VN","text":"Nghe và viết lại bằng tiếng Anh"},"skillIds":["listening","u1.grammar"],"type":"dictation","vocabularyIds":["u1.teacher","u1.good"]}],"gradingRulesVersion":"g1","guideText":"Mẫu câu chính: \"Hello, I am Mai.\" (Xin chào, tôi là Mai.) — \"What is your name?\" (Bạn tên là gì?) — \"Nice to meet you.\" (Rất vui được gặp bạn.)\nNgữ pháp: động từ \"to be\": I am, you are, he/she is. Khi nói, người bản xứ hay rút gọn: I'm, you're, he's, she's. Cả hai cách viết đều được chấp nhận.\nMẹo: \"I\" luôn viết hoa. Dùng \"a\" trước nghề nghiệp: \"I am a student.\" Tiếng Việt có thể bỏ \"một\", tiếng Anh thì không.\nLịch sự: \"Excuse me\" dùng để bắt chuyện, \"Sorry\" dùng khi xin lỗi vì lỗi của mình.","lessonId":"u1n6l3","lessonVersion":"v2.u1n6l3","manifestHash":"013672aa5927648264926e14d514d9d670ba04f547fc10aba6d50095b8e8b587","nodeId":"u1n6","order":5,"rewardIdentity":"v2.u1n6l3","schemaVersion":1,"sectionId":"sec1","signature":"JlknxJvSrY3aL2afBk4YC_wnCxyB8ZGchZNfRiFlLN6sb8eh55UghidFKeRaWiflAbeku2le6I_w_pFc-g_0Bw","signatureKeyId":"dev-content-1","skillIds":["listening","u1.grammar","u1.vocab"],"title":"Bạn đến từ đâu? · Bài 3","unitId":"u1"}