acritics":false,"ignorePunctuation":true},"hint":"\"go\" = đi; \"school\" = trường; \"Sunday\" = Chủ nhật","id":"u5n6l2-e12","prompt":{"locale":"vi-VN","text":"Chúng tôi không đi học vào Chủ nhật."},"skillIds":["u5.grammar"],"type":"textTranslation","vocabularyIds":["u5.go","u5.school","u5.sunday"]}],"gradingRulesVersion":"g1","guideText":"Mẫu câu chính: \"What time is it?\" (Mấy giờ rồi?) — \"It is seven o'clock.\" (Bảy giờ rồi.) — \"I get up at six.\" (Tôi dậy lúc sáu giờ.)\nGiới từ thời gian: at + giờ (at six o'clock), on + thứ (on Monday), in + buổi (in the morning, in the evening).\nThì hiện tại đơn cho thói quen: \"Mai goes to school every day.\" Với he/she/it: go → goes, get up → gets up.\nTrạng từ tần suất đứng TRƯỚC động từ thường: \"I always eat breakfast\", \"Kiko never eats bread\". Thứ tự: always > usually > sometimes > never.\nThứ trong tuần luôn viết hoa: Monday, Sunday.","lessonId":"u5n6l2","lessonVersion":"v2.u5n6l2","manifestHash":"013672aa5927648264926e14d514d9d670ba04f547fc10aba6d50095b8e8b587","nodeId":"u5n6","order":37,"rewardIdentity":"v2.u5n6l2","schemaVersion":1,"sectionId":"sec1","signature":"L9HHAjplajXjVmaly8XKqgK1dMpfojJ5RFQ4QPDCSRGpRNyMkM_eL0zbVq7cfdQq90KeGvZ0zewzlElUNVQtDg","signatureKeyId":"dev-content-1","skillIds":["u5.vocab","u5.grammar","listening"],"title":"Luôn luôn, thỉnh thoảng · Bài 2","unitId":"u5"}