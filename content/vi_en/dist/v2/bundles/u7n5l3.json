ompt":{"locale":"vi-VN","text":"Chọn câu tiếng Anh có nghĩa: \"Tom làm bài tập về nhà ở nhà.\""},"skillIds":["listening","u7.grammar"],"type":"choice","vocabularyIds":["u5.home","u7.homework"]},"prompt":{"audioAssetId":"a.u7.s6.n","locale":"vi-VN","text":"Nghe và chọn câu bạn nghe được"},"skillIds":["listening","u7.grammar"],"type":"listenChoice","vocabularyIds":["u5.home","u7.homework"]},{"content":{"maxChars":200,"placeholder":"Viết những gì bạn nghe"},"explanation":"Bạn nghe: \"I read a book every evening.\".","gradingRule":{"acceptedText":["I read a book every evening."],"caseSensitive":false,"ignoreDiacritics":false,"ignorePunctuation":true},"hint":"Câu có 6 từ. Nghĩa: \"Tôi đọc sách mỗi buổi tối.\"","id":"u7n5l3-e12","nonAudioAlternative":{"content":{"maxChars":200,"placeholder":"Viết bằng tiếng Anh"},"explanation":"Đáp án: \"I read a book every evening.\".","gradingRule":{"acceptedText":["I read a book every evening."],"caseSensitive":false,"ignoreDiacritics":false,"ignorePunctuation":true},"hint":"\"book\" = quyển sách; \"every\" = mỗi; \"evening\" = buổi tối; \"read\" = đọc","id":"u7n5l3-e12a","prompt":{"locale":"vi-VN","text":"Tôi đọc sách mỗi buổi tối."},"skillIds":["listening","u7.grammar"],"type":"textTranslation","vocabularyIds":["u4.book","u5.every","u5.evening","u7.read"]},"prompt":{"audioAssetId":"a.u7.s7.n","locale":"vi-VN","text":"Nghe và viết lại bằng tiếng Anh"},"skillIds":["listening","u7.grammar"],"type":"dictation","vocabularyIds":["u4.book","u5.every","u5.evening","u7.read"]}],"gradingRulesVersion":"g1","guideText":"Mẫu câu chính: \"Can you help me?\" (Bạn có thể giúp tôi không?) — \"I do not understand.\" (Tôi không hiểu.) — \"Please open your books.\" (Hãy mở sách ra.)\n\"Can\" + động từ nguyên mẫu (không thêm -s, không \"to\"): \"She can speak English\", không nói \"She cans speaks\".\nCâu mệnh lệnh: bắt đầu bằng động từ: \"Open the window.\" Thêm \"please\" cho lịch sự.\nCâu hỏi \"What does this word mean?\" — dùng khi gặp từ mới. Trả lời: \"It means ...\".\nHọc sinh Việt hay nhầm: \"learn\" (học, tiếp thu) và \"study\" (học bài, nghiên cứu) — cả hai đều dịch là \"học\".","lessonId":"u7n5l3","lessonVersion":"v2.u7n5l3","manifestHash":"013672aa5927648264926e14d514d9d670ba04f547fc10aba6d50095b8e8b587","nodeId":"u7n5","order":52,"rewardIdentity":"v2.u7n5l3","schemaVersion":1,"sectionId":"sec1","signature":"0JrBZkWaYDoVRwdCA6mnyRDlxSoFKZsOzlE__EEdha9lezUOcbWXPRQj5UfbIN9bmxFDhkx72MIt3Jgn4GnnCQ","signatureKeyId":"dev-content-1","skillIds":["listening","u7.grammar","u7.vocab"],"title":"Dễ hay khó? · Bài 3","unitId":"u7"}