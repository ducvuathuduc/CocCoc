ôi đi học với Tom."},"skillIds":["listening","u5.grammar"],"type":"textTranslation","vocabularyIds":["u5.go","u5.school"]},"prompt":{"audioAssetId":"a.u5.s11.n","locale":"vi-VN","text":"Nghe và viết lại bằng tiếng Anh"},"skillIds":["listening","u5.grammar"],"type":"dictation","vocabularyIds":["u5.go","u5.school"]},{"content":{"tokens":[{"id":"t1","text":"What"},{"id":"t2","text":"time"},{"id":"t3","text":"is"},{"id":"t4","text":"students"},{"id":"t5","text":"How"},{"id":"t6","text":"year"},{"id":"t7","text":"it"}]},"explanation":"Câu đúng: \"What time is it?\".","gradingRule":{"caseSensitive":false,"correctTokenIds":["t1","t2","t3","t7"],"ignoreDiacritics":false,"ignorePunctuation":false},"hint":"\"time\" = thời gian","id":"u5n2l5-e11","prompt":{"locale":"vi-VN","text":"Dịch câu này: \"Mấy giờ rồi?\""},"skillIds":["u5.grammar"],"type":"wordBank","vocabularyIds":["u5.time"]},{"content":{"maxChars":200,"placeholder":"Viết bằng tiếng Anh"},"explanation":"Đáp án: \"I eat breakfast at six o'clock.\".","gradingRule":{"acceptedText":["I eat breakfast at six o'clock."],"caseSensitive":false,"ignoreDiacritics":false,"ignorePunctuation":true},"hint":"\"eat\" = ăn; \"breakfast\" = bữa sáng; \"six\" = sáu; \"o'clock\" = giờ (đúng)","id":"u5n2l5-e12","prompt":{"locale":"vi-VN","text":"Tôi ăn sáng lúc sáu giờ."},"skillIds":["u5.grammar"],"type":"textTranslation","vocabularyIds":["u3.eat","u3.breakfast","u4.six","u5.oclock"]}],"gradingRulesVersion":"g1","guideText":"Mẫu câu chính: \"What time is it?\" (Mấy giờ rồi?) — \"It is seven o'clock.\" (Bảy giờ rồi.) — \"I get up at six.\" (Tôi dậy lúc sáu giờ.)\nGiới từ thời gian: at + giờ (at six o'clock), on + thứ (on Monday), in + buổi (in the morning, in the evening).\nThì hiện tại đơn cho thói quen: \"Mai goes to school every day.\" Với he/she/it: go → goes, get up → gets up.\nTrạng từ tần suất đứng TRƯỚC động từ thường: \"I always eat breakfast\", \"Kiko never eats bread\". Thứ tự: always > usually > sometimes > never.\nThứ trong tuần luôn viết hoa: Monday, Sunday.","lessonId":"u5n2l5","lessonVersion":"v2.u5n2l5","manifestHash":"013672aa5927648264926e14d514d9d670ba04f547fc10aba6d50095b8e8b587","nodeId":"u5n2","order":33,"rewardIdentity":"v2.u5n2l5","schemaVersion":1,"sectionId":"sec1","signature":"5u5f43YyctpQAm4sAkopbItuplo03UUehk6WMX3D-6y9xLY-b8n0xmCYGDz65Jvx9G_npc7D3-yBPLHcQV_9Dw","signatureKeyId":"dev-content-1","skillIds":["u5.vocab","u5.grammar","listening"],"title":"Đi học, về nhà · Bài 5","unitId":"u5"}