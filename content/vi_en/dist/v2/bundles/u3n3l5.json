 is rice.\".","gradingRule":{"caseSensitive":false,"correctTokenIds":["t6","t2","t3"],"ignoreDiacritics":false,"ignorePunctuation":false},"hint":"\"rice\" = cơm","id":"u3n3l5-e11","prompt":{"locale":"vi-VN","text":"Dịch câu này: \"Đây là cơm.\""},"skillIds":["u3.grammar"],"type":"wordBank","vocabularyIds":["u3.rice"]},{"content":{"maxChars":200,"placeholder":"Viết bằng tiếng Anh"},"explanation":"Đáp án: \"This is my coffee.\".","gradingRule":{"acceptedText":["This is my coffee."],"caseSensitive":false,"ignoreDiacritics":false,"ignorePunctuation":true},"hint":"\"coffee\" = cà phê","id":"u3n3l5-e12","prompt":{"locale":"vi-VN","text":"Đây là cà phê của tôi."},"skillIds":["u3.grammar"],"type":"textTranslation","vocabularyIds":["u3.coffee"]}],"gradingRulesVersion":"g1","guideText":"Mẫu câu chính: \"Water, please.\" (Cho tôi nước.) — \"I like tea.\" (Tôi thích trà.) — \"Do you want coffee?\" (Bạn có muốn cà phê không?)\nMạo từ: \"a\" trước phụ âm (a banana), \"an\" trước nguyên âm (an apple, an egg).\nThì hiện tại đơn: he/she thêm -s: \"Kiko likes fish.\" Câu phủ định dùng do not / does not: \"Tom does not like coffee.\" (hay: doesn't).\nLịch sự khi gọi món: thêm \"please\" ở cuối câu. \"I want ...\" hơi thẳng; dùng \"..., please\" khi nói với người phục vụ.\nBữa ăn: breakfast (bữa sáng), lunch (bữa trưa), dinner (bữa tối) — nói \"for breakfast\" (cho bữa sáng).","lessonId":"u3n3l5","lessonVersion":"v2.u3n3l5","manifestHash":"013672aa5927648264926e14d514d9d670ba04f547fc10aba6d50095b8e8b587","nodeId":"u3n3","order":18,"rewardIdentity":"v2.u3n3l5","schemaVersion":1,"sectionId":"sec1","signature":"7HdvOQ9pyRNXizhPfP80g77nULOnBQ1lAAj88y3SRuaHnGMwaDpIPqDq4oywiO35Tb8JAd3TYGzusbvOiqlCBA","signatureKeyId":"dev-content-1","skillIds":["u3.vocab","u3.grammar","listening"],"title":"Tôi thích, tôi muốn · Bài 5","unitId":"u3"}