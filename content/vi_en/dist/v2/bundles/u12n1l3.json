did\" + động từ nguyên mẫu: \"Did you finish your work?\" (không nói \"Did you finished\").\nMốc thời gian quá khứ: yesterday (hôm qua), last week (tuần trước).","lessonId":"u12n1l3","lessonVersion":"v2.u12n1l3","manifestHash":"013672aa5927648264926e14d514d9d670ba04f547fc10aba6d50095b8e8b587","nodeId":"u12n1","order":88,"rewardIdentity":"v2.u12n1l3","schemaVersion":1,"sectionId":"sec2","signature":"PE7wMYH1eseKPQ3N-iSj01LqrvxXFUFZJvPfaULGtlSsiDptQR1HXYWGEchAS3JEE9-Qpn-ifq7iEVOOx5FUAQ","signatureKeyId":"dev-content-1","skillIds":["listening","u12.grammar","u12.vocab"],"title":"Công việc của tôi · Bài 3","unitId":"u12"}