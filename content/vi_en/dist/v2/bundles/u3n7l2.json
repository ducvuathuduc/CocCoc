ocale":"en-US","maxSeconds":6,"referenceText":"This is rice."},"explanation":"Câu mẫu: \"This is rice.\".","gradingRule":{"acceptedText":["This is rice."],"caseSensitive":false,"ignoreDiacritics":false,"ignorePunctuation":true},"hint":"Nghĩa: \"Đây là cơm.\"","id":"u3n7l2-e13","nonSpeechAlternative":{"content":{"tokens":[{"id":"t1","text":"This"},{"id":"t2","text":"rice"},{"id":"t3","text":"is"}]},"explanation":"Câu đúng: \"This is rice.\".","gradingRule":{"caseSensitive":false,"correctTokenIds":["t1","t3","t2"],"ignoreDiacritics":false,"ignorePunctuation":false},"hint":"Câu bắt đầu bằng \"This\".","id":"u3n7l2-e13a","prompt":{"locale":"vi-VN","text":"Sắp xếp thành câu đúng: \"Đây là cơm.\""},"skillIds":["speaking","u3.grammar"],"type":"sentenceOrder","vocabularyIds":["u3.rice"]},"prompt":{"audioAssetId":"a.u3.s2.n","locale":"en-US","text":"Nói câu sau: \"This is rice.\""},"skillIds":["speaking","u3.grammar"],"type":"speakRepeat","vocabularyIds":["u3.rice"]},{"content":{"tokens":[{"id":"t1","text":"trà"},{"id":"t2","text":"người"},{"id":"t3","text":"hay"},{"id":"t4","text":"Ông"},{"id":"t5","text":"tôi"},{"id":"t6","text":"phê"},{"id":"t7","text":"Chào"},{"id":"t8","text":"Cà"}]},"explanation":"Câu đúng: \"Cà phê hay trà?\".","gradingRule":{"caseSensitive":false,"correctTokenIds":["t8","t6","t3","t1"],"ignoreDiacritics":false,"ignorePunctuation":false},"hint":"\"tea\" = trà; \"coffee\" = cà phê","id":"u3n7l2-e14","prompt":{"locale":"vi-VN","text":"Dịch sang tiếng Việt: \"Coffee or tea?\""},"skillIds":["u3.grammar"],"type":"wordBank","vocabularyIds":["u3.tea","u3.coffee"]},{"content":{"maxChars":200,"placeholder":"Viết bằng tiếng Anh"},"explanation":"Đáp án: \"We drink juice.\".","gradingRule":{"acceptedText":["We drink juice."],"caseSensitive":false,"ignoreDiacritics":false,"ignorePunctuation":true},"hint":"\"juice\" = nước ép; \"drink\" = uống","id":"u3n7l2-e15","prompt":{"locale":"vi-VN","text":"Chúng tôi uống nước ép."},"skillIds":["u3.grammar"],"type":"textTranslation","vocabularyIds":["u3.juice","u3.drink"]}],"gradingRulesVersion":"g1","guideText":"Mẫu câu chính: \"Water, please.\" (Cho tôi nước.) — \"I like tea.\" (Tôi thích trà.) — \"Do you want coffee?\" (Bạn có muốn cà phê không?)\nMạo từ: \"a\" trước phụ âm (a banana), \"an\" trước nguyên âm (an apple, an egg).\nThì hiện tại đơn: he/she thêm -s: \"Kiko likes fish.\" Câu phủ định dùng do not / does not: \"Tom does not like coffee.\" (hay: doesn't).\nLịch sự khi gọi món: thêm \"please\" ở cuối câu. \"I want ...\" hơi thẳng; dùng \"..., please\" khi nói với người phục vụ.\nBữa ăn: breakfast (bữa sáng), lunch (bữa trưa), dinner (bữa tối) — nói \"for breakfast\" (cho bữa sáng).","lessonId":"u3n7l2","lessonVersion":"v2.u3n7l2","manifestHash":"013672aa5927648264926e14d514d9d670ba04f547fc10aba6d50095b8e8b587","nodeId":"u3n7","order":22,"rewardIdentity":"v2.u3n7l2","schemaVersion":1,"sectionId":"sec1","signature":"VYxWDq-Z0YNuf05R05-V1em9bR43kT174U7ftxQ8sODdetWkYCm1mRKOEwsdbah0OKYrQB5Kdl8MWlovhAKvCA","signatureKeyId":"dev-content-1","skillIds":["u3.grammar","listening","speaking","u3.dialogue","reading","u3.story","u3.vocab"],"title":"Ôn tập cửa ải · Bài 2","unitId":"u3"}