10.map"]},{"content":{"maxChars":40,"placeholder":"Điền từ còn thiếu"},"explanation":"Từ đúng: \"City\" → Ho Chi Minh City is very big.","gradingRule":{"acceptedText":["City"],"caseSensitive":false,"ignoreDiacritics":false,"ignorePunctuation":true},"hint":"\"thành phố\" trong tiếng Anh là \"c...\"","id":"u10n5l1-e11","prompt":{"locale":"en-US","text":"Ho Chi Minh ___ is very big. — \"Thành phố Hồ Chí Minh rất lớn.\""},"skillIds":["u10.grammar"],"type":"fillBlank","vocabularyIds":["u10.city","u6.big"]},{"content":{"maxChars":200,"placeholder":"Viết bằng tiếng Anh"},"explanation":"Đáp án: \"The bridge is near my house.\".","gradingRule":{"acceptedText":["The bridge is near my house."],"caseSensitive":false,"ignoreDiacritics":false,"ignorePunctuation":true},"hint":"\"house\" = ngôi nhà; \"near\" = gần; \"bridge\" = cây cầu","id":"u10n5l1-e12","prompt":{"locale":"vi-VN","text":"Cây cầu ở gần nhà tôi."},"skillIds":["u10.grammar"],"type":"textTranslation","vocabularyIds":["u6.house","u10.near","u10.bridge"]},{"content":{"tokens":[{"id":"t1","text":"park"},{"id":"t2","text":"live"},{"id":"t3","text":"school"},{"id":"t4","text":"bank"},{"id":"t5","text":"near"},{"id":"t6","text":"I"},{"id":"t7","text":"father"},{"id":"t8","text":"the"}]},"explanation":"Câu đúng: \"I live near the school.\".","gradingRule":{"caseSensitive":false,"correctTokenIds":["t6","t2","t5","t8","t3"],"ignoreDiacritics":false,"ignorePunctuation":false},"hint":"\"school\" = trường; \"live\" = sống; \"near\" = gần","id":"u10n5l1-e13","prompt":{"locale":"vi-VN","text":"Dịch câu này: \"Tôi sống gần trường.\""},"skillIds":["u10.grammar"],"type":"wordBank","vocabularyIds":["u5.school","u6.live","u10.near"]}],"gradingRulesVersion":"g1","guideText":"Mẫu câu chính: \"Excuse me, where is the bank?\" (Xin lỗi, ngân hàng ở đâu?) — \"Go straight and turn left.\" (Đi thẳng rồi rẽ trái.) — \"Is it far?\" (Có xa không?)\nChỉ đường dùng câu mệnh lệnh: Go straight. Turn right. Turn left at the corner.\nVị trí: on the left / on the right (bên trái / bên phải), next to (bên cạnh), opposite (đối diện), near (gần), on the corner (ở góc đường).\n\"Near\" không cần \"to\": \"near the school\" (không nói \"near to the school\" trong văn nói chuẩn A2).\nHỏi khoảng cách: \"Is it far from here?\" — Trả lời: \"No, you can walk.\" (Không, bạn có thể đi bộ.)","lessonId":"u10n5l1","lessonVersion":"v2.u10n5l1","manifestHash":"013672aa5927648264926e14d514d9d670ba04f547fc10aba6d50095b8e8b587","nodeId":"u10n5","order":76,"rewardIdentity":"v2.u10n5l1","schemaVersion":1,"sectionId":"sec2","signature":"_Q3ka7x2I7U6fqJFogZdPqDBb2_HGXQ34UCTDrMTjn3UTKclSRWmc5PiZtFswNdGDizueimzWexgNTswWGEFBw","signatureKeyId":"dev-content-1","skillIds":["u10.vocab","u10.grammar","listening"],"title":"Thành phố của tôi · Bài 1","unitId":"u10"}