other."},"explanation":"Câu mẫu: \"This is my mother.\".","gradingRule":{"acceptedText":["This is my mother.","This is my mom."],"caseSensitive":false,"ignoreDiacritics":false,"ignorePunctuation":true},"hint":"Nghĩa: \"Đây là mẹ tôi.\"","id":"u2n5l4-e11","nonSpeechAlternative":{"content":{"tokens":[{"id":"t1","text":"mother"},{"id":"t2","text":"is"},{"id":"t3","text":"This"},{"id":"t4","text":"my"}]},"explanation":"Câu đúng: \"This is my mother.\".","gradingRule":{"caseSensitive":false,"correctTokenIds":["t3","t2","t4","t1"],"ignoreDiacritics":false,"ignorePunctuation":false},"hint":"Câu bắt đầu bằng \"This\".","id":"u2n5l4-e11a","prompt":{"locale":"vi-VN","text":"Sắp xếp thành câu đúng: \"Đây là mẹ tôi.\""},"skillIds":["speaking","u2.grammar"],"type":"sentenceOrder","vocabularyIds":["u2.mother"]},"prompt":{"audioAssetId":"a.u2.s1.n","locale":"en-US","text":"Nói câu sau: \"This is my mother.\""},"skillIds":["speaking","u2.grammar"],"type":"speakRepeat","vocabularyIds":["u2.mother"]},{"content":{"maxChars":200,"placeholder":"Viết bằng tiếng Việt (có dấu)"},"explanation":"Đáp án: \"Con gái cô ấy là học sinh.\". Cũng đúng: \"Con gái của cô ấy là học sinh.\", \"Con gái cô ấy là sinh viên.\".","gradingRule":{"acceptedText":["Con gái cô ấy là học sinh.","Con gái của cô ấy là học sinh.","Con gái cô ấy là sinh viên.","Con gái của bà ấy là học sinh."],"caseSensitive":false,"ignoreDiacritics":false,"ignorePunctuation":true},"hint":"\"student\" = học sinh; \"daughter\" = con gái","id":"u2n5l4-e12","prompt":{"locale":"en-US","text":"Her daughter is a student."},"skillIds":["u2.grammar"],"type":"textTranslation","vocabularyIds":["u1.student","u2.daughter"]}],"gradingRulesVersion":"g1","guideText":"Mẫu câu chính: \"This is my mother.\" (Đây là mẹ tôi.) — \"I have a brother.\" (Tôi có một anh/em trai.)\nTính từ sở hữu: my (của tôi), your (của bạn), his (của anh ấy), her (của cô ấy), their (của họ). Đặt TRƯỚC danh từ: \"my father\", không nói \"father my\".\nĐộng từ \"have\": I/you/we/they have — he/she has. \"Mai has a cat.\"\nLưu ý: tiếng Anh không phân biệt anh/em: \"brother\" = anh trai hoặc em trai, \"sister\" = chị gái hoặc em gái. \"Aunt/uncle\" gồm cả cô, dì, chú, cậu, bác.","lessonId":"u2n5l4","lessonVersion":"v2.u2n5l4","manifestHash":"013672aa5927648264926e14d514d9d670ba04f547fc10aba6d50095b8e8b587","nodeId":"u2n5","order":12,"rewardIdentity":"v2.u2n5l4","schemaVersion":1,"sectionId":"sec1","signature":"jPJjCRlnrHGs3xFBX2QHNb6aXMu5R_8iprP8_pqyoQf0bAwfMX_Ohkx5P4VQJZI_q4DgIVdwKxsHJhPzSwEIAQ","signatureKeyId":"dev-content-1","skillIds":["speaking","u2.grammar","u2.dialogue","u2.vocab"],"title":"Tôi có một con mèo · Bài 4","unitId":"u2"}