uter"]},{"content":{"tokens":[{"id":"t1","text":"your"},{"id":"t2","text":"sofa"},{"id":"t3","text":"job"},{"id":"t4","text":"is"},{"id":"t5","text":"What"},{"id":"t6","text":"dinner"},{"id":"t7","text":"home"}]},"explanation":"Câu đúng: \"What is your job?\".","gradingRule":{"caseSensitive":false,"correctTokenIds":["t5","t4","t1","t3"],"ignoreDiacritics":false,"ignorePunctuation":false},"hint":"\"job\" = công việc","id":"u12n5l5-e11","prompt":{"locale":"vi-VN","text":"Dịch câu này: \"Công việc của bạn là gì?\""},"skillIds":["u12.grammar"],"type":"wordBank","vocabularyIds":["u12.job"]},{"content":{"maxChars":200,"placeholder":"Viết bằng tiếng Anh"},"explanation":"Đáp án: \"The office is on the third floor.\".","gradingRule":{"acceptedText":["The office is on the third floor."],"caseSensitive":false,"ignoreDiacritics":false,"ignorePunctuation":true},"hint":"\"floor\" = tầng; \"office\" = văn phòng","id":"u12n5l5-e12","prompt":{"locale":"vi-VN","text":"Văn phòng ở tầng ba."},"skillIds":["u12.grammar"],"type":"textTranslation","vocabularyIds":["u6.floor","u12.office"]}],"gradingRulesVersion":"g1","guideText":"Mẫu câu chính: \"What do you do?\" (Bạn làm nghề gì?) — \"I am an engineer.\" (Tôi là kỹ sư.) — \"I worked late yesterday.\" (Hôm qua tôi làm việc muộn.)\nNghề nghiệp luôn có a/an: \"She is a nurse\", \"He is an engineer\" (an trước nguyên âm).\nThì quá khứ đơn (động từ có quy tắc): thêm -ed: work → worked, start → started, finish → finished. Quá khứ của \"be\": I/he/she was, you/we/they were.\nCâu hỏi quá khứ dùng \"did\" + động từ nguyên mẫu: \"Did you finish your work?\" (không nói \"Did you finished\").\nMốc thời gian quá khứ: yesterday (hôm qua), last week (tuần trước).","lessonId":"u12n5l5","lessonVersion":"v2.u12n5l5","manifestHash":"013672aa5927648264926e14d514d9d670ba04f547fc10aba6d50095b8e8b587","nodeId":"u12n5","order":92,"rewardIdentity":"v2.u12n5l5","schemaVersion":1,"sectionId":"sec2","signature":"HszjAOyt8KKSCqOJgmLoe-T8DRPj0vaFYl2INh2oHRsru8zohHgbG