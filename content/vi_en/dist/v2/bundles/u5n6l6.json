":{"audioAssetId":"a.u5.s27.n","locale":"en-US","text":"Nói câu sau: \"I sometimes drink coffee.\""},"skillIds":["speaking","u5.grammar"],"type":"speakRepeat","vocabularyIds":["u3.coffee","u3.drink","u5.sometimes"]},{"content":{"maxChars":200,"placeholder":"Viết bằng tiếng Anh"},"explanation":"Đáp án: \"Tom usually gets up at seven.\".","gradingRule":{"acceptedText":["Tom usually gets up at seven."],"caseSensitive":false,"ignoreDiacritics":false,"ignorePunctuation":true},"hint":"\"seven\" = bảy; \"get up\" = thức dậy; \"usually\" = thường","id":"u5n6l6-e09","prompt":{"locale":"vi-VN","text":"Tom thường thức dậy lúc bảy giờ."},"skillIds":["u5.grammar"],"type":"textTranslation","vocabularyIds":["u4.seven","u5.get_up","u5.usually"]},{"content":{"tokens":[{"id":"t1","text":"usually"},{"id":"t2","text":"gets"},{"id":"t3","text":"up"},{"id":"t4","text":"Tom"},{"id":"t5","text":"seven"},{"id":"t6","text":"at"}]},"explanation":"Câu đúng: \"Tom usually gets up at seven.\".","gradingRule":{"caseSensitive":false,"correctTokenIds":["t4","t1","t2","t3","t6","t5"],"ignoreDiacritics":false,"ignorePunctuation":false},"hint":"Câu bắt đầu bằng \"Tom\".","id":"u5n6l6-e10","prompt":{"locale":"vi-VN","text":"Sắp xếp thành câu đúng: \"Tom thường thức dậy lúc bảy giờ.\""},"skillIds":["u5.grammar"],"type":"sentenceOrder","vocabularyIds":["u4.seven","u5.get_up","u5.usually"]},{"content":{"locale":"en-US","maxSeconds":7,"referenceText":"It is eight o'clock now."},"explanation":"Câu mẫu: \"It is eight o'clock now.\".","gradingRule":{"acceptedText":["It is eight o'clock now.","It's eight o'clock now."],"caseSensitive":false,"ignoreDiacritics":false,"ignorePunctuation":true},"hint":"Nghĩa: \"Bây giờ là tám giờ.\"","id":"u5n6l6-e11","nonSpeechAlternative":{"content":{"tokens":[{"id":"t1","text":"eight"},{"id":"t2","text":"It"},{"id":"t3","text":"now"},{"id":"t4","text":"is"},{"id":"t5","text":"o'clock"}]},"explanation":"Câu đúng: \"It is eight o'clock now.\".","gradingRule":{"caseSensitive":false,"correctTokenIds":["t2","t4","t1","t5","t3"],"ignoreDiacritics":false,"ignorePunctuation":false},"hint":"Câu bắt đầu bằng \"It\".","id":"u5n6l6-e11a","prompt":{"locale":"vi-VN","text":"Sắp xếp thành câu đúng: \"Bây giờ là tám giờ.\""},"skillIds":["speaking","u5.grammar"],"type":"sentenceOrder","vocabularyIds":["u4.eight","u5.oclock","u5.now"]},"prompt":{"audioAssetId":"a.u5.s3.n","locale":"en-US","text":"Nói câu sau: \"It is eight o'clock now.\""},"skillIds":["speaking","u5.grammar"],"type":"speakRepeat","vocabularyIds":["u4.eight","u5.oclock","u5.now"]},{"content":{"maxChars":200,"placeholder":"Viết bằng tiếng Việt (có dấu)"},"explanation":"Đáp án: \"Mấy giờ rồi?\". Cũng đúng: \"Bây giờ là mấy giờ?\", \"Bây giờ mấy giờ rồi?\".","gradingRule":{"acceptedText":["Mấy giờ rồi?","Bây giờ là mấy giờ?","Bây giờ mấy giờ rồi?"],"caseSensitive":false,"ignoreDiacritics":false,"ignorePunctuation":true},"hint":"\"time\" = thời gian","id":"u5n6l6-e12","prompt":{"locale":"en-US","text":"What time is it?"},"skillIds":["u5.grammar"],"type":"textTranslation","vocabularyIds":["u5.time"]}],"gradingRulesVersion":"g1","guideText":"Mẫu câu chính: \"What time is it?\" (Mấy giờ rồi?) — \"It is seven o'clock.\" (Bảy giờ rồi.) — \"I get up at six.\" (Tôi dậy lúc sáu giờ.)\nGiới từ thời gian: at + giờ (at six o'clock), on + thứ (on Monday), in + buổi (in the morning, in the evening).\nThì hiện tại đơn cho thói quen: \"Mai goes to school every day.\" Với he/she/it: go → goes, get up → gets up.\nTrạng từ tần suất đứng TRƯỚC động từ thường: \"I always eat breakfast\", \"Kiko never eats bread\". Thứ tự: always > usually > sometimes > never.\nThứ trong tuần luôn viết hoa: Monday, Sunday.","lessonId":"u5n6l6","lessonVersion":"v2.u5n6l6","manifestHash":"013672aa5927648264926e14d514d9d670ba04f547fc10aba6d50095b8e8b587","nodeId":"u5n6","order":37,"rewardIdentity":"v2.u5n6l6","schemaVersion":1,"sectionId":"sec1","signature":"qYAtQGlT7LEpHH5QK5XfFvC6fSbt0__l3MPyY0NaN3SgUletKU2SgxRKGsbk7VlCTX0NB2Ju8rf4IFNDl9CnAw","signatureKeyId":"dev-content-1","skillIds":["speaking","u5.grammar","u5.dialogue","u5.vocab"],"title":"Luôn luôn, thỉnh thoảng · Bài 6","unitId":"u5"}