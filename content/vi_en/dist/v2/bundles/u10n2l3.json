nAudioAlternative":{"content":{"maxChars":200,"placeholder":"Viết bằng tiếng Anh"},"explanation":"Đáp án: \"Go straight.\".","gradingRule":{"acceptedText":["Go straight."],"caseSensitive":false,"ignoreDiacritics":false,"ignorePunctuation":true},"hint":"\"go\" = đi; \"straight\" = thẳng","id":"u10n2l3-e12a","prompt":{"locale":"vi-VN","text":"Đi thẳng."},"skillIds":["listening","u10.grammar"],"type":"textTranslation","vocabularyIds":["u5.go","u10.straight"]},"prompt":{"audioAssetId":"a.u10.s1.n","locale":"vi-VN","text":"Nghe và viết lại bằng tiếng Anh"},"skillIds":["listening","u10.grammar"],"type":"dictation","vocabularyIds":["u5.go","u10.straight"]}],"gradingRulesVersion":"g1","guideText":"Mẫu câu chính: \"Excuse me, where is the bank?\" (Xin lỗi, ngân hàng ở đâu?) — \"Go straight and turn left.\" (Đi thẳng rồi rẽ trái.) — \"Is it far?\" (Có xa không?)\nChỉ đường dùng câu mệnh lệnh: Go straight. Turn right. Turn left at the corner.\nVị trí: on the left / on the right (bên trái / bên phải), next to (bên cạnh), opposite (đối diện), near (gần), on the corner (ở góc đường).\n\"Near\" không cần \"to\": \"near the school\" (không nói \"near to the school\" trong văn nói chuẩn A2).\nHỏi khoảng cách: \"Is it far from here?\" — Trả lời: \"No, you can walk.\" (Không, bạn có thể đi bộ.)","lessonId":"u10n2l3","lessonVersion":"v2.u10n2l3","manifestHash":"013672aa5927648264926e14d514d9d670ba04f547fc10aba6d50095b8e8b587","nodeId":"u10n2","order":73,"rewardIdentity":"v2.u10n2l3","schemaVersion":1,"sectionId":"sec2","signature":"G9BZj99Q9UgUzaxSGEwGQDkKjTXsJcy9QcmHg0p0aieClrXe1dxNfrHVukbQAEAkNRX9nyiC8pp-Ah7GwmXTBA","signatureKeyId":"dev-content-1","skillIds":["listening","u10.grammar","u10.vocab"],"title":"Rẽ ở ngân hàng · Bài 3","unitId":"u10"}