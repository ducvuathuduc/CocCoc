ernative":{"content":{"tokens":[{"id":"t1","text":"Mai"},{"id":"t2","text":"Hello"}]},"explanation":"Câu đúng: \"Hello, Mai!\".","gradingRule":{"caseSensitive":false,"correctTokenIds":["t2","t1"],"ignoreDiacritics":false,"ignorePunctuation":false},"hint":"Câu bắt đầu bằng \"Hello\".","id":"u9n1l4-e11a","prompt":{"locale":"vi-VN","text":"Sắp xếp thành câu đúng: \"Xin chào, Mai!\""},"skillIds":["speaking","u9.grammar"],"type":"sentenceOrder","vocabularyIds":["u1.hello"]},"prompt":{"audioAssetId":"a.u1.s1.n","locale":"en-US","text":"Nói câu sau: \"Hello, Mai!\""},"skillIds":["speaking","u9.grammar"],"type":"speakRepeat","vocabularyIds":["u1.hello"]},{"content":{"maxChars":200,"placeholder":"Viết bằng tiếng Việt (có dấu)"},"explanation":"Đáp án: \"Hôm nay là thứ mấy?\". Cũng đúng: \"Hôm nay thứ mấy?\".","gradingRule":{"acceptedText":["Hôm nay là thứ mấy?","Hôm nay thứ mấy?"],"caseSensitive":false,"ignoreDiacritics":false,"ignorePunctuation":true},"hint":"\"day\" = ngày; \"today\" = hôm nay","id":"u9n1l4-e12","prompt":{"locale":"en-US","text":"What day is it today?"},"skillIds":["u9.grammar"],"type":"textTranslation","vocabularyIds":["u5.day","u5.today"]}],"gradingRulesVersion":"g1","guideText":"Mẫu câu chính: \"How much is this dress?\" (Cái váy này bao nhiêu tiền?) — \"Can I pay by card?\" (Tôi trả bằng thẻ được không?) — \"It is on sale.\" (Nó đang giảm giá.)\nHow much is + số ít / How much are + số nhiều: \"How much are the shoes?\"\n\"Shoes\" luôn ở dạng số nhiều (một đôi giày = a pair of shoes).\nMàu sắc đứng trước danh từ: \"a red dress\" (một cái váy đỏ). Hỏi màu: \"What color is it?\"\nTrả tiền: pay in cash (tiền mặt) / pay by card (bằng thẻ). \"Expensive\" (đắt) ↔ \"cheap\" (rẻ).","lessonId":"u9n1l4","lessonVersion":"v2.u9n1l4","manifestHash":"013672aa5927648264926e14d514d9d670ba04f547fc10aba6d50095b8e8b587","nodeId":"u9n1","order":64,"rewardIdentity":"v2.u9n1l4","schemaVersion":1,"sectionId":"sec2","signature":"dRXAAmPl0P-ZoDSIKww_qImkIMPoCSh1lS6mfCGuyJIgXP_Cn