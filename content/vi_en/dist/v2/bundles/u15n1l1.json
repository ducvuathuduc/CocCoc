ngry"]},{"content":{"tokens":[{"id":"t1","text":"week"},{"id":"t2","text":"eat"},{"id":"t3","text":"You"},{"id":"t4","text":"eggs"},{"id":"t5","text":"vegetables"},{"id":"t6","text":"more"},{"id":"t7","text":"morning"},{"id":"t8","text":"should"}]},"explanation":"Câu đúng: \"You should eat more vegetables.\".","gradingRule":{"caseSensitive":false,"correctTokenIds":["t3","t8","t2","t6","t5"],"ignoreDiacritics":false,"ignorePunctuation":false},"hint":"\"eat\" = ăn; \"should\" = nên; \"vegetable\" = rau","id":"u15n1l1-e13","prompt":{"locale":"vi-VN","text":"Dịch câu này: \"Bạn nên ăn nhiều rau hơn.\""},"skillIds":["u15.grammar"],"type":"wordBank","vocabularyIds":["u3.eat","u14.should","u14.vegetable"]}],"gradingRulesVersion":"g1","guideText":"Mẫu câu chính: \"Why are you sad?\" (Sao bạn buồn?) — \"Nam is taller than Tom.\" (Nam cao hơn Tom.) — \"Happy birthday!\" (Chúc mừng sinh nhật!)\nSo sánh hơn với tính từ ngắn: thêm -er + than: tall → taller than, young → younger than, smart → smarter than.\nTính từ cảm xúc đuôi -ed mô tả cảm giác của người: I am bored, I am excited, She was surprised.\nGiới từ đi kèm: afraid of (sợ), worried about (lo về), excited about (háo hức về).\nLời khuyên nhẹ nhàng: \"Don't be sad.\" (Đừng buồn.)","lessonId":"u15n1l1","lessonVersion":"v2.u15n1l1","manifestHash":"013672aa5927648264926e14d514d9d670ba04f547fc10aba6d50095b8e8b587","nodeId":"u15n1","order":112,"rewardIdentity":"v2.u15n1l1","schemaVersion":1,"sectionId":"sec2","signature":"-ibYi9-Oj1uBf_IxQUsuZSqAKQac9nnopzdpNTop24M0LVH4XHoZVTYHfEFJg7TYyvLQfNkNZzs0qxwdCL6XCQ","signatureKeyId":"dev-content-1","skillIds":["u15.vocab","u15.grammar","listening"],"title":"Vui hay buồn? · Bài 1","unitId":"u15"}