","text":"straight"},{"id":"t2","text":"Go"},{"id":"t3","text":"card"},{"id":"t4","text":"his"},{"id":"t5","text":"three"}]},"explanation":"Câu đúng: \"Go straight.\".","gradingRule":{"caseSensitive":false,"correctTokenIds":["t2","t1"],"ignoreDiacritics":false,"ignorePunctuation":false},"hint":"\"go\" = đi; \"straight\" = thẳng","id":"u10n2l1-e13","prompt":{"locale":"vi-VN","text":"Dịch câu này: \"Đi thẳng.\""},"skillIds":["u10.grammar"],"type":"wordBank","vocabularyIds":["u5.go","u10.straight"]}],"gradingRulesVersion":"g1","guideText":"Mẫu câu chính: \"Excuse me, where is the bank?\" (Xin lỗi, ngân hàng ở đâu?) — \"Go straight and turn left.\" (Đi thẳng rồi rẽ trái.) — \"Is it far?\" (Có xa không?)\nChỉ đường dùng câu mệnh lệnh: Go straight. Turn right. Turn left at the corner.\nVị trí: on the left / on the right (bên trái / bên phải), next to (bên cạnh), opposite (đối diện), near (gần), on the corner (ở góc đường).\n\"Near\" không cần \"to\": \"near the school\" (không nói \"near to the school\" trong văn nói chuẩn A2).\nHỏi khoảng cách: \"Is it far from here?\" — Trả lời: \"No, you can walk.\" (Không, bạn có thể đi bộ.)","lessonId":"u10n2l1","lessonVersion":"v2.u10n2l1","manifestHash":"013672aa5927648264926e14d514d9d670ba04f547fc10aba6d50095b8e8b587","nodeId":"u10n2","order":73,"rewardIdentity":"v2.u10n2l1","schemaVersion":1,"sectionId":"sec2","signature":"qJ6_TJia0-ouIQFqRNxy8ZkzfuZm8UrafxYtCBPOZYjACxGEsqsI8S8_E8fIsjvqGwK9Xpvp_qzcygW9rl37DQ","signatureKeyId":"dev-content-1","skillIds":["u10.vocab","u10.grammar","listening"],"title":"Rẽ ở ngân hàng · Bài 1","unitId":"u10"}