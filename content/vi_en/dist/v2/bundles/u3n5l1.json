:"textTranslation","vocabularyIds":["u3.hungry"]},{"content":{"tokens":[{"id":"t1","text":"tea"},{"id":"t2","text":"I"},{"id":"t3","text":"Sorry"},{"id":"t4","text":"like"},{"id":"t5","text":"uncle"},{"id":"t6","text":"Excuse"}]},"explanation":"Câu đúng: \"I like tea.\".","gradingRule":{"caseSensitive":false,"correctTokenIds":["t2","t4","t1"],"ignoreDiacritics":false,"ignorePunctuation":false},"hint":"\"tea\" = trà; \"like\" = thích","id":"u3n5l1-e13","prompt":{"locale":"vi-VN","text":"Dịch câu này: \"Tôi thích trà.\""},"skillIds":["u3.grammar"],"type":"wordBank","vocabularyIds":["u3.tea","u3.like"]}],"gradingRulesVersion":"g1","guideText":"Mẫu câu chính: \"Water, please.\" (Cho tôi nước.) — \"I like tea.\" (Tôi thích trà.) — \"Do you want coffee?\" (Bạn có muốn cà phê không?)\nMạo từ: \"a\" trước phụ âm (a banana), \"an\" trước nguyên âm (an apple, an egg).\nThì hiện tại đơn: he/she thêm -s: \"Kiko likes fish.\" Câu phủ định dùng do not / does not: \"Tom does not like coffee.\" (hay: doesn't).\nLịch sự khi gọi món: thêm \"please\" ở cuối câu. \"I want ...\" hơi thẳng; dùng \"..., please\" khi nói với người phục vụ.\nBữa ăn: breakfast (bữa sáng), lunch (bữa trưa), dinner (bữa tối) — nói \"for breakfast\" (cho bữa sáng).","lessonId":"u3n5l1","lessonVersion":"v2.u3n5l1","manifestHash":"013672aa5927648264926e14d514d9d670ba04f547fc10aba6d50095b8e8b587","nodeId":"u3n5","order":20,"rewardIdentity":"v2.u3n5l1","schemaVersion":1,"sectionId":"sec1","signature":"TwCsAoOYhKqmuega0GYVkjRe2WZbkCpvXstTV-uYVA_55xLSrxU3Vi0J-zI-yRAaQZN9WJvlp0dA3z3C8xRTDw","signatureKeyId":"dev-content-1","skillIds":["u3.vocab","u3.grammar","listening"],"title":"Bữa ăn trong ngày · Bài 1","unitId":"u3"}