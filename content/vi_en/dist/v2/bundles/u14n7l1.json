d?"}]},"explanation":"Bạn nghe: \"You should not drink coffee at night.\" (Bạn không nên uống cà phê vào ban đêm.).","gradingRule":{"caseSensitive":false,"correctChoiceId":"c1","ignoreDiacritics":false,"ignorePunctuation":false},"hint":"Câu có nghĩa: \"Bạn không nên uống cà phê vào ban đêm.\"","id":"u14n7l1-e07a","prompt":{"locale":"vi-VN","text":"Chọn câu tiếng Anh có nghĩa: \"Bạn không nên uống cà phê vào ban đêm.\""},"skillIds":["listening","u14.grammar"],"type":"choice","vocabularyIds":["u3.coffee","u3.drink","u5.night","u14.should"]},"prompt":{"audioAssetId":"a.u14.s18.n","locale":"vi-VN","text":"Nghe và chọn câu bạn nghe được"},"skillIds":["listening","u14.grammar"],"type":"listenChoice","vocabularyIds":["u3.coffee","u3.drink","u5.night","u14.should"]},{"content":{"locale":"en-US","maxSeconds":12,"referenceText":"It is at three o'clock."},"explanation":"Câu trả lời mẫu: \"It is at three o'clock.\". Cũng đúng: \"At three.\", \"It's at three o'clock.\".","gradingRule":{"acceptedText":["It is at three o'clock.","At three.","It's at three o'clock."],"caseSensitive":false,"ignoreDiacritics":false,"ignorePunctuation":true},"hint":"Gợi ý trả lời: \"Lúc ba giờ.\"","id":"u14n7l1-e08","nonSpeechAlternative":{"content":{"choices":[{"id":"c1","text":"It is on the second floor."},{"id":"c2","text":"It is at three o'clock."},{"id":"c3","text":"Yes, I have homework."}]},"explanation":"Câu trả lời mẫu: \"It is at three o'clock.\".","gradingRule":{"caseSensitive":false,"correctChoiceId":"c2","ignoreDiacritics":false,"ignorePunctuation":false},"hint":"Gợi ý trả lời: \"Lúc ba giờ.\"","id":"u14n7l1-e08a","prompt":{"locale":"vi-VN","text":"\"When is your appointment?\" — chọn câu trả lời phù hợp"},"skillIds":["speaking","u14.dialogue"],"type":"choice","vocabularyIds":["u4.three","u5.oclock","u14.appointment"]},"prompt":{"audioAssetId":"a.u14.d6.n","locale":"en-US","text":"When is your appointment?"},"skillIds":["speaking","u14.dialogue"],"type":"dialogueTurn","vocabularyIds":["u4.three","u5.oclock","u14.appointment"]},{"content":{"choices":[{"id":"c1","text":"His leg"},{"id":"c2","text":"His tooth"},{"id":"c3","text":"His stomach"}],"passage":"On Monday, Nam does not go to school. He is sick. He has a fever and a headache, and his stomach hurts. \"You should go to the doctor,\" his mother says. The doctor says, \"You ate too much last night! You should rest and drink water. Take this medicine after dinner.\" Nam sleeps all day. On Wednesday, he feels better. \"No more chicken at midnight,\" he says. Mai brings him fruit and his homework.","question":"What hurts?"},"explanation":"Đáp án: \"His stomach\".","gradingRule":{"caseSensitive":false,"correctChoiceId":"c3","ignoreDiacritics":false,"ignorePunctuation":false},"hint":"Đọc lại câu chuyện \"Nam bị ốm\".","id":"u14n7l1-e09","prompt":{"locale":"en-US","text":"What hurts?"},"skillIds":["reading","u14.story"],"type":"storyQuestion","vocabularyIds":[]},{"content":{"choices":[{"id":"c1","imageAssetId":"i.u6.lamp","text":"lamp"},{"id":"c2","imageAssetId":"i.u10.building","text":"building"},{"id":"c3","imageAssetId":"i.u11.train","text":"train"},{"id":"c4","imageAssetId":"i.u14.fruit","text":"fruit"}]},"explanation":"\"fruit\" = \"trái cây\".","gradingRule":{"caseSensitive":false,"correctChoiceId":"c4","ignoreDiacritics":false,"ignorePunctuation":false},"hint":"\"trái cây\" là \"fruit\".","id":"u14n7l1-e10","prompt":{"locale":"vi-VN","text":"Hình nào là \"trái cây\"?"},"skillIds":["u14.vocab"],"type":"imageChoice","vocabularyIds":["u14.fruit"]},{"content":{"pairs":[{"id":"p1","left":{"id":"p1l","text":"dentist"},"right":{"id":"p1r","text":"nha sĩ"}},{"id":"p2","left":{"id":"p2l","text":"should"},"right":{"id":"p2r","text":"nên"}},{"id":"p3","left":{"id":"p3l","text":"medicine"},"right":{"id":"p3r","text":"thuốc"}},{"id":"p4","left":{"id":"p4l","text":"pharmacy"},"right":{"id":"p4r","text":"hiệu thuốc"}},{"id":"p5","left":{"id":"p5l","text":"vegetable"},"right":{"id":"p5r","text":"rau"}}]},"explanation":"dentist = nha sĩ; should = nên; medicine = thuốc; pharmacy = hiệu thuốc; vegetable = rau","gradingRule":{"caseSensitive":false,"correctPairIds":["p1","p2","p3","p4","p5"],"ignoreDiacritics":false,"ignorePunctuation":false},"hint":"Ví dụ: \"dentist\" = \"nha sĩ\".","id":"u14n7l1-e11","prompt":{"locale":"vi-VN","text":"Nối các cặp từ tương ứng"},"skillIds":["u14.vocab"],"type":"matchPairs","vocabularyIds":["u14.dentist","u14.should","u14.medicine","u14.pharmacy","u14.vegetable"]},{"content":{"choices":[{"id":"c1","text":"fever"},{"id":"c2","text":"nice"},{"id":"c3","text":"late"},{"id":"c4","text":"live"}]},"explanation":"\"fever\" = \"sốt\".","gradingRule":{"caseSensitive":false,"correctChoiceId":"c1","ignoreDiacritics":false,"ignorePunctuation":false},"hint":"\"fever\" nghĩa là \"sốt\".","id":"u14n7l1-e12","prompt":{"locale":"vi-VN","text":"\"sốt\" trong tiếng Anh là gì?"},"skillIds":["u14.vocab"],"type":"choice","vocabularyIds":["u14.fever"]},{"content":{"locale":"en-US","maxSeconds":7,"referenceText":"How do you feel today?"},"explanation":"Câu mẫu: \"How do you feel today?\".","gradingRule":{"acceptedText":["How do you feel today?"],"caseSensitive":false,"ignoreDiacritics":false,"ignorePunctuation":true},"hint":"Nghĩa: \"Hôm nay bạn cảm thấy thế nào?\"","id":"u14n7l1-e13","nonSpeechAlternative":{"content":{"tokens":[{"id":"t1","text":"feel"},{"id":"t2","text":"today"},{"id":"t3","text":"you"},{"id":"t4","text":"do"},{"id":"t5","text":"How"}]},"explanation":"Câu đúng: \"How do you feel today?\".","gradingRule":{"caseSensitive":false,"correctTokenIds":["t5","t4","t3","t1","t2"],"ignoreDiacritics":false,"ignorePunctuation":false},"hint":"Câu bắt đầu bằng \"How\".","id":"u14n7l1-e13a","prompt":{"locale":"vi-VN","text":"Sắp xếp thành câu đúng: \"Hôm nay bạn cảm thấy thế nào?\""},"skillIds":["speaking","u14.grammar"],"type":"sentenceOrder","vocabularyIds":["u5.today","u14.feel"]},"prompt":{"audioAssetId":"a.u14.s15.n","locale":"en-US","text":"Nói câu sau: \"How do you feel today?\""},"skillIds":["speaking","u14.grammar"],"type":"speakRepeat","vocabularyIds":["u5.today","u14.feel"]},{"content":{"tokens":[{"id":"t1","text":"tôi"},{"id":"t2","text":"Mặc"},{"id":"t3","text":"ho"},{"id":"t4","text":"bị"},{"id":"t5","text":"muộn"},{"id":"t6","text":"ốm"},{"id":"t7","text":"ngơi"},{"id":"t8","text":"Mẹ"}]},"explanation":"Câu đúng: \"Mẹ tôi bị ốm.\".","gradingRule":{"caseSensitive":false,"correctTokenIds":["t8","t1","t4","t6"],"ignoreDiacritics":false,"ignorePunctuation":false},"hint":"\"mother\" = mẹ; \"sick\" = ốm","id":"u14n7l1-e14","prompt":{"locale":"vi-VN","text":"Dịch sang tiếng Việt: \"My mother is sick.\""},"skillIds":["u14.grammar"],"type":"wordBank","vocabularyIds":["u2.mother","u14.sick"]},{"content":{"maxChars":200,"placeholder":"Viết bằng tiếng Anh"},"explanation":"Đáp án: \"I eat fruit every day.\".","gradingRule":{"acceptedText":["I eat fruit every day."],"caseSensitive":false,"ignoreDiacritics":false,"ignorePunctuation":true},"hint":"\"eat\" = ăn; \"day\" = ngày; \"every\" = mỗi; \"fruit\" = trái cây","id":"u14n7l1-e15","prompt":{"locale":"vi-VN","text":"Tôi ăn trái cây mỗi ngày."},"skillIds":["u14.grammar"],"type":"textTranslation","vocabularyIds":["u3.eat","u5.day","u5.every","u14.fruit"]}],"gradingRulesVersion":"g1","guideText":"Mẫu câu chính: \"How do you feel?\" (Bạn thấy thế nào?) — \"I have a headache.\" (Tôi bị đau đầu.) — \"You should rest.\" (Bạn nên nghỉ ngơi.)\nBệnh dùng \"have\": have a fever (bị sốt), have a cough (bị ho), have a headache (bị đau đầu). Tính từ dùng \"be\": I am sick, I am tired.\nChỗ đau: \"My stomach hurts\" (Tôi bị đau bụng) — động từ \"hurt\" thêm -s với he/she/it và danh từ số ít.\nLời khuyên: should / should not (shouldn't) + động từ nguyên mẫu: \"You should eat more vegetables.\"\nSố nhiều bất quy tắc: one tooth → two teeth.","lessonId":"u14n7l1","lessonVersion":"v2.u14n7l1","manifestHash":"013672aa5927648264926e14d514d9d670ba04f547fc10aba6d50095b8e8b587","nodeId":"u14n7","orde