acritics":false,"ignorePunctuation":true},"hint":"\"eat\" = ăn; \"breakfast\" = bữa sáng; \"six\" = sáu; \"o'clock\" = giờ (đúng)","id":"u5n6l5-e12","prompt":{"locale":"vi-VN","text":"Tôi ăn sáng lúc sáu giờ."},"skillIds":["u5.grammar"],"type":"textTranslation","vocabularyIds":["u3.eat","u3.breakfast","u4.six","u5.oclock"]}],"gradingRulesVersion":"g1","guideText":"Mẫu câu chính: \"What time is it?\" (Mấy giờ rồi?) — \"It is seven o'clock.\" (Bảy giờ rồi.) — \"I get up at six.\" (Tôi dậy lúc sáu giờ.)\nGiới từ thời gian: at + giờ (at six o'clock), on + thứ (on Monday), in + buổi (in the morning, in the evening).\nThì hiện tại đơn cho thói quen: \"Mai goes to school every day.\" Với he/she/it: go → goes, get up → gets up.\nTrạng từ tần suất đứng TRƯỚC động từ thường: \"I always eat breakfast\", \"Kiko never eats bread\". Thứ tự: always > usually > sometimes > never.\nThứ trong tuần luôn viết hoa: Monday, Sunday.","lessonId":"u5n6l5","lessonVersion":"v2.u5n6l5","manifestHash":"013672aa5927648264926e14d514d9d670ba04f547fc10aba6d50095b8e8b587","nodeId":"u5n6","order":37,"rewardIdentity":"v2.u5n6l5","schemaVersion":1,"sectionId":"sec1","signature":"TSsY5pIy0iypVda74BwqRKtugYCFwCfAZde__aG5ETcLtMz0Y01jBulK2gKkRDUc12NiRSX5W0q1oxNz4fXgBw","signatureKeyId":"dev-content-1","skillIds":["u5.vocab","u5.grammar","listening"],"title":"Luôn luôn, thỉnh thoảng · Bài 5","unitId":"u5"}