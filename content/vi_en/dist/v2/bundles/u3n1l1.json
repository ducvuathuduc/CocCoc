r","u1.please","u3.bread"]},{"content":{"maxChars":200,"placeholder":"Viết bằng tiếng Anh"},"explanation":"Đáp án: \"Mai has an apple.\".","gradingRule":{"acceptedText":["Mai has an apple."],"caseSensitive":false,"ignoreDiacritics":false,"ignorePunctuation":true},"hint":"\"have\" = có; \"apple\" = quả táo","id":"u3n1l1-e12","prompt":{"locale":"vi-VN","text":"Mai có một quả táo."},"skillIds":["u3.grammar"],"type":"textTranslation","vocabularyIds":["u2.have","u3.apple"]},{"content":{"tokens":[{"id":"t1","text":"Vietnam"},{"id":"t2","text":"she"},{"id":"t3","text":"I"},{"id":"t4","text":"to"},{"id":"t5","text":"am"},{"id":"t6","text":"Nam"},{"id":"t7","text":"No"}]},"explanation":"Câu đúng: \"No, I am Nam.\".","gradingRule":{"caseSensitive":false,"correctTokenIds":["t7","t3","t5","t6"],"ignoreDiacritics":false,"ignorePunctuation":false},"hint":"\"no\" = không","id":"u3n1l1-e13","prompt":{"locale":"vi-VN","text":"Dịch câu này: \"Không, tôi là Nam.\""},"skillIds":["u3.grammar"],"type":"wordBank","vocabularyIds":["u1.no"]}],"gradingRulesVersion":"g1","guideText":"Mẫu câu chính: \"Water, please.\" (Cho tôi nước.) — \"I like tea.\" (Tôi thích trà.) — \"Do you want coffee?\" (Bạn có muốn cà phê không?)\nMạo từ: \"a\" trước phụ âm (a banana), \"an\" trước nguyên âm (an apple, an egg).\nThì hiện tại đơn: he/she thêm -s: \"Kiko likes fish.\" Câu phủ định dùng do not / does not: \"Tom does not like coffee.\" (hay: doesn't).\nLịch sự khi gọi món: thêm \"please\" ở cuối câu. \"I want ...\" hơi thẳng; dùng \"..., please\" khi nói với người phục vụ.\nBữa ăn: breakfast (bữa sáng), lunch (bữa trưa), dinner (bữa tối) — nói \"for breakfast\" (cho bữa sáng).","lessonId":"u3n1l1","lessonVersion":"v2.u3n1l1","manifestHash":"013672aa5927648264926e14d514d9d670ba04f547fc10aba6d50095b8e8b587","nodeId":"u3n1","order":16,"rewardIdentity":"v2.u3n1l1","schemaVersion":1,"sectionId":"sec1","signature":"0G22F5Ma7tvEnl1Uats4AvB0w9ss1fM4H_2k9_vGpEL8D86E8OXZZcEDTRNGhSU3dlvyrioL9vyVL4WZPbBQCA","signature