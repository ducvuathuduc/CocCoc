":false,"correctChoiceId":"c1","ignoreDiacritics":false,"ignorePunctuation":false},"hint":"\"apple\" nghĩa là \"quả táo\".","id":"u3n1l1-e08","prompt":{"locale":"vi-VN","text":"\"quả táo\" trong tiếng Anh là gì?"},"skillIds":["u3.vocab"],"type":"choice","vocabularyIds":["u3.apple"]},{"content":{"tokens":[{"id":"t1","text":"bánh"},{"id":"t2","text":"mì"},{"id":"t3","text":"Vâng"},{"id":"t4","text":"gì"},{"id":"t5","text":"Tôi"},{"id":"t6","text":"Cô"},{"id":"t7","text":"sáng"},{"id":"t8","text":"có"}]},"explanation":"Câu đúng: \"Tôi có bánh mì.\".","gradingRule":{"caseSensitive":false,"correctTokenIds":["t5","t8","t1","t2"],"ignoreDiacritics":false,"ignorePunctuation":false},"hint":"\"have\" = có; \"bread\" = bánh mì","id":"u3n1l1-e09","prompt":{"locale":"vi-VN","text":"Dịch sang tiếng Việt: \"I have bread.\""},"skillIds":["u3.grammar"],"type":"wordBank","vocabularyIds":["u2.have","u3.bread"]},{"content":{"tokens":[{"id":"t1","text":"please"},{"id":"t2","text":"Water"}]},"explanation":"Câu đúng: \"Water, please.\".","gradingRule":{"caseSensitive":false,"correctTokenIds":["t2","t1"],"ignoreDiacritics":false,"ignorePunctuation":false},"hint":"Câu bắt đầu bằng \"Water\".","id":"u3n1l1-e10","prompt":{"locale":"vi-VN","text":"Sắp xếp thành câu đúng: \"Làm ơn cho tôi nước.\""},"skillIds":["u3.grammar"],"type":"sentenceOrder","vocabularyIds":["u1.please","u3.water"]},{"content":{"maxChars":40,"placeholder":"Điền từ còn thiếu"},"explanation":"Từ đúng: \"water\" → Bread and water, please.","gradingRule":{"acceptedText":["water"],"caseSensitive":false,"ignoreDiacritics":false,"ignorePunctuation":true},"hint":"\"nước\" trong tiếng Anh là \"w...\"","id":"u3n1l1-e11","prompt":{"locale":"en-US","text":"Bread and ___, please. — \"Làm ơn cho tôi bánh mì và nước.\""},"skillIds":["u3.grammar"],"type":"fillBlank","vocabularyIds":["u3.water","u1.please","u3.bread"]},{"content":{"maxChars":200,"placeholder":"Viết bằng tiếng Anh"},"explanation":"Đáp án: \"Mai has an apple.\".","gradingRule":{"acceptedText":["Mai has an apple."],"caseSensitive":false,"ignoreDiacritics":false,"ignorePunctuation":true},"hint":"\"have\" = có; \"apple\" = quả táo","id":"u3n1l1-e12","prompt":{"locale":"vi-VN","text":"Mai có một quả táo."},"skillIds":["u3.grammar"],"type":"textTranslation","vocabularyIds":["u2.have","u3.apple"]},{"content":{"tokens":[{"id":"t1","text":"Vietnam"},{"id":"t2","text":"she"},{"id":"t3","text":"I"},{"id":"t4","text":"to"},{"id":"t5","text":"am"},{"id":"t6","text":"Nam"},{"id":"t7","text":"No"}]},"explanation":"Câu đúng: \"No, I am Nam.\".","gradingRule":{"caseSensitive":false,"correctTokenIds":["t7","t3","t5","t6"],"ignoreDiacritics":false,"ignorePunctuation":false},"hint":"\"no\" = không","id":"u3n1l1-e13","prompt":{"locale":"vi-VN","text":"Dịch câu này: \"Không, tôi là Nam.\""},"skillIds":["u3.grammar"],"type":"wordBank","vocabularyIds":["u1.no"]}],"gradingRulesVersion":"g1","guideText":"Mẫu câu chính: \"Water, please.\" (Cho tôi nước.) — \"I like tea.\" (Tôi thích trà.) — \"Do you want coffee?\" (Bạn có muốn cà phê không?)\nMạo từ: \"a\" trước phụ âm (a banana), \"an\" trước nguyên âm (an apple, an egg).\nThì hiện tại đơn: he/she thêm -s: \"Kiko likes fish.\" Câu phủ định dùng do not / does not: \"Tom does not like coffee.\" (hay: doesn't).\nLịch sự khi gọi món: thêm \"please\" ở cuối câu. \"I want ...\" hơi thẳng; dùng \"..., please\" khi nói với người phục vụ.\nBữa ăn: breakfast (bữa sáng), lunch (bữa trưa), dinner (bữa tối) — nói \"for breakfast\" (cho bữa sáng).","lessonId":"u3n1l1","lessonVersion":"v2.u3n1l1","manifestHash":"013672aa5927648264926e14d514d9d670ba04f547fc10aba6d50095b8e8b587","nodeId":"u3n1","order":16,"rewardIdentity":"v2.u3n1l1","schemaVersion":1,"sectionId":"sec1","signature":"d3jY2hQv8e0Va3sMOWHq8L0hEWOGN7zonP9MHrNcqvP-d07af022h4zg-vqsLmom3l597haYe1NcCOgkWXF_Ag","signatureKeyId":"dev-content-1","skillIds":["u3.vocab","u3.grammar","listening"],"title":"Cơm và bánh mì · Bài 1","unitId":"u3"}