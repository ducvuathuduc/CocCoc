aryIds":["u5.school","u10.walk"]},{"content":{"tokens":[{"id":"t1","text":"the"},{"id":"t2","text":"map"},{"id":"t3","text":"Minh"},{"id":"t4","text":"at"},{"id":"t5","text":"cousin"},{"id":"t6","text":"Twenty"},{"id":"t7","text":"Look"}]},"explanation":"Câu đúng: \"Look at the map.\".","gradingRule":{"caseSensitive":false,"correctTokenIds":["t7","t4","t1","t2"],"ignoreDiacritics":false,"ignorePunctuation":false},"hint":"\"map\" = bản đồ","id":"u10n6l1-e13","prompt":{"locale":"vi-VN","text":"Dịch câu này: \"Hãy nhìn vào bản đồ.\""},"skillIds":["u10.grammar"],"type":"wordBank","vocabularyIds":["u10.map"]}],"gradingRulesVersion":"g1","guideText":"Mẫu câu chính: \"Excuse me, where is the bank?\" (Xin lỗi, ngân hàng ở đâu?) — \"Go straight and turn left.\" (Đi thẳng rồi rẽ trái.) — \"Is it far?\" (Có xa không?)\nChỉ đường dùng câu mệnh lệnh: Go straight. Turn right. Turn left at the corner.\nVị trí: on the left / on the right (bên trái / bên phải), next to (bên cạnh), opposite (đối diện), near (gần), on the corner (ở góc đường).\n\"Near\" không cần \"to\": \"near the school\" (không nói \"near to the school\" trong văn nói chuẩn A2).\nHỏi khoảng cách: \"Is it far from here?\" — Trả lời: \"No, you can walk.\" (Không, bạn có thể đi bộ.)","lessonId":"u10n6l1","lessonVersion":"v2.u10n6l1","manifestHash":"013672aa5927648264926e14d514d9d670ba04f547fc10aba6d50095b8e8b587","nodeId":"u10n6","order":77,"rewardIdentity":"v2.u10n6l1","schemaVersion":1,"sectionId":"sec2","signature":"KC732Ph3FS7ul4kGe44okY5t5QfIO7_FxgwG32o8YIr1_h6RjuyB6b7qc9o4x-QX9KAb5uKvprbpBRpD-VtXBw","signatureKeyId":"dev-content-1","skillIds":["u10.vocab","u10.grammar","listening"],"title":"Tôi bị lạc! · Bài 1","unitId":"u10"}