lanation":"Câu trả lời mẫu: \"No, it is easy.\". Cũng đúng: \"No, it's easy.\".","gradingRule":{"acceptedText":["No, it is easy.","No, it's easy."],"caseSensitive":false,"ignoreDiacritics":false,"ignorePunctuation":true},"hint":"Gợi ý trả lời: \"Không, nó dễ.\"","id":"u7n7l1-e08","nonSpeechAlternative":{"content":{"choices":[{"id":"c1","text":"No, it is easy."},{"id":"c2","text":"No, she is my cousin."},{"id":"c3","text":"I eat bread and eggs."}]},"explanation":"Câu trả lời mẫu: \"No, it is easy.\".","gradingRule":{"caseSensitive":false,"correctChoiceId":"c1","ignoreDiacritics":false,"ignorePunctuation":false},"hint":"Gợi ý trả lời: \"Không, nó dễ.\"","id":"u7n7l1-e08a","prompt":{"locale":"vi-VN","text":"\"Is English difficult?\" — chọn câu trả lời phù hợp"},"skillIds":["speaking","u7.dialogue"],"type":"choice","vocabularyIds":["u1.no","u7.english","u7.easy","u7.difficult"]},"prompt":{"audioAssetId":"a.u7.d4.n","locale":"en-US","text":"Is English difficult?"},"skillIds":["speaking","u7.dialogue"],"type":"dialogueTurn","vocabularyIds":["u1.no","u7.english","u7.easy","u7.difficult"]},{"content":{"choices":[{"id":"c1","text":"Please open your books."},{"id":"c2","text":"Please go home."},{"id":"c3","text":"Please close the door."}],"passage":"It is Monday. Mai, Nam and Tom are in English class. Mr. Long writes a question on the board: \"What do you do every day?\" Nam does not understand the question. \"Can you read it again, please?\" he asks. Mr. Long reads it again. Now Nam understands. He answers, \"I get up, I go to school and I study English!\" Everyone laughs. Then Mr. Long says, \"Please open your books. Today we learn ten new words.\" Tom thinks English is easy. Mai thinks it is a little difficult.","question":"What does Mr. Long say?"},"explanation":"Đáp án: \"Please open your books.\".","gradingRule":{"caseSensitive":false,"correctChoiceId":"c1","ignoreDiacritics":false,"ignorePunctuation":false},"hint":"Đọc lại câu chuyện \"Giờ học tiếng Anh\".","id":"u7n7l1-e09","prompt":{"locale":"en-US","text":"What does Mr. Long say?"},"skillIds":["reading","u7.story"],"type":"storyQuestion","vocabularyIds":[]},{"content":{"choices":[{"id":"c1","imageAssetId":"i.u5.night","text":"night"},{"id":"c2","imageAssetId":"i.u1.friend","text":"friend"},{"id":"c3","imageAssetId":"i.u7.class","text":"class"},{"id":"c4","imageAssetId":"i.u2.cat","text":"cat"}]},"explanation":"\"class\" = \"lớp\".","gradingRule":{"caseSensitive":false,"correctChoiceId":"c3","ignoreDiacritics":false,"ignorePunctuation":false},"hint":"\"lớp\" là \"class\".","id":"u7n7l1-e10","prompt":{"locale":"vi-VN","text":"Hình nào là \"lớp\"?"},"skillIds":["u7.vocab"],"type":"imageChoice","vocabularyIds":["u7.class"]},{"content":{"pairs":[{"id":"p1","left":{"id":"p1l","text":"listen"},"right":{"id":"p1r","text":"nghe"}},{"id":"p2","left":{"id":"p2l","text":"speak"},"right":{"id":"p2r","text":"nói"}},{"id":"p3","left":{"id":"p3l","text":"question"},"right":{"id":"p3r","text":"câu hỏi"}},{"id":"p4","left":{"id":"p4l","text":"write"},"right":{"id":"p4r","text":"viết"}},{"id":"p5","left":{"id":"p5l","text":"difficult"},"right":{"id":"p5r","text":"khó"}}]},"explanation":"listen = nghe; speak = nói; question = câu hỏi; write = viết; difficult = khó","gradingRule":{"caseSensitive":false,"correctPairIds":["p1","p2","p3","p4","p5"],"ignoreDiacritics":false,"ignorePunctuation":false},"hint":"Ví dụ: \"listen\" = \"nghe\".","id":"u7n7l1-e11","prompt":{"locale":"vi-VN","text":"Nối các cặp từ tương ứng"},"skillIds":["u7.vocab"],"type":"matchPairs","vocabularyIds":["u7.listen","u7.speak","u7.question","u7.write","u7.difficult"]},{"content":{"choices":[{"id":"c1","text":"hungry"},{"id":"c2","text":"house"},{"id":"c3","text":"can"},{"id":"c4","text":"home"}]},"explanation":"\"can\" = \"có thể\".","gradingRule":{"caseSensitive":false,"correctChoiceId":"c3","ignoreDiacritics":false,"ignorePunctuation":false},"hint":"\"can\" nghĩa là \"có thể\".","id":"u7n7l1-e12","prompt":{"locale":"vi-VN","text":"\"có thể\" trong tiếng Anh là gì?"},"skillIds":["u7.vocab"],"type":"choice","vocabularyIds":["u7.can"]},{"content":{"locale":"en-US","maxSeconds":6,"referenceText":"Please open your books."},"explanation":"Câu mẫu: \"Please open your books.\".","gradingRule":{"acceptedText":["Please open your books."],"caseSensitive":false,"ignoreDiacritics":false,"ignorePunctuation":true},"hint":"Nghĩa: \"Vui lòng mở sách ra.\"","id":"u7n7l1-e13","nonSpeechAlternative":{"content":{"tokens":[{"id":"t1","text":"open"},{"id":"t2","text":"books"},{"id":"t3","text":"your"},{"id":"t4","text":"Please"}]},"explanation":"Câu đúng: \"Please open your books.\".","gradingRule":{"caseSensitive":false,"correctTokenIds":["t4","t1","t3","t2"],"ignoreDiacritics":false,"ignorePunctuation":false},"hint":"Câu bắt đầu bằng \"Please\".","id":"u7n7l1-e13a","prompt":{"locale":"vi-VN","text":"Sắp xếp thành câu đúng: \"Vui lòng mở sách ra.\""},"skillIds":["speaking","u7.grammar"],"type":"sentenceOrder","vocabularyIds":["u1.please","u4.book","u7.open"]},"prompt":{"audioAssetId":"a.u7.s25.n","locale":"en-US","text":"Nói câu sau: \"Please open your books.\""},"skillIds":["speaking","u7.grammar"],"type":"speakRepeat","vocabularyIds":["u1.please","u4.book","u7.open"]},{"content":{"tokens":[{"id":"t1","text":"Bạn"},{"id":"t2","text":"trăm"},{"id":"t3","text":"tôi"},{"id":"t4","text":"không"},{"id":"t5","text":"Hãy"},{"id":"t6","text":"thể"},{"id":"t7","text":"có"},{"id":"t8","text":"giúp"},{"id":"t9","text":"cảm"},{"id":"t10","text":"ngày"}]},"explanation":"Câu đúng: \"Bạn có thể giúp tôi không?\".","gradingRule":{"caseSensitive":false,"correctTokenIds":["t1","t7","t6","t8","t3","t4"],"ignoreDiacritics":false,"ignorePunctuation":false},"hint":"\"can\" = có thể","id":"u7n7l1-e14","prompt":{"locale":"vi-VN","text":"Dịch sang tiếng Việt: \"Can you help me?\""},"skillIds":["u7.grammar"],"type":"wordBank","vocabularyIds":["u7.can"]},{"content":{"maxChars":200,"placeholder":"Viết bằng tiếng Anh"},"explanation":"Đáp án: \"Please write your name.\".","gradingRule":{"acceptedText":["Please write your name."],"caseSensitive":false,"ignoreDiacritics":false,"ignorePunctuation":true},"hint":"\"name\" = tên; \"please\" = làm ơn; \"write\" = viết","id":"u7n7l1-e15","prompt":{"locale":"vi-VN","text":"Vui lòng viết tên của bạn."},"skillIds":["u7.grammar"],"type":"textTranslation","vocabularyIds":["u1.name","u1.please","u7.write"]}],"gradingRulesVersion":"g1","guideText":"Mẫu câu chính: \"Can you help me?\" (Bạn có thể giúp tôi không?) — \"I do not understand.\" (Tôi không hiểu.) — \"Please open your books.\" (Hãy mở sách ra.)\n\"Can\" + động từ nguyên mẫu (không thêm -s, không \"to\"): \"She can speak English\", không nói \"She cans speaks\".\nCâu mệnh lệnh: bắt đầu bằng động từ: \"Open the window.\" Thêm \"please\" cho lịch sự.\nCâu hỏi \"What does this word mean?\" — dùng khi gặp từ mới. Trả lời: \"It means ...\".\nHọc sinh Việt hay nhầm: \"learn\" (học, tiếp thu) và \"study\" (học bài, nghiên cứu) — cả hai đều dịch là \"học\".","lessonId":"u7n7l1","lessonVersion":"v2.u7n7l1","manifestHash":"013672aa5927648264926e14d514d9d670ba04f547fc10aba6d50095b8e8b587","nodeId":"u7n7","order":54,"rewardIdentity":"v2.u7n7l1","schemaVersion":1,"sectionId":"sec1","signature":"OGfoXNz0FeCC-dqIIm9WkjRe75w28Tv8bHTdbqYM6v0PRKDDCIAvhdcOm4QUxz_IJ9PsXRKh5rpM_b5xf9f-Cw","signatureKeyId":"dev-content-1","skillIds":["u7.grammar","listening","speaking","u7.dialogue","reading","u7.story","u7.vocab"],"title":"Ôn tập cửa ải · Bài 1","unitId":"u7"}