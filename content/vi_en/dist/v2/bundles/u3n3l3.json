":{"acceptedText":["Do you have milk?"],"caseSensitive":false,"ignoreDiacritics":false,"ignorePunctuation":true},"hint":"\"have\" = có; \"milk\" = sữa","id":"u3n3l3-e12a","prompt":{"locale":"vi-VN","text":"Bạn có sữa không?"},"skillIds":["listening","u3.grammar"],"type":"textTranslation","vocabularyIds":["u2.have","u3.milk"]},"prompt":{"audioAssetId":"a.u3.s12.n","locale":"vi-VN","text":"Nghe và viết lại bằng tiếng Anh"},"skillIds":["listening","u3.grammar"],"type":"dictation","vocabularyIds":["u2.have","u3.milk"]}],"gradingRulesVersion":"g1","guideText":"Mẫu câu chính: \"Water, please.\" (Cho tôi nước.) — \"I like tea.\" (Tôi thích trà.) — \"Do you want coffee?\" (Bạn có muốn cà phê không?)\nMạo từ: \"a\" trước phụ âm (a banana), \"an\" trước nguyên âm (an apple, an egg).\nThì hiện tại đơn: he/she thêm -s: \"Kiko likes fish.\" Câu phủ định dùng do not / does not: \"Tom does not like coffee.\" (hay: doesn't).\nLịch sự khi gọi món: thêm \"please\" ở cuối câu. \"I want ...\" hơi thẳng; dùng \"..., please\" khi nói với người phục vụ.\nBữa ăn: breakfast (bữa sáng), lunch (bữa trưa), dinner (bữa tối) — nói \"for breakfast\" (cho bữa sáng).","lessonId":"u3n3l3","lessonVersion":"v2.u3n3l3","manifestHash":"013672aa5927648264926e14d514d9d670ba04f547fc10aba6d50095b8e8b587","nodeId":"u3n3","order":18,"rewardIdentity":"v2.u3n3l3","schemaVersion":1,"sectionId":"sec1","signature":"CQeizmMoKSJukwNCcR559CMU_ikF-uRlsjouoQL6FHcBM17DDRSLAQ4fI_OzAXAw_mhrOzVmf2-tD2pekPALCg","signatureKeyId":"dev-content-1","skillIds":["listening","u3.grammar","u3.vocab"],"title":"Tôi thích, tôi muốn · Bài 3","unitId":"u3"}