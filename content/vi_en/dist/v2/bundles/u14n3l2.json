houldn't) + động từ nguyên mẫu: \"You should eat more vegetables.\"\nSố nhiều bất quy tắc: one tooth → two teeth.","lessonId":"u14n3l2","lessonVersion":"v2.u14n3l2","manifestHash":"013672aa5927648264926e14d514d9d670ba04f547fc10aba6d50095b8e8b587","nodeId":"u14n3","order":106,"rewardIdentity":"v2.u14n3l2","schemaVersion":1,"sectionId":"sec2","signature":"Ei24DvyNSNwxj8-DQtW2noyGOmKIVGFZvMMy6hY5_lbP_P4GLvE3cne-uQsZN82d68DMV3nkyz1ZjuxlkOlhCw","signatureKeyId":"dev-content-1","skillIds":["u14.vocab","u14.grammar","listening"],"title":"Bạn nên... · Bài 2","unitId":"u14"}