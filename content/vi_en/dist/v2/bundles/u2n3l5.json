ening","u2.grammar"],"type":"textTranslation","vocabularyIds":["u2.husband"]},"prompt":{"audioAssetId":"a.u2.s15.n","locale":"vi-VN","text":"Nghe và viết lại bằng tiếng Anh"},"skillIds":["listening","u2.grammar"],"type":"dictation","vocabularyIds":["u2.husband"]},{"content":{"tokens":[{"id":"t1","text":"nice"},{"id":"t2","text":"Is"},{"id":"t3","text":"Nam"},{"id":"t4","text":"your"},{"id":"t5","text":"he"},{"id":"t6","text":"good"},{"id":"t7","text":"brother"}]},"explanation":"Câu đúng: \"Is he your brother?\".","gradingRule":{"caseSensitive":false,"correctTokenIds":["t2","t5","t4","t7"],"ignoreDiacritics":false,"ignorePunctuation":false},"hint":"\"brother\" = anh trai","id":"u2n3l5-e11","prompt":{"locale":"vi-VN","text":"Dịch câu này: \"Anh ấy là anh trai bạn à?\""},"skillIds":["u2.grammar"],"type":"wordBank","vocabularyIds":["u2.brother"]},{"content":{"maxChars":200,"placeholder":"Viết bằng tiếng Anh"},"explanation":"Đáp án: \"The baby is my sister.\".","gradingRule":{"acceptedText":["The baby is my sister."],"caseSensitive":false,"ignoreDiacritics":false,"ignorePunctuation":true},"hint":"\"sister\" = chị gái; \"baby\" = em bé","id":"u2n3l5-e12","prompt":{"locale":"vi-VN","text":"Em bé là em gái tôi."},"skillIds":["u2.grammar"],"type":"textTranslation","vocabularyIds":["u2.sister","u2.baby"]}],"gradingRulesVersion":"g1","guideText":"Mẫu câu chính: \"This is my mother.\" (Đây là mẹ tôi.) — \"I have a brother.\" (Tôi có một anh/em trai.)\nTính từ sở hữu: my (của tôi), your (của bạn), his (của anh ấy), her (của cô ấy), their (của họ). Đặt TRƯỚC danh từ: \"my father\", không nói \"father my\".\nĐộng từ \"have\": I/you/we/they have — he/she has. \"Mai has a cat.\"\nLưu ý: tiếng Anh không phân biệt anh/em: \"brother\" = anh trai hoặc em trai, \"sister\" = chị gái hoặc em gái. \"Aunt/uncle\" gồm cả cô, dì, chú, cậu, bác.","lessonId":"u2n3l5","lessonVersion":"v2.u2n3l5","manifestHash":"013672aa5927648264926e14d514d9d670ba04f547fc10aba6d50095b8e8b587","nodeId":"u2n3","order":10,"rewardIdentity":"v2.u2n3l5","schemaVersion":1,"sectionId":"sec1","signature":"NobjXUxMXBu6GU3On3Me7z-GiyuLKILjDZGfLLRv9Qo_X6A_kH30yRRHZJopEUKGz4untsQdUyYG1R27qpwcAQ","signatureKeyId":"dev-content-1","skillIds":["u2.vocab","u2.grammar","listening"],"title":"Vợ chồng, con cái · Bài 5","unitId":"u2"}