ation":false},"hint":"Câu bắt đầu bằng \"Good\".","id":"u5n5l4-e11a","prompt":{"locale":"vi-VN","text":"Sắp xếp thành câu đúng: \"Chúc mẹ ngủ ngon.\""},"skillIds":["speaking","u5.grammar"],"type":"sentenceOrder","vocabularyIds":["u1.good","u2.mother","u5.night"]},"prompt":{"audioAssetId":"a.u5.s16.n","locale":"en-US","text":"Nói câu sau: \"Good night, Mom.\""},"skillIds":["speaking","u5.grammar"],"type":"speakRepeat","vocabularyIds":["u1.good","u2.mother","u5.night"]},{"content":{"maxChars":200,"placeholder":"Viết bằng tiếng Việt (có dấu)"},"explanation":"Đáp án: \"Tôi đi học mỗi ngày.\". Cũng đúng: \"Ngày nào tôi cũng đi học.\", \"Tôi đến trường mỗi ngày.\".","gradingRule":{"acceptedText":["Tôi đi học mỗi ngày.","Ngày nào tôi cũng đi học.","Tôi đến trường mỗi ngày.","Mình đi học mỗi ngày.","Ngày nào mình cũng đi học.","Mình đến trường mỗi ngày."],"caseSensitive":false,"ignoreDiacritics":false,"ignorePunctuation":true},"hint":"\"day\" = ngày; \"go\" = đi; \"school\" = trường; \"every\" = mỗi","id":"u5n5l4-e12","prompt":{"locale":"en-US","text":"I go to school every day."},"skillIds":["u5.grammar"],"type":"textTranslation","vocabularyIds":["u5.day","u5.go","u5.school","u5.every"]}],"gradingRulesVersion":"g1","guideText":"Mẫu câu chính: \"What time is it?\" (Mấy giờ rồi?) — \"It is seven o'clock.\" (Bảy giờ rồi.) — \"I get up at six.\" (Tôi dậy lúc sáu giờ.)\nGiới từ thời gian: at + giờ (at six o'clock), on + thứ (on Monday), in + buổi (in the morning, in the evening).\nThì hiện tại đơn cho thói quen: \"Mai goes to school every day.\" Với he/she/it: go → goes, get up → gets up.\nTrạng từ tần suất đứng TRƯỚC động từ thường: \"I always eat breakfast\", \"Kiko never eats bread\". Thứ tự: always > usually > sometimes > never.\nThứ trong tuần luôn viết hoa: Monday, Sunday.","lessonId":"u5n5l4","lessonVersion":"v2.u5n5l4","manifestHash":"013672aa5927648264926e14d514d9d670ba04f547fc10aba6d50095b8e8b587","nodeId":"u5n5","order":36,"rewardIdentity":"v2.u5n5l4","schemaVersion":1,"sectionId":"sec1","signature":"4-4eFNGr0QfK5QnGptwW6VmBAb_Oe00ilNtojxXZLp8M8-STd4RyLb-NrfHhmEIt1sMYUywNpbnNRBhA6GqNAA","signatureKeyId":"dev-content-1","skillIds":["speaking","u5.grammar","u5.dialogue","u5.vocab"],"title":"Các ngày trong tuần · Bài 4","unitId":"u5"}