":["I want new shoes."],"caseSensitive":false,"ignoreDiacritics":false,"ignorePunctuation":true},"hint":"\"want\" = muốn; \"new\" = mới; \"shoes\" = giày","id":"u9n2l2-e10a","prompt":{"locale":"vi-VN","text":"Tôi muốn đôi giày mới."},"skillIds":["listening","u9.grammar"],"type":"textTranslation","vocabularyIds":["u3.want","u6.new","u9.shoes"]},"prompt":{"audioAssetId":"a.u9.s8.n","locale":"vi-VN","text":"Nghe và viết lại bằng tiếng Anh"},"skillIds":["listening","u9.grammar"],"type":"dictation","vocabularyIds":["u3.want","u6.new","u9.shoes"]},{"content":{"tokens":[{"id":"t1","text":"Mr"},{"id":"t2","text":"for"},{"id":"t3","text":"to"},{"id":"t4","text":"buy"},{"id":"t5","text":"I"},{"id":"t6","text":"windows"},{"id":"t7","text":"want"},{"id":"t8","text":"bread"}]},"explanation":"Câu đúng: \"I want to buy bread.\".","gradingRule":{"caseSensitive":false,"correctTokenIds":["t5","t7","t3","t4","t8"],"ignoreDiacritics":false,"ignorePunctuation":false},"hint":"\"bread\" = bánh mì; \"want\" = muốn; \"buy\" = mua","id":"u9n2l2-e11","prompt":{"locale":"vi-VN","text":"Dịch câu này: \"Tôi muốn mua bánh mì.\""},"skillIds":["u9.grammar"],"type":"wordBank","vocabularyIds":["u3.bread","u3.want","u9.buy"]},{"content":{"maxChars":200,"placeholder":"Viết bằng tiếng Anh"},"explanation":"Đáp án: \"Mai goes shopping on Sunday.\".","gradingRule":{"acceptedText":["Mai goes shopping on Sunday."],"caseSensitive":false,"ignoreDiacritics":false,"ignorePunctuation":true},"hint":"\"go\" = đi; \"Sunday\" = Chủ nhật; \"shop\" = cửa hàng","id":"u9n2l2-e12","prompt":{"locale":"vi-VN","text":"Mai đi mua sắm vào Chủ nhật."},"skillIds":["u9.grammar"],"type":"textTranslation","vocabularyIds":["u5.go","u5.sunday","u9.shop"]}],"gradingRulesVersion":"g1","guideText":"Mẫu câu chính: \"How much is this dress?\" (Cái váy này bao nhiêu tiền?) — \"Can I pay by card?\" (Tôi trả bằng thẻ được không?) — \"It is on sale.\" (Nó đang giảm giá.)\nHow much is + số ít / How much are + số nhiều: \"How much are the shoes