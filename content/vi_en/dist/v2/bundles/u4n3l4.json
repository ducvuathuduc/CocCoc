has"},{"id":"t4","text":"cousins"}]},"explanation":"Câu đúng: \"Mai has three cousins.\".","gradingRule":{"caseSensitive":false,"correctTokenIds":["t2","t3","t1","t4"],"ignoreDiacritics":false,"ignorePunctuation":false},"hint":"Câu bắt đầu bằng \"Mai\".","id":"u4n3l4-e11a","prompt":{"locale":"vi-VN","text":"Sắp xếp thành câu đúng: \"Mai có ba người anh em họ.\""},"skillIds":["speaking","u4.grammar"],"type":"sentenceOrder","vocabularyIds":["u2.have","u2.cousin","u4.three"]},"prompt":{"audioAssetId":"a.u4.s6.n","locale":"en-US","text":"Nói câu sau: \"Mai has three cousins.\""},"skillIds":["speaking","u4.grammar"],"type":"speakRepeat","vocabularyIds":["u2.have","u2.cousin","u4.three"]},{"content":{"maxChars":200,"placeholder":"Viết bằng tiếng Việt (có dấu)"},"explanation":"Đáp án: \"Năm cộng hai là bảy.\". Cũng đúng: \"Năm cộng hai bằng bảy.\".","gradingRule":{"acceptedText":["Năm cộng hai là bảy.","Năm cộng hai bằng bảy."],"caseSensitive":false,"ignoreDiacritics":false,"ignorePunctuation":true},"hint":"\"two\" = hai; \"five\" = năm (số 5); \"seven\" = bảy","id":"u4n3l4-e12","prompt":{"locale":"en-US","text":"Five and two is seven."},"skillIds":["u4.grammar"],"type":"textTranslation","vocabularyIds":["u4.two","u4.five","u4.seven"]}],"gradingRulesVersion":"g1","guideText":"Mẫu câu chính: \"How old are you?\" (Bạn bao nhiêu tuổi?) — \"I am twenty years old.\" (Tôi hai mươi tuổi.) — \"How many books do you have?\" (Bạn có bao nhiêu quyển sách?)\nSố nhiều: thêm -s sau danh từ khi nhiều hơn một: one cat, two cats; one egg, six eggs. Tiếng Việt không đổi danh từ, nhưng tiếng Anh thì có.\nTuổi: dùng \"be\", không dùng \"have\": \"I am ten years old\" hoặc ngắn gọn \"I am ten\". Không nói \"I have ten years\".\nSố: 20 = twenty, 28 = twenty-eight (có gạch nối), 100 = a hundred / one hundred.\n\"How many + danh từ số nhiều\": How many pens? How many cats?","lessonId":"u4n3l4","lessonVersion":"v2.u4n3l4","manifestHash":"013672aa5927648264926e14d514d9d670ba04f547fc10aba6d50095b8e8