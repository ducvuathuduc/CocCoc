 Anh thì không.\nLịch sự: \"Excuse me\" dùng để bắt chuyện, \"Sorry\" dùng khi xin lỗi vì lỗi của mình.","lessonId":"u1n5l1","lessonVersion":"v2.u1n5l1","manifestHash":"013672aa5927648264926e14d514d9d670ba04f547fc10aba6d50095b8e8b587","nodeId":"u1n5","order":4,"rewardIdentity":"v2.u1n5l1","schemaVersion":1,"sectionId":"sec1","signature":"0tu30sSxBJYHFWeCpwEZQTRs90wF75YgVuesUTaea3CZ9fYTvwQaarV5dodMHOP-t9GoOPqp0GGEQbHbl012Aw","signatureKeyId":"dev-content-1","skillIds":["u1.vocab","u1.grammar","listening"],"title":"Rất vui được gặp bạn · Bài 1","unitId":"u1"}