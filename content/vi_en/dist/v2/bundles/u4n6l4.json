câu sau: \"There are ten books in my bag.\""},"skillIds":["speaking","u4.grammar"],"type":"speakRepeat","vocabularyIds":["u4.ten","u4.book","u4.bag"]},{"content":{"maxChars":200,"placeholder":"Viết bằng tiếng Anh"},"explanation":"Đáp án: \"How many cats does she have?\".","gradingRule":{"acceptedText":["How many cats does she have?"],"caseSensitive":false,"ignoreDiacritics":false,"ignorePunctuation":true},"hint":"\"have\" = có; \"cat\" = con mèo; \"many\" = nhiều","id":"u4n6l4-e09","prompt":{"locale":"vi-VN","text":"Cô ấy có bao nhiêu con mèo?"},"skillIds":["u4.grammar"],"type":"textTranslation","vocabularyIds":["u2.have","u2.cat","u4.many"]},{"content":{"tokens":[{"id":"t1","text":"have"},{"id":"t2","text":"How"},{"id":"t3","text":"do"},{"id":"t4","text":"pens"},{"id":"t5","text":"you"},{"id":"t6","text":"many"}]},"explanation":"Câu đúng: \"How many pens do you have?\".","gradingRule":{"caseSensitive":false,"correctTokenIds":["t2","t6","t4","t3","t5","t1"],"ignoreDiacritics":false,"ignorePunctuation":false},"hint":"Câu bắt đầu bằng \"How\".","id":"u4n6l4-e10","prompt":{"locale":"vi-VN","text":"Sắp xếp thành câu đúng: \"Bạn có bao nhiêu cây bút?\""},"skillIds":["u4.grammar"],"type":"sentenceOrder","vocabularyIds":["u2.have","u4.pen","u4.many"]},{"content":{"locale":"en-US","maxSeconds":6,"referenceText":"Mai has three cousins."},"explanation":"Câu mẫu: \"Mai has three cousins.\".","gradingRule":{"acceptedText":["Mai has three cousins."],"caseSensitive":false,"ignoreDiacritics":false,"ignorePunctuation":true},"hint":"Nghĩa: \"Mai có ba người anh em họ.\"","id":"u4n6l4-e11","nonSpeechAlternative":{"content":{"tokens":[{"id":"t1","text":"three"},{"id":"t2","text":"Mai"},{"id":"t3","text":"cousins"},{"id":"t4","text":"has"}]},"explanation":"Câu đúng: \"Mai has three cousins.\".","gradingRule":{"caseSensitive":false,"correctTokenIds":["t2","t4","t1","t3"],"ignoreDiacritics":false,"ignorePunctuation":false},"hint":"Câu bắt đầu bằng \"Mai\".","id":"u4n6l4-e11a","prompt":{"locale":"vi-VN","text":"Sắp xếp thành câu đúng: \"Mai có ba người anh em họ.\""},"skillIds":["speaking","u4.grammar"],"type":"sentenceOrder","vocabularyIds":["u2.have","u2.cousin","u4.three"]},"prompt":{"audioAssetId":"a.u4.s6.n","locale":"en-US","text":"Nói câu sau: \"Mai has three cousins.\""},"skillIds":["speaking","u4.grammar"],"type":"speakRepeat","vocabularyIds":["u2.have","u2.cousin","u4.three"]},{"content":{"maxChars":200,"placeholder":"Viết bằng tiếng Việt (có dấu)"},"explanation":"Đáp án: \"Chúng tôi có bốn quả trứng.\". Cũng đúng: \"Chúng ta có bốn quả trứng.\", \"Chúng mình có bốn quả trứng.\".","gradingRule":{"acceptedText":["Chúng tôi có bốn quả trứng.","Chúng ta có bốn quả trứng.","Chúng mình có bốn quả trứng."],"caseSensitive":false,"ignoreDiacritics":false,"ignorePunctuation":true},"hint":"\"have\" = có; \"egg\" = trứng; \"four\" = bốn","id":"u4n6l4-e12","prompt":{"locale":"en-US","text":"We have four eggs."},"skillIds":["u4.grammar"],"type":"textTranslation","vocabularyIds":["u2.have","u3.egg","u4.four"]}],"gradingRulesVersion":"g1","guideText":"Mẫu câu chính: \"How old are you?\" (Bạn bao nhiêu tuổi?) — \"I am twenty years old.\" (Tôi hai mươi tuổi.) — \"How many books do you have?\" (Bạn có bao nhiêu quyển sách?)\nSố nhiều: thêm -s sau danh từ khi nhiều hơn một: one cat, two cats; one egg, six eggs. Tiếng Việt không đổi danh từ, nhưng tiếng Anh thì có.\nTuổi: dùng \"be\", không dùng \"have\": \"I am ten years old\" hoặc ngắn gọn \"I am ten\". Không nói \"I have ten years\".\nSố: 20 = twenty, 28 = twenty-eight (có gạch nối), 100 = a hundred / one hundred.\n\"How many + danh từ số nhiều\": How many pens? How many cats?","lessonId":"u4n6l4","lessonVersion":"v2.u4n6l4","manifestHash":"013672aa5927648264926e14d514d9d670ba04f547fc10aba6d50095b8e8b587","nodeId":"u4n6","order":29,"rewardIdentity":"v2.u4n6l4","schemaVersion":1,"sectionId":"sec1","signature":"-ZhdKssEd70mQ0TQsb69MUBC4aHZGMnb8i85NjJr6UodoXAqivxE2ikomOSf74sMCrM7RBvaliSJr9AFAxalCg","signature