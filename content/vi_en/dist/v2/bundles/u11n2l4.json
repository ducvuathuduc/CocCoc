dingRule":{"caseSensitive":false,"correctTokenIds":["t2","t4","t1","t3"],"ignoreDiacritics":false,"ignorePunctuation":false},"hint":"Câu bắt đầu bằng \"I\".","id":"u11n2l4-e11a","prompt":{"locale":"vi-VN","text":"Sắp xếp thành câu đúng: \"Tôi thích đi du lịch.\""},"skillIds":["speaking","u11.grammar"],"type":"sentenceOrder","vocabularyIds":["u2.love","u11.travel"]},"prompt":{"audioAssetId":"a.u11.s1.n","locale":"en-US","text":"Nói câu sau: \"I love to travel.\""},"skillIds":["speaking","u11.grammar"],"type":"speakRepeat","vocabularyIds":["u2.love","u11.travel"]},{"content":{"maxChars":200,"placeholder":"Viết bằng tiếng Việt (có dấu)"},"explanation":"Đáp án: \"Máy bay to.\". Cũng đúng: \"Máy bay lớn.\".","gradingRule":{"acceptedText":["Máy bay to.","Máy bay lớn."],"caseSensitive":false,"ignoreDiacritics":false,"ignorePunctuation":true},"hint":"\"big\" = to; \"plane\" = máy bay","id":"u11n2l4-e12","prompt":{"locale":"en-US","text":"The plane is big."},"skillIds":["u11.grammar"],"type":"textTranslation","vocabularyIds":["u6.big","u11.plane"]}],"gradingRulesVersion":"g1","guideText":"Mẫu câu chính: \"I want to visit Hanoi.\" (Tôi muốn đi thăm Hà Nội.) — \"When does the train leave?\" (Khi nào tàu chạy?) — \"Can I have a ticket, please?\" (Cho tôi một vé.)\nPhương tiện: by plane, by train, by bus, by taxi (không có \"the\"). Hoặc: take the bus / take a taxi.\nLịch trình dùng hiện tại đơn: \"The train leaves at six.\" \"The plane arrives at nine o'clock.\"\n\"Arrive at\" + địa điểm nhỏ (at the airport), \"arrive in\" + thành phố/quốc gia (arrive in Da Nang).\n\"Visit\" + nơi chốn/người, không cần giới từ: \"visit my grandmother\", không nói \"visit to\".","lessonId":"u11n2l4","lessonVersion":"v2.u11n2l4","manifestHash":"013672aa5927648264926e14d514d9d670ba04f547fc10aba6d50095b8e8b587","nodeId":"u11n2","order":81,"rewardIdentity":"v2.u11n2l4","schemaVersion":1,"sectionId":"sec2","signature":"7vmbGw2z5cMmvr-S4Wpmz7Di5SyHd0EHKFVDR1hTVdewR7-tIEP4i6JSQUD0WDU9D_79701jLOGnvwyMWP