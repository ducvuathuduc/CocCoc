","t7","t5"],"ignoreDiacritics":false,"ignorePunctuation":false},"hint":"\"want\" = muốn; \"new\" = mới; \"shoes\" = giày","id":"u9n3l1-e13","prompt":{"locale":"vi-VN","text":"Dịch câu này: \"Tôi muốn đôi giày mới.\""},"skillIds":["u9.grammar"],"type":"wordBank","vocabularyIds":["u3.want","u6.new","u9.shoes"]}],"gradingRulesVersion":"g1","guideText":"Mẫu câu chính: \"How much is this dress?\" (Cái váy này bao nhiêu tiền?) — \"Can I pay by card?\" (Tôi trả bằng thẻ được không?) — \"It is on sale.\" (Nó đang giảm giá.)\nHow much is + số ít / How much are + số nhiều: \"How much are the shoes?\"\n\"Shoes\" luôn ở dạng số nhiều (một đôi giày = a pair of shoes).\nMàu sắc đứng trước danh từ: \"a red dress\" (một cái váy đỏ). Hỏi màu: \"What color is it?\"\nTrả tiền: pay in cash (tiền mặt) / pay by card (bằng thẻ). \"Expensive\" (đắt) ↔ \"cheap\" (rẻ).","lessonId":"u9n3l1","lessonVersion":"v2.u9n3l1","manifestHash":"013672aa5927648264926e14d514d9d670ba04f547fc10aba6d50095b8e8b587","nodeId":"u9n3","order":66,"rewardIdentity":"v2.u9n3l1","schemaVersion":1,"sectionId":"sec2","signature":"xTsgqq25JnWyxNr5vCwXKJX9qqzG2rVWbnDp5xM9IwN1sgr1qfUlXKVnQdInrXcf5NAY-BzTz5XRj7CXahVACg","signatureKeyId":"dev-content-1","skillIds":["u9.vocab","u9.grammar","listening"],"title":"Màu sắc · Bài 1","unitId":"u9"}