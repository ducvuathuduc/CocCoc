\" = câu","id":"u7n5l2-e10a","prompt":{"locale":"vi-VN","text":"Vui lòng đọc câu này."},"skillIds":["listening","u7.grammar"],"type":"textTranslation","vocabularyIds":["u1.please","u7.read","u7.sentence"]},"prompt":{"audioAssetId":"a.u7.s22.n","locale":"vi-VN","text":"Nghe và viết lại bằng tiếng Anh"},"skillIds":["listening","u7.grammar"],"type":"dictation","vocabularyIds":["u1.please","u7.read","u7.sentence"]},{"content":{"tokens":[{"id":"t1","text":"help"},{"id":"t2","text":"Can"},{"id":"t3","text":"twenty-eight"},{"id":"t4","text":"Excuse"},{"id":"t5","text":"fifth"},{"id":"t6","text":"me"},{"id":"t7","text":"you"}]},"explanation":"Câu đúng: \"Can you help me?\".","gradingRule":{"caseSensitive":false,"correctTokenIds":["t2","t7","t1","t6"],"ignoreDiacritics":false,"ignorePunctuation":false},"hint":"\"can\" = có thể","id":"u7n5l2-e11","prompt":{"locale":"vi-VN","text":"Dịch câu này: \"Bạn có thể giúp tôi không?\""},"skillIds":["u7.grammar"],"type":"wordBank","vocabularyIds":["u7.can"]},{"content":{"maxChars":200,"placeholder":"Viết bằng tiếng Anh"},"explanation":"Đáp án: \"I have a question.\".","gradingRule":{"acceptedText":["I have a question."],"caseSensitive":false,"ignoreDiacritics":false,"ignorePunctuation":true},"hint":"\"have\" = có; \"question\" = câu hỏi","id":"u7n5l2-e12","prompt":{"locale":"vi-VN","text":"Tôi có một câu hỏi."},"skillIds":["u7.grammar"],"type":"textTranslation","vocabularyIds":["u2.have","u7.question"]}],"gradingRulesVersion":"g1","guideText":"Mẫu câu chính: \"Can you help me?\" (Bạn có thể giúp tôi không?) — \"I do not understand.\" (Tôi không hiểu.) — \"Please open your books.\" (Hãy mở sách ra.)\n\"Can\" + động từ nguyên mẫu (không thêm -s, không \"to\"): \"She can speak English\", không nói \"She cans speaks\".\nCâu mệnh lệnh: bắt đầu bằng động từ: \"Open the window.\" Thêm \"please\" cho lịch sự.\nCâu hỏi \"What does this word mean?\" — dùng khi gặp từ mới. Trả lời: \"It means ...\".\nHọc sinh Việt hay nhầm: \"learn\" (học, tiếp thu) và \"study\" (học bài, nghiên cứu) — cả hai đều dịch là \"học\".","lessonId":"u7n5l2","lessonVersion":"v2.u7n5l2","manifestHash":"013672aa5927648264926e14d514d9d670ba04f547fc10aba6d50095b8e8b587","nodeId":"u7n5","order":52,"rewardIdentity":"v2.u7n5l2","schemaVersion":1,"sectionId":"sec1","signature":"7dN9-nfRdYRECdas8nuh0c5Ke_FZBn9-VAA-8WMohDYQWcPgJNGfVsOJ5DGYBYphmGaP5mTEmp1R4iZqA5p3Cw","signatureKeyId":"dev-content-1","skillIds":["u7.vocab","u7.grammar","listening"],"title":"Dễ hay khó? · Bài 2","unitId":"u7"}