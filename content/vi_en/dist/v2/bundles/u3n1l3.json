lanation":"Bạn nghe: \"Where are you from?\".","gradingRule":{"acceptedText":["Where are you from?"],"caseSensitive":false,"ignoreDiacritics":false,"ignorePunctuation":true},"hint":"Câu có 4 từ. Nghĩa: \"Bạn đến từ đâu?\"","id":"u3n1l3-e12","nonAudioAlternative":{"content":{"maxChars":200,"placeholder":"Viết bằng tiếng Anh"},"explanation":"Đáp án: \"Where are you from?\".","gradingRule":{"acceptedText":["Where are you from?"],"caseSensitive":false,"ignoreDiacritics":false,"ignorePunctuation":true},"hint":"\"from\" = từ; \"where\" = ở đâu","id":"u3n1l3-e12a","prompt":{"locale":"vi-VN","text":"Bạn đến từ đâu?"},"skillIds":["listening","u3.grammar"],"type":"textTranslation","vocabularyIds":["u1.from","u1.where"]},"prompt":{"audioAssetId":"a.u1.s28.n","locale":"vi-VN","text":"Nghe và viết lại bằng tiếng Anh"},"skillIds":["listening","u3.grammar"],"type":"dictation","vocabularyIds":["u1.from","u1.where"]}],"gradingRulesVersion":"g1","guideText":"Mẫu câu chính: \"Water, please.\" (Cho tôi nước.) — \"I like tea.\" (Tôi thích trà.) — \"Do you want coffee?\" (Bạn có muốn cà phê không?)\nMạo từ: \"a\" trước phụ âm (a banana), \"an\" trước nguyên âm (an apple, an egg).\nThì hiện tại đơn: he/she thêm -s: \"Kiko likes fish.\" Câu phủ định dùng do not / does not: \"Tom does not like coffee.\" (hay: doesn't).\nLịch sự khi gọi món: thêm \"please\" ở cuối câu. \"I want ...\" hơi thẳng; dùng \"..., please\" khi nói với người phục vụ.\nBữa ăn: breakfast (bữa sáng), lunch (bữa trưa), dinner (bữa tối) — nói \"for breakfast\" (cho bữa sáng).","lessonId":"u3n1l3","lessonVersion":"v2.u3n1l3","manifestHash":"013672aa5927648264926e14d514d9d670ba04f547fc10aba6d50095b8e8b587","nodeId":"u3n1","order":16,"rewardIdentity":"v2.u3n1l3","schemaVersion":1,"sectionId":"sec1","signature":"xy0WNTXxwZKIApNDBssy7QrZMVUFEIAjilPhx3U_POwQ2HUB5a4J9Ye45OW6JTV1nRM1G3Xe3tWFcRY8vCu7CQ","signatureKeyId":"dev-content-1","skillIds":["listening","u3.grammar","u3.vocab"],"title":"Cơm và bánh mì · Bài 3","unitId":"u3"}