t3","text":"school"},{"id":"t4","text":"take"},{"id":"t5","text":"We"},{"id":"t6","text":"the"}]},"explanation":"Câu đúng: \"We take the bus to school.\".","gradingRule":{"caseSensitive":false,"correctTokenIds":["t5","t4","t6","t2","t1","t3"],"ignoreDiacritics":false,"ignorePunctuation":false},"hint":"Câu bắt đầu bằng \"We\".","id":"u12n1l4-e11a","prompt":{"locale":"vi-VN","text":"Sắp xếp thành câu đúng: \"Chúng tôi đi xe buýt đến trường.\""},"skillIds":["speaking","u12.grammar"],"type":"sentenceOrder","vocabularyIds":["u5.school","u11.bus"]},"prompt":{"audioAssetId":"a.u11.s7.n","locale":"en-US","text":"Nói câu sau: \"We take the bus to school.\""},"skillIds":["speaking","u12.grammar"],"type":"speakRepeat","vocabularyIds":["u5.school","u11.bus"]},{"content":{"maxChars":200,"placeholder":"Viết bằng tiếng Việt (có dấu)"},"explanation":"Đáp án: \"Bệnh viện ở đâu?\".","gradingRule":{"acceptedText":["Bệnh viện ở đâu?"],"caseSensitive":false,"ignoreDiacritics":false,"ignorePunctuation":true},"hint":"\"where\" = ở đâu; \"hospital\" = bệnh viện","id":"u12n1l4-e12","prompt":{"locale":"en-US","text":"Where is the hospital?"},"skillIds":["u12.grammar"],"type":"textTranslation","vocabularyIds":["u1.where","u10.hospital"]}],"gradingRulesVersion":"g1","guideText":"Mẫu câu chính: \"What do you do?\" (Bạn làm nghề gì?) — \"I am an engineer.\" (Tôi là kỹ sư.) — \"I worked late yesterday.\" (Hôm qua tôi làm việc muộn.)\nNghề nghiệp luôn có a/an: \"She is a nurse\", \"He is an engineer\" (an trước nguyên âm).\nThì quá khứ đơn (động từ có quy tắc): thêm -ed: work → worked, start → started, finish → finished. Quá khứ của \"be\": I/he/she was, you/we/they were.\nCâu hỏi quá khứ dùng \"did\" + động từ nguyên mẫu: \"Did you finish your work?\" (không nói \"Did you finished\").\nMốc thời gian quá khứ: yesterday (hôm qua), last week (tuần trước).","lessonId":"u12n1l4","lessonVersion":"v2.u12n1l4","manifestHash":"013672aa5927648264926e14d514d9d670ba04f547fc10aba6d50095b8e8b587","nodeId":"u12