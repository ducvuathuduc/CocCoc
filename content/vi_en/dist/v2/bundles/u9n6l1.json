ift\" nghĩa là \"món quà\".","id":"u9n6l1-e08","prompt":{"locale":"vi-VN","text":"\"món quà\" trong tiếng Anh là gì?"},"skillIds":["u9.vocab"],"type":"choice","vocabularyIds":["u9.gift"]},{"content":{"tokens":[{"id":"t1","text":"ấy"},{"id":"t2","text":"bán"},{"id":"t3","text":"nhưng"},{"id":"t4","text":"thể"},{"id":"t5","text":"Bà"},{"id":"t6","text":"trả"},{"id":"t7","text":"cà"},{"id":"t8","text":"phê"},{"id":"t9","text":"Rosa"}]},"explanation":"Câu đúng: \"Bà Rosa bán cà phê.\".","gradingRule":{"caseSensitive":false,"correctTokenIds":["t5","t9","t2","t7","t8"],"ignoreDiacritics":false,"ignorePunctuation":false},"hint":"\"coffee\" = cà phê; \"sell\" = bán","id":"u9n6l1-e09","prompt":{"locale":"vi-VN","text":"Dịch sang tiếng Việt: \"Mrs. Rosa sells coffee.\""},"skillIds":["u9.grammar"],"type":"wordBank","vocabularyIds":["u3.coffee","u9.sell"]},{"content":{"tokens":[{"id":"t1","text":"at"},{"id":"t2","text":"fish"},{"id":"t3","text":"buy"},{"id":"t4","text":"the"},{"id":"t5","text":"market"},{"id":"t6","text":"We"}]},"explanation":"Câu đúng: \"We buy fish at the market.\".","gradingRule":{"caseSensitive":false,"correctTokenIds":["t6","t3","t2","t1","t4","t5"],"ignoreDiacritics":false,"ignorePunctuation":false},"hint":"Câu bắt đầu bằng \"We\".","id":"u9n6l1-e10","prompt":{"locale":"vi-VN","text":"Sắp xếp thành câu đúng: \"Chúng tôi mua cá ở chợ.\""},"skillIds":["u9.grammar"],"type":"sentenceOrder","vocabularyIds":["u3.fish","u9.buy","u9.market"]},{"content":{"maxChars":40,"placeholder":"Điền từ còn thiếu"},"explanation":"Từ đúng: \"gift\" → This is a gift for my mother.","gradingRule":{"acceptedText":["gift"],"caseSensitive":false,"ignoreDiacritics":false,"ignorePunctuation":true},"hint":"\"món quà\" trong tiếng Anh là \"g...\"","id":"u9n6l1-e11","prompt":{"locale":"en-US","text":"This is a ___ for my mother. — \"Đây là quà cho mẹ tôi.\""},"skillIds":["u9.grammar"],"type":"fillBlank","vocabularyIds":["u9.gift","u2.mother"]},{"content":{"maxChars":200,"placeholder":"Viết bằng tiếng Anh"},"explanation":"Đáp án: \"I have no money in my wallet.\".","gradingRule":{"acceptedText":["I have no money in my wallet."],"caseSensitive":false,"ignoreDiacritics":false,"ignorePunctuation":true},"hint":"\"no\" = không; \"have\" = có; \"money\" = tiền; \"wallet\" = cái ví","id":"u9n6l1-e12","prompt":{"locale":"vi-VN","text":"Trong ví tôi không có tiền."},"skillIds":["u9.grammar"],"type":"textTranslation","vocabularyIds":["u1.no","u2.have","u9.money","u9.wallet"]},{"content":{"tokens":[{"id":"t1","text":"shoes"},{"id":"t2","text":"The"},{"id":"t3","text":"read"},{"id":"t4","text":"am"},{"id":"t5","text":"Have"},{"id":"t6","text":"sale"},{"id":"t7","text":"are"},{"id":"t8","text":"on"}]},"explanation":"Câu đúng: \"The shoes are on sale.\".","gradingRule":{"caseSensitive":false,"correctTokenIds":["t2","t1","t7","t8","t6"],"ignoreDiacritics":false,"ignorePunctuation":false},"hint":"\"shoes\" = giày; \"sale\" = giảm giá","id":"u9n6l1-e13","prompt":{"locale":"vi-VN","text":"Dịch câu này: \"Đôi giày đang giảm giá.\""},"skillIds":["u9.grammar"],"type":"wordBank","vocabularyIds":["u9.shoes","u9.sale"]}],"gradingRulesVersion":"g1","guideText":"Mẫu câu chính: \"How much is this dress?\" (Cái váy này bao nhiêu tiền?) — \"Can I pay by card?\" (Tôi trả bằng thẻ được không?) — \"It is on sale.\" (Nó đang giảm giá.)\nHow much is + số ít / How much are + số nhiều: \"How much are the shoes?\"\n\"Shoes\" luôn ở dạng số nhiều (một đôi giày = a pair of shoes).\nMàu sắc đứng trước danh từ: \"a red dress\" (một cái váy đỏ). Hỏi màu: \"What color is it?\"\nTrả tiền: pay in cash (tiền mặt) / pay by card (bằng thẻ). \"Expensive\" (đắt) ↔ \"cheap\" (rẻ).","lessonId":"u9n6l1","lessonVersion":"v2.u9n6l1","manifestHash":"013672aa5927648264926e14d514d9d670ba04f547fc10aba6d50095b8e8b587","nodeId":"u9n6","order":69,"rewardIdentity":"v2.u9n6l1","schemaVersion":1,"sectionId":"sec2","signature":"9hbrDKvh793BsBf-wf7PoPbNbz4t8soba7sqaB31bwBr9oTlaBjmsgltPOKWSvXGb2CcwWgG4_u5rcpzta8vBw