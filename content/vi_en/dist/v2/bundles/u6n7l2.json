erenceText":"This is my bedroom."},"explanation":"Câu mẫu: \"This is my bedroom.\".","gradingRule":{"acceptedText":["This is my bedroom."],"caseSensitive":false,"ignoreDiacritics":false,"ignorePunctuation":true},"hint":"Nghĩa: \"Đây là phòng ngủ của tôi.\"","id":"u6n7l2-e13","nonSpeechAlternative":{"content":{"tokens":[{"id":"t1","text":"bedroom"},{"id":"t2","text":"This"},{"id":"t3","text":"is"},{"id":"t4","text":"my"}]},"explanation":"Câu đúng: \"This is my bedroom.\".","gradingRule":{"caseSensitive":false,"correctTokenIds":["t2","t3","t4","t1"],"ignoreDiacritics":false,"ignorePunctuation":false},"hint":"Câu bắt đầu bằng \"This\".","id":"u6n7l2-e13a","prompt":{"locale":"vi-VN","text":"Sắp xếp thành câu đúng: \"Đây là phòng ngủ của tôi.\""},"skillIds":["speaking","u6.grammar"],"type":"sentenceOrder","vocabularyIds":["u6.bedroom"]},"prompt":{"audioAssetId":"a.u6.s4.n","locale":"en-US","text":"Nói câu sau: \"This is my bedroom.\""},"skillIds":["speaking","u6.grammar"],"type":"speakRepeat","vocabularyIds":["u6.bedroom"]},{"content":{"tokens":[{"id":"t1","text":"hai"},{"id":"t2","text":"giờ"},{"id":"t3","text":"chồng"},{"id":"t4","text":"ghế"},{"id":"t5","text":"Phòng"},{"id":"t6","text":"tôi"},{"id":"t7","text":"sổ"},{"id":"t8","text":"có"},{"id":"t9","text":"cửa"},{"id":"t10","text":"chào"}]},"explanation":"Câu đúng: \"Phòng tôi có hai cửa sổ.\".","gradingRule":{"caseSensitive":false,"correctTokenIds":["t5","t6","t8","t1","t9","t7"],"ignoreDiacritics":false,"ignorePunctuation":false},"hint":"\"have\" = có; \"two\" = hai; \"room\" = phòng; \"window\" = cửa sổ","id":"u6n7l2-e14","prompt":{"locale":"vi-VN","text":"Dịch sang tiếng Việt: \"My room has two windows.\""},"skillIds":["u6.grammar"],"type":"wordBank","vocabularyIds":["u2.have","u4.two","u6.room","u6.window"]},{"content":{"maxChars":200,"placeholder":"Viết bằng tiếng Anh"},"explanation":"Đáp án: \"The lamp is on the table.\".","gradingRule":{"acceptedText":["The lamp is on the table."],"caseSensitive":false,"ignoreDiacritics":false,"ignorePunctuation":true},"hint":"\"table\" = cái bàn; \"lamp\" = đèn","id":"u6n7l2-e15","prompt":{"locale":"vi-VN","text":"Cái đèn ở trên bàn."},"skillIds":["u6.grammar"],"type":"textTranslation","vocabularyIds":["u6.table","u6.lamp"]}],"gradingRulesVersion":"g1","guideText":"Mẫu câu chính: \"There is a lamp in my room.\" (Có một cái đèn trong phòng tôi.) — \"There are four chairs.\" (Có bốn cái ghế.) — \"Where do you live?\" (Bạn sống ở đâu?)\nThere is + danh từ số ít; there are + danh từ số nhiều. Rút gọn: there's.\nGiới từ vị trí: in (trong), on (trên): \"in the kitchen\", \"on the table\".\nTính từ đứng TRƯỚC danh từ: \"a big house\" (một ngôi nhà to) — ngược với tiếng Việt.\n\"Live in\" + nơi chốn: \"We live in an apartment.\" Tầng nhà: \"on the fifth floor\".","lessonId":"u6n7l2","lessonVersion":"v2.u6n7l2","manifestHash":"013672aa5927648264926e14d514d9d670ba04f547fc10aba6d50095b8e8b587","nodeId":"u6n7","order":46,"rewardIdentity":"v2.u6n7l2","schemaVersion":1,"sectionId":"sec1","signature":"-cGo-O1NyJG3s0vLP1NNZ4ZfmjdysB_izTEPEDal0d2V9DXKRK3pLRI1cTlpXUHjDlgfVnOxym7IBaHpMuv6Cw","signatureKeyId":"dev-content-1","skillIds":["u6.grammar","listening","speaking","u6.dialogue","reading","u6.story","u6.vocab"],"title":"Ôn tập cửa ải · Bài 2","unitId":"u6"}