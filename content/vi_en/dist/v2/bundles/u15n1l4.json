t":"can"},{"id":"t6","text":"We"}]},"explanation":"Câu đúng: \"We can walk to the bridge.\".","gradingRule":{"caseSensitive":false,"correctTokenIds":["t6","t5","t2","t4","t3","t1"],"ignoreDiacritics":false,"ignorePunctuation":false},"hint":"Câu bắt đầu bằng \"We\".","id":"u15n1l4-e11a","prompt":{"locale":"vi-VN","text":"Sắp xếp thành câu đúng: \"Chúng ta có thể đi bộ đến cây cầu.\""},"skillIds":["speaking","u15.grammar"],"type":"sentenceOrder","vocabularyIds":["u7.can","u10.bridge","u10.walk"]},"prompt":{"audioAssetId":"a.u10.s30.n","locale":"en-US","text":"Nói câu sau: \"We can walk to the bridge.\""},"skillIds":["speaking","u15.grammar"],"type":"speakRepeat","vocabularyIds":["u7.can","u10.bridge","u10.walk"]},{"content":{"maxChars":200,"placeholder":"Viết bằng tiếng Việt (có dấu)"},"explanation":"Đáp án: \"Cảm ơn bạn nhé.\". Cũng đúng: \"Cảm ơn bạn của tôi.\", \"Cảm ơn bạn.\".","gradingRule":{"acceptedText":["Cảm ơn bạn nhé.","Cảm ơn bạn của tôi.","Cảm ơn bạn.","Cảm ơn bạn của mình."],"caseSensitive":false,"ignoreDiacritics":false,"ignorePunctuation":true},"hint":"\"friend\" = bạn; \"thank you\" = cảm ơn","id":"u15n1l4-e12","prompt":{"locale":"en-US","text":"Thank you, my friend."},"skillIds":["u15.grammar"],"type":"textTranslation","vocabularyIds":["u1.friend","u1.thank_you"]}],"gradingRulesVersion":"g1","guideText":"Mẫu câu chính: \"Why are you sad?\" (Sao bạn buồn?) — \"Nam is taller than Tom.\" (Nam cao hơn Tom.) — \"Happy birthday!\" (Chúc mừng sinh nhật!)\nSo sánh hơn với tính từ ngắn: thêm -er + than: tall → taller than, young → younger than, smart → smarter than.\nTính từ cảm xúc đuôi -ed mô tả cảm giác của người: I am bored, I am excited, She was surprised.\nGiới từ đi kèm: afraid of (sợ), worried about (lo về), excited about (háo hức về).\nLời khuyên nhẹ nhàng: \"Don't be sad.\" (Đừng buồn.)","lessonId":"u15n1l4","lessonVersion":"v2.u15n1l4","manifestHash":"013672aa5927648264926e14d514d9d670ba04f547fc10aba6d50095b8e8b587","nodeId":"u15n1","order":112,"rewardIdentity":"v2.u15n1l4","schemaVersion":1,"sectionId":"sec2","signature":"3iBy8bPZxZr5Ldlvgro5_wL7jKQkmZ0puQxYK2mWtDktjmNZyeZKGS2URXxek7Bb3qHJ0gh8r-W53nOjUOGABA","signatureKeyId":"dev-content-1","skillIds":["speaking","u15.grammar","u15.dialogue","u15.vocab"],"title":"Vui hay buồn? · Bài 4","unitId":"u15"}