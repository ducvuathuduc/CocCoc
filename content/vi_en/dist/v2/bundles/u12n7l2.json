hợp"},"skillIds":["speaking","u12.dialogue"],"type":"choice","vocabularyIds":["u1.yes","u1.meet","u2.have","u12.meeting","u12.busy"]},"prompt":{"audioAssetId":"a.u12.d3.n","locale":"en-US","text":"Are you busy?"},"skillIds":["speaking","u12.dialogue"],"type":"dialogueTurn","vocabularyIds":["u1.yes","u1.meet","u2.have","u12.meeting","u12.busy"]},{"content":{"choices":[{"id":"c1","text":"She had a meeting."},{"id":"c2","text":"She wrote emails."},{"id":"c3","text":"She finished work."}],"passage":"Yesterday was Linh's first day at her new job. She is an engineer at a big company. She started work at eight o'clock. Her boss, Mr. Hai, is nice. Her colleagues are friendly. At ten, she had a meeting. In the afternoon, she wrote many emails on her new computer. She finished work at six. She was very tired but happy. \"I love my new job,\" she told Mai.","question":"What did she do at ten?"},"explanation":"Đáp án: \"She had a meeting.\".","gradingRule":{"caseSensitive":false,"correctChoiceId":"c1","ignoreDiacritics":false,"ignorePunctuation":false},"hint":"Đọc lại câu chuyện \"Ngày đầu đi làm của Linh\".","id":"u12n7l2-e09","prompt":{"locale":"en-US","text":"What did she do at ten?"},"skillIds":["reading","u12.story"],"type":"storyQuestion","vocabularyIds":[]},{"content":{"choices":[{"id":"c1","imageAssetId":"i.u2.grandfather","text":"grandfather"},{"id":"c2","imageAssetId":"i.u12.engineer","text":"engineer"},{"id":"c3","imageAssetId":"i.u12.office","text":"office"},{"id":"c4","imageAssetId":"i.u10.street","text":"street"}]},"explanation":"\"engineer\" = \"kỹ sư\".","gradingRule":{"caseSensitive":false,"correctChoiceId":"c2","ignoreDiacritics":false,"ignorePunctuation":false},"hint":"\"kỹ sư\" là \"engineer\".","id":"u12n7l2-e10","prompt":{"locale":"vi-VN","text":"Hình nào là \"kỹ sư\"?"},"skillIds":["u12.vocab"],"type":"imageChoice","vocabularyIds":["u12.engineer"]},{"content":{"pairs":[{"id":"p1","left":{"id":"p1l","text":"yesterday"},"right":{"id":"p1r","text":"hôm qua"}