tive":false,"ignoreDiacritics":false,"ignorePunctuation":true},"hint":"\"nhiều\" trong tiếng Anh là \"m...\"","id":"u4n6l1-e11","prompt":{"locale":"en-US","text":"How ___ pens do you have? — \"Bạn có bao nhiêu cây bút?\""},"skillIds":["u4.grammar"],"type":"fillBlank","vocabularyIds":["u4.many","u2.have","u4.pen"]},{"content":{"maxChars":200,"placeholder":"Viết bằng tiếng Anh"},"explanation":"Đáp án: \"There are ten books in my bag.\".","gradingRule":{"acceptedText":["There are ten books in my bag."],"caseSensitive":false,"ignoreDiacritics":false,"ignorePunctuation":true},"hint":"\"ten\" = mười; \"book\" = quyển sách; \"bag\" = cái cặp","id":"u4n6l1-e12","prompt":{"locale":"vi-VN","text":"Có mười quyển sách trong cặp của tôi."},"skillIds":["u4.grammar"],"type":"textTranslation","vocabularyIds":["u4.ten","u4.book","u4.bag"]},{"content":{"tokens":[{"id":"t1","text":"love"},{"id":"t2","text":"Twenty"},{"id":"t3","text":"eggs"},{"id":"t4","text":"lunch"},{"id":"t5","text":"please"},{"id":"t6","text":"makes"}]},"explanation":"Câu đúng: \"Twenty eggs, please.\".","gradingRule":{"caseSensitive":false,"correctTokenIds":["t2","t3","t5"],"ignoreDiacritics":false,"ignorePunctuation":false},"hint":"\"please\" = làm ơn; \"egg\" = trứng; \"twenty\" = hai mươi","id":"u4n6l1-e13","prompt":{"locale":"vi-VN","text":"Dịch câu này: \"Làm ơn cho tôi hai mươi quả trứng.\""},"skillIds":["u4.grammar"],"type":"wordBank","vocabularyIds":["u1.please","u3.egg","u4.twenty"]}],"gradingRulesVersion":"g1","guideText":"Mẫu câu chính: \"How old are you?\" (Bạn bao nhiêu tuổi?) — \"I am twenty years old.\" (Tôi hai mươi tuổi.) — \"How many books do you have?\" (Bạn có bao nhiêu quyển sách?)\nSố nhiều: thêm -s sau danh từ khi nhiều hơn một: one cat, two cats; one egg, six eggs. Tiếng Việt không đổi danh từ, nhưng tiếng Anh thì có.\nTuổi: dùng \"be\", không dùng \"have\": \"I am ten years old\" hoặc ngắn gọn \"I am ten\". Không nói \"I have ten years\".\nSố: 20 = twenty, 28 = twenty-eight (có gạch nối), 100 = a hundred / one hundred.\n\"How many + danh từ số nhiều\": How many pens? How many cats?","lessonId":"u4n6l1","lessonVersion":"v2.u4n6l1","manifestHash":"013672aa5927648264926e14d514d9d670ba04f547fc10aba6d50095b8e8b587","nodeId":"u4n6","order":29,"rewardIdentity":"v2.u4n6l1","schemaVersion":1,"sectionId":"sec1","signature":"Q0Uyh3yyg9QK_sjd-sMcv71JrGP0t-j310EIProkndH8CQZqsjIE843dKqyx4JtXlBw3Qs6gvRtLG-LqvzJOAg","signatureKeyId":"dev-content-1","skillIds":["u4.vocab","u4.grammar","listening"],"title":"Bao nhiêu? · Bài 1","unitId":"u4"}