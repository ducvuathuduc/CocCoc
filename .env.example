# Public placeholders only. Real process environment belongs outside Git.
APPWRITE_ENDPOINT=https://REGION.cloud.appwrite.io/v1
APPWRITE_PROJECT_ID=SET_TEST_PROJECT_ID
APPWRITE_PROJECT_ENV=test
BUILD_ID=local-scaffold
# APPWRITE_API_KEY and provider/HMAC credentials are intentionally absent.
# Live adapters remain disabled until account, security and device gates pass.
NATIVE_LIVE_ENABLED=false
PRONUNCIATION_ENABLED=false
LIVE_BILLING_ENABLED=false

# Mobile dart-defines (flutter run --dart-define=...); public values only.
# APPWRITE_RECOVERY_URL=
# APPWRITE_VERIFICATION_URL=
# APPWRITE_GOOGLE_ENABLED=false

# Server-only names (set in the Function/process environment, never here, never as dart-defines):
# APPWRITE_API_KEY=            schema:apply / live probes (appwrite/scripts)
# COC_SERVICE_KEYS=            JSON keyring [{"keyId","sender","secretHex"}] for internal HMAC (docs/api/EVENTS_ERRORS.md)
# Provider variable names: GEMINI_API_KEY, GROQ_API_KEY, COC_AZURE_SPEECH_KEY,
# COC_AZURE_SPEECH_REGION, CLOUDFLARE_AI_TOKEN. Provider admission is separate.
# `pnpm dev:services` needs none of these: it uses built-in dev keys and in-memory stores.
