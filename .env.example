# Public placeholders only. Real process environment belongs outside Git.
APPWRITE_ENDPOINT=https://REGION.cloud.appwrite.io/v1
APPWRITE_PROJECT_ID=SET_TEST_PROJECT_ID
APPWRITE_PROJECT_ENV=test
BUILD_ID=local-scaffold
