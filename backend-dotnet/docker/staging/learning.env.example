COC_LEARNING_PERSISTENCE=appwrite
# When using compose.staging.secrets.yaml, keep secret values empty here.
COC_LEARNING_APPWRITE_KEY=
COC_SERVICE_KEYS=
# Optional when exactly one Learning signing key exists. Set during overlapping HMAC rotation.
COC_LEARNING_SIGNING_KEY_ID=
# JSON array of trusted content signing public keys: keyId and publicKeyHex.
COC_CONTENT_PUBLIC_KEYS=[]
COC_LEARNING_ADMITTED=
COC_LEARNING_READINESS_GATES=
COC_LEARNING_WORKER_ENABLED=false
# Preserve the current Node default: energy is unlimited unless explicitly reviewed as LIMITED.
COC_ENERGY_MODE=UNLIMITED
# Empty means content publishing remains unavailable to every account.
COC_MAINTAINER_USER_IDS=
