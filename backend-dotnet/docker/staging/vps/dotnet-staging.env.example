# Install as /etc/cocenglish/dotnet-staging.env after replacing the placeholders.
# The unit expects /srv/cocenglish to exist and Docker at /usr/bin/docker.
COC_RELEASE_DIR=/srv/cocenglish/releases/REPLACE_WITH_COMMIT
COC_IMAGES_ENV_FILE=/srv/cocenglish/deployments/REPLACE_WITH_RELEASE_ID/images.env
