# BUILD_ID is baked into reviewed images by build-images.sh; do not override it here.
APPWRITE_ENDPOINT=https://sgp.cloud.appwrite.io/v1
APPWRITE_PROJECT_ID=6acc656d0025cc57bd81
COC_DATABASE_ID=cocenglish
# Hosting must provide HTTPS routes with trusted certificates and internal-route access controls.
COC_PROGRESS_URL=https://progress-staging.example.invalid
COC_LEARNING_URL=https://learning-staging.example.invalid
COC_AI_URL=https://ai-staging.example.invalid
# Shared default worker cadence; workers remain disabled unless an owner flag is reviewed.
COC_WORKER_INTERVAL_MS=60000
# Explicit web origins, if required; Android/iOS calls do not require browser CORS.
COC_CORS_ALLOWED_ORIGINS=
# Optional: full OTLP/HTTP metrics signal URL; unset keeps exporting disabled.
COC_OTEL_METRICS_ENDPOINT=
