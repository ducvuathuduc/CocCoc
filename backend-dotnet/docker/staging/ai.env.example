COC_AI_PERSISTENCE=appwrite
# When using compose.staging.secrets.yaml, keep secret values empty here.
COC_AI_APPWRITE_KEY=
COC_SERVICE_KEYS=
# Optional when exactly one AI signing key exists. Set during overlapping HMAC rotation.
COC_AI_SIGNING_KEY_ID=
COC_AI_ADMITTED=
COC_AI_READINESS_GATES=
COC_AI_WORKER_ENABLED=false
# Keep provider disabled until speech quality, device, privacy and cost acceptance is complete.
COC_AI_PROVIDER=disabled
COC_AI_SPEECH_ADMITTED=
COC_AI_ROLEPLAY_MIN_PLAN=MAX
COC_AI_VIDEO_CALL_MIN_PLAN=MAX
COC_AZURE_SPEECH_REGION=eastasia
COC_AZURE_SPEECH_KEY=
COC_ASSEMBLYAI_API_KEY=
COC_SPEECH_DAILY_SECONDS=540
COC_DEEPGRAM_API_KEY=
