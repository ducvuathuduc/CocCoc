COC_PROGRESS_PERSISTENCE=appwrite
# When using compose.staging.secrets.yaml, keep secret values empty here.
COC_PROGRESS_APPWRITE_KEY=
COC_PROGRESS_CODE_SECRET=
# JSON service keyring: keyId, sender and secretHex. Supply via a private server file.
# Include the accepted inbound keys and this service's outbound signing key.
COC_SERVICE_KEYS=
# Optional when exactly one Progress signing key exists. Set during overlapping HMAC rotation.
COC_PROGRESS_SIGNING_KEY_ID=
# Set admission values only after the corresponding evidence has been reviewed.
COC_PROGRESS_ADMITTED=
COC_PROGRESS_READINESS_GATES=
COC_PROGRESS_WORKER_ENABLED=false
