@learningBaseUrl = https://learning.example.invalid
@userJwt = appwrite-user-jwt
@operationId = 11111111-1111-4111-8111-111111111111
@localCompletionId = 22222222-2222-4222-8222-222222222222
@bundleHash = 0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

### Sync a fully regraded offline lesson answer log
POST {{learningBaseUrl}}/v1/offline-completions
Authorization: Bearer {{userJwt}}
Idempotency-Key: 33333333-3333-4333-8333-333333333333
Content-Type: application/json

{
  "operationId": "{{operationId}}",
  "localCompletionId": "{{localCompletionId}}",
  "courseId": "vi_en",
  "lessonId": "u1n1l1",
  "lessonVersion": "v1",
  "bundleHash": "{{bundleHash}}",
  "expectedEnrollmentRevision": 0,
  "answers": [
    {
      "exerciseId": "exercise-1",
      "attemptOrdinal": 0,
      "answer": { "kind": "choice", "choiceId": "choice-a" },
      "assisted": false,
      "substituted": false
    }
  ]
}
