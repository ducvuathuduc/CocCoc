# Copy to .env.local. Only names live here — never commit a real key.

# Appwrite (TablesDB + storage). The real values belong in `<repo>/.secrets/real.env`, which the CMS
# reads at startup; leave these empty and that file decides. Set them here only to point one machine
# at another project. With no endpoint, project id and key anywhere, the CMS runs on the file store.
APPWRITE_ENDPOINT=
APPWRITE_PROJECT_ID=
APPWRITE_API_KEY=

CMS_DATABASE_ID=cocenglish
CMS_ASSET_BUCKET=learning-assets

# Comma-separated Appwrite userIds allowed into the CMS. Required in production.
# This list is the whole access rule: the login form checks the password with Appwrite, then only a
# listed userId opens the editor. There is no dev login, so while APPWRITE_* are empty nobody signs in.
CMS_ADMIN_USER_IDS=

# Repo paths. Relative values resolve from apps/cms.
CMS_REPO_ROOT=../..
CMS_DATA_DIR=.cms-data

# Learning service base URL, used later for publishing content versions.
CMS_LEARNING_URL=http://127.0.0.1:4101

# Explicit opt-in for the "Publish thật" button. Leave 0 unless you mean to write to the Appwrite
# project configured above; the dry run does not need it.
CMS_ALLOW_PUBLISH=0
