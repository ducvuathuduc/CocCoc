# [VI] Image chạy MỘT service (learning|progress|ai), dùng chung cho cả 3:
#   stage build: cài pnpm + dependency theo lockfile, copy source, chạy pnpm backend:build;
#   stage runtime: chỉ copy dist của service được chọn → image nhỏ, không có source/toolchain.
# Build arg SERVICE bị validate chỉ nhận learning/progress/ai. Container chạy user node,
# không chứa secret trong layer; secret được inject lúc runtime qua env file.
# Registry-verified multi-platform index, 2026-10-25. No runtime secrets in builds.
FROM node:22.23.3-bookworm-slim@sha256:3ed98443660ff48413b5af19ecefce3b9d50845a901a43420d47cc63a9fddbe9 AS build
WORKDIR /workspace
RUN npm install --global pnpm@10.15.0
COPY package.json pnpm-lock.yaml ./
RUN pnpm install --frozen-lockfile
COPY tsconfig.backend.json ./
COPY packages/api_contracts/ packages/api_contracts/
COPY services/ services/
COPY tools/scripts/backend-check.mjs tools/scripts/backend-check.mjs
RUN pnpm backend:build

FROM node:22.23.3-bookworm-slim@sha256:3ed98443660ff48413b5af19ecefce3b9d50845a901a43420d47cc63a9fddbe9
ARG SERVICE
RUN case "$SERVICE" in learning|progress|ai) ;; *) exit 1 ;; esac
ENV NODE_ENV=production HOST=0.0.0.0 PORT=8080
WORKDIR /app
COPY --from=build --chown=node:node /workspace/services/${SERVICE}/dist/ ./
USER node
EXPOSE 8080
CMD ["node", "http.mjs"]
