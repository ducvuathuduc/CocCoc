# Public configuration template only. Copy outside Git; inject keys there later.
# These disabled adapters keep /ready and business commands closed without admission.
APPWRITE_ENDPOINT=https://sgp.cloud.appwrite.io/v1
APPWRITE_PROJECT_ID=replace-with-test-project-id
COC_DATABASE_ID=cocenglish
COC_LEARNING_PERSISTENCE=disabled
COC_PROGRESS_PERSISTENCE=disabled
COC_AI_PERSISTENCE=disabled
COC_AI_PROVIDER=disabled
COC_WORKER_INTERVAL_MS=30000
# Per-process HTTP concurrency cap (1..1024); excess requests receive retryable 429.
COC_HTTP_MAX_IN_FLIGHT=128
# COC_{LEARNING,PROGRESS,AI}_APPWRITE_KEY: least-privilege server-only credentials.
# COC_{LEARNING,PROGRESS,AI}_ADMITTED=reviewed-cloud-gate only after recorded admission.
# COC_CONTENT_PUBLIC_KEYS: approved signing public keys, COC_SERVICE_KEYS: private HMAC keyring.
# Direct relay currently requires HTTPS COC_{LEARNING,PROGRESS,AI}_URL.
# Container-local HTTP does not silently bypass the relay TLS requirement.
# Optional speech configuration belongs only in .secrets/ai.env, never in mobile defines.
# COC_AI_PROVIDER=speech selects actual recorded speech only when a provider is configured.
# COC_AZURE_SPEECH_KEY / COC_AZURE_SPEECH_REGION: dedicated pronunciation + recognition.
# COC_ASSEMBLYAI_API_KEY / COC_DEEPGRAM_API_KEY: STT fallback, never pronunciation scores.
# COC_SPEECH_DAILY_SECONDS: positive bounded daily speech allocation; review before enabling.
# Gemini live/text model integration is not implemented by this runtime foundation.
# Hosted simulated purchases/gifts/rewarded ads are disabled in code; no payment key enables them.
